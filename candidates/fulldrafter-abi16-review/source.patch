+struct Buffer {
+    std::vector<int32_t> host, got;
+    void* device = nullptr;
+    explicit Buffer(int n) : host(n+2*guard,sentinel), got(host) {
+        device = rad_dev_alloc(static_cast<int64_t>(host.size()*4),RAD_MEM_DEVICE);
