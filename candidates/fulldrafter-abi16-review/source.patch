+    print(f" Target: {TARGET_URL} | Runs: {NUM_RUNS} | Reqs/Run: {NUM_REQUESTS} | Concurrency: {CONCURRENCY}")
+    print("=" * 72)
+
+    for run_idx in range(1, NUM_RUNS + 1):
+        temp_out = f"tests/live_results/run_{run_idx}.json"
