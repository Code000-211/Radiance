@@ -1153,8 +1153,13 @@ TEST(a_layer_with_no_fixed_stride_is_refused) {
         RadWriter w;
         CHECK_OK(w.begin(p.c_str()));
         w.set_arch("radtest");
-        for (int e = 0; e < 3; ++e)
-            CHECK(w.add_weight(mkw("e", plain_bf16(), 32, 64, 0, e, 0), ps.ptr.data()) >= 0);
+        for (int e = 0; e < 3; ++e) {
+            /* DISTINCT NAMES. A weight is stored once per name, so three experts called "e" are
+             * refused by that rule before the stride is ever reached -- and this case is about the
+             * stride. The names carry the expert id for the same reason the diagnostic does. */
+            const std::string nm = "e" + std::to_string(e);
+            CHECK(w.add_weight(mkw(nm.c_str(), plain_bf16(), 32, 64, 0, e, 0), ps.ptr.data()) >= 0);
+        }
         CHECK_OK(w.finish());
 
         /* It opens as written. */
diff --git a/tests/fulldrafter_markov_select_gpu_test.hip b/tests/fulldrafter_markov_select_gpu_test.hip
new file mode 100644
index 0000000000000000000000000000000000000000..85e86a029c866142b1bc48ff53220bca2cf0d887
--- /dev/null
+++ b/tests/fulldrafter_markov_select_gpu_test.hip
@@ -0,0 +1,358 @@
+/* Real gfx1201 selector regression, not a reimplementation of its GPU reductions.
+ * Including the production translation unit gives the test its actual kernel and scratch
+ * layout without exporting test hooks. Only the selector launch wrapper is executed.
+ * Build/run: see libr4d/README.md, "FullDrafter selector regression".
+ */
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#include "../libr4d/r4d_fulldrafter.hip"
+
+namespace {
+constexpr int kSequences = 2;
+constexpr int kPrevCount = 16;
+constexpr uint32_t kUnwrittenId = 0xdeadbeefu;
+constexpr float kUnwrittenScore = -8192.0f;
+constexpr uint32_t kAnchors[kSequences] = {11, 13};
+constexpr uint32_t kCollisionIds[K_TOP] = {
+    7, 263, 519, 775, 1031, 1287, 1543, 1799,
+    2055, 2311, 2567, 2823, 3079, 3335, 3591, 3847,
+};
+constexpr uint32_t kMixedIds[] = {
+    31, 287, 543, 799, 1055, 1311, 1567, 1823,
+    4007, 27415, 58424, 120343, 124177, 155295, 194191,
+    240815, 244503, 248076,
+};
+static_assert(M2_GRID_BLOCKS == 64 && M2_THREADS == 256 && K_TOP == 16);
+static_assert(V_TOTAL == 248320 && V_ACT == 248077 && V_TOTAL / M2_GRID_BLOCKS == 3880);
+static_assert(M_RANK == 64 && S_RANK == 64 && H_DIM == 768);
+static_assert(BLOCK_K == 6 && FULLDRAFTER_TOTAL_K == 12);
+static_assert(kCollisionIds[15] < V_TOTAL / M2_GRID_BLOCKS);
+static_assert(kCollisionIds[15] % M2_THREADS == kCollisionIds[0] % M2_THREADS);
+
+size_t checked_values = 0;
+
+void require(bool condition, const char* message) {
+    if (!condition) {
+        std::fprintf(stderr, "FAIL: %s\n", message);
+        std::exit(1);
+    }
+}
+
+void hip_check(hipError_t error, const char* expression, int line) {
+    if (error != hipSuccess) {
+        std::fprintf(stderr, "FAIL: line %d: %s: %s\n", line, expression,
+                     hipGetErrorString(error));
+        std::exit(1);
+    }
+}
+#define HIP_CHECK(expression) hip_check((expression), #expression, __LINE__)
+
+template <class T> struct DeviceBuffer {
+    T* data = nullptr;
+    explicit DeviceBuffer(size_t count) {
+        HIP_CHECK(hipMalloc(reinterpret_cast<void**>(&data), count * sizeof(T)));
+    }
+    ~DeviceBuffer() { HIP_CHECK(hipFree(data)); }
+    DeviceBuffer(const DeviceBuffer&) = delete;
+    DeviceBuffer& operator=(const DeviceBuffer&) = delete;
+};
+
+uint16_t exact_bf16(int value) {
+    const float f = static_cast<float>(value);
+    uint32_t bits;
+    std::memcpy(&bits, &f, sizeof(bits));
+    require((bits & 0xffffu) == 0, "fixture value must be exactly BF16-representable");
+    return static_cast<uint16_t>(bits >> 16);
+}
+
+// All nonzero coordinates are integers, and every intermediate is far below 2^24.
+// Integer scalar arithmetic is thus an independent, zero-tolerance float/BF16 oracle.
+int anchor_a0(uint32_t token) { return static_cast<int>(token % 5) - 2; }
+int anchor_a63(uint32_t token) { return static_cast<int>(token % 3) - 1; }
+int pred0(uint32_t token) { return 1 + static_cast<int>(token % 2); }
+int pred63(uint32_t token) { return 1 + static_cast<int>(token % 3); }
+int hidden0(int sequence, int stage, int slot) { return 16 * sequence + 4 * stage + slot; }
+int hidden767(int sequence, int stage, int slot) { return sequence + stage + slot; }
+
+struct Features {
+    int sequence = -1;
+    int b0 = 0, b63 = 0;
+    int succ0 = 0, succ63 = 0;
+};
+
+int base_logit(const Features& f, uint32_t token, int sequence, int stage, int slot) {
+    if (token >= V_ACT) return 1 << 20; // Padding would win every slot if scanned.
+    if (f.sequence != sequence) return -4096;
+    // Both sequence-1 anchors have pred0 == 2. Give the higher-ID tied winner a
+    // unary lead exactly canceled by its smaller successor code, so it is visited first.
+    return 128 + 32 * stage + 2 * slot + 8 * sequence + (token == V_ACT - 1 ? 8 : 0)
+           + (token == 124177 ? 2 * hidden0(sequence, stage, slot) : 0);
+}
+
+struct Candidate { uint32_t id; int unary; };
+struct Oracle {
+    std::array<uint32_t, M2_GRID_BLOCKS * K_TOP> block_ids;
+    std::array<float, M2_GRID_BLOCKS * K_TOP> block_unary;
+    std::array<uint32_t, K_TOP> ids;
+    std::array<float, K_TOP> scores;
+    uint32_t winner = kUnwrittenId;
+};
+
+Oracle scalar_oracle(const std::vector<Features>& features, int sequence, int stage,
+                     int slot, uint32_t anchor) {
+    std::vector<Candidate> vocabulary(V_ACT);
+    for (uint32_t v = 0; v < V_ACT; ++v) {
+        const Features& f = features[v];
+        vocabulary[v] = {v, base_logit(f, v, sequence, stage, slot) +
+                            anchor_a0(anchor) * f.b0 + anchor_a63(anchor) * f.b63};
+    }
+    const auto order = [](const Candidate& a, const Candidate& b) {
+        return a.unary != b.unary ? a.unary > b.unary : a.id < b.id;
+    };
+    Oracle result;
+    // Sort the complete scalar vocabulary, never emulate threads, shuffles or feed/pop.
+    // Block outputs are also observable, so check them separately before the global sort.
+    const int per_block = (V_TOTAL + M2_GRID_BLOCKS - 1) / M2_GRID_BLOCKS;
+    for (int b = 0; b < M2_GRID_BLOCKS; ++b) {
+        auto begin = vocabulary.begin() + b * per_block;
+        auto end = vocabulary.begin() + std::min((b + 1) * per_block, V_ACT);
+        std::partial_sort(begin, begin + K_TOP, end, order);
+        for (int k = 0; k < K_TOP; ++k) {
+            result.block_ids[b * K_TOP + k] = begin[k].id;
+            result.block_unary[b * K_TOP + k] = static_cast<float>(begin[k].unary);
+        }
+    }
+    std::partial_sort(vocabulary.begin(), vocabulary.begin() + K_TOP, vocabulary.end(), order);
+    int best_score = -1000000;
+    for (int k = 0; k < K_TOP; ++k) {
+        const Candidate& c = vocabulary[k];
+        const Features& f = features[c.id];
+        const int score = c.unary + hidden0(sequence, stage, slot) * pred0(anchor) * f.succ0
+                                 - 2 * hidden767(sequence, stage, slot) * pred63(anchor) * f.succ63;
+        result.ids[k] = c.id;
+        result.scores[k] = static_cast<float>(score);
+        if (score > best_score || (score == best_score && c.id < result.winner)) {
+            best_score = score;
+            result.winner = c.id;
+        }
+    }
+    return result;
+}
+
+void expect_ids(const char* label, const uint32_t* expected, const uint32_t* actual,
+                size_t count, int sequence, int stage, int slot) {
+    for (size_t i = 0; i < count; ++i) {
+        if (expected[i] != actual[i]) {
+            std::fprintf(stderr, "FAIL: %s seq=%d stage=%d slot=%d index=%zu: expected %u, got %u\n",
+                         label, sequence, stage, slot, i, expected[i], actual[i]);
+            std::exit(1);
+        }
+        ++checked_values;
+    }
+}
+
+void expect_scores(const char* label, const float* expected, const float* actual,
+                   size_t count, int sequence, int stage, int slot) {
+    for (size_t i = 0; i < count; ++i) {
+        if (std::memcmp(expected + i, actual + i, sizeof(float)) != 0) {
+            std::fprintf(stderr, "FAIL: %s seq=%d stage=%d slot=%d index=%zu: expected %a, got %a\n",
+                         label, sequence, stage, slot, i, expected[i], actual[i]);
+            std::exit(1);
+        }
+        ++checked_values;
+    }
+}
+
+struct Published {
+    std::array<uint32_t, FULLDRAFTER_TOTAL_K * K_TOP> ids;
+    std::array<float, FULLDRAFTER_TOTAL_K * K_TOP> scores;
+    std::array<uint32_t, FULLDRAFTER_TOTAL_K> tokens;
+    std::array<uint32_t, kPrevCount> prev;
+};
+
+void run_regression() {
+    std::vector<Features> features(V_TOTAL);
+    for (uint32_t id : kCollisionIds) features[id] = {0, 1, 2, 0, 1};
+    for (uint32_t id : kMixedIds) features[id] = {1, 1, 2, 0, 1};
+    // These two cross the Top16 cutoff for anchor 13, but not for the winning token 1823.
+    for (uint32_t id : {240815u, 244503u}) {
+        features[id].b0 = 4;
+        features[id].b63 = -2;
+    }
+    // Equal reranked scores: the lower ID must win, including when visited later.
+    for (uint32_t id : {3591u, 3847u, 1823u, 124177u}) features[id].succ0 = 8;
+    features[124177].succ0 = 7;
+
+    const size_t code_count = static_cast<size_t>(V_TOTAL) * M_RANK;
+    DeviceBuffer<uint16_t> a(code_count), b(code_count), pred(code_count), succ(code_count);
+    DeviceBuffer<uint16_t> projection(static_cast<size_t>(S_RANK) * H_DIM);
+    std::vector<uint16_t> weights(code_count, 0);
+    for (uint32_t v = 0; v < V_TOTAL; ++v) {
+        weights[static_cast<size_t>(v) * M_RANK] = exact_bf16(anchor_a0(v));
+        weights[static_cast<size_t>(v) * M_RANK + 63] = exact_bf16(anchor_a63(v));
+    }
+    HIP_CHECK(hipMemcpy(a.data, weights.data(), weights.size() * sizeof(uint16_t), hipMemcpyHostToDevice));
+    std::fill(weights.begin(), weights.end(), 0);
+    for (uint32_t v = 0; v < V_TOTAL; ++v) {
+        weights[static_cast<size_t>(v) * M_RANK] = exact_bf16(features[v].b0);
+        weights[static_cast<size_t>(v) * M_RANK + 63] = exact_bf16(features[v].b63);
+    }
+    HIP_CHECK(hipMemcpy(b.data, weights.data(), weights.size() * sizeof(uint16_t), hipMemcpyHostToDevice));
+    std::fill(weights.begin(), weights.end(), 0);
+    for (uint32_t v = 0; v < V_TOTAL; ++v) {
+        weights[static_cast<size_t>(v) * S_RANK] = exact_bf16(pred0(v));
+        weights[static_cast<size_t>(v) * S_RANK + 63] = exact_bf16(pred63(v));
+    }
+    HIP_CHECK(hipMemcpy(pred.data, weights.data(), weights.size() * sizeof(uint16_t), hipMemcpyHostToDevice));
+    std::fill(weights.begin(), weights.end(), 0);
+    for (uint32_t v = 0; v < V_TOTAL; ++v) {
+        weights[static_cast<size_t>(v) * S_RANK] = exact_bf16(features[v].succ0);
+        weights[static_cast<size_t>(v) * S_RANK + 63] = exact_bf16(features[v].succ63);
+    }
+    HIP_CHECK(hipMemcpy(succ.data, weights.data(), weights.size() * sizeof(uint16_t), hipMemcpyHostToDevice));
+    weights.assign(static_cast<size_t>(S_RANK) * H_DIM, 0);
+    weights[0] = exact_bf16(1);
+    weights[63 * H_DIM + H_DIM - 1] = exact_bf16(-2);
+    HIP_CHECK(hipMemcpy(projection.data, weights.data(), weights.size() * sizeof(uint16_t), hipMemcpyHostToDevice));
+
+    FullDrafterGpuPointers pointers{};
+    pointers.markov_matrix_a = a.data;
+    pointers.markov_matrix_b = b.data;
+    pointers.selector_pred_codebook = pred.data;
+    pointers.selector_succ_codebook = succ.data;
+    pointers.selector_hidden_proj = projection.data;
+    // The selector only tests this pointer for non-null to choose the full, padded vocabulary;
+    // it never reads a teacher head. No teacher GEMV/backbone is part of this focused test.
+    pointers.teacher_lm_head_rank1 = a.data;
+    DeviceBuffer<FullDrafterGpuPointers> params(1);
+    HIP_CHECK(hipMemcpy(params.data, &pointers, sizeof(pointers), hipMemcpyHostToDevice));
+    DeviceBuffer<char> scratch(kSequences * SCR_PER_SEQ);
+    DeviceBuffer<uint32_t> tokens(kSequences * FULLDRAFTER_TOTAL_K);
+    HIP_CHECK(hipMemset(scratch.data, 0, kSequences * SCR_PER_SEQ));
+    std::array<Published, kSequences> expected;
+    for (int s = 0; s < kSequences; ++s) {
+        Published& e = expected[s];
+        e.ids.fill(kUnwrittenId);
+        e.scores.fill(kUnwrittenScore);
+        e.tokens.fill(kUnwrittenId);
+        e.prev.fill(kUnwrittenId);
+        e.prev[0] = kAnchors[s];
+        char* seq = scratch.data + s * SCR_PER_SEQ;
+        HIP_CHECK(hipMemcpy(seq + SCR_PROP_ID_OFF, e.ids.data(), sizeof(e.ids), hipMemcpyHostToDevice));
+        HIP_CHECK(hipMemcpy(seq + SCR_PROP_VAL_OFF, e.scores.data(), sizeof(e.scores), hipMemcpyHostToDevice));
+        HIP_CHECK(hipMemcpy(seq + SCR_PREV_TOK_OFF, e.prev.data(), sizeof(e.prev), hipMemcpyHostToDevice));
+        HIP_CHECK(hipMemcpy(tokens.data + s * FULLDRAFTER_TOTAL_K, e.tokens.data(), sizeof(e.tokens), hipMemcpyHostToDevice));
+        for (int stage = 1; stage <= 2; ++stage) {
+            std::vector<float> hidden(BLOCK_K * H_DIM, 0.0f);
+            for (int slot = 0; slot < BLOCK_K; ++slot) {
+                hidden[slot * H_DIM] = static_cast<float>(hidden0(s, stage, slot));
+                hidden[slot * H_DIM + H_DIM - 1] = static_cast<float>(hidden767(s, stage, slot));
+            }
+            HIP_CHECK(hipMemcpy(seq + (stage == 1 ? SCR_H1_OFF : SCR_H2_OFF), hidden.data(),
+                                hidden.size() * sizeof(float), hipMemcpyHostToDevice));
+        }
+    }
+
+    hipStream_t stream;
+    HIP_CHECK(hipStreamCreate(&stream));
+    for (int stage = 1; stage <= 2; ++stage) {
+        for (int s = 0; s < kSequences; ++s) {
+            std::vector<float> logits(static_cast<size_t>(BLOCK_K) * V_TOTAL);
+            for (int slot = 0; slot < BLOCK_K; ++slot)
+                for (uint32_t v = 0; v < V_TOTAL; ++v)
+                    logits[static_cast<size_t>(slot) * V_TOTAL + v] =
+                        static_cast<float>(base_logit(features[v], v, s, stage, slot));
+            HIP_CHECK(hipMemcpy(scratch.data + s * SCR_PER_SEQ + SCR_BASE_LOGITS_OFF,
+                                logits.data(), logits.size() * sizeof(float), hipMemcpyHostToDevice));
+        }
+        for (int slot = 0; slot < BLOCK_K; ++slot) {
+            const int global_slot = (stage - 1) * BLOCK_K + slot;
+            std::array<Oracle, kSequences> oracle;
+            for (int s = 0; s < kSequences; ++s) {
+                Published& e = expected[s];
+                oracle[s] = scalar_oracle(features, s, stage, slot, e.prev[global_slot]);
+                const Oracle& o = oracle[s];
+                if (s == 0) {
+                    expect_ids("16 winners from thread 7", kCollisionIds, o.ids.data(), K_TOP, s, stage, slot);
+                    require(o.winner == 3591, "reranker must choose the fifteenth same-thread candidate");
+                } else {
+                    require(o.winner == 1823, "reranker must resolve the cross-block winner tie by low ID");
+                    require(o.ids[0] == 124177 && o.ids[1] == V_ACT - 1,
+                            "higher-ID tied winner must lead; last active row must survive padding exclusion");
+                    const auto low = std::find(o.ids.begin(), o.ids.end(), 1823u);
+                    require(low != o.ids.end() && o.scores[low - o.ids.begin()] == o.scores[0],
+                            "lower-ID winner must appear later with exactly the same reranked score");
+                    for (uint32_t id : {240815u, 244503u}) {
+                        const bool present = std::find(o.ids.begin(), o.ids.end(), id) != o.ids.end();
+                        require(present == (global_slot == 0), "anchor conditioning must change shortlist membership");
+                    }
+                }
+                std::copy(o.ids.begin(), o.ids.end(), e.ids.begin() + global_slot * K_TOP);
+                std::copy(o.scores.begin(), o.scores.end(), e.scores.begin() + global_slot * K_TOP);
+                e.tokens[global_slot] = o.winner;
+                e.prev[global_slot + 1] = o.winner;
+            }
+            require(r4d_fulldrafter_slot_markov_select(stage, slot, params.data, scratch.data,
+                                                      tokens.data, kSequences, stream) == 0,
+                    "production selector launch wrapper must accept the fixture");
+            HIP_CHECK(hipGetLastError());
+            HIP_CHECK(hipStreamSynchronize(stream));
+            for (int s = 0; s < kSequences; ++s) {
+                const char* seq = scratch.data + s * SCR_PER_SEQ;
+                Published actual;
+                HIP_CHECK(hipMemcpy(actual.ids.data(), seq + SCR_PROP_ID_OFF, sizeof(actual.ids), hipMemcpyDeviceToHost));
+                HIP_CHECK(hipMemcpy(actual.scores.data(), seq + SCR_PROP_VAL_OFF, sizeof(actual.scores), hipMemcpyDeviceToHost));
+                HIP_CHECK(hipMemcpy(actual.prev.data(), seq + SCR_PREV_TOK_OFF, sizeof(actual.prev), hipMemcpyDeviceToHost));
+                HIP_CHECK(hipMemcpy(actual.tokens.data(), tokens.data + s * FULLDRAFTER_TOTAL_K,
+                                    sizeof(actual.tokens), hipMemcpyDeviceToHost));
+                const Published& e = expected[s];
+                // Compare all slots after each launch, including untouched sentinels and earlier
+                // stage output: a correct value written to the wrong global slot must fail.
+                expect_ids("published Top16", e.ids.data(), actual.ids.data(), e.ids.size(), s, stage, slot);
+                expect_scores("reranked scores", e.scores.data(), actual.scores.data(), e.scores.size(), s, stage, slot);
+                expect_ids("winning tokens", e.tokens.data(), actual.tokens.data(), e.tokens.size(), s, stage, slot);
+                expect_ids("Markov chain publication", e.prev.data(), actual.prev.data(), e.prev.size(), s, stage, slot);
+                std::array<uint32_t, M2_GRID_BLOCKS * K_TOP> block_ids;
+                std::array<float, M2_GRID_BLOCKS * K_TOP> block_unary;
+                HIP_CHECK(hipMemcpy(block_ids.data(), seq + SCR_BLK_CANDS_OFF, sizeof(block_ids), hipMemcpyDeviceToHost));
+                HIP_CHECK(hipMemcpy(block_unary.data(), seq + SCR_BLK_UNARY_OFF, sizeof(block_unary), hipMemcpyDeviceToHost));
+                expect_ids("block Top16", oracle[s].block_ids.data(), block_ids.data(), block_ids.size(), s, stage, slot);
+                expect_scores("block unary scores", oracle[s].block_unary.data(), block_unary.data(), block_unary.size(), s, stage, slot);
+                uint32_t arrival;
+                HIP_CHECK(hipMemcpy(&arrival, seq + SCR_ARRIVAL_CTR_OFF, sizeof(arrival), hipMemcpyDeviceToHost));
+                require(arrival == 0, "last workgroup must reset arrival counter before the next slot");
+            }
+        }
+    }
+    HIP_CHECK(hipStreamDestroy(stream));
+}
+} // namespace
+
+int main() {
+    int count = 0;
+    HIP_CHECK(hipGetDeviceCount(&count));
+    int device = -1;
+    for (int i = 0; i < count; ++i) {
+        hipDeviceProp_t properties{};
+        HIP_CHECK(hipGetDeviceProperties(&properties, i));
+        if (std::strncmp(properties.gcnArchName, "gfx1201", 7) == 0 &&
+            (properties.gcnArchName[7] == '\0' || properties.gcnArchName[7] == ':') &&
+            properties.warpSize == 32) {
+            device = i;
+            break;
+        }
+    }
+    if (device < 0) {
+        std::puts("SKIP: fulldrafter_markov_select_gpu_test requires a visible gfx1201 Wave32 device");
+        return 77;
+    }
+    HIP_CHECK(hipSetDevice(device));
+    run_regression();
+    std::printf("PASS: actual selector, 2 sequences x 2 stages x 6 slots; %zu exact ID/score checks\n", checked_values);
+    return 0;
+}
diff --git a/tests/fulldrafter_select_test.cpp b/tests/fulldrafter_select_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f3825057d53874b56405d5c2f085625e4b935b3b
--- /dev/null
+++ b/tests/fulldrafter_select_test.cpp
@@ -0,0 +1,449 @@
+/* fulldrafter_select_test.cpp -- CPU-only regression test for FullDrafter top-16 candidate selection.
+ *
+ * Verifies exact top-16 vocabulary selection with strict lower-ID tie breaking:
+ *   1. Negative control: proves that old per-thread top-2 hierarchy loses up to 14 true candidates
+ *      and selects the wrong downstream winner under selector bias.
+ *   2. Proves that FullDrafterThreadTop16 retains all candidates and selects the exact winner.
+ *   3. Adversarial same-thread top-16 retention.
+ *   4. Strict lower-ID tie breaking on equal finite scores.
+ *   5. Inactive padding rejection (tokens >= V_ACT cannot enter top-16).
+ *   6. Dual-rank (V_TOTAL=248320) and single-rank (V_SHARD=124160) vocabulary partitioning.
+ *   7. Deterministic randomized comparison against full std::stable_sort.
+ */
+
+#include "rad_test.h"
+#include "../libr4d/r4d_fulldrafter_select.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <random>
+
+using namespace r4d;
+
+static constexpr int TEST_BLOCKS       = 64;
+static constexpr int TEST_THREADS      = 256;
+static constexpr int TEST_V_TOTAL      = 248320;
+static constexpr int TEST_V_ACT        = 248077;
+static constexpr int TEST_V_SHARD      = 124160;
+static constexpr int TEST_K_TOP        = 16;
+
+// Mock old top-2 hierarchy for deliberate negative control
+struct OldTop2Thread {
+    float top_v[2] = { FULLDRAFTER_SENTINEL_SCORE, FULLDRAFTER_SENTINEL_SCORE };
+    uint32_t top_i[2] = { FULLDRAFTER_SENTINEL_ID, FULLDRAFTER_SENTINEL_ID };
+
+    void insert(float logit, uint32_t v) {
+        if (fulldrafter_is_better(logit, v, top_v[0], top_i[0])) {
+            top_v[1] = top_v[0]; top_i[1] = top_i[0];
+            top_v[0] = logit;    top_i[0] = v;
+        } else if (fulldrafter_is_better(logit, v, top_v[1], top_i[1])) {
+            top_v[1] = logit;    top_i[1] = v;
+        }
+    }
+};
+
+static void old_block_top16(
+    const OldTop2Thread* threads,
+    float* out_vals,
+    uint32_t* out_ids
+) {
+    // Old implementation staged 512 candidate pairs into LDS
+    float s_all_val[512];
+    uint32_t s_all_id[512];
+    for (int t = 0; t < TEST_THREADS; ++t) {
+        s_all_val[t]       = threads[t].top_v[0];
+        s_all_id[t]        = threads[t].top_i[0];
+        s_all_val[256 + t] = threads[t].top_v[1];
+        s_all_id[256 + t]  = threads[t].top_i[1];
+    }
+
+    for (int k = 0; k < TEST_K_TOP; ++k) {
+        float best_v = FULLDRAFTER_SENTINEL_SCORE;
+        uint32_t best_i = FULLDRAFTER_SENTINEL_ID;
+        int best_idx = -1;
+        for (int i = 0; i < 512; ++i) {
+            if (fulldrafter_is_better(s_all_val[i], s_all_id[i], best_v, best_i)) {
+                best_v = s_all_val[i];
+                best_i = s_all_id[i];
+                best_idx = i;
+            }
+        }
+        out_vals[k] = best_v;
+        out_ids[k] = best_i;
+        if (best_idx >= 0) {
+            s_all_val[best_idx] = FULLDRAFTER_SENTINEL_SCORE;
+            s_all_id[best_idx]  = FULLDRAFTER_SENTINEL_ID;
+        }
+    }
+}
+
+// -----------------------------------------------------------------------------
+// Test 1: Deliberate Negative Control & Exact Top-16 Proof on Counterexample
+// -----------------------------------------------------------------------------
+TEST(counterexample_negative_control_and_exact_proof) {
+    // Counterexample geometry from PREFLIGHT.md:
+    // V = 248320, 64 blocks, 256 threads, ceil(V/64) = 3880 rows per block.
+    // Thread 0 of Block 0 visits 0, 256, 512, 768, 1024, ..., 3840 (16 rows).
+    // Logits: 100, 99, 98, ..., 85.
+    // All other active logits: -1000.
+    std::vector<float> logits(TEST_V_TOTAL, -1000.0f);
+    std::vector<uint32_t> expected_cand_ids(TEST_K_TOP);
+    for (int i = 0; i < TEST_K_TOP; ++i) {
+        uint32_t tok = (uint32_t)(i * 256);
+        logits[tok] = 100.0f - (float)i;
+        expected_cand_ids[i] = tok;
+    }
+
+    // Run Old Top-2 pipeline on Block 0
+    OldTop2Thread old_threads[TEST_THREADS];
+    const int v_per_block = (TEST_V_TOTAL + TEST_BLOCKS - 1) / TEST_BLOCKS;
+    const int v_start = 0;
+    const int v_end = std::min(v_start + v_per_block, TEST_V_TOTAL);
+
+    for (int tid = 0; tid < TEST_THREADS; ++tid) {
+        for (int v = v_start + tid; v < v_end; v += TEST_THREADS) {
+            if (v < TEST_V_ACT) {
+                old_threads[tid].insert(logits[v], (uint32_t)v);
+            }
+        }
+    }
+
+    float old_vals[TEST_K_TOP];
+    uint32_t old_ids[TEST_K_TOP];
+    old_block_top16(old_threads, old_vals, old_ids);
+
+    // Negative control check: old top-2 hierarchy retained ONLY tokens 0 and 256,
+    // and lost tokens 512..3840!
+    CHECK_EQ(old_ids[0], 0u);
+    CHECK_EQ(old_ids[1], 256u);
+    bool old_has_512 = false;
+    for (int k = 0; k < TEST_K_TOP; ++k) {
+        if (old_ids[k] == 512u) old_has_512 = true;
+    }
+    CHECK(!old_has_512); // Deliberate failure verified: token 512 was lost!
+
+    // Run Exact Top-16 pipeline on Block 0 using shared FullDrafterThreadTop16
+    FullDrafterThreadTop16 exact_threads[TEST_THREADS];
+    for (int tid = 0; tid < TEST_THREADS; ++tid) exact_threads[tid].init();
+
+    for (int tid = 0; tid < TEST_THREADS; ++tid) {
+        for (int v = v_start + tid; v < v_end; v += TEST_THREADS) {
+            if (v >= TEST_V_ACT) continue;
+            exact_threads[tid].insert(logits[v], (uint32_t)v);
+        }
+    }
+
+    int local_idx[TEST_THREADS] = {0};
+    float exact_vals[TEST_K_TOP];
+    uint32_t exact_ids[TEST_K_TOP];
+    fulldrafter_block_top16(exact_threads, local_idx, TEST_THREADS, exact_vals, exact_ids);
+
+    // Exact pipeline check: ALL 16 candidates are retained in exact descending order
+    for (int k = 0; k < TEST_K_TOP; ++k) {
+        CHECK_EQ(exact_ids[k], expected_cand_ids[k]);
+        CHECK_EQ(exact_vals[k], 100.0f - (float)k);
+    }
+    bool exact_has_512 = false;
+    for (int k = 0; k < TEST_K_TOP; ++k) {
+        if (exact_ids[k] == 512u) exact_has_512 = true;
+    }
+    CHECK(exact_has_512);
+
+    // Downstream selector demonstration:
+    // Selector query adds bias +100.0f to token 512, and 0.0f to all others.
+    auto score_selector = [](uint32_t tok_id, float unary_val) -> float {
+        float bias = (tok_id == 512u) ? 100.0f : 0.0f;
+        return unary_val + bias;
+    };
+
+    // Old selector winner:
+    uint32_t old_winner = old_ids[0];
+    float old_best_score = score_selector(old_ids[0], old_vals[0]);
+    for (int k = 1; k < TEST_K_TOP; ++k) {
+        float s = score_selector(old_ids[k], old_vals[k]);
+        if (fulldrafter_is_better(s, old_ids[k], old_best_score, old_winner)) {
+            old_best_score = s;
+            old_winner = old_ids[k];
+        }
+    }
+
+    // Exact selector winner:
+    uint32_t exact_winner = exact_ids[0];
+    float exact_best_score = score_selector(exact_ids[0], exact_vals[0]);
+    for (int k = 1; k < TEST_K_TOP; ++k) {
+        float s = score_selector(exact_ids[k], exact_vals[k]);
+        if (fulldrafter_is_better(s, exact_ids[k], exact_best_score, exact_winner)) {
+            exact_best_score = s;
+            exact_winner = exact_ids[k];
+        }
+    }
+
+    // The counterexample proves:
+    // Old hierarchy produced winner 0 (wrong!).
+    // Exact hierarchy produces winner 512 (exact true winner!).
+    CHECK_EQ(old_winner, 0u);
+    CHECK_EQ(exact_winner, 512u);
+}
+
+// -----------------------------------------------------------------------------
+// Test 2: Adversarial Same-Thread Top-16 on Arbitrary Thread
+// -----------------------------------------------------------------------------
+TEST(adversarial_same_thread_arbitrary_lane) {
+    // Thread 42 owns all top-16 scores across the entire block
+    FullDrafterThreadTop16 threads[TEST_THREADS];
+    for (int tid = 0; tid < TEST_THREADS; ++tid) threads[tid].init();
+
+    // Background scores for all threads
+    for (int tid = 0; tid < TEST_THREADS; ++tid) {
+        for (int step = 0; step < 16; ++step) {
+            uint32_t id = (uint32_t)(tid + step * 256);
+            threads[tid].insert(-50.0f - (float)step, id);
+        }
+    }
+
+    // Thread 42 gets 16 high scores: 200 down to 185
+    std::vector<uint32_t> t42_ids(TEST_K_TOP);
+    for (int step = 0; step < TEST_K_TOP; ++step) {
+        uint32_t id = (uint32_t)(42 + step * 256);
+        t42_ids[step] = id;
+        threads[42].insert(200.0f - (float)step, id);
+    }
+
+    int local_idx[TEST_THREADS] = {0};
+    float out_vals[TEST_K_TOP];
+    uint32_t out_ids[TEST_K_TOP];
+    fulldrafter_block_top16(threads, local_idx, TEST_THREADS, out_vals, out_ids);
+
+    for (int k = 0; k < TEST_K_TOP; ++k) {
+        CHECK_EQ(out_ids[k], t42_ids[k]);
+        CHECK_EQ(out_vals[k], 200.0f - (float)k);
+    }
+}
+
+// -----------------------------------------------------------------------------
+// Test 3: Strict Lower-ID Tie Breaking
+// -----------------------------------------------------------------------------
+TEST(strict_lower_id_tie_breaking) {
+    FullDrafterThreadTop16 thread;
+    thread.init();
+
+    // Insert candidates with identical scores in arbitrary token order
+    thread.insert(50.0f, 500u);
+    thread.insert(50.0f, 100u);
+    thread.insert(50.0f, 300u);
+    thread.insert(50.0f, 200u);
+    thread.insert(50.0f, 400u);
+
+    CHECK_EQ(thread.id[0], 100u);
+    CHECK_EQ(thread.id[1], 200u);
+    CHECK_EQ(thread.id[2], 300u);
+    CHECK_EQ(thread.id[3], 400u);
+    CHECK_EQ(thread.id[4], 500u);
+
+    // Test tie breaking across threads in block reduction
+    FullDrafterThreadTop16 threads[TEST_THREADS];
+    for (int tid = 0; tid < TEST_THREADS; ++tid) threads[tid].init();
+
+    // 16 different threads each have a candidate with score 77.0f
+    std::vector<uint32_t> tie_ids = {
+        900, 150, 42, 1024, 7, 333, 88, 12, 5000, 64, 18, 9999, 2, 400, 777, 5
+    };
+    for (size_t i = 0; i < tie_ids.size(); ++i) {
+        int tid = (int)(i * 10);
+        threads[tid].insert(77.0f, tie_ids[i]);
+    }
+
+    int local_idx[TEST_THREADS] = {0};
+    float out_vals[TEST_K_TOP];
+    uint32_t out_ids[TEST_K_TOP];
+    fulldrafter_block_top16(threads, local_idx, TEST_THREADS, out_vals, out_ids);
+
+    std::vector<uint32_t> sorted_tie_ids = tie_ids;
+    std::sort(sorted_tie_ids.begin(), sorted_tie_ids.end());
+
+    for (int k = 0; k < TEST_K_TOP; ++k) {
+        CHECK_EQ(out_vals[k], 77.0f);
+        CHECK_EQ(out_ids[k], sorted_tie_ids[k]);
+    }
+}
+
+// -----------------------------------------------------------------------------
+// Test 4: Inactive Padding Exclusion
+// -----------------------------------------------------------------------------
+TEST(inactive_padding_exclusion) {
+    // Tokens in range [TEST_V_ACT, TEST_V_TOTAL) must be excluded
+    FullDrafterThreadTop16 threads[TEST_THREADS];
+    for (int tid = 0; tid < TEST_THREADS; ++tid) threads[tid].init();
+
+    // Simulate loop over vocab with inactive tokens having huge scores
+    const int v_start = 63 * 3880;
+    const int v_end = TEST_V_TOTAL;
+
+    for (int tid = 0; tid < TEST_THREADS; ++tid) {
+        for (int v = v_start + tid; v < v_end; v += TEST_THREADS) {
+            if (v >= TEST_V_ACT) {
+                // Inactive token: must be skipped!
+                continue;
+            }
+            float val = 10.0f - (float)(v - v_start) * 0.001f;
+            threads[tid].insert(val, (uint32_t)v);
+        }
+    }
+
+    int local_idx[TEST_THREADS] = {0};
+    float out_vals[TEST_K_TOP];
+    uint32_t out_ids[TEST_K_TOP];
+    fulldrafter_block_top16(threads, local_idx, TEST_THREADS, out_vals, out_ids);
+
+    for (int k = 0; k < TEST_K_TOP; ++k) {
+        if (out_ids[k] != FULLDRAFTER_SENTINEL_ID) {
+            CHECK(out_ids[k] < (uint32_t)TEST_V_ACT);
+        }
+    }
+}
+
+// -----------------------------------------------------------------------------
+// Test 5: Sentinel Handling and Empty Slots
+// -----------------------------------------------------------------------------
+TEST(sentinel_handling_and_empty_slots) {
+    FullDrafterThreadTop16 thread;
+    thread.init();
+
+    // Verify initial sentinels
+    for (int i = 0; i < FullDrafterThreadTop16::K; ++i) {
+        CHECK_EQ(thread.val[i], FULLDRAFTER_SENTINEL_SCORE);
+        CHECK_EQ(thread.id[i], FULLDRAFTER_SENTINEL_ID);
+    }
+
+    // Insert only 3 items
+    thread.insert(-10.0f, 100u);
+    thread.insert(-5.0f, 50u);
+    thread.insert(-20.0f, 200u);
+
+    CHECK_EQ(thread.id[0], 50u);
+    CHECK_EQ(thread.id[1], 100u);
+    CHECK_EQ(thread.id[2], 200u);
+    for (int i = 3; i < FullDrafterThreadTop16::K; ++i) {
+        CHECK_EQ(thread.id[i], FULLDRAFTER_SENTINEL_ID);
+        CHECK_EQ(thread.val[i], FULLDRAFTER_SENTINEL_SCORE);
+    }
+
+    // Check that pop beyond 3 yields sentinel
+    CHECK_EQ(thread.current_val(0), -5.0f);
+    CHECK_EQ(thread.current_val(2), -20.0f);
+    CHECK_EQ(thread.current_val(3), FULLDRAFTER_SENTINEL_SCORE);
+    CHECK_EQ(thread.current_id(3), FULLDRAFTER_SENTINEL_ID);
+    CHECK_EQ(thread.current_val(16), FULLDRAFTER_SENTINEL_SCORE);
+    CHECK_EQ(thread.current_id(16), FULLDRAFTER_SENTINEL_ID);
+
+    CHECK_EQ(thread.current_id(-1), FULLDRAFTER_SENTINEL_ID);
+    CHECK_EQ(thread.current_val(-1), FULLDRAFTER_SENTINEL_SCORE);
+    CHECK(fulldrafter_is_better(-1e30f, 1234u, FULLDRAFTER_SENTINEL_SCORE, FULLDRAFTER_SENTINEL_ID));
+}
+
+TEST(finite_scores_below_empty_slot_value) {
+    FullDrafterThreadTop16 thread;
+    thread.init();
+    thread.insert(-3e30f, 7u);
+    thread.insert(-2e30f, 9u);
+    thread.insert(-2e30f, 3u);
+    CHECK_EQ(thread.current_id(0), 3u);
+    CHECK_EQ(thread.current_id(1), 9u);
+    CHECK_EQ(thread.current_id(2), 7u);
+    CHECK(!fulldrafter_is_better(FULLDRAFTER_SENTINEL_SCORE,
+                               FULLDRAFTER_SENTINEL_ID, -3e30f, 7u));
+    int cursor = 0;
+    float values[TEST_K_TOP];
+    uint32_t ids[TEST_K_TOP];
+    fulldrafter_block_top16(&thread, &cursor, 1, values, ids);
+    float merged_values[TEST_K_TOP];
+    uint32_t merged_ids[TEST_K_TOP];
+    fulldrafter_merge_top16(values, ids, TEST_K_TOP, merged_values, merged_ids);
+    CHECK_EQ(merged_ids[0], 3u);
+    CHECK_EQ(merged_ids[1], 9u);
+    CHECK_EQ(merged_ids[2], 7u);
+    CHECK_EQ(merged_values[2], -3e30f);
+    for (int i = 3; i < TEST_K_TOP; ++i)
+        CHECK_EQ(merged_ids[i], FULLDRAFTER_SENTINEL_ID);
+}
+
+// -----------------------------------------------------------------------------
+// Test 6: Full Pipeline Simulation vs Full Sort (Dual-Rank & Single-Rank Shard)
+// -----------------------------------------------------------------------------
+static void run_full_pipeline_test(int total_vocab, int active_vocab, uint32_t seed) {
+    std::mt19937 rng(seed);
+    std::uniform_real_distribution<float> dist(-100.0f, 100.0f);
+
+    std::vector<float> logits(total_vocab);
+    for (int i = 0; i < active_vocab; ++i) {
+        logits[i] = dist(rng);
+    }
+    for (int i = active_vocab; i < total_vocab; ++i) {
+        logits[i] = -1e30f; // inactive
+    }
+
+    // Step 1: Run 64 blocks of Top-16 reduction
+    const int v_per_block = (total_vocab + TEST_BLOCKS - 1) / TEST_BLOCKS;
+    std::vector<float> blk_unary(TEST_BLOCKS * TEST_K_TOP);
+    std::vector<uint32_t> blk_cands(TEST_BLOCKS * TEST_K_TOP);
+
+    for (int b = 0; b < TEST_BLOCKS; ++b) {
+        const int v_start = b * v_per_block;
+        const int v_end = std::min(v_start + v_per_block, total_vocab);
+
+        FullDrafterThreadTop16 threads[TEST_THREADS];
+        for (int tid = 0; tid < TEST_THREADS; ++tid) threads[tid].init();
+
+        for (int tid = 0; tid < TEST_THREADS; ++tid) {
+            for (int v = v_start + tid; v < v_end; v += TEST_THREADS) {
+                if (v >= active_vocab) continue;
+                threads[tid].insert(logits[v], (uint32_t)v);
+            }
+        }
+
+        int local_idx[TEST_THREADS] = {0};
+        fulldrafter_block_top16(
+            threads, local_idx, TEST_THREADS,
+            &blk_unary[b * TEST_K_TOP],
+            &blk_cands[b * TEST_K_TOP]
+        );
+    }
+
+    // Step 2: Merge across the 64 blocks (1024 candidates)
+    float final_vals[TEST_K_TOP];
+    uint32_t final_ids[TEST_K_TOP];
+    fulldrafter_merge_top16(
+        blk_unary.data(), blk_cands.data(),
+        TEST_BLOCKS * TEST_K_TOP,
+        final_vals, final_ids
+    );
+
+    // Step 3: Reference computation: sort all active vocabulary tokens
+    struct Item { float val; uint32_t id; };
+    std::vector<Item> all_items;
+    all_items.reserve(active_vocab);
+    for (int i = 0; i < active_vocab; ++i) {
+        all_items.push_back({logits[i], (uint32_t)i});
+    }
+    std::stable_sort(all_items.begin(), all_items.end(), [](const Item& a, const Item& b) {
+        return a.val != b.val ? a.val > b.val : a.id < b.id;
+    });
+
+    // Step 4: Verify exact match
+    for (int k = 0; k < TEST_K_TOP; ++k) {
+        CHECK_EQ(final_ids[k], all_items[k].id);
+        CHECK_EQ(final_vals[k], all_items[k].val);
+    }
+}
+
+TEST(full_pipeline_dual_rank_random_sort) {
+    run_full_pipeline_test(TEST_V_TOTAL, TEST_V_ACT, 42);
+    run_full_pipeline_test(TEST_V_TOTAL, TEST_V_ACT, 1337);
+}
+
+TEST(full_pipeline_single_rank_shard_random_sort) {
+    run_full_pipeline_test(TEST_V_SHARD, TEST_V_SHARD, 999);
+    run_full_pipeline_test(TEST_V_SHARD, TEST_V_SHARD, 2026);
+}
+
+RAD_TEST_MAIN()
