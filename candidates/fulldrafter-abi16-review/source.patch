+    if (tid == 0) {
+        float g_bias = p->exit_gate_net_bias ? bf16_to_f32(((const uint16_t*)p->exit_gate_net_bias)[0]) : 0.0f;
+        float d_bias = (p->exit_gate_depth_bias && depth >= 0 && depth < 4)
+                           ? bf16_to_f32(((const uint16_t*)p->exit_gate_depth_bias)[depth])
+                           : 0.0f;
