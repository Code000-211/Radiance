+    const int seq = blockIdx.y * SEQS_PER_WG;
+    char* seq_scr = scratch_base + (size_t)seq * SCR_PER_SEQ;
+    bool all_skipped = true;
+    #pragma unroll
+    for (int i = 0; i < SEQS_PER_WG; ++i)
