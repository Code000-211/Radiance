+ * the same committed anchor. Deeper forks need per-parent Markov/selector conditioning that does
+ * not exist yet, and stage-2 rows hang off the original greedy T6 path because that is the only
+ * base representation the drafter computed. Nothing here claims the teacher can verify any
+ * particular node count: node_budget is the caller's statement of what this step's verification
+ * actually supports, and this builder never widens it.
+ *
+ * Host-only, allocation-free, fixed-size locals only: this is step-path code. Every input
+ * byte is read before the first write to *out, so a caller may publish the chain and the
+ * top-16 out of one overlapping scratch buffer.
+ */
+
+#pragma once
+
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+
+/* Same directory, quoted: resolves relative to this file however it was included, which is
+ * why the fallback chain the heavier fulldrafter header needs is unnecessary here. */
+#include "rad_tree_candidate.h"
+
+/* RAD_OK / RAD_E_*: errors are values, never exceptions. Relative to this file, which is
+ * how the plugin and test builds include it; a missing file is a loud compile error. */
+#include "../../abi/rad_types.h"
+
+/* The approved top-16 ordering (finite scores descending, ties to the lower token id, sentinel
+ * ids always losing) is reused verbatim from the reviewed selection primitive rather than
+ * re-implemented: a second ordering that could drift from it is exactly the kind of quiet fork
+ * this file must not introduce. */
+#include "../../libr4d/r4d_fulldrafter_select.h"
+
+namespace radiance {
+
+/* THE ROOT FORK'S OWN BUDGET, root included: the 16-wide verification it was built for, not the
+ * host tree capacity (RAD_TREE_MAX_NODES), which grew for wider drafters and does not widen this. */
+constexpr size_t FULLDRAFTER_TREE_MAX_NODES = 16;
+static_assert(FULLDRAFTER_TREE_MAX_NODES <= RAD_TREE_MAX_NODES, "the root fork must fit a CandidateTree");
+
+/* Explicit inputs for one sequence's root-fork tree. No defaults: every field is a decision the
+ * caller (the engine lane) owns and states out loud. */
+struct FulldrafterRootFork {
+    uint32_t        anchor_token;    /* committed anchor: becomes root node 0 */
+    const uint32_t* greedy_chain;    /* [chain_len] the drafter's greedy winners, spine order
+                                      * (stage 1 slots 0..5 then stage 2 slots 6..11 for the
+                                      * 2x6 drafter; chain[BLOCK_K-1] is the T6 boundary) */
+    size_t          chain_len;       /* 1..15, the full two-stage chain (12 for FullDrafter) */
+    const uint32_t* root_cand_ids;   /* [n_cand] slot-0 top-16 candidate token ids */
+    const float*    root_cand_scores;/* [n_cand] reranked selector scores, parallel to ids */
+    size_t          n_cand;          /* 0..16 valid entries; entries at or past this are ignored */
+    size_t          alt_count;       /* alternate root children to add (0 = pure linear spine) */
+    size_t          node_budget;     /* total node cap INCLUDING the root; 1..FULLDRAFTER_TREE_MAX_NODES */
+};
+
+/* Builds the tree into the caller-owned CandidateTree.
+ *
+ * Topology (spine-first node order):
+ *   node 0                root, anchor token, depth 0
+ *   nodes 1..chain_len    the greedy spine, verbatim: token chain[i-1], parent i-1, depth i,
+ *                         score 1.0 (the builder receives no spine scores; 1.0 matches the
+ *                         linear builder's convention and verification never reads .score)
+ *   nodes chain_len+1..   chain_len+alt_count alternate children of the root ONLY: depth 1,
+ *                         leaves, carrying their slot-0 selector score
+ *
+ * Candidate selection: ids equal to r4d::FULLDRAFTER_SENTINEL_ID are dropped deterministically
+ * (unfilled top-16 slots); duplicate ids collapse to their best entry; the first greedy token is
+ * already the spine head (node 1, a child of the root) and never duplicated as an alternate.
+ * Remaining candidates are taken in the approved top-16 order, so an already-reranked input list
+ * is reproduced exactly and an unordered one is sorted. Candidates whose id equals a DEEPER
+ * spine token are allowed: they are conditioned on the anchor, not on their spine namesake, so
+ * they are a different hypothesis at a different node, not a duplicate.
+ *
+ * Errors (RAD_E_INVAL) on: null out, null chain / zero-length chain (a request with no draft
+ * builds no tree), chain longer than 15 or than the budget leaves room for, budget of 0 or above
+ * FULLDRAFTER_TREE_MAX_NODES, n_cand above 16, null candidate arrays with n_cand > 0, alt_count the
+ * budget cannot hold, alt_count the deduplicated candidates cannot fill, or a non-finite score.
+ * On RAD_E_INVAL *out is left untouched (no partial output); the caller resets or reuses at its
+ * own pace. Parents are derived, never read from input, so an invalid parent cannot arrive; the
+ * add_node calls are still checked and a failure (a broken invariant, not a caller error) resets
+ * *out and returns RAD_E_STATE.
+ */
+inline int fulldrafter_build_root_fork(const FulldrafterRootFork& r, CandidateTree* out) {
+    if (!out) return RAD_E_INVAL;
+    if (r.node_budget == 0 || r.node_budget > FULLDRAFTER_TREE_MAX_NODES) return RAD_E_INVAL;
+    if (!r.greedy_chain || r.chain_len == 0) return RAD_E_INVAL;
+    if (r.chain_len > FULLDRAFTER_TREE_MAX_NODES - 1) return RAD_E_INVAL;
+    if (r.chain_len + 1 > r.node_budget) return RAD_E_INVAL;
+    if (r.n_cand > FULLDRAFTER_TREE_MAX_NODES) return RAD_E_INVAL;
+    if (r.n_cand > 0 && (!r.root_cand_ids || !r.root_cand_scores)) return RAD_E_INVAL;
+    if (r.n_cand == 0 && r.alt_count > 0) return RAD_E_INVAL;
+    if (r.alt_count > r.node_budget - 1 - r.chain_len) return RAD_E_INVAL;
+
+    /* Read everything first, write *out last: inputs may alias *out and each other. */
+    uint32_t chain[FULLDRAFTER_TREE_MAX_NODES - 1];
+    for (size_t i = 0; i < r.chain_len; ++i) chain[i] = r.greedy_chain[i];
+
+    for (size_t i = 0; i < r.n_cand; ++i) {
+        if (!std::isfinite(r.root_cand_scores[i])) return RAD_E_INVAL;
+    }
+
+    r4d::FullDrafterThreadTop16 rank;
+    rank.init();
+    for (size_t i = 0; i < r.n_cand; ++i) {
+        const uint32_t id = r.root_cand_ids[i];
+        if (id == r4d::FULLDRAFTER_SENTINEL_ID) continue; /* unfilled slot, dropped */
+        if (id == chain[0]) continue;                     /* spine head owns this token already */
+        rank.insert(r.root_cand_scores[i], id);
+    }
+
+    uint32_t alt_id[FULLDRAFTER_TREE_MAX_NODES - 1];
+    float    alt_score[FULLDRAFTER_TREE_MAX_NODES - 1];
+    size_t   got = 0;
+    for (int k = 0; k < r4d::FullDrafterThreadTop16::K && got < r.alt_count; ++k) {
+        const uint32_t id = rank.id[k];
+        if (id == r4d::FULLDRAFTER_SENTINEL_ID) break; /* sorted: the rest are empty too */
+        bool dup = false;
+        for (size_t j = 0; j < got; ++j) {
+            if (alt_id[j] == id) { dup = true; break; } /* collapse to the best entry */
+        }
+        if (dup) continue;
+        alt_id[got]   = id;
+        alt_score[got] = rank.val[k];
+        ++got;
+    }
+    if (got < r.alt_count) return RAD_E_INVAL; /* refuse; silently shrinking is a policy */
+
+    out->reset();
+    if (!out->add_node(0, -1, r.anchor_token, 0, 1.0f)) {
+        out->reset();
+        return RAD_E_STATE;
+    }
+    for (size_t i = 0; i < r.chain_len; ++i) {
+        if (!out->add_node(static_cast<int32_t>(i + 1), static_cast<int32_t>(i), chain[i],
+                           static_cast<int32_t>(i + 1), 1.0f)) {
+            out->reset();
+            return RAD_E_STATE;
+        }
+    }
+    for (size_t a = 0; a < got; ++a) {
+        if (!out->add_node(static_cast<int32_t>(r.chain_len + 1 + a), 0, alt_id[a], 1,
+                           alt_score[a])) {
+            out->reset();
+            return RAD_E_STATE;
+        }
+    }
+    return RAD_OK;
+}
+
+} /* namespace radiance */
diff --git a/arch/common/rad_kv_compact.h b/arch/common/rad_kv_compact.h
new file mode 100644
index 0000000000000000000000000000000000000000..bb4cabfbe8ecdb57eab6ebcbd7c82676548df0b5
--- /dev/null
+++ b/arch/common/rad_kv_compact.h
@@ -0,0 +1,300 @@
+#pragma once
+
+#include <cstdint>
+#include <cstddef>
+#include <cstring>
+#include <vector>
+#include <algorithm>
+
+#if defined(__HIPCC__) || defined(__HIP_DEVICE_COMPILE__)
+#include <hip/hip_runtime.h>
+#endif
+
+#if __has_include("abi/rad_device.h")
+#include "abi/rad_device.h"
+#elif __has_include("../abi/rad_device.h")
+#include "../abi/rad_device.h"
+#elif __has_include("../../abi/rad_device.h")
+#include "../../abi/rad_device.h"
+#else
+extern "C" int rad_memcpy_async(void* dst, const void* src, int64_t bytes, void* s);
+#endif
+
+namespace radiance {
+
+#define RAD_KV_COMPACT_MAX_MOVES 16
+
+/**
+ * RadKVSlotMove: A single physical slot copy operation.
+ * Hazard-free guarantee: when executed in ascending depth order k = 1, ..., acc,
+ * target index k is strictly less than all future source indices n_j (j > k).
+ */
+struct RadKVSlotMove {
+    int32_t src_slot;
+    int32_t dst_slot;
+};
+
+/**
+ * RadKVCompactParams: Compact POD parameter structure passed to device kernel
+ * or host dispatcher by value (zero host-device memory allocation overhead).
+ */
+struct RadKVCompactParams {
+    void*         kv_pool_base;       // Base pointer to paged KV pool on local rank
+    int64_t       layer_stride;       // Byte stride between attention layers
+    int64_t       kv_block_stride;    // Byte stride per physical block
+    int64_t       kv_head_stride;     // Byte stride per KV head within a block
+    int32_t       block_size;         // Tokens per block (4 or 16)
+    int32_t       tok_bytes;          // Byte size of (K, V) per token per head (2 * HEAD_DIM * sizeof(dtype))
+    int32_t       n_layers;           // Number of full-attention layers
+    int32_t       n_heads;            // Number of KV heads on this rank
+    int32_t       n_moves;            // Number of slot relocations to execute
+    RadKVSlotMove moves[RAD_KV_COMPACT_MAX_MOVES];
+};
+
+#if defined(__HIPCC__) || defined(__HIP_DEVICE_COMPILE__)
+/**
+ * rad_kv_compact_winning_branch_kernel:
+ * In-place GPU slot compaction kernel for AMD RDNA4 (gfx1201).
+ *
+ * Parallelization geometry:
+ * - Grid: (n_heads, n_layers)
+ * - Block: 32 threads (1 wave on gfx1201)
+ *
+ * Uses 128-bit vectorized (uint4) transfers for peak GDDR6 memory bandwidth.
+ * Moves are evaluated sequentially in ascending depth order k = 1..acc, ensuring
+ * strictly hazard-free execution without scratchpad buffers.
+ */
+__global__ __launch_bounds__(32) void rad_kv_compact_winning_branch_kernel(
+    RadKVCompactParams p)
+{
+    const int h = blockIdx.x; // KV head index on this rank
+    const int l = blockIdx.y; // Layer index
+    const int lane = threadIdx.x; // 0..31
+
+    if (h >= p.n_heads || l >= p.n_layers) return;
+
+    uint8_t* const layer_base = reinterpret_cast<uint8_t*>(p.kv_pool_base) + (size_t)l * p.layer_stride;
+
+    #pragma nounroll
+    for (int m = 0; m < p.n_moves; ++m) {
+        const int32_t src = p.moves[m].src_slot;
+        const int32_t dst = p.moves[m].dst_slot;
+
+        if (src == dst || src < 0 || dst < 0) continue;
+
+        const size_t src_blk = static_cast<size_t>(src / p.block_size);
+        const size_t src_off = static_cast<size_t>(src % p.block_size);
+        const size_t dst_blk = static_cast<size_t>(dst / p.block_size);
+        const size_t dst_off = static_cast<size_t>(dst % p.block_size);
+
+        const size_t src_byte_off = src_blk * static_cast<size_t>(p.kv_block_stride)
+                                  + static_cast<size_t>(h) * static_cast<size_t>(p.kv_head_stride)
+                                  + src_off * static_cast<size_t>(p.tok_bytes);
+
+        const size_t dst_byte_off = dst_blk * static_cast<size_t>(p.kv_block_stride)
+                                  + static_cast<size_t>(h) * static_cast<size_t>(p.kv_head_stride)
+                                  + dst_off * static_cast<size_t>(p.tok_bytes);
+
+        const uint8_t* const s_ptr = layer_base + src_byte_off;
+        uint8_t* const d_ptr       = layer_base + dst_byte_off;
+
+        // Opaque rows can include metadata and need not have 16-byte-aligned token strides.
+        if (((reinterpret_cast<uintptr_t>(s_ptr) | reinterpret_cast<uintptr_t>(d_ptr)) & 15u) == 0) {
+            const int vector_bytes = p.tok_bytes & ~15;
+            for (int b = lane * 16; b < vector_bytes; b += 32 * 16)
+                *reinterpret_cast<uint4*>(d_ptr + b) = *reinterpret_cast<const uint4*>(s_ptr + b);
+            for (int b = vector_bytes + lane; b < p.tok_bytes; b += 32)
+                d_ptr[b] = s_ptr[b];
+        } else {
+            for (int b = lane; b < p.tok_bytes; b += 32)
+                d_ptr[b] = s_ptr[b];
+        }
+        // A later move may read a slot this move just wrote, including another lane's bytes.
+        if (m + 1 < p.n_moves) __syncthreads();
+    }
+}
+#endif
+
+/**
+ * Compares winning node indices n_k against target contiguous slot positions k
+ * for k = 1, ..., acc and builds the hazard-free move list in ascending order.
+ *
+ * Fast-path check: returns 0 if n_k == k for all k (e.g. root-only or linear path).
+ */
+inline int32_t rad_kv_compact_build_moves(
+    const int32_t* best_nodes,
+    int32_t acc,
+    int64_t ctx_len,
+    const std::vector<int32_t>& block_table,
+    int64_t first_pos,
+    int32_t block_size,
+    RadKVSlotMove* out_moves,
+    int32_t max_moves)
+{
+    if (!best_nodes || acc <= 0 || !out_moves || max_moves <= 0 || block_size <= 0) {
+        return 0;
+    }
+
+    int32_t n_moves = 0;
+    for (int32_t k = 1; k <= acc && n_moves < max_moves; ++k) {
+        const int32_t node_id = best_nodes[k];
+        if (node_id == k) {
+            // Already in contiguous slot: no relocation needed
+            continue;
+        }
+
+        const int64_t target_pos = ctx_len + k;
+        const int64_t source_pos = ctx_len + node_id;
+
+        const int64_t bi_dst = (target_pos - first_pos) / block_size;
+        const int64_t bi_src = (source_pos - first_pos) / block_size;
+
+        if (bi_dst >= 0 && bi_dst < static_cast<int64_t>(block_table.size()) &&
+            bi_src >= 0 && bi_src < static_cast<int64_t>(block_table.size())) {
+            out_moves[n_moves].dst_slot = block_table[static_cast<size_t>(bi_dst)] * block_size +
+                                          static_cast<int32_t>(target_pos % block_size);
+            out_moves[n_moves].src_slot = block_table[static_cast<size_t>(bi_src)] * block_size +
+                                          static_cast<int32_t>(source_pos % block_size);
+            n_moves++;
+        }
+    }
+    return n_moves;
+}
+
+/**
+ * rad_kv_compact_winning_branch:
+ * Standalone wrapper for header-only regressions. The engine uses the runtime-selected
+ * core/device entry, not this compile-time dispatch.
+ *
+ * No moves or identity moves bypass dispatch. HIP translation units launch the kernel;
+ * ordinary C++ uses stream-ordered copies, or CPU copies when stream is null.
+ */
+static inline int rad_kv_compact_winning_branch(
+    void* kv_pool_base,
+    int64_t layer_stride,
+    int64_t kv_block_stride,
+    int64_t kv_head_stride,
+    int32_t block_size,
+    int32_t tok_bytes,
+    int32_t n_layers,
+    int32_t n_heads,
+    const RadKVSlotMove* moves,
+    int32_t n_moves,
+    void* stream = nullptr)
+{
+    // Host fast-path: 0 moves needed
+    if (n_moves <= 0 || !moves || !kv_pool_base || block_size <= 0 || tok_bytes <= 0) {
+        return 0;
+    }
+
+    bool has_active_moves = false;
+    for (int i = 0; i < n_moves; ++i) {
+        if (moves[i].src_slot != moves[i].dst_slot && moves[i].src_slot >= 0 && moves[i].dst_slot >= 0) {
+            has_active_moves = true;
+            break;
+        }
+    }
+    if (!has_active_moves) {
+        return 0;
+    }
+
+    RadKVCompactParams params{};
+    params.kv_pool_base    = kv_pool_base;
+    params.layer_stride    = layer_stride;
+    params.kv_block_stride = kv_block_stride;
+    params.kv_head_stride  = kv_head_stride;
+    params.block_size      = block_size;
+    params.tok_bytes       = tok_bytes;
+    params.n_layers        = n_layers;
+    params.n_heads         = std::max(1, n_heads);
+    params.n_moves         = std::min(n_moves, RAD_KV_COMPACT_MAX_MOVES);
+
+    for (int i = 0; i < params.n_moves; ++i) {
+        params.moves[i] = moves[i];
+    }
+
+#if defined(__HIPCC__)
+    dim3 grid(static_cast<uint32_t>(params.n_heads), static_cast<uint32_t>(params.n_layers));
+    dim3 block(32);
+    hipLaunchKernelGGL(
+        rad_kv_compact_winning_branch_kernel,
+        grid,
+        block,
+        0,
+        reinterpret_cast<hipStream_t>(stream),
+        params
+    );
+    // A successful enqueue is required before the accepted branch may be committed.
+    return hipGetLastError() == hipSuccess ? 0 : -1;
+#else
+    if (stream != nullptr) {
+        // Asynchronous stream-ordered relocations via 128-bit vectorized device blits
+        for (int l = 0; l < params.n_layers; ++l) {
+            uint8_t* const layer_base = reinterpret_cast<uint8_t*>(params.kv_pool_base) + (size_t)l * params.layer_stride;
+            for (int h = 0; h < params.n_heads; ++h) {
+                for (int m = 0; m < params.n_moves; ++m) {
+                    const int32_t src = params.moves[m].src_slot;
+                    const int32_t dst = params.moves[m].dst_slot;
+                    if (src == dst || src < 0 || dst < 0) continue;
+
+                    const size_t src_blk = static_cast<size_t>(src / params.block_size);
+                    const size_t src_off = static_cast<size_t>(src % params.block_size);
+                    const size_t dst_blk = static_cast<size_t>(dst / params.block_size);
+                    const size_t dst_off = static_cast<size_t>(dst % params.block_size);
+
+                    const size_t src_byte_off = src_blk * static_cast<size_t>(params.kv_block_stride)
+                                              + static_cast<size_t>(h) * static_cast<size_t>(params.kv_head_stride)
+                                              + src_off * static_cast<size_t>(params.tok_bytes);
+
+                    const size_t dst_byte_off = dst_blk * static_cast<size_t>(params.kv_block_stride)
+                                              + static_cast<size_t>(h) * static_cast<size_t>(params.kv_head_stride)
+                                              + dst_off * static_cast<size_t>(params.tok_bytes);
+
+                    const int status = rad_memcpy_async(
+                        layer_base + dst_byte_off,
+                        layer_base + src_byte_off,
+                        params.tok_bytes,
+                        reinterpret_cast<RadStream>(stream)
+                    );
+                    if (status != 0) return status;
+                }
+            }
+        }
+        return 0;
+    } else {
+        // Host CPU execution with 128-bit vectorized transfers (for unit tests / CPU mock)
+        for (int l = 0; l < params.n_layers; ++l) {
+            uint8_t* const layer_base = reinterpret_cast<uint8_t*>(params.kv_pool_base) + (size_t)l * params.layer_stride;
+            for (int h = 0; h < params.n_heads; ++h) {
+                for (int m = 0; m < params.n_moves; ++m) {
+                    const int32_t src = params.moves[m].src_slot;
+                    const int32_t dst = params.moves[m].dst_slot;
+                    if (src == dst || src < 0 || dst < 0) continue;
+
+                    const size_t src_blk = static_cast<size_t>(src / params.block_size);
+                    const size_t src_off = static_cast<size_t>(src % params.block_size);
+                    const size_t dst_blk = static_cast<size_t>(dst / params.block_size);
+                    const size_t dst_off = static_cast<size_t>(dst % params.block_size);
+
+                    const size_t src_byte_off = src_blk * static_cast<size_t>(params.kv_block_stride)
+                                              + static_cast<size_t>(h) * static_cast<size_t>(params.kv_head_stride)
+                                              + src_off * static_cast<size_t>(params.tok_bytes);
+
+                    const size_t dst_byte_off = dst_blk * static_cast<size_t>(params.kv_block_stride)
+                                              + static_cast<size_t>(h) * static_cast<size_t>(params.kv_head_stride)
+                                              + dst_off * static_cast<size_t>(params.tok_bytes);
+
+                    uint8_t* const d_ptr = layer_base + dst_byte_off;
+                    const uint8_t* const s_ptr = layer_base + src_byte_off;
+
+                    // memcpy permits unaligned packed rows without typed-load aliasing.
+                    std::memcpy(d_ptr, s_ptr, static_cast<size_t>(params.tok_bytes));
+                }
+            }
+        }
+        return 0;
+    }
+#endif
+}
+
+} // namespace radiance
diff --git a/arch/common/rad_mtp_tree_config.h b/arch/common/rad_mtp_tree_config.h
new file mode 100644
index 0000000000000000000000000000000000000000..9daa08797e516e4a3cacb8fc99ee1757c4e0fd57
--- /dev/null
+++ b/arch/common/rad_mtp_tree_config.h
@@ -0,0 +1,80 @@
+#ifndef RAD_MTP_TREE_CONFIG_H
+#define RAD_MTP_TREE_CONFIG_H
+
+#include <cerrno>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+
+namespace rad {
+/* Startup-only MTP experiment. cost[n] is the measured cost of ROOT + n
+ * proposal rows, n=0..7. There is deliberately no invented calibration.
+ * score/cost q is a proxy: full coarse vocabulary logits with local top-8 FP32
+ * reranks replaced, normalized globally. pruned instead normalizes merged top8. */
+struct MtpTreeConfig {
+    int policy = 0; // off=0, score=1, cost=2, pruned=3
+    int rounds = 3;
+    double costs[8]{};
+    const char* error = nullptr;
+    bool pruned() const { return policy == 3; }
+    static constexpr int width = 8, candidates = 8, depth = 5, budget = 7;
+    static constexpr double beta = -0.2;
+};
+
+inline bool parse_mtp_tree_config(MtpTreeConfig& out, const char** error = nullptr) {
+    MtpTreeConfig c{};
+    const char* policy = std::getenv("RADIANCE_MTP_TREE_POLICY");
+    const char* rounds = std::getenv("RADIANCE_MTP_TREE_ROUNDS");
+    const char* costs = std::getenv("RADIANCE_MTP_TREE_COSTS");
+    if (policy && std::strcmp(policy, "off")) {
+        if (!std::strcmp(policy, "score")) c.policy = 1;
+        else if (!std::strcmp(policy, "cost")) c.policy = 2;
+        else if (!std::strcmp(policy, "pruned")) c.policy = 3;
+        else c.error = "RADIANCE_MTP_TREE_POLICY must be off, score, cost, or pruned";
+    }
+    if (rounds) {
+        if (!std::strcmp(rounds, "3")) c.rounds = 3;
+        else if (!std::strcmp(rounds, "5")) c.rounds = 5;
+        else if (!std::strcmp(rounds, "8")) c.rounds = 8;
+        else c.error = "RADIANCE_MTP_TREE_ROUNDS must be 3, 5 or 8";
+    }
+    /* Fixed MTP8/64 tree (8 spine + 56 alternates + root) has no scored/cost/pruned variant. */
+    if (c.rounds == 8 && c.policy != 0)
+        c.error = "RADIANCE_MTP_TREE_ROUNDS=8 requires RADIANCE_MTP_TREE_POLICY=off";
+    if (c.pruned() && c.rounds != MtpTreeConfig::depth)
+        c.error = "pruned policy requires RADIANCE_MTP_TREE_ROUNDS=5";
+    if (c.policy == 2) {
+        if (!costs || !*costs) c.error = "cost policy requires RADIANCE_MTP_TREE_COSTS";
+        else {
+            const char* p = costs;
+            for (int n = 0; n < 8; ++n) {
+                char* end = nullptr;
+                errno = 0;
+                const double value = std::strtod(p, &end);
+                if (end == p || errno == ERANGE || !std::isfinite(value) || value <= 0 ||
+                    (n < 7 ? *end != ',' : *end != '\0')) {
+                    c.error = "RADIANCE_MTP_TREE_COSTS requires exactly 8 finite positive costs (root + n rows, n=0..7)";
+                    break;
+                }
+                c.costs[n] = value;
+                p = n < 7 ? end + 1 : end;
+            }
+        }
+    } else if (costs) {
+        c.error = "RADIANCE_MTP_TREE_COSTS is only valid with cost policy";
+    }
+    out = c;
+    if (error) *error = c.error;
+    return c.error == nullptr;
+}
+
+inline const MtpTreeConfig& mtp_tree_config() {
+    static const MtpTreeConfig config = [] {
+        MtpTreeConfig c{};
+        parse_mtp_tree_config(c);
+        return c;
+    }();
+    return config;
+}
