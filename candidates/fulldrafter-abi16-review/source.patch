+namespace {
+struct TmpFile {
+    std::string path;
+    explicit TmpFile(const std::string& text) {
+        char t[] = "/tmp/diag_test.XXXXXX";
+        const int fd = mkstemp(t);
+        path = t;
+        FILE* f = fdopen(fd, "wb");
+        fwrite(text.data(), 1, text.size(), f);
+        fclose(f);
+    }
+    ~TmpFile() { std::remove(path.c_str()); }
+};
+}  /* namespace */
