index 0000000000000000000000000000000000000000..030ea8580915e6310e6d7bf4d7dca351fd43dfbf
--- /dev/null
+++ b/libref/ref_tree_state.h
@@ -0,0 +1,437 @@
+/* libref/ref_tree_state.h -- the CPU oracle for parent-indexed tree serving of the GDN block.
+ *
+ * This is NOT an op. It is a header-only, allocation-free scalar reference for wave 1 of tree
+ * serving (reports/drafter_optimization_20261013/TREE_PLAN.md, "state" lane): given a candidate
+ * tree of at most 16 nodes with an explicit root-inclusive parent topology, it computes each
+ * node's depthwise-convolution outputs, rolling conv history and gated-delta-net state/output
+ * FROM ITS PARENT'S STATE, and maps an accepted winning path back onto the committed state.
+ * Nothing here is registered in ref_registry.cpp, has a schema, or is reachable by rad-kbench;
+ * the GPU wave turns the factor contract below into a separately named op with its own libref
+ * line or truthful replaces hook, exactly as the plan requires.
+ *
+ * ============================ THE ARITHMETIC (stated, not invented) ============================
+ *
+ * Every recurrence below is ref_gdn.cpp's decode path restated per node. Per token, per v head,
+ * with the state S shaped [head_v, head_k]:
+ *
+ *     g    = -exp(A_log) . softplus(a + dt_bias)        beta = sigmoid(b)
+ *     qn   = q . rsqrt(sum(q^2) + l2_eps) . scale       kn   = k . rsqrt(sum(k^2) + l2_eps)
+ *     S   *= e^g
+ *     u    = beta . (v - S kn)                          S += u kn^T          o = S qn
+ *     o    = o . rsqrt(mean(o^2) + eps) . norm_w . act(z)
+ *
+ * The operation ORDER is ref_gdn_recurrent_update's own: decay and the dot in one pass per state
+ * row, the rank-1 update and the output dot in a second, then the gated RMS norm over the head's
+ * head_v channels. The convolution is gdn_conv_update's: a causal width-`conv_width` depthwise
+ * window over RAW projection values (no activation before the taps), silu after, bias added
+ * before the taps. The l2 norm is rsqrt(sum + l2_eps) with NO division by the head width. All
+ * accumulation is f32; compile with -ffp-contract=off as libref does if bit-exactness against
+ * the plugin matters (see the test's tolerance note).
+ *
+ * ======================= TOPOLOGY =======================
+ *
+ * `parent[i] < i` for every node but the root, whose `parent[root] == -1`. Nodes may appear in
+ * any topological order -- sibling numbering, depth ordering and path contiguity are all free,
+ * and NOTHING here may derive a node's parent from its index. The root is the anchor token
+ * processed in this step from `state0`/`hist0` (the committed state entering the step).
+ * Committing with zero accepted draft children still commits this root anchor (replay length 1),
+ * advancing the committed state to the root's slot.
+ *
+ * ======================= BUFFERS (caller-owned, fixed size) =======================
+ *
+ * No function here allocates, syncs, or keeps state between calls. Scratch sizes:
+ *
+ *   q, k        n * n_head_k * head_k          v, o        n * n_head_v * head_v
+ *   a, b        n * n_head_v                   A_log,dt_bias  n_head_v (or null)
+ *   z           n * n_head_v * head_v (or null)  norm_w     head_v (or null)
+ *   states      n * n_head_v * head_v * head_k   state0     n_head_v * head_v * head_k
+ *   hist        n * conv_dim * (conv_width-1)    hist0      conv_dim * (conv_width-1)
+ *   factors     n * n_head_v * (head_k+head_v+2)
+ *
+ * Inputs and outputs must not alias except where a function says so (the commit and replay
+ * functions accept state_out == state0 and hist_out == hist0).
+ *
+ * ======================= THE FACTOR CONTRACT (for the GPU wave) =======================
+ *
+ * THE GPU DOES NOT NEED A STATE POOL PER NODE. The delta step's state effect factorises: a node
+ * contributes, per v head, exactly
+ *
+ *     kn[head_k]  (k l2-normalised by rsqrt(sum k^2 + l2_eps), NO scale)
+ *     v[head_v]   (raw)
+ *     g           (the decay log-factor as computed, before exp)
+ *     beta
+ *
+ * and folding a chain of such factor rows onto any state reproduces the per-node states
+ * BITWISE, because rad_gdn_state_step() below is the one code path both the direct walk and the
+ * replay call. This is the anchor-replay contract libr4d's
+ * r4d_gdn_recurrent_update_k128_v128_bf16_fp32state.hip already implements for the linear path:
+ * its factor row stride is RU_FSTR = 4*head_k + head_v + 8 -- this row with kn written four
+ * times (one copy per 32-row group, at offset grp*head_k), v at 4*head_k+row, g and beta at
+ * 4*head_k+head_v+2*grp and +1, plus a one-based page-shift marker at 16*RU_FSTR. The MINIMAL
+ * canonical row here is the un-duplicated one, len head_k + head_v + 2. A tree kernel replays
+ * the accepted path's factors onto the one committed state; scratch per (node, head) is that
+ * row, so 16 nodes cost 16*(K+V+2) floats a head against 16*K*V for a state pool -- and the
+ * committed state stays ONE slot a sequence whatever the topology.
+ *
+ * The convolution does not factor: its "state" is the raw-x window, conv_dim*(conv_width-1)
+ * floats, but only the accepted node's WINDOW is ever committed, so a tree kernel needs the
+ * window beside the factors, not a pool per node.
+ */
+#ifndef RAD_REF_TREE_STATE_H
+#define RAD_REF_TREE_STATE_H
+
+#include "rad_abi.h"
+
+#include <math.h>
+#include <string.h>
+
+extern "C" {
+
+#define RAD_TREE_MAX_NODES  16      /* CandidateTree's existing capacity, root included */
+#define RAD_TREE_HIST_MAX   16      /* deepest conv history held, ref_gdn.cpp's own bound */
+
+struct RadTreeGdn {
+    int   head_k, head_v;           /* K, V: the per-head widths */
+    int   n_head_k, n_head_v;       /* Hg, Hv: head counts, Hv % Hg == 0 */
+    float scale;                    /* the attention scale folded into qn */
+    float l2_eps;                   /* the q/k l2 norm epsilon (1e-6f in ref) */
+    float norm_eps;                 /* the gated RMS norm epsilon */
+    float softplus_thr;             /* softplus linear region threshold (20.0f in ref) */
+    int   act;                      /* output gate: 0 = silu, 1 = sigmoid (ref's p_enum) */
+};
+
+/* ------------------------------------------------------------------ topology */
+/* RAD_OK, or RAD_E_INVAL/RAD_E_SHAPE by name: n in [1, RAD_TREE_MAX_NODES], exactly one root
+ * (parent == -1), every other parent in [0, i). parent[i] >= i is a forward edge, which in a
+ * parent-indexed tree is a cycle and is refused rather than walked. */
+static inline int rad_tree_check_topo(const int* parent, int n) {
+    if (!parent || n < 1 || n > RAD_TREE_MAX_NODES) return RAD_E_INVAL;
+    int roots = 0;
+    for (int i = 0; i < n; ++i) {
+        if (parent[i] == -1) { ++roots; continue; }
+        if (parent[i] < 0 || parent[i] >= i) return RAD_E_INVAL;
+    }
+    return roots == 1 ? RAD_OK : RAD_E_INVAL;
+}
+
+static inline int rad_tree_cfg_ok(const struct RadTreeGdn* g) {
+    return g && g->head_k > 0 && g->head_v > 0 && g->n_head_k > 0 && g->n_head_v > 0 &&
+           g->n_head_v % g->n_head_k == 0;
+}
+
+/* depth[i]: the root is 0. Caller owns depth[n]. */
+static inline void rad_tree_depths(const int* parent, int n, int* depth) {
+    for (int i = 0; i < n; ++i)
+        depth[i] = parent[i] < 0 ? 0 : depth[parent[i]] + 1;
+}
+
+/* ------------------------------------------------------------------ activations */
+/* ref_common.h's definitions, restated so this header stands alone. */
+static inline float rad_tree_sigmoid(float x) { return 1.0f / (1.0f + expf(-x)); }
+static inline float rad_tree_silu(float x)    { return x * rad_tree_sigmoid(x); }
+static inline float rad_tree_softplus(float x, float thr) {
+    if (x > thr) return x;
+    return x > 0.0f ? x + log1pf(expf(-x)) : log1pf(expf(x));
+}
+
+/* ------------------------------------------------------------------ the shared delta step */
+/* THE ONE STATE UPDATE BOTH PATHS CALL, so the replay and the direct walk cannot drift. Per
+ * (state row e): phase 1 decays and dots, phase 2 applies the rank-1 update; the output dot
+ * rides phase 2 exactly as ref_gdn_recurrent_update's does. qn == null skips only the output,
+ * never the state. `dec` and `bt` are passed precomputed so the factor path can supply them
+ * from a stored g/beta and still produce the identical sequence. */
+static inline void rad_gdn_state_step(float* S, const float* kn, const float* vraw,
+                                      const float* qn, float* o_or_null, float dec, float bt,
+                                      int K, int V) {
+    for (int e = 0; e < V; ++e) {
+        float sk2 = 0.0f;
+        for (int d = 0; d < K; ++d) {
+            S[e * K + d] *= dec;
+            sk2 += S[e * K + d] * kn[d];
+        }
+        const float u = bt * (vraw[e] - sk2);
+        float ss = 0.0f;
+        for (int d = 0; d < K; ++d) {
+            S[e * K + d] += u * kn[d];
+            if (qn) ss += S[e * K + d] * qn[d];
+        }
+        if (o_or_null) o_or_null[e] = ss;
+    }
+}
+
+/* qn/kn exactly as the decode kernel forms them: the l2 norm over the head, no width division,
+ * the scale folded into q's factor only. */
+static inline void rad_gdn_norm_qk(const float* q, const float* k, float* qn, float* kn,
+                                   float scale, float l2_eps, int K) {
+    float sq = 0.0f, sk = 0.0f;
+    for (int d = 0; d < K; ++d) { sq += q[d] * q[d]; sk += k[d] * k[d]; }
+    const float qs = 1.0f / sqrtf(sq + l2_eps) * scale;
+    const float ks = 1.0f / sqrtf(sk + l2_eps);
+    for (int d = 0; d < K; ++d) { qn[d] = q[d] * qs; kn[d] = k[d] * ks; }
+}
+
+/* ------------------------------------------------------------------ the convolution */
+/* Per node: the depthwise causal conv over the PARENT's rolling window (the root's is `hist0`,
+ * or zeros when hist0 == null -- ref's cold `has_init` case), silu applied, and the node's own
+ * window written for its children. x rows are RAW projection values: the taps run on x itself,
+ * the activation after. q/k/v land in ref's split layout. */
+static inline int rad_tree_conv(const struct RadTreeGdn* g, int conv_width, int conv_dim,
+                                const int* parent, int n,
+                                const float* x, const float* conv_w, const float* conv_b,
+                                const float* hist0,
+                                float* q, float* k, float* v, float* hist) {
+    if (!rad_tree_cfg_ok(g)) return RAD_E_SHAPE;
+    const int topo = rad_tree_check_topo(parent, n);
+    if (topo != RAD_OK) return topo;
+    if (conv_width < 1 || conv_width - 1 > RAD_TREE_HIST_MAX) return RAD_E_UNSUPPORTED;
+    const int64_t cd = 2 * (int64_t)g->n_head_k * g->head_k + (int64_t)g->n_head_v * g->head_v;
+    if (conv_dim != cd) return RAD_E_SHAPE;
+    if (!x || !conv_w || !q || !k || !v) return RAD_E_INVAL;
+    if (conv_width > 1 && !hist) return RAD_E_INVAL;   /* no history to keep means no buffer;
+                                                        * a warm step needs its window, and a
+                                                        * cold one passes a zeroed one */
+    if (conv_width > 1 && !hist0) return RAD_E_INVAL;   /* a warm step needs a window; use zeros
+                                                         * by passing one, not by inventing it */
+
+    const int hist_len = conv_width - 1;
+    for (int i = 0; i < n; ++i) {
+        const float* xrow = x + (size_t)i * conv_dim;
+        const float* win = hist_len == 0 ? (const float*)0 : (parent[i] < 0
+            ? hist0
+            : hist + ((size_t)parent[i] * conv_dim) * hist_len);
+        float* myhist = hist_len == 0 ? (float*)0 : hist + ((size_t)i * conv_dim) * hist_len;
+        for (int c = 0; c < conv_dim; ++c) {
+            const float bs = conv_b ? conv_b[c] : 0.0f;
+            float acc = bs;
+            for (int j = 0; j < conv_width; ++j) {
+                /* tap j covers the value width-1-j places back: x itself for j == width-1 */
+                const float val = j == conv_width - 1
+                    ? xrow[c]
+                    : (win ? win[(size_t)c * hist_len + j] : 0.0f);
+                acc += val * conv_w[(size_t)c * conv_width + j];
+            }
+            const float o = rad_tree_silu(acc);
+            float* dst;
+            int64_t off;
+            if (c < g->n_head_k * g->head_k) {
+                dst = q; off = (size_t)i * g->n_head_k * g->head_k + c;
+            } else if (c < 2 * g->n_head_k * g->head_k) {
+                dst = k; off = (size_t)i * g->n_head_k * g->head_k + (c - g->n_head_k * g->head_k);
+            } else {
+                dst = v;
+                off = (size_t)i * g->n_head_v * g->head_v +
+                      (c - 2 * g->n_head_k * g->head_k);
+            }
+            dst[off] = o;
+            if (hist_len > 0)
+                myhist[(size_t)c * hist_len + hist_len - 1] = xrow[c];
+        }
+        /* the window in front of this node's own value is the parent's, shifted by one */
+        for (int c = 0; c < conv_dim && hist_len > 1; ++c)
+            for (int j = 0; j < hist_len - 1; ++j)
+                hist[((size_t)i * conv_dim + c) * hist_len + j] =
+                    win ? win[(size_t)c * hist_len + j + 1] : 0.0f;
+    }
+    return RAD_OK;
+}
+
+/* ------------------------------------------------------------------ the delta net */
+/* Per node, per v head: the state comes from the PARENT's slot in `states` (the root's from
+ * state0), the row is this node's, and the result lands in the node's own slot. `states` is
+ * read and written in one pass, so a child's slot is only read after its parent wrote it --
+ * which the topological parent order guarantees. */
+static inline int rad_tree_gdn(const struct RadTreeGdn* g, const int* parent, int n,
+                               const float* q, const float* k, const float* v,
+                               const float* a, const float* b,
+                               const float* A_log, const float* dt_bias,
+                               const float* state0,
+                               const float* z, const float* norm_w,
+                               float* o, float* states) {
+    if (!rad_tree_cfg_ok(g)) return RAD_E_SHAPE;
+    const int topo = rad_tree_check_topo(parent, n);
+    if (topo != RAD_OK) return topo;
+    if (!q || !k || !v || !a || !b || !state0 || !o || !states) return RAD_E_INVAL;
+    if (g->head_k > 512 || g->head_v > 512) return RAD_E_UNSUPPORTED;
+
+    const int K = g->head_k, V = g->head_v, Hg = g->n_head_k, Hv = g->n_head_v;
+    const int grp = Hv / Hg;
+    const size_t head_state = (size_t)V * K, slot = (size_t)Hv * head_state;
+
+    for (int i = 0; i < n; ++i) {
+        const float* s_in = parent[i] < 0 ? state0 : states + (size_t)parent[i] * slot;
+        float* s_out = states + (size_t)i * slot;
+        memcpy(s_out, s_in, sizeof(float) * slot);
+        for (int h = 0; h < Hv; ++h) {
+            const int hk = h / grp;
+            const float alog = A_log ? A_log[h] : 0.0f;
+            const float dtb  = dt_bias ? dt_bias[h] : 0.0f;
+            const float gv = -expf(alog) * rad_tree_softplus(a[(size_t)i * Hv + h] + dtb,
+                                                             g->softplus_thr);
+            const float bt = rad_tree_sigmoid(b[(size_t)i * Hv + h]);
+            float qnv[512], knv[512];      /* head widths <= 512, refused by name above */
+            rad_gdn_norm_qk(q + ((size_t)i * Hg + hk) * K, k + ((size_t)i * Hg + hk) * K,
+                            qnv, knv, g->scale, g->l2_eps, K);
+            float orow[512];
+            rad_gdn_state_step(s_out + (size_t)h * head_state, knv,
+                               v + ((size_t)i * Hv + h) * V, qnv, orow,
+                               expf(gv), bt, K, V);
+            /* the gated RMS norm, over the head's V channels, in ref's own order */
+            float sq2 = 0.0f;
+            for (int e = 0; e < V; ++e) sq2 += orow[e] * orow[e];
+            const float sc = 1.0f / sqrtf(sq2 / (float)V + g->norm_eps);
+            for (int e = 0; e < V; ++e) {
+                float r = orow[e] * sc;
+                if (norm_w) r *= norm_w[e];
+                if (z) {
+                    const float zz = z[((size_t)i * Hv + h) * V + e];
+                    r *= g->act == 1 ? rad_tree_sigmoid(zz) : rad_tree_silu(zz);
+                }
+                o[((size_t)i * Hv + h) * V + e] = r;
+            }
+        }
+    }
+    return RAD_OK;
+}
+
+/* ------------------------------------------------------------------ factors */
+static inline int rad_tree_factor_len(const struct RadTreeGdn* g) {
+    return g ? g->head_k + g->head_v + 2 : 0;
+}
+
+/* Record every node's factor row, per v head: [ kn | v | g | beta ]. The values are the SAME
+ * floats the direct walk formed (the norm and the softplus chain are the shared helpers), which
+ * is what makes the replay bitwise. */
+static inline int rad_tree_pack_factors(const struct RadTreeGdn* g, const int* parent, int n,
+                                        const float* k, const float* v,
+                                        const float* a, const float* b,
+                                        const float* A_log, const float* dt_bias,
+                                        float* factors) {
+    if (!rad_tree_cfg_ok(g)) return RAD_E_SHAPE;
+    const int topo = rad_tree_check_topo(parent, n);
+    if (topo != RAD_OK) return topo;
+    if (!k || !v || !a || !b || !factors) return RAD_E_INVAL;
+    if (g->head_k > 512 || g->head_v > 512) return RAD_E_UNSUPPORTED;
+    const int K = g->head_k, V = g->head_v, Hg = g->n_head_k, Hv = g->n_head_v;
+    const int grp = Hv / Hg, len = rad_tree_factor_len(g);
+
+    for (int i = 0; i < n; ++i)
+        for (int h = 0; h < Hv; ++h) {
+            float* f = factors + ((size_t)i * Hv + h) * len;
+            const int hk = h / grp;
+            float qn[512], knv[512];                   /* qn unused here; the norm is shared */
+            rad_gdn_norm_qk(k + ((size_t)i * Hg + hk) * K, k + ((size_t)i * Hg + hk) * K,
+                            qn, knv, 1.0f, g->l2_eps, K);
+            memcpy(f, knv, sizeof(float) * K);
+            memcpy(f + K, v + ((size_t)i * Hv + h) * V, sizeof(float) * V);
+            const float alog = A_log ? A_log[h] : 0.0f;
+            const float dtb  = dt_bias ? dt_bias[h] : 0.0f;
+            f[K + V] = -expf(alog) * rad_tree_softplus(a[(size_t)i * Hv + h] + dtb,
+                                                       g->softplus_thr);
+            f[K + V + 1] = rad_tree_sigmoid(b[(size_t)i * Hv + h]);
+        }
+    return RAD_OK;
+}
+
+/* Fold a chain of factor rows onto a state. `chain` is node ids, root first, each in
+ * [0, n_nodes); state_out may alias state0. Invalid inputs leave state_out unchanged.
+ * This is the commit path a GPU kernel runs against its ONE anchor state, and the reference
+ * any per-parent reconstruction is checked against. */
+static inline int rad_tree_replay_factors(const struct RadTreeGdn* g,
+                                          const int* chain, int chain_len, int n_nodes,
+                                          const float* factors, const float* state0,
+                                          float* state_out) {
+    if (!rad_tree_cfg_ok(g)) return RAD_E_SHAPE;
+    if (chain_len < 0 || chain_len > n_nodes || n_nodes > RAD_TREE_MAX_NODES) return RAD_E_INVAL;
+    if (!factors || !state0 || !state_out) return RAD_E_INVAL;
+    if (chain_len > 0 && !chain) return RAD_E_INVAL;
+    if (g->head_k > 512 || g->head_v > 512) return RAD_E_UNSUPPORTED;
+    for (int c = 0; c < chain_len; ++c)
+        if (chain[c] < 0 || chain[c] >= n_nodes) return RAD_E_INVAL;
+    const int K = g->head_k, V = g->head_v, Hv = g->n_head_v;
+    const int len = rad_tree_factor_len(g);
+    const size_t head_state = (size_t)V * K, slot = (size_t)Hv * head_state;
+
+    if (state_out != state0)
+        memcpy(state_out, state0, sizeof(float) * slot);
+    for (int c = 0; c < chain_len; ++c) {
+        for (int h = 0; h < Hv; ++h) {
+            const float* f = factors + ((size_t)chain[c] * Hv + h) * len;
+            rad_gdn_state_step(state_out + (size_t)h * head_state, f, f + K,
+                               (const float*)0, (float*)0, expf(f[K + V]), f[K + V + 1], K, V);
+        }
+    }
+    return RAD_OK;
+}
+
+/* ------------------------------------------------------------------ commit */
+struct RadTreeCommit {
+    int node;        /* the node whose state becomes committed: path[accepted_children] */
+    int replay_len;  /* replay length: accepted_children + 1 */
+    int read_row;    /* the engine's 1-based num_accepted for the NEXT step under the
+                      * anchor-row-inclusive layout: accepted_children + 1. Next step read offset is
+                      * read_row - 1 = accepted_children. */
+};
+
+/* `accepted_children` is the number of winning-path draft children accepted, in [0, path_len - 1].
+ * CRITICAL (TREE_PLAN.md): zero accepted draft children (accepted_children == 0) still commits
+ * the root anchor (path[0]), with replay length 1 (accepted_children + 1).
+ * Any newly sampled bonus token (or EOG promoted to bonus) has not been forwarded through the
+ * recurrent net in this step and is excluded from commit/replay.
+ * `path` must be a valid root-to-node chain: path[0] is root (parent == -1) and every subsequent
+ * step's parent is the node before it in path. */
+static inline int rad_tree_commit_index(const int* parent, int n,
+                                        const int* path, int path_len, int accepted_children,
+                                        struct RadTreeCommit* out) {
+    const int topo = rad_tree_check_topo(parent, n);
+    if (topo != RAD_OK) return topo;
+    if (!out || !path || path_len < 1 || path_len > n ||
+        accepted_children < 0 || accepted_children >= path_len)
+        return RAD_E_INVAL;
+    for (int i = 0; i < path_len; ++i) {
+        if (path[i] < 0 || path[i] >= n) return RAD_E_INVAL;
+        const int expect = i == 0 ? -1 : path[i - 1];
+        if (parent[path[i]] != expect) return RAD_E_INVAL;
+    }
+    out->node = path[accepted_children];
+    out->replay_len = accepted_children + 1;
+    out->read_row = accepted_children + 1;
+    return RAD_OK;
+}
+
+/* Copy the committed state and conv window the acceptance picked.
+ * Zero accepted draft children (accepted_children == 0) commits the root anchor (path[0]),
+ * with replay length 1 (accepted_children + 1).
+ * New bonus / EOG promoted to bonus is not forwarded, excluded from committed state.
+ * state_out may alias state0 and hist_out may alias hist0; both are fully written.
+ * Width 1 has no history: hist0, hist and hist_out may all be null. */
+static inline int rad_tree_commit(const struct RadTreeGdn* g, int conv_width, int conv_dim,
+                                  const int* parent, int n,
+                                  const int* path, int path_len, int accepted_children,
+                                  const float* state0, const float* hist0,
+                                  const float* states, const float* hist,
+                                  float* state_out, float* hist_out) {
+    if (!rad_tree_cfg_ok(g)) return RAD_E_SHAPE;
+    struct RadTreeCommit ci;
+    const int rc = rad_tree_commit_index(parent, n, path, path_len, accepted_children, &ci);
+    if (rc != RAD_OK) return rc;
+    if (conv_width < 1 || conv_width - 1 > RAD_TREE_HIST_MAX) return RAD_E_UNSUPPORTED;
+    if (conv_dim < 1) return RAD_E_SHAPE;
+    if (!states || !state0 || !state_out) return RAD_E_INVAL;
+    const int hl = conv_width - 1;
+    if (hl > 0 && (!hist0 || !hist || !hist_out)) return RAD_E_INVAL;
+
+    const size_t slot = (size_t)g->n_head_v * g->head_v * g->head_k;
+    const float* src_s = states + (size_t)ci.node * slot;
+    if (state_out != src_s)
+        memcpy(state_out, src_s, sizeof(float) * slot);
+    if (hl > 0) {
+        const float* src_h = hist + (size_t)ci.node * conv_dim * hl;
+        if (hist_out != src_h)
+            memcpy(hist_out, src_h, sizeof(float) * ((size_t)conv_dim * hl));
+    }
+    return RAD_OK;
+}
+
+}  /* extern "C" */
+
+#endif  /* RAD_REF_TREE_STATE_H */
diff --git a/mine/CMakeLists.txt b/mine/CMakeLists.txt
new file mode 100644
index 0000000000000000000000000000000000000000..1be94b0df350421e6b23f9340c3fdbb7755ef604
--- /dev/null
+++ b/mine/CMakeLists.txt
@@ -0,0 +1,47 @@
+# Model-owned kernels and their host-domain reference plugin.
+if(NOT COMMAND rad_add_plugin)
+  cmake_minimum_required(VERSION 3.21)
+  project(mine LANGUAGES CXX)
+  find_package(radiance REQUIRED)
+  rad_plugin_defaults()
+  if(RAD_HIP_FOUND)
+    enable_language(HIP)
+  endif()
+endif()
+
+add_library(mine_ref_ops OBJECT dloop_ops.cpp dloop_full.cpp tree_gdn.cpp tree_gdn_fused_ref.cpp ple_tree.cpp
+  ref_dloop.cpp ref_dloop_full.cpp ref_gdn_tree.cpp ref_ple_tree.cpp
+  dflash_tree_select.cpp ref_dflash_tree.cpp mtp_tree_accum.cpp ref_mtp_tree_accum.cpp
+  qsa_tree_commit.cpp qsa_tree_commit_ref.cpp mtp_scored_tree.cpp ref_mtp_scored_tree.cpp
+  mtp_pruned_tree.cpp ref_mtp_pruned_tree.cpp mtp_overlay.cpp ref_mtp_overlay.cpp
+  spechub.cpp ref_spechub.cpp attn_paged_tree.cpp ref_attn_paged_tree.cpp)
+target_link_libraries(mine_ref_ops PRIVATE radiance::abi)
+set_target_properties(mine_ref_ops PROPERTIES POSITION_INDEPENDENT_CODE ON)
+target_compile_options(mine_ref_ops PRIVATE -ffp-contract=off)
+rad_add_plugin(mine_ref kernels SOURCES ref_rows.cpp $<TARGET_OBJECTS:mine_ref_ops>)
+target_compile_options(mine_ref PRIVATE -ffp-contract=off)
+
+if(RAD_HIP_FOUND)
+  rad_add_plugin(mine kernels
+    SOURCES rows.cpp tree_gdn.cpp ple_tree.cpp dloop_ops.cpp dloop_full.cpp dloop_rows.cpp
+            hc_mean.cpp
+            # DFlash2 experimental fusions: host schema/args/row beside the launcher below.
+            dflash_conv_add.cpp dflash_k_norm_rope_store.cpp dflash_gated_bf16.cpp
+            dflash_tree_select.cpp mtp_tree_accum.cpp qsa_tree_commit.cpp mtp_scored_tree.cpp
+            mtp_pruned_tree.cpp mtp_overlay.cpp spechub.cpp attn_paged_tree.cpp
+    HIP_SOURCES tree_gdn.hip ple_tree.hip dloop_kernels.hip dloop_tree.hip dloop_skinny.hip
+                hc_mean.hip hc_up_wmma.hip shared_i8a8_down.hip
+                dflash_conv_add.hip dflash_k_norm_rope_store.hip dflash_gated_bf16.hip
+                dflash_tree_select.hip mtp_tree_accum.hip qsa_tree_commit.hip mtp_scored_tree.hip
+                mtp_pruned_tree.hip mtp_overlay.hip spechub.hip attn_paged_tree.hip
+    GPU_TARGETS gfx1201)
+  target_compile_options(mine PRIVATE -ffp-contract=off)
+  # The HC override reuses upstream helpers with hidden visibility; discard unused helpers.
+  set_source_files_properties(hc_up_wmma.hip PROPERTIES
+    COMPILE_OPTIONS "-ffunction-sections;-fdata-sections")
+  target_link_options(mine PRIVATE -Wl,--gc-sections)
+  # dloop_full.cpp carries the device row table next to the schemas: this is what tells it the HIP
+  # entry points exist in this build. Without it the plugin would publish the schemas and the host
+  # oracle while quietly registering no device row at all, which selection reads as "no kernel".
+  target_compile_definitions(mine PRIVATE RAD_DLOOP_FULL_DEVICE=1)
+endif()
diff --git a/mine/attn_paged_tree.cpp b/mine/attn_paged_tree.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e9297844f5ae23851983ff0fdef5cbb89ae0f52b
--- /dev/null
+++ b/mine/attn_paged_tree.cpp
@@ -0,0 +1,149 @@
+#include "attn_paged_tree.h"
+#include <climits>
+#include <cstring>
+#include <initializer_list>
+
+namespace {
+#define PI(k) {k, RAD_P_INT, RAD_REQUIRED, 0}
+#define PS(k) {k, RAD_P_STR, RAD_REQUIRED, 0}
+const RadParamSpec params[] = {
+    PI("q_len"), {"max_tokens", RAD_P_INT, RAD_REQUIRED, RAD_PROLE_CAPACITY},
+    PI("max_seqs"), PI("max_ctx"), PI("head_dim"), PI("gqa"), PI("n_head"),
+    PI("block_size"), PI("causal"), PI("window"), PS("q_dtype"), PS("kv_dtype")};
+#undef PI
+#undef PS
+const RadOperandSpec operands[] = {
+    {"q", RAD_OPD_IN, 0}, {"kv", RAD_OPD_IN, 0}, {"block_table", RAD_OPD_IN, 0},
+    {"seqused", RAD_OPD_IN, 0}, {"cu_seqlens", RAD_OPD_IN, 0},
+    {"spec_parent", RAD_OPD_IN, 0}, {"out", RAD_OPD_OUT, 0}};
+const RadOpSchema schema = {"attn_paged_tree", params, 12, operands, RAD_ATP_OPERANDS,
+    "Full-context paged attention over a prefix and a <=65-node ordered tree per sequence. "
+    "Only self and ancestors are visible in the tree suffix. Causal sequences encode chains. "
+    "FP32 dot/softmax/PV and split partials, BF16 output; invalid metadata zeroes the sequence. "
+    "Fixed scale=1/16; no KV descales. Reordered, not bit-exact to F16/PF16 decode."};
+struct Geometry { int64_t q, tokens, seqs, ctx; };
+int geometry(const RadParam* p, int n, Geometry& g) {
+    g = {rad_param_getdim(p,n,"q_len",0), rad_param_getdim(p,n,"max_tokens",0),
+         rad_param_getdim(p,n,"max_seqs",0), rad_param_getdim(p,n,"max_ctx",0)};
+    if(g.q<1 || g.q>65 || g.tokens<1 || g.tokens>INT32_MAX/12 ||
+       g.seqs<1 || g.seqs>65535 || g.ctx<1 || g.ctx>INT32_MAX-3)
+        return RAD_E_UNSUPPORTED;
+    if(rad_param_getdim(p,n,"head_dim",0)!=256 || rad_param_getdim(p,n,"gqa",0)!=12 ||
+       rad_param_getdim(p,n,"n_head",0)!=12 || rad_param_getdim(p,n,"block_size",0)!=4 ||
+       rad_param_getdim(p,n,"causal",0)!=1 || rad_param_getdim(p,n,"window",-1)!=0)
+        return RAD_E_UNSUPPORTED;
+    if(std::strcmp(rad_param_gets(p,n,"q_dtype",""),"bf16") ||
+       std::strcmp(rad_param_gets(p,n,"kv_dtype",""),"fp8_e4m3")) return RAD_E_DTYPE;
+    return RAD_OK;
+}
+/* Validate positive non-overlapping strides and address arithmetic without reading data. */
+int tensor(const RadTensor& t, uint32_t dtype, uint64_t& bytes) {
+    if(!t.data) return RAD_E_INVAL;
+    if(t.dtype!=dtype) return RAD_E_DTYPE;
+    if(t.rank<1 || t.rank>4) return RAD_E_SHAPE;
+    const uint64_t size = dtype==RAD_BF16 ? 2 : dtype==RAD_I32 ? 4 : 1;
+    if(reinterpret_cast<uintptr_t>(t.data)%size) return RAD_E_ALIGN;
+    uint64_t span=1;
+    for(int i=int(t.rank)-1;i>=0;--i) {
+        if(t.shape[i]<1 || t.shape[i]>INT32_MAX) return RAD_E_SHAPE;
+        if(t.stride[i]<1 || (i<int(t.rank)-1 && uint64_t(t.stride[i])<span)) return RAD_E_STRIDE;
+        const uint64_t extent=uint64_t(t.shape[i]-1);
+        if(extent && uint64_t(t.stride[i])>(INT64_MAX/size-span)/extent) return RAD_E_SHAPE;
+        span+=extent*uint64_t(t.stride[i]);
+    }
+    bytes=span*size;
+    return reinterpret_cast<uintptr_t>(t.data)>UINTPTR_MAX-bytes ? RAD_E_INVAL : RAD_OK;
+}
+bool dense(const RadTensor& t) {
+    int64_t stride=1;
+    for(int i=int(t.rank)-1;i>=0;--i) {
+        if(t.stride[i]!=stride) return false;
+        stride*=t.shape[i];
+    }
+    return true;
+}
+const RadConstraint constraints[] = {
+    RAD_CGE("q_len",1), RAD_CLE("q_len",65), RAD_CEQ("head_dim",256),
+    RAD_CEQ("gqa",12), RAD_CEQ("n_head",12), RAD_CEQ("block_size",4),
+    RAD_CEQ("causal",1), RAD_CEQ("window",0),
+    RAD_CIN("q_dtype","bf16"), RAD_CIN("kv_dtype","fp8_e4m3")};
+}
+int rad_attn_paged_tree_schema_count() { return 1; }
+const RadOpSchema* rad_attn_paged_tree_schema_at(int i) { return i==0 ? &schema : nullptr; }
+int rad_attn_paged_tree_shape(const RadParam* p,int n,int i,RadOpdDesc* out) {
+    if(!out || i<0 || i>=RAD_ATP_OPERANDS) return RAD_E_INVAL;
+    Geometry g{}; const int rc=geometry(p,n,g); if(rc) return rc;
+    RadOpdDesc d{}; d.dtype=RAD_I32; d.idx_const=-1;
+    const int64_t blocks=(g.ctx+3)/4;
+    if(i==RAD_ATP_Q || i==RAD_ATP_OUT) {
+        d.dtype=RAD_BF16; d.rank=2; d.shape[0]=g.tokens; d.shape[1]=3072; d.fill=RAD_FILL_NORMAL;
+    } else if(i==RAD_ATP_KV) {
+        if(blocks>INT32_MAX/g.seqs) return RAD_E_UNSUPPORTED;
+        d.dtype=RAD_F8E4M3; d.rank=4; d.shape[0]=blocks*g.seqs;
+        d.shape[1]=1; d.shape[2]=4; d.shape[3]=512; d.fill=RAD_FILL_NORMAL;
+    } else if(i==RAD_ATP_BT) {
+        d.rank=2; d.shape[0]=g.seqs; d.shape[1]=blocks;
+        d.fill=RAD_FILL_INDEX; d.idx_max=blocks*g.seqs;
+    } else {
+        d.rank=1; d.shape[0]=i==RAD_ATP_SEQ ? g.seqs : i==RAD_ATP_CU ? g.seqs+1 : g.tokens;
+        d.fill=RAD_FILL_INDEX;
+        d.idx_const=i==RAD_ATP_PARENT ? -1 : i==RAD_ATP_SEQ ? g.ctx : 0;
+    }
+    *out=d; return RAD_OK;
+}
+int rad_attn_paged_tree_args(const RadArgs* a,RadAttnPagedTreeCall* out) {
+    if(!a || !out || !a->t || a->n_t!=RAD_ATP_OPERANDS) return RAD_E_INVAL;
+    Geometry g{}; int rc=geometry(a->p,a->n_p,g); if(rc) return rc;
+    uint64_t bytes[RAD_ATP_OPERANDS]{};
+    for(int i=0;i<RAD_ATP_OPERANDS;++i) {
+        const uint32_t dtype=i==RAD_ATP_Q || i==RAD_ATP_OUT ? uint32_t(RAD_BF16)
+            : i==RAD_ATP_KV ? uint32_t(RAD_F8E4M3) : uint32_t(RAD_I32);
+        if((rc=tensor(a->t[i],dtype,bytes[i]))) return rc;
+    }
+    const auto& q=a->t[RAD_ATP_Q]; const auto& o=a->t[RAD_ATP_OUT];
+    const auto& kv=a->t[RAD_ATP_KV]; const auto& bt=a->t[RAD_ATP_BT];
+    const int64_t rows=q.shape[0], seqs=bt.shape[0];
+    if(rows>g.tokens || seqs>g.seqs || bt.rank!=2 || kv.rank!=4) return RAD_E_SHAPE;
+    for(int i : {RAD_ATP_Q,RAD_ATP_OUT}) {
+        const auto& t=a->t[i];
+        if(t.shape[0]!=rows || (t.rank!=2 && t.rank!=3)) return RAD_E_SHAPE;
+        if(t.rank==2 ? t.shape[1]!=3072 : (t.shape[1]!=12 || t.shape[2]!=256)) return RAD_E_SHAPE;
+        if(!dense(t)) return RAD_E_STRIDE;
+    }
+    if(kv.shape[1]!=1 || kv.shape[2]!=4 || kv.shape[3]!=512) return RAD_E_SHAPE;
+    if(kv.stride[3]!=1 || kv.stride[2]!=512 || bt.stride[1]!=1) return RAD_E_STRIDE;
+    const int indices[]={RAD_ATP_SEQ,RAD_ATP_CU,RAD_ATP_PARENT};
+    const int64_t lengths[]={seqs,seqs+1,rows};
+    for(int j=0;j<3;++j) {
+        const auto& t=a->t[indices[j]];
+        if(t.rank!=1 || t.shape[0]!=lengths[j]) return RAD_E_SHAPE;
+        if(!dense(t)) return RAD_E_STRIDE;
+    }
+    const uintptr_t begin=reinterpret_cast<uintptr_t>(o.data);
+    for(int i=0;i<RAD_ATP_OUT;++i) {
+        const uintptr_t x=reinterpret_cast<uintptr_t>(a->t[i].data);
+        if(begin<x+bytes[i] && x<begin+bytes[RAD_ATP_OUT]) return RAD_E_INVAL;
+    }
+    *out={static_cast<const uint16_t*>(q.data),static_cast<const uint8_t*>(kv.data),
+          static_cast<const int32_t*>(bt.data),static_cast<const int32_t*>(a->t[RAD_ATP_SEQ].data),
+          static_cast<const int32_t*>(a->t[RAD_ATP_CU].data),
+          static_cast<const int32_t*>(a->t[RAD_ATP_PARENT].data),static_cast<uint16_t*>(o.data),
+          int(rows),int(seqs),int(kv.shape[0]),int(bt.shape[1]),int(g.ctx),int(g.q),
+          bt.stride[0],kv.stride[0],kv.stride[1]};
+    return RAD_OK;
+}
+int64_t rad_attn_paged_tree_scratch(const RadArgs* a) {
+    Geometry g{};
+    if(!a || geometry(a->p,a->n_p,g)) return 0;
+    return g.tokens*12*RAD_ATP_SPLITS*RAD_ATP_PARTIAL*int64_t(sizeof(float));
+}
+RadKernelInfo rad_attn_paged_tree_row(RadLaunchFn launch) {
+    RadKernelInfo r{}; r.name="mine_attn_paged_tree_h256_gqa12_b4"; r.op=schema.op;
+    r.family="attention"; r.computes=schema.doc;
+    r.shape="head_dim256, gqa12, n_head12, block4; ragged <=65 nodes/sequence; ordered I32 parents";
+    r.dtypes="bf16 q/out, OCP fp8_e4m3 KV, i32 metadata";
+    r.domain=RAD_DOMAIN_DEVICE; r.priority=100; r.launch=launch;
+    r.constraints=constraints; r.n_constraints=int(sizeof(constraints)/sizeof(constraints[0]));
+    r.opd_shape=rad_attn_paged_tree_shape; r.scratch=rad_attn_paged_tree_scratch;
+    return r;
+}
diff --git a/mine/attn_paged_tree.h b/mine/attn_paged_tree.h
new file mode 100644
index 0000000000000000000000000000000000000000..a50ccb1ca570dc271dc3d769d128299ff98109b2
--- /dev/null
+++ b/mine/attn_paged_tree.h
@@ -0,0 +1,38 @@
+#ifndef RAD_MINE_ATTN_PAGED_TREE_H
+#define RAD_MINE_ATTN_PAGED_TREE_H
+
+#include "rad_plugin.h"
+#include <cstdint>
+
+/* Model-owned, full-context attention: prefix followed by <=65 ordered tree nodes.
+ * spec_parent is compact I32[T], sequence-local; root=-1, 0<=parent[j]<j.
+ * Ordinary causal rows use parent[j]=j-1, never an all-minus-one sentinel.
+ * Invalid device metadata produces zero output for the affected sequence.
+ * No descales: the target stores unscaled OCP E4M3FN codes in its paged cache.
+ * Numerik: verlustfrei-nicht-bitgenau relative to upstream decode's F16/PF16
+ * path: conversions are exact, FP32 QK/softmax/PV and partials retain at least
+ * its precision, but the dot reduction and split/merge order differ. */
+enum { RAD_ATP_Q, RAD_ATP_KV, RAD_ATP_BT, RAD_ATP_SEQ, RAD_ATP_CU,
+       RAD_ATP_PARENT, RAD_ATP_OUT, RAD_ATP_OPERANDS };
+constexpr int RAD_ATP_SPLITS = 16;
+constexpr int RAD_ATP_PARTIAL = 258;  // FP32 numerator[256], maximum, denominator
+struct RadAttnPagedTreeCall {
+    const uint16_t* q;
+    const uint8_t* kv;
+    const int32_t *bt, *seqused, *cu, *parent;
+    uint16_t* out;
+    int rows, seqs, pages, bt_width, max_ctx, q_bound;
+    int64_t bt_pitch, kv_block_pitch, kv_head_pitch;
+};
+int rad_attn_paged_tree_schema_count();
+const RadOpSchema* rad_attn_paged_tree_schema_at(int);
+int rad_attn_paged_tree_shape(const RadParam*, int, int, RadOpdDesc*);
+int rad_attn_paged_tree_args(const RadArgs*, RadAttnPagedTreeCall*);
+int64_t rad_attn_paged_tree_scratch(const RadArgs*);
+RadKernelInfo rad_attn_paged_tree_row(RadLaunchFn);
+int rad_ref_attn_paged_tree_launch(const RadArgs*, RadStream);
+int rad_ref_attn_paged_tree_count();
+const RadKernelInfo* rad_ref_attn_paged_tree_at(int);
+int rad_mine_attn_paged_tree_count();
+const RadKernelInfo* rad_mine_attn_paged_tree_at(int);
+#endif
diff --git a/mine/attn_paged_tree.hip b/mine/attn_paged_tree.hip
new file mode 100644
index 0000000000000000000000000000000000000000..14364e48afba8acb7cc0bbeb1eab6db88faa2bfe
--- /dev/null
+++ b/mine/attn_paged_tree.hip
@@ -0,0 +1,140 @@
+#include <hip/hip_runtime.h>
+#include "attn_paged_tree.h"
+#include <cmath>
+
+namespace {
+__device__ float fp8(uint8_t x) {
+    const int e=(x>>3)&15, m=x&7;
+    if(e==15 && m==7) return NAN;
+    const float mag=e ? ldexpf(float(8+m),e-10) : ldexpf(float(m),-9);
+    return x&128 ? -mag : mag;
+}
+__device__ uint16_t bf16(float value) {
+    uint32_t u=__float_as_uint(value);
+    if((u&0x7fffffffU)>0x7f800000U) return uint16_t((u>>16)|0x40U);
+    u+=0x7fffU+((u>>16)&1U); return uint16_t(u>>16);
+}
+// One wave owns one query/head/split. Every intermediate and partial is FP32,
+// unlike upstream decode's F16 operands/probabilities and PF16 output partials.
+// Numerik: verlustfrei-nicht-bitgenau; reductions and packing are not upstream's.
+__global__ __launch_bounds__(32) void paged_tree_partial(RadAttnPagedTreeCall c,float* scratch) {
+    const int job=blockIdx.x, split=blockIdx.y, lane=threadIdx.x;
+    const int row=job/12, head=job%12;
+    int seq=-1, prefix=0, ctx=0, valid=1;
+    uint32_t mask0=0, mask1=0, mask2=0;
+    if(lane==0) {
+        if(c.cu[0]!=0 || c.cu[c.seqs]!=c.rows) valid=0;
+        for(int s=0;s<c.seqs;++s) {
+            const int begin=c.cu[s], end=c.cu[s+1];
+            if(begin<0 || end<begin || end>c.rows) valid=0;
+            if(row>=begin && row<end) seq=s;
+        }
+        if(seq<0) valid=0;
+        if(valid) {
+            const int begin=c.cu[seq], count=c.cu[seq+1]-begin;
+            ctx=c.seqused[seq]; prefix=ctx-count;
+            valid=count<=c.q_bound && ctx>=count && ctx<=c.max_ctx &&
+                (int64_t(ctx)+3)/4<=c.bt_width && c.parent[begin]==-1;
+            for(int j=1;j<count && valid;++j) valid=c.parent[begin+j]>=0 && c.parent[begin+j]<j;
+            for(int64_t b=0;b<(int64_t(ctx)+3)/4 && valid;++b) {
+                const int page=c.bt[int64_t(seq)*c.bt_pitch+b];
+                valid=page>=0 && page<c.pages;
+            }
+            if(valid) {
+                int cur=row-begin;
+                // Ordered parents strictly decrease; the hard bound prevents malformed loops.
+                for(int step=0;step<65 && cur>=0;++step) {
+                    if(cur<32) mask0|=uint32_t(1)<<cur;
+                    else if(cur<64) mask1|=uint32_t(1)<<(cur-32);
+                    else mask2|=1u;
+                    cur=c.parent[begin+cur];
+                }
+            }
+        }
+    }
+    valid=__shfl(valid,0); seq=__shfl(seq,0); ctx=__shfl(ctx,0); prefix=__shfl(prefix,0);
+    mask0=__shfl(mask0,0); mask1=__shfl(mask1,0); mask2=__shfl(mask2,0);
+    float query[8], accum[8]{};
+    #pragma unroll
+    for(int d=0;d<8;++d)
+        query[d]=__uint_as_float(uint32_t(c.q[(int64_t(row)*12+head)*256+lane+32*d])<<16);
+    float maximum=-INFINITY, denominator=0;
+    if(valid) {
+        const int64_t lo=int64_t(ctx)*split/RAD_ATP_SPLITS;
+        const int64_t hi=int64_t(ctx)*(split+1)/RAD_ATP_SPLITS;
+        for(int64_t pos=lo;pos<hi;++pos) {
+            if(pos>=prefix) {
+                const int n=int(pos)-prefix;
+                const bool visible=n<32 ? ((mask0>>n)&1u) : n<64 ? ((mask1>>(n-32))&1u) : (mask2&1u);
+                if(!visible) continue;
+            }
+            const int page=c.bt[int64_t(seq)*c.bt_pitch+pos/4];
+            const int64_t base=int64_t(page)*c.kv_block_pitch+(pos%4)*512;
+            float dot=0;
+            #pragma unroll
+            for(int d=0;d<8;++d) dot=dot+query[d]*fp8(c.kv[base+lane+32*d]);
+            #pragma unroll
+            for(int delta=16;delta;delta/=2) dot+=__shfl_xor(dot,delta);
+            const float logit=dot*(1.0f/16.0f), next=fmaxf(maximum,logit);
+            const float alpha=expf(maximum-next), weight=expf(logit-next);
+            denominator=denominator*alpha+weight; maximum=next;
+            #pragma unroll
+            for(int d=0;d<8;++d)
+                accum[d]=accum[d]*alpha+weight*fp8(c.kv[base+256+lane+32*d]);
+        }
+    }
+    float* partial=scratch+(int64_t(job)*RAD_ATP_SPLITS+split)*RAD_ATP_PARTIAL;
+    #pragma unroll
+    for(int d=0;d<8;++d) partial[lane+32*d]=accum[d];
+    if(lane==0) { partial[256]=maximum; partial[257]=denominator; }
+}
+__global__ __launch_bounds__(32) void paged_tree_merge(RadAttnPagedTreeCall c,const float* scratch) {
+    const int job=blockIdx.x, lane=threadIdx.x;
+    const float* partial=scratch+int64_t(job)*RAD_ATP_SPLITS*RAD_ATP_PARTIAL;
+    float maximum=-INFINITY;
+    for(int s=0;s<RAD_ATP_SPLITS;++s)
+        if(partial[s*RAD_ATP_PARTIAL+257]>0) maximum=fmaxf(maximum,partial[s*RAD_ATP_PARTIAL+256]);
+    float numerator[8]{}, denominator=0;
+    for(int s=0;s<RAD_ATP_SPLITS;++s) {
+        const float* p=partial+s*RAD_ATP_PARTIAL;
+        if(p[257]==0) continue; // includes invalid metadata and splits with no visible keys
+        const float weight=expf(p[256]-maximum);
+        denominator+=weight*p[257];
+        #pragma unroll
+        for(int d=0;d<8;++d) numerator[d]+=weight*p[lane+32*d];
+    }
+    #pragma unroll
+    for(int d=0;d<8;++d)
+        c.out[int64_t(job)*256+lane+32*d]=denominator==0 ? uint16_t(0) : bf16(numerator[d]/denominator);
+}
+int launch(const RadArgs* a,RadStream stream) {
+    RadAttnPagedTreeCall c{}; const int rc=rad_attn_paged_tree_args(a,&c); if(rc) return rc;
+    const int64_t need=rad_attn_paged_tree_scratch(a);
+    if(!a->scratch || a->scratch_bytes<need) return RAD_E_SCRATCH;
+    if(reinterpret_cast<uintptr_t>(a->scratch)%8) return RAD_E_ALIGN;
+    const uintptr_t start=reinterpret_cast<uintptr_t>(a->scratch);
+    if(uint64_t(need)>UINTPTR_MAX-start) return RAD_E_INVAL;
+    // Scratch must be disjoint from every operand; allocation is the caller's responsibility.
+    for(int i=0;i<a->n_t;++i) {
+        const auto& t=a->t[i]; int64_t span=1;
+        for(uint32_t j=0;j<t.rank;++j) span+=(t.shape[j]-1)*t.stride[j];
+        const uint64_t size=t.dtype==RAD_BF16 ? 2 : t.dtype==RAD_I32 ? 4 : 1;
+        const uintptr_t x=reinterpret_cast<uintptr_t>(t.data);
+        if(start<x+uint64_t(span)*size && x<start+uint64_t(need)) return RAD_E_INVAL;
+    }
+    float* scratch=static_cast<float*>(a->scratch);
+    void* args[]={&c,&scratch};
+    const dim3 jobs(static_cast<unsigned>(c.rows*12));
+    const auto s=reinterpret_cast<hipStream_t>(stream);
+    hipError_t status=hipLaunchKernel(reinterpret_cast<const void*>(paged_tree_partial),
+        dim3(jobs.x,RAD_ATP_SPLITS),dim3(32),args,0,s);
+    if(status!=hipSuccess) return RAD_E_DEVICE;
+    status=hipLaunchKernel(reinterpret_cast<const void*>(paged_tree_merge),jobs,dim3(32),args,0,s);
+    return status==hipSuccess ? RAD_OK : RAD_E_DEVICE;
+}
+}
+int rad_mine_attn_paged_tree_count() { return 1; }
+const RadKernelInfo* rad_mine_attn_paged_tree_at(int i) {
+    static const RadKernelInfo row=rad_attn_paged_tree_row(launch);
+    return i==0 ? &row : nullptr;
+}
diff --git a/mine/dflash_conv_add.cpp b/mine/dflash_conv_add.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..10bf755a8a09cc81f419a230aba3cbd5bbc56ddb
--- /dev/null
+++ b/mine/dflash_conv_add.cpp
@@ -0,0 +1,420 @@
+/* dflash_conv_add.cpp -- schema, operand description, call validation and the declared fusion for
+ * DFlash2's closing convolution plus its residual add.
+ *
+ * THE SCHEMA IS `dflash_conv`'s, PLUS THE RESIDUAL. The parameters are the convolution's own, in
+ * its own spelling and order (`T`, `hidden_size`, `taps`, `group_size`, `NG`, `block_size`,
+ * `dtype`), because the fused op is selected where that op was selected and a caller that has the
+ * geometry already has it in this form. Nothing of `add`'s geometry is added: its `M` is `T` and
+ * its `n` is `hidden_size`, so a second pair of keys would be the same two numbers under two names
+ * and a way for them to disagree.
+ *
+ * THE OPERAND ORDER IS THE CONVOLUTION'S, WITH THE RESIDUAL AND THE OUTPUT AT THE END:
+ * x, delta, base, residual, out. Appending rather than interleaving keeps the conv's four
+ * operands in the positions the unfused op already names -- which is what makes the fusion hook
+ * below a wiring of indices rather than a re-description -- and puts the two operands the fusion
+ * adds where a reader looks for them.
+ *
+ * THE OUTPUT MAY ALIAS `residual`, AND MUST NOT ALIAS `x`. The unfused pair is issued with the
+ * residual stream as the add's `a` and its `y` (arch/common/rad_block_dflash2.h:1126), while the
+ * add's `b` is the bf16 plane the convolution wrote -- so an in-place form is the real call and
+ * refusing it would refuse every site. `x` is different: tap 1 of row t reads row t-1 of the
+ * INPUT, so an output overlapping it writes a row the tap set has not read yet.
+ *
+ * THIS FILE IS COMPILED INTO THE DEVICE PLUGIN ONLY. The host-domain reference for the chain is
+ * the two unsfused rows' own (libr4d's dflash_conv is itself device-only, and `add` has libref's
+ * host row), and duplicating that here would be a second reference to disagree with. What is
+ * shared is the SCHEMA and the VALIDATION: a device kernel accepting a call the unfused pair
+ * refuses is a divergence no oracle can see.
+ */
+#include "dflash_conv_add.h"
+
+#include <cstdint>
+#include <cstring>
+#include <initializer_list>
+
+namespace {
+
+/* The one geometry the device row is compiled for. taps 2 and group_size 16 are DFlash2's, and
+ * hidden_size divisible by 64 is what makes a lane's 8-channel group, its 16 channels of group,
+ * and the 16-byte vector loads line up: `hidden_size/8` lanes, a group of two lanes, and every row
+ * start 16-byte aligned. It is the unfused row's band (`cDflashConv`), so no geometry arrives here
+ * that `dflash_conv` would have served. */
+constexpr int64_t kTaps  = 2;
+constexpr int64_t kGroup = 16;
+constexpr int64_t kAlign = 64;
+constexpr int64_t kVec   = 8;
+
+/* Elements a tensor occupies, from its OWN shape and strides -- a view is measured over what it
+ * names, not over the buffer it looks into. */
+int64_t span_elements(const RadTensor& t) {
+    int64_t e = 1;
+    for (uint32_t i = 0; i < t.rank; ++i) e += (t.shape[i] - 1) * t.stride[i];
+    return e;
+}
+
+bool byte_overlap(const RadTensor& a, const RadTensor& b, int64_t ea, int64_t eb) {
+    if (!a.data || !b.data) return false;
+    const uintptr_t x = (uintptr_t)a.data, y = (uintptr_t)b.data;
+    const uint64_t xa = (uint64_t)ea * 2u, xb = (uint64_t)eb * 2u;
+    return x < y + xb && y < x + xa;
+}
+
+/* EVERY AXIS BUT THE LEADING ONE IS DENSE, so the tensor is rows of one width and the only pitch
+ * is stride[0]. That is the reading libr4d's shims take of the same operands (r4d_args.h's
+ * r4d_row_pitch), and it is deliberately the same one: the delta operand is a COLUMN SLICE whose
+ * row pitch is the wider buffer's, and a helper that answered with the packed width would read the
+ * other coefficient half and produce numbers that look like a convolution.
+ *
+ * `width` receives the elements one row spans. */
+int64_t dense_row_pitch(const RadTensor& t, int64_t* width) {
+    if (t.rank < 2) return -1;
+    int64_t acc = 1;
+    for (int i = (int)t.rank - 1; i >= 1; --i) {
+        if (t.shape[i] != 1 && t.stride[i] != acc) return -1;
+        acc *= t.shape[i];
+    }
+    *width = acc;
+    return t.stride[0];
+}
+
+bool aligned16(const void* p) { return p && ((uintptr_t)p & 15u) == 0; }
+
+}  /* namespace */
+
+int rad_dflash_conv_add_schema_count(void) { return 1; }
+
+/* ---- schema ---------------------------------------------------------------------------------- */
+#define P_INT(k)  { k, RAD_P_INT, RAD_REQUIRED, 0 }
+#define P_STR(k)  { k, RAD_P_STR, RAD_REQUIRED, 0 }
+#define IN(n)     { n, RAD_OPD_IN,  0 }
+#define OUT(n)    { n, RAD_OPD_OUT, 0 }
+
+static const RadParamSpec kParams[] = {
+    P_INT("T"), P_INT("hidden_size"), P_INT("taps"), P_INT("group_size"),
+    P_INT("NG"), P_INT("block_size"), P_STR("dtype"),
+};
+static const RadOperandSpec kOperands[] = {
+    IN("x"),
+    IN("delta"),
+    /* A WEIGHT, for the reason dflash_conv states: base_kernel is a checkpoint parameter, and the
+     * role is what gives it a residency class and a prefetch interval. */
+    { "base", RAD_OPD_WEIGHT, 0 },
+    IN("residual"),
+    OUT("out"),
+};
+static const RadOpSchema kSchema = {
+    "dflash_conv_add", kParams, (int)(sizeof(kParams) / sizeof(kParams[0])),
+    kOperands, (int)(sizeof(kOperands) / sizeof(kOperands[0])),
+    "DFlash2's closing grouped convolution with its residual add in one launch: h2 = conv(x, "
+    "delta, base) with the accumulator rounded to bf16, then out = residual + h2 rounded once. "
+    "Its arithmetic target is the unfused `dflash_conv` followed by `add`, including the bf16 "
+    "rounding between them; the equivalence has NOT been measured."
+};
+#undef P_INT
+#undef P_STR
+#undef IN
+#undef OUT
+
+const RadOpSchema* rad_dflash_conv_add_schema_at(int i) { return i == 0 ? &kSchema : nullptr; }
+
+/* ---- operand description --------------------------------------------------------------------- */
+int rad_dflash_conv_add_shape(const RadParam* p, int n_p, int operand, RadOpdDesc* out) {
+    if (!out || operand < 0 || operand >= RAD_DFLASH_CONV_ADD_OPERANDS) return RAD_E_INVAL;
+    const int64_t T    = rad_param_getdim(p, n_p, "T", 0);
+    const int64_t H    = rad_param_getdim(p, n_p, "hidden_size", 0);
+    const int64_t taps = rad_param_getdim(p, n_p, "taps", 0);
+    const int64_t NG   = rad_param_getdim(p, n_p, "NG", 0);
+    const int64_t grp  = rad_param_getdim(p, n_p, "group_size", 0);
+    const char*   dt   = rad_param_gets(p, n_p, "dtype", nullptr);
+    /* The entry point's own conditions, checked here so a geometry that cannot be served declines
+     * rather than being described into a buffer nothing will read. */
+    if (T <= 0 || H <= 0 || grp <= 0 || taps <= 0 || NG <= 0) return RAD_E_UNSUPPORTED;
+    if (taps != kTaps || grp != kGroup || H % kAlign || NG != H / grp) return RAD_E_UNSUPPORTED;
+    if (!dt || std::strcmp(dt, "bf16") != 0) return RAD_E_UNSUPPORTED;
+
+    RadOpdDesc d{};
+    d.dtype = RAD_BF16;
+    d.fill  = (uint32_t)RAD_FILL_NORMAL;
+    d.idx_const = -1;
+    switch (operand) {
+    case RAD_DFLASH_CONV_ADD_X:
+    case RAD_DFLASH_CONV_ADD_RESIDUAL:
+    case RAD_DFLASH_CONV_ADD_OUT:
+        d.rank = 2;
+        d.shape[0] = T;
+        d.shape[1] = H;
+        break;
+    case RAD_DFLASH_CONV_ADD_DELTA:
+        /* THE PROJECTION, NOT THE SLICE: the operand a real call hands over is one half of this
+         * at the projection's own row pitch (2*taps*NG), and a description of the half would
+         * allocate a buffer whose natural pitch is half the one the kernel is handed. */
+        d.rank = 4;
+        d.shape[0] = T;
+        d.shape[1] = 2;
+        d.shape[2] = taps;
+        d.shape[3] = NG;
+        break;
+    case RAD_DFLASH_CONV_ADD_BASE:
+    default:
+        d.rank = 2;
+        d.shape[0] = taps;
+        d.shape[1] = H;
+        break;
+    }
+    *out = d;
+    return RAD_OK;
+}
+
+/* ---- the call ---------------------------------------------------------------------------------- */
+int rad_dflash_conv_add_args(const RadArgs* a, RadDflashConvAddCall* call) {
+    if (!a || !call || !a->t || a->n_t != RAD_DFLASH_CONV_ADD_OPERANDS) return RAD_E_INVAL;
+    const RadTensor& x   = a->t[RAD_DFLASH_CONV_ADD_X];
+    const RadTensor& d   = a->t[RAD_DFLASH_CONV_ADD_DELTA];
+    const RadTensor& b   = a->t[RAD_DFLASH_CONV_ADD_BASE];
+    const RadTensor& r   = a->t[RAD_DFLASH_CONV_ADD_RESIDUAL];
+    const RadTensor& o   = a->t[RAD_DFLASH_CONV_ADD_OUT];
+    if (!x.data || !d.data || !b.data || !r.data || !o.data) return RAD_E_INVAL;
+
+    const int64_t H    = rad_param_getdim(a->p, a->n_p, "hidden_size", 0);
+    const int64_t taps = rad_param_getdim(a->p, a->n_p, "taps", 0);
+    const int64_t NG   = rad_param_getdim(a->p, a->n_p, "NG", 0);
+    const int64_t grp  = rad_param_getdim(a->p, a->n_p, "group_size", 0);
+    const int64_t bsz  = rad_param_getdim(a->p, a->n_p, "block_size", 0);
+    if (H <= 0 || taps <= 0 || NG <= 0 || grp <= 0 || bsz <= 0) return RAD_E_SHAPE;
+    if (H > INT32_MAX || NG > INT32_MAX || bsz > INT32_MAX) return RAD_E_SHAPE;
+    /* THE PARAMETERS ARE THE SPECIALISATION: a call outside the compiled geometry is refused here
+     * rather than by the constraints alone, because a tool may reach a launch with no selection in
+     * front of it. */
+    if (taps != kTaps || grp != kGroup || H % kAlign || NG != H / grp) return RAD_E_UNSUPPORTED;
+    /* THE OFF MASK IN THE KERNEL IS A BOUND, NOT AN OPTIMISATION. A lane's channel offset is
+     * `(hv & 0xFFFFF) * 8`, so hidden_size above `8 * (1 << 20)` would alias lane offsets onto
+     * each other -- silently, with every admitted call looking legitimate. H is capped here at
+     * exactly that value, which also keeps every derived pitch inside `int`. */
+    if (H > 8 * (INT64_C(1) << 20)) return RAD_E_UNSUPPORTED;
+
+    const char* dt = rad_param_gets(a->p, a->n_p, "dtype", "bf16");
+    if (!dt || std::strcmp(dt, "bf16") != 0) return RAD_E_DTYPE;
+    if (x.dtype != RAD_BF16 || d.dtype != RAD_BF16 || b.dtype != RAD_BF16 ||
+        r.dtype != RAD_BF16 || o.dtype != RAD_BF16)
+        return RAD_E_DTYPE;
+
+    /* Rows are the OPERAND's, and `T` is only the ceiling of the band -- a decode step presents
+     * one row of a max_tok arena, and reading `T` as the count walks rows nobody wrote. */
+    if (x.rank != 2 || r.rank != 2 || o.rank != 2) return RAD_E_UNSUPPORTED;
+    const int64_t rows = x.shape[0];
+    const int64_t band = rad_param_getdim(a->p, a->n_p, "T", 0);
+    if (rows <= 0 || rows > INT32_MAX || (band > 0 && rows > band)) return RAD_E_SHAPE;
+    if (r.shape[0] != rows || o.shape[0] != rows) return RAD_E_SHAPE;
+    if (x.shape[1] != H || r.shape[1] != H || o.shape[1] != H) return RAD_E_SHAPE;
+
+    int64_t aw = 0, rw = 0, ow = 0;
+    const int64_t x_pitch = dense_row_pitch(x, &aw);
+    const int64_t r_pitch = dense_row_pitch(r, &rw);
+    const int64_t o_pitch = dense_row_pitch(o, &ow);
+    if (x_pitch < 0 || r_pitch < 0 || o_pitch < 0) return RAD_E_STRIDE;
+    if (aw != H || rw != H || ow != H) return RAD_E_SHAPE;
+    /* A negative pitch is never a view; a pitch narrower than the row would make consecutive rows
+     * overlap (a store to row t landing in row t+1's data); a pitch that overflows the product
+     * would wrap the address. All three are refused. */
+    if (x_pitch < H || r_pitch < H || o_pitch < H) return RAD_E_SHAPE;
+    if (rows > INT64_MAX / x_pitch || rows > INT64_MAX / r_pitch || rows > INT64_MAX / o_pitch)
+        return RAD_E_SHAPE;
+    /* THE LAUNCH NARROWS EVERY PITCH AND WIDTH TO `int`, so anything above INT32_MAX is refused
+     * HERE rather than silently truncated at the argument struct. A truncated pitch is the worst
+     * kind of wrong: the kernel reads a plausible row and produces a plausible number. */
+    if (x_pitch > INT32_MAX || r_pitch > INT32_MAX || o_pitch > INT32_MAX) return RAD_E_SHAPE;
+    /* Every lane loads one 16-byte vector at `row*pitch + off`, so both the pointer and the pitch
+     * have to be 16-byte aligned. H is a multiple of 64, so the pitch rule only bites on a view
+     * of a buffer whose row is not. */
+    if (!aligned16(x.data) || !aligned16(r.data) || !aligned16(o.data)) return RAD_E_ALIGN;
+    if (x_pitch % kVec || r_pitch % kVec || o_pitch % kVec) return RAD_E_ALIGN;
+
+    /* ---- the coefficients: a slice of the [T, 2, taps, NG] projection ---- */
+    int64_t dw = 0;
+    const int64_t dpitch = dense_row_pitch(d, &dw);
+    if (dpitch < 0) return RAD_E_STRIDE;
+    /* THIS IS THE ONE CHECK NO SHAPE TEST WOULD MAKE. The slice's natural width is taps*NG and
+     * the projection's row pitch is 2*taps*NG; passing the packed pitch reads the other side's
+     * coefficients, which is a plausible convolution and not a shape error. */
+    if (dpitch != 2 * taps * NG) return RAD_E_STRIDE;
+    if (dpitch > INT32_MAX) return RAD_E_SHAPE;
+    if (dw < taps * NG || dw % NG) return RAD_E_SHAPE;
+    if (d.shape[0] < rows) return RAD_E_SHAPE;
+    if (!aligned16(d.data) || dpitch % kVec) return RAD_E_ALIGN;
+
+    /* ---- base: the tap row of base_kernel, contiguous ---- */
+    if (!rad_tensor_is_contiguous(&b)) return RAD_E_STRIDE;
+    if (rad_tensor_numel(&b) < taps * H) return RAD_E_SHAPE;
+    if (!aligned16(b.data)) return RAD_E_ALIGN;
+
+    /* ---- aliasing ---- */
+    /* `out` MAY be `residual`, and when it is, it must be the SAME view -- same base, same pitch.
+     * The graph issues the add in place (`x = x + h2`), so a partial overlap is not something a
+     * caller produces; it is the case where lane j's store lands on lane j' 's unread residual,
+     * and no per-lane ordering makes that defined. Refusing it keeps "in place" meaning in place
+     * rather than "some overlap nobody reasoned about".
+     *
+     * `out` may NOT overlap `x` -- tap 1 reads row t-1 of the input, and a row already overwritten
+     * is a convolution over its own output -- nor the coefficients, whose reads are pitched and
+     * shared between rows. */
+    const bool in_place = o.data == r.data;
+    if (in_place && o_pitch != r_pitch) return RAD_E_INVAL;
+    const int64_t ex = span_elements(x), ed = span_elements(d), eb = span_elements(b);
+    const int64_t er = span_elements(r), eo = span_elements(o);
+    if (ex <= 0 || ed <= 0 || eb <= 0 || er <= 0 || eo <= 0) return RAD_E_SHAPE;
+    if (byte_overlap(o, x, eo, ex) || byte_overlap(o, d, eo, ed) || byte_overlap(o, b, eo, eb))
+        return RAD_E_INVAL;
+    if (!in_place && byte_overlap(o, r, eo, er)) return RAD_E_INVAL;
+
+    call->x        = x.data;
+    call->delta    = d.data;
+    call->base     = b.data;
+    call->residual = r.data;
+    call->out      = o.data;
+    call->rows     = rows;
+    call->H        = H;
+    call->NG       = NG;
+    call->dpitch   = dpitch;
+    call->x_pitch  = x_pitch;
+    call->r_pitch  = r_pitch;
+    call->o_pitch  = o_pitch;
+    call->block_size = bsz;
+    return RAD_OK;
+}
+
+/* ---- the declared fusion ----------------------------------------------------------------------- */
+/* THE CHAIN, IN THE FUSED OP'S OWN OPERAND INDICES:
+ *
+ *   add temp          <- dflash_conv(x, delta, base)            the bf16 the add reads back
+ *   out               <- add(residual, temp)
+ *
+ * The temporary is exactly the [T, hidden_size] plane the unfused pair materialises, so both
+ * sides of a comparison leave the same bytes behind and the rounding between the two steps is the
+ * rounding the fusion preserves.
+ *
+ * The steps' parameters are the steps' own spelling. `dflash_conv` takes this op's seven
+ * parameters under the same names; `add` calls them `M` and `n`, and `T`/`hidden_size` are the
+ * same two numbers, so they are emitted as INT with the band's HIGH bound -- what rad_param_getdim
+ * would answer, and what the step's own selector buckets on.
+ *
+ * EVERY OPERAND OF THIS OP IS REQUIRED, so a `present` mask that omits one describes a call that
+ * cannot be issued: the honest answer is RAD_E_UNSUPPORTED, not a chain with a hole in it. */
+int rad_dflash_conv_add_fuse(const RadParam* p, int n_p, uint64_t present, int step,
+                             RadFuseStep* out) {
+    if (!out) return RAD_E_INVAL;
+    for (int i = 0; i < RAD_DFLASH_CONV_ADD_OPERANDS; ++i)
+        if (!RAD_FUSE_HAS(present, i)) return RAD_E_UNSUPPORTED;
+
+    const int64_t T    = rad_param_getdim(p, n_p, "T", 0);
+    const int64_t H    = rad_param_getdim(p, n_p, "hidden_size", 0);
+    const int64_t taps = rad_param_getdim(p, n_p, "taps", 0);
+    const int64_t NG   = rad_param_getdim(p, n_p, "NG", 0);
+    const int64_t grp  = rad_param_getdim(p, n_p, "group_size", 0);
+    const char*   dt   = rad_param_gets(p, n_p, "dtype", nullptr);
+    if (T <= 0 || H <= 0 || taps != kTaps || grp != kGroup || NG != H / grp || H % kAlign)
+        return RAD_E_UNSUPPORTED;
+    if (!dt || std::strcmp(dt, "bf16") != 0) return RAD_E_UNSUPPORTED;
+
+    /* Field by field rather than through rad_types.h's builders: those are compound literals, a C
+     * construct that is only a GNU extension in C++, and this is ordinary host C++. */
+    auto mirror = [&](const char* k) -> bool {
+        if (out->n_p >= RAD_MAX_FUSE_PARAMS) return false;
+        const RadParam* f = rad_param_find(p, n_p, k);
+        if (!f) return false;
+        out->p[out->n_p++] = *f;
+        return true;
+    };
+    /* THE RANGED KEY HAS TO BE RE-EMITTED AS AN INT, and this is not the band loss libr4d's
+     * `Step::mirror` warns about. A RadFuseStep is read back by writing each parameter into a
+     * selector geometry, and that reader carries RAD_P_INT, RAD_P_STR and RAD_P_F64 -- a
+     * RAD_P_RANGE in a step is silently dropped, so a mirrored `T` would reach the step's own
+     * shape hook as absent and the temporary it sizes would be refused. rad_param_getdim's high
+     * bound IS the value the fused op is resolved at, so the step carries the same band. */
+    auto pint = [&](const char* k, long long v) -> bool {
+        if (out->n_p >= RAD_MAX_FUSE_PARAMS) return false;
+        RadParam q{};
+        q.key = k;
+        q.kind = RAD_P_INT;
+        q.ival = v;
+        out->p[out->n_p++] = q;
+        return true;
+    };
+    auto wire = [&](std::initializer_list<int> from) -> int {
+        if (from.size() > RAD_MAX_FUSE_OPD) return RAD_E_INVAL;
+        for (int v : from) out->from[out->n_from++] = (int16_t)v;
+        return RAD_OK;
+    };
+
+    *out = RadFuseStep{};
+    switch (step) {
+    case 0:
+        /* The convolution, into the plane the pair materialises. */
+        out->op = "dflash_conv";
+        if (!pint("T", T) || !pint("hidden_size", H) || !mirror("taps") ||
+            !mirror("group_size") || !mirror("NG") || !mirror("block_size") || !mirror("dtype"))
+            return RAD_E_INVAL;
+        /* x, delta, base, out */
+        return wire({ RAD_DFLASH_CONV_ADD_X, RAD_DFLASH_CONV_ADD_DELTA, RAD_DFLASH_CONV_ADD_BASE,
+                      RAD_FUSE_TMP(0) });
+    case 1:
+        /* The residual add, in place on `out` exactly as the block issues it. `add` spells the two
+         * extents `M` and `n`; they are the same two numbers the convolution calls `T` and
+         * `hidden_size`, so nothing is invented. */
+        out->op = "add";
+        if (!pint("M", T) || !pint("n", H) || !mirror("dtype")) return RAD_E_INVAL;
+        /* a, b, y */
+        return wire({ RAD_DFLASH_CONV_ADD_RESIDUAL, RAD_FUSE_TMP(0), RAD_DFLASH_CONV_ADD_OUT });
+    default:
+        return RAD_E_NOTFOUND;
+    }
+}
+
+/* ---- the row ----------------------------------------------------------------------------------- */
+/* THE CONSTRAINTS ARE THE SPECIALISATION, stated so selection never has to find out the hard way.
+ * They are `dflash_conv`'s own (`cDflashConv` in libr4d) and not a widening of them: this row is
+ * chosen for exactly the geometries the unfused row would have served, so a model that resolves
+ * it never finds a band the other would have taken. */
+static const RadConstraint kConstraints[] = {
+    RAD_CEQ("taps", 2),
+    RAD_CEQ("group_size", 16),
+    RAD_CDIV("hidden_size", 64),
+    RAD_CIN("dtype", "bf16"),
+    RAD_CGE("block_size", 1),
+};
+
+RadKernelInfo rad_dflash_conv_add_row(RadLaunchFn launch) {
+    RadKernelInfo r{};
+    r.name = "mine_dflash_conv_add_t2_g16_bf16";
+    r.op = kSchema.op;
+    r.family = "dflash";
+    r.computes = kSchema.doc;
+    r.shape = "taps 2, group_size 16, hidden_size % 64; delta is a slice of the [T, 2, taps, NG] "
+              "projection so its row pitch is 2*taps*NG; out may alias residual and must not "
+              "alias x";
+    r.dtypes = "bf16 in and out, fp32 accumulate, bf16 rounding of the convolution before the add";
+    r.domain = RAD_DOMAIN_DEVICE;
+    r.priority = 100;
+    r.constraints = kConstraints;
+    r.n_constraints = (int)(sizeof(kConstraints) / sizeof(kConstraints[0]));
+    r.launch = launch;
+    r.opd_shape = rad_dflash_conv_add_shape;
+    r.replaces = rad_dflash_conv_add_fuse;
+    return r;
+}
+
+/* ============================== WHAT `replaces` DOES *NOT* BUY HERE ==============================
+ *
+ * The hook above is the truthful chain, and on its own IT IS NOT EXECUTABLE BY STOCK rad-kbench.
+ * The tool resolves each declared step with `row_in(THIS row's plugin, step_op, ...)`
+ * (tools/rad_kbench.cpp:2682-2686), and `mine` has no `dflash_conv` and no `add` row -- by
+ * design, since duplicating libr4d's kernels into this plugin would be a second copy of the
+ * arithmetic the fusion is supposed to be checked against, and registering an `add` row here would
+ * shadow libr4d's for every model that uses this plugin.
+ *
+ * So the chain is declared for the graph dump and for a comparator that selects the candidate row
+ * by name and each unfused step from libr4d explicitly. Until that comparator exists and runs, NO
+ * PARITY CLAIM RESTS ON THIS HOOK -- see reports/dflash2-conv-add-handoff.md, which states the
+ * same blocker and the evidence still owed.
+ */
+
+
diff --git a/mine/dflash_conv_add.h b/mine/dflash_conv_add.h
new file mode 100644
index 0000000000000000000000000000000000000000..0dbf92b9160b03e39ff2dab77274b314f3b8e9d9
--- /dev/null
+++ b/mine/dflash_conv_add.h
@@ -0,0 +1,121 @@
+#ifndef RAD_MINE_DFLASH_CONV_ADD_H
+#define RAD_MINE_DFLASH_CONV_ADD_H
+
+#include "rad_plugin.h"
+#include <stdint.h>
+
+/* dflash_conv_add -- DFlash2's closing grouped convolution plus the residual add, in one launch.
+ *
+ *   h2 = dflash_conv(h, delta, base_row)      the rounded bf16 convolution output
+ *   x  = x + h2                               the residual add, in place
+ *
+ * This is `dflash_conv -> add` and NOTHING ELSE. It exists because the unfused pair materialises
+ * an [T, n_embd] bf16 plane that the add reads back exactly once, and because the block issues
+ * that pair twice a layer, five layers deep (arch/common/rad_block_dflash2.h:1124-1126,
+ * :1151-1153).
+ *
+ * ============================== WHAT IT IS NOT ==============================
+ *
+ * NOT A TOLERANCE. The unfused pair rounds the convolution's f32 accumulator to bf16 and THEN
+ * adds, and that rounding is part of the function the model was trained with -- it is not
+ * intermediate precision a fusion may keep in f32 to be "more accurate". The kernel stores
+ * `to_bf16(to_f32(residual) + to_f32(to_bf16(acc)))`: two bf16 roundings, in the unfused order.
+ *
+ * NOT AN ATTENTION FUSION. The all-reduce that precedes it in the graph stays where it is: this op
+ * is issued only after the TP reduction, and it neither reads nor writes any collective.
+ *
+ * NOT A SECOND CONVOLUTION. taps 2 and group_size 16 are the DFlash2 geometry and the only one
+ * compiled; `rad_dflash_conv_add_args` refuses every other, and the row's constraints say so
+ * before selection rather than after it. There is no non-vector tail: hidden_size is a whole
+ * number of 8-channel lanes and a multiple of 64, which is the unfused row's own band.
+ *
+ * ============================== THE LAYOUT ==============================
+ *
+ * The ARITHMETIC is `libr4d/r4d_dflash_conv_body.h`'s, expression for expression: one lane owns
+ * eight contiguous channels, the group index -- and both delta scalars -- are uniform over that
+ * span because group_size 16 divides it, the position inside the draft block is `t % block_size`
+ * (wave-uniform, from grid.y), and tap `k` contributes only where that position is at least `k`.
+ * The loop STRUCTURE differs in one respect, recorded below: the shifted addresses are formed
+ * inside the tap predicate. That is an addressing difference, not an arithmetic one -- no operand
+ * value, operation or rounding changes -- and it has not been compiled, so it is not a claim about
+ * the resulting instruction stream.
+ *
+ * THE ROWS ARE PITCHED, AND SO IS THE OUTPUT. `x`, `residual` and `out` each carry their own
+ * row pitch, read off the operand: the add's call site hands the residual stream itself, and the
+ * convolution's hands a row range of the activation buffer. The delta operand is the SLICE of the
+ * [T, 2, taps, NG] kernel projection as issued -- its row pitch is 2*taps*NG, not taps*NG, which
+ * is a difference no shape check would catch and which silently reads the other half's
+ * coefficients.
+ *
+ * ============================== ALIASING AND `restrict` ==============================
+ *
+ * `out` MAY BE `residual`, as the SAME view (same base, same pitch): that is the in-place call
+ * arch/common/rad_block_dflash2.h:1126 issues. A partial overlap is refused, because a lane's
+ * store landing on another lane's unread residual is not ordered by anything.
+ *
+ * `out` MUST NOT overlap `x`, `delta` or `base`. That is the only property the kernel relies on:
+ * every read of those three happens before the store.
+ *
+ * THE DEVICE ARGUMENT STRUCT CARRIES NO `restrict` AT ALL. `restrict` promises pairwise
+ * disjointness among the qualified pointers, and the validation above proves only output-vs-input
+ * disjointness while explicitly allowing the in-place form -- so qualifying anything would be a
+ * promise the kernel breaks on its most common call. The alternative, proving all pairs disjoint,
+ * would forbid the in-place call the graph actually makes.
+ *
+ * The second tap's pointers (`xrow - tap*pitch`, and the base/delta rows) are formed ONLY on the
+ * rows where the tap fires, so row 0 never forms an address before its object.
+ *
+ * ============================== OWNERSHIP ==============================
+ *
+ * `base` is a WEIGHT operand, exactly as it is on `dflash_conv`: base_kernel is a checkpoint
+ * parameter and the role is what gives it a residency class. The two halves of the [2, taps,
+ * n_embd] tensor are two issues of the same op against `wrow_slice(...)`, and the op receives one
+ * row of that slice, contiguous.
+ *
+ * Nothing is allocated and nothing synchronises: one launch, one argument struct by value, and
+ * the only host work is the validation below, which dereferences no device memory. */
+enum {
+    RAD_DFLASH_CONV_ADD_X        = 0,
+    RAD_DFLASH_CONV_ADD_DELTA    = 1,
+    RAD_DFLASH_CONV_ADD_BASE     = 2,
+    RAD_DFLASH_CONV_ADD_RESIDUAL = 3,
+    RAD_DFLASH_CONV_ADD_OUT      = 4,
+    RAD_DFLASH_CONV_ADD_OPERANDS = 5
+};
+
+/* Validated, device-free view of one call. Shape, stride and alias checks only: nothing here
+ * dereferences a pointer, because at issue every operand is device memory. */
+struct RadDflashConvAddCall {
+    const void* x;
+    const void* delta;
+    const void* base;
+    const void* residual;
+    void*       out;
+    int64_t     rows;        /* the operand's rows, not the T band ceiling */
+    int64_t     H;           /* hidden_size */
+    int64_t     NG;          /* H / group_size */
+    int64_t     dpitch;      /* delta's row pitch: 2*taps*NG */
+    int64_t     x_pitch;     /* stride[0] of each activation row view */
+    int64_t     r_pitch;
+    int64_t     o_pitch;
+    int64_t     block_size;  /* the draft block: the position law is t % block_size */
+};
+
+int rad_dflash_conv_add_schema_count(void);
+const RadOpSchema* rad_dflash_conv_add_schema_at(int);
+int rad_dflash_conv_add_shape(const RadParam*, int, int, RadOpdDesc*);
+/* RAD_OK, or the reason this call is not the op: RAD_E_UNSUPPORTED outside taps 2 / group 16 /
+ * the declared width band, RAD_E_SHAPE for extents or pitches that disagree with the parameters,
+ * RAD_E_DTYPE for anything but bf16, RAD_E_ALIGN for a row the 16-byte loads cannot address, and
+ * RAD_E_INVAL for a required operand absent or an output aliasing the convolution's reads. */
+int rad_dflash_conv_add_args(const RadArgs*, RadDflashConvAddCall*);
+/* The declared chain -- `dflash_conv` then `add`. It is a DESCRIPTION of what this kernel
+ * computes, and it is not checkable by stock rad-kbench: that tool resolves each step inside the
+ * fused row's own plugin, and `mine` publishes no `dflash_conv` and no `add` row. Parity must be
+ * established by a comparator that names this row and each unfused reference row explicitly. */
+int rad_dflash_conv_add_fuse(const RadParam*, int, uint64_t, int, RadFuseStep*);
+RadKernelInfo rad_dflash_conv_add_row(RadLaunchFn);
+int rad_mine_dflash_conv_add_count(void);
+const RadKernelInfo* rad_mine_dflash_conv_add_at(int);
+
+#endif /* RAD_MINE_DFLASH_CONV_ADD_H */
diff --git a/mine/dflash_conv_add.hip b/mine/dflash_conv_add.hip
new file mode 100644
index 0000000000000000000000000000000000000000..46bd26e5d6b9ccee420c828f507d7dd56662528d
--- /dev/null
+++ b/mine/dflash_conv_add.hip
@@ -0,0 +1,189 @@
+/* dflash_conv_add.hip -- DFlash2's closing grouped convolution and its residual add, one launch.
+ * The definition of the fusion is mine/dflash_conv_add.h; this file is the device form.
+ *
+ * ============================== THE ARITHMETIC IS libr4d's ==============================
+ *
+ * The convolution below is `libr4d/r4d_dflash_conv_body.h`'s loop, and its primitives --
+ * `R4dV8`, `r4d_bf2f`, `r4d_f2bf` -- are that header's own, included rather than re-spelled. What
+ * is repeated is the loop structure, because the body stores its accumulator straight to `out` and
+ * this op has to keep the eight f32 values long enough to round them, read the residual, and round
+ * again. There is no way to redirect the body's store into a register block without pointing `out`
+ * at a per-lane buffer it computes the address of itself, and a wild pointer is not a saving.
+ *
+ * THE DUPLICATION IS NOT SELF-VERIFYING. The row declares `replaces` = dflash_conv -> add, and
+ * that declaration is not executable by stock rad-kbench -- the tool resolves every chain step
+ * inside the fused row's own plugin, and this plugin publishes neither of those rows. So nothing
+ * in this file's structure proves the loops agree: parity has to come from a comparator that
+ * selects this row by name and each unfused reference row (libr4d's `dflash_conv_t2_g16_bf16` and
+ * `add_bf16`) explicitly, on the same bytes, with zero tolerance. Until that runs, no parity claim
+ * rests on this file.
+ *
+ * ============================== TWO ROUNDINGS, IN THE UNFUSED ORDER ==============================
+ *
+ *     h2  = to_bf16(acc)                       <- the bf16 plane the pair materialises
+ *     out = to_bf16(to_f32(residual) + to_f32(h2))
+ *
+ * The second line is `add_bf16` (`binary_kernel` in libr4d/r4d_model_bf16.hip: read both in f32,
+ * add, round once) with `h2` already rounded. Carrying `acc` in f32 into the add instead would be
+ * a different function -- more accurate, and not the one the model was trained with.
+ *
+ * ============================== THE LAYOUT ==============================
+ *
+ * A lane owns eight contiguous channels: one dwordx4 load of `x`, of `base`, of the residual and
+ * one dwordx4 store. group_size 16 divides that span, so the group index and both delta scalars
+ * are uniform over the lane and are loaded once per row rather than per channel. The position
+ * inside the draft block is `t % block_size`, one scalar remainder per workgroup, and tap `k`
+ * contributes only where that position is at least `k` -- which is what keeps one sequence's
+ * block from convolving with the previous sequence's rows.
+ *
+ * EVERY ROW VIEW IS PITCHED: `x`, the residual and `out` arrive with their own row pitch, and the
+ * delta with the projection's (`2*taps*NG`, not the slice's `taps*NG`).
+ *
+ * NOTHING IS ALLOCATED AND NOTHING SYNCHRONISES: one launch, one argument struct by value.
+ */
+#include <hip/hip_runtime.h>
+
+#include "dflash_conv_add.h"
+#include "../libr4d/r4d_dflash_conv_body.h"
+
+namespace {
+
+constexpr int kThreads = 128;
+constexpr int kVec     = 8;
+
+/* The specialisation the row declares, as compile-time constants: `rad_dflash_conv_add_args` has
+ * already refused every other geometry, so the loop bounds are literal and the group index is a
+ * shift. */
+constexpr int kTaps  = 2;
+constexpr int kGroup = 16;
+
+struct Args {
+    /* NO `restrict` ON ANY OF THESE, AND THAT IS THE CONTRACT RATHER THAN AN OVERSIGHT.
+     *
+     * `restrict` promises no overlap with ANY other restrict-qualified pointer in the scope. The
+     * host validation proves only what this kernel actually needs: that the output is disjoint
+     * from `x`, `delta` and `base`, which is what makes "every read happens before the store"
+     * sufficient. It proves nothing about the reads aliasing EACH OTHER, and it deliberately
+     * permits `out == residual`, which is the in-place form rad_block_dflash2.h:1126 issues.
+     * Qualifying any member here would be a promise the kernel breaks on its most common call.
+     *
+     * The cost is a pointer kept live instead of a base+offset reconstruction, and it is not
+     * measured: no build was run. If a later code object shows it matters, the honest fix is to
+     * strengthen rad_dflash_conv_add_args to prove pairwise disjointness -- not to write
+     * `restrict` and hope. */
+    const r4d_u16* x;
+    const r4d_u16* delta;
+    const r4d_u16* base;
+    const r4d_u16* residual;
+    r4d_u16*       out;
+    int H, dpitch, NG, vpr, block_size;
+    int x_pitch, r_pitch, o_pitch;
+};
+
+__global__ __launch_bounds__(kThreads) void conv_add_kernel(Args a) {
+    const int hv = blockIdx.x * kThreads + threadIdx.x;
+    if (hv >= a.vpr) return;
+    const int t = blockIdx.y;
+    const int bpos = t % a.block_size;
+
+    /* Split every address into a wave-uniform pointer and a lane offset the backend can keep in a
+     * single 32-bit VGPR -- gfx12's saddr form. The mask is load-bearing: the backend only folds a
+     * lane offset into saddr when it can prove the byte-scaled offset stays inside 32 bits, and a
+     * lane index built from workgroup_id has no known bound. The same two rules the shared body
+     * states: pointer + offset, never a vector-typed array indexed by lane. */
+    const unsigned off = ((unsigned)hv & 0xFFFFFu) * (unsigned)kVec;
+    const unsigned g   = off / (unsigned)kGroup;
+
+    const r4d_u16* xrow = a.x + (long)t * a.x_pitch;
+    const r4d_u16* rrow = a.residual + (long)t * a.r_pitch;
+    r4d_u16*       orow = a.out + (long)t * a.o_pitch;
+    const r4d_u16* drow = a.delta + (long)t * a.dpitch;
+
+    R4dV8 x0; x0.v = *(const r4d_u32x4*)(xrow + off);
+    R4dV8 b0; b0.v = *(const r4d_u32x4*)(a.base + off);
+    const float d0 = r4d_bf2f(drow[g]);
+
+    float acc[kVec];
+#pragma unroll
+    for (int j = 0; j < kVec; ++j)
+        acc[j] = (r4d_bf2f(b0.h[j]) + d0) * r4d_bf2f(x0.h[j]);
+
+    /* Tap `k` contributes only where the position within the block is at least `k`. `bpos` and `t`
+     * are wave-uniform, so the predicate is a scalar branch and the shifted load is not issued on
+     * the rows it skips.
+     *
+     * THE SHIFTED POINTER IS FORMED INSIDE THE PREDICATE, unlike the shared body, which hoists it
+     * for saddr reasons. Hoisting computes `x - k*pitch` on row 0 of every sequence, i.e. an
+     * address before the object -- harmless in practice on this target, UB in the abstract, and
+     * refused here rather than rationalised. The same deferral applies to `btap`/`dtap`: they are
+     * in bounds (`base` is `taps*H` long, the delta row `taps*NG` wide) but forming them only on
+     * the taken path keeps one rule for all three. Whether the deferral costs the saddr fold is a
+     * question for a code object, and none was built. */
+#pragma unroll
+    for (int tap = 1; tap < kTaps; ++tap) {
+        if (bpos >= tap) {
+            const r4d_u16* xprev = xrow - (long)tap * a.x_pitch;
+            const r4d_u16* btap  = a.base + (long)tap * a.H;
+            const r4d_u16* dtap  = drow + (long)tap * a.NG;
+            R4dV8 xs; xs.v = *(const r4d_u32x4*)(xprev + off);
+            R4dV8 bt; bt.v = *(const r4d_u32x4*)(btap + off);
+            const float dt = r4d_bf2f(dtap[g]);
+#pragma unroll
+            for (int j = 0; j < kVec; ++j)
+                acc[j] += (r4d_bf2f(bt.h[j]) + dt) * r4d_bf2f(xs.h[j]);
+        }
+    }
+
+    /* THE TWO ROUNDINGS. `h2` is the value the unfused pair writes to memory; the add then reads
+     * it back as a bf16 and rounds the sum. The residual is loaded and consumed BEFORE the store,
+     * which is what makes `out == residual` an in-place update rather than a read of its own
+     * output -- and the reason neither pointer carries `restrict`. */
+    R4dV8 res; res.v = *(const r4d_u32x4*)(rrow + off);
+    R4dV8 o;
+#pragma unroll
+    for (int j = 0; j < kVec; ++j) {
+        const r4d_u16 h2 = r4d_f2bf(acc[j]);
+        o.h[j] = r4d_f2bf(r4d_bf2f(res.h[j]) + r4d_bf2f(h2));
+    }
+    *(r4d_u32x4*)(orow + off) = o.v;
+}
+
+}  /* namespace */
+
+/* The launch. `rad_dflash_conv_add_args` has already refused every geometry and every view this
+ * kernel was not given, so there is no second validation here and no path that computes
+ * something the oracle would not: either the call is the op or it returned a reason. */
+int rad_mine_dflash_conv_add_launch(const RadArgs* a, RadStream stream) {
+    RadDflashConvAddCall call{};
+    const int rc = rad_dflash_conv_add_args(a, &call);
+    if (rc != RAD_OK) return rc;
+
+    Args args{};
+    args.x        = static_cast<const r4d_u16*>(call.x);
+    args.delta    = static_cast<const r4d_u16*>(call.delta);
+    args.base     = static_cast<const r4d_u16*>(call.base);
+    args.residual = static_cast<const r4d_u16*>(call.residual);
+    args.out      = static_cast<r4d_u16*>(call.out);
+    args.H        = (int)call.H;
+    args.dpitch   = (int)call.dpitch;
+    args.NG       = (int)call.NG;
+    args.vpr      = (int)(call.H / kVec);
+    args.block_size = (int)call.block_size;
+    args.x_pitch  = (int)call.x_pitch;
+    args.r_pitch  = (int)call.r_pitch;
+    args.o_pitch  = (int)call.o_pitch;
+
+    const unsigned gx = (unsigned)((args.vpr + kThreads - 1) / kThreads);
+    const unsigned gy = (unsigned)call.rows;
+    void* kargs[] = { &args };
+    const hipError_t e = hipLaunchKernel((const void*)conv_add_kernel, dim3(gx, gy),
+                                         dim3(kThreads), kargs, 0, (hipStream_t)stream);
+    return e == hipSuccess ? RAD_OK : RAD_E_DEVICE;
+}
+
+int rad_mine_dflash_conv_add_count(void) { return 1; }
+
+const RadKernelInfo* rad_mine_dflash_conv_add_at(int i) {
+    static const RadKernelInfo row = rad_dflash_conv_add_row(rad_mine_dflash_conv_add_launch);
+    return i == 0 ? &row : nullptr;
+}
diff --git a/mine/dflash_gated_bf16.cpp b/mine/dflash_gated_bf16.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5779e32e772b26759ee560c8bc0762d5a62b0685
--- /dev/null
+++ b/mine/dflash_gated_bf16.cpp
@@ -0,0 +1,355 @@
+/* dflash_gated_bf16.cpp -- the schema, the host-side validation and the declared chain for
+ * DFlash2's BF16 gate/up projection with the SiLU-gated product fused into the epilogue.
+ *
+ * THIS FILE IS COMPILED INTO THE DEVICE PLUGIN ONLY. The host oracle for the unfused chain is
+ * libr4d's own `gemm_nt` and `silu_mul` rows, and libref's reference GEMM and elementwise kernels;
+ * duplicating them here would be a second reference a comparator could then pick between. What
+ * this file shares is the SCHEMA and the VALIDATION, so a device kernel that accepted a call the
+ * reference refuses is a divergence the comparator cannot see.
+ *
+ * THE PARAMETERS ARE `gemm_nt`'s, and that is deliberate: the fused op replaces one GEMM, so M, N
+ * and K keep their meanings and `N` is the gate_up width, 2 * n_ff. The output is half that wide.
+ * A caller porting a graph rewrites one op, not its arithmetic.
+ */
+#include "dflash_gated_bf16.h"
+
+#include <cstdint>
+#include <cstring>
+
+namespace {
+
+/* THE GEOMETRY THIS ROW IS COMPILED FOR, and every bound below has a reason rather than a
+ * measured number behind it:
+ *
+ *   kRowMax   64    the skinny arm's decode band. `gemm_bf16_nt_m64` itself serves M <= 65536,
+ *                   but this fusion holds TWO accumulator sets (gate AND up) live across the whole
+ *                   K loop, so it stays on the band the DFlash2 query pass actually runs --
+ *                   max_seqs * block, capped by the block the drafter declares. Above 64 rows the
+ *                   tiled arm would be the right shape and is NOT implemented; the op then has no
+ *                   row in that band, resolution fails closed, and the graph keeps the unfused
+ *                   pair.
+ *   kNMin     2048  the gate_up width that makes the split law answer SK == 1 by construction:
+ *                   the law takes the smallest split whose `n_tiles * SK` reaches 128, and
+ *                   2048/16 = 128 tiles already reaches it. SK != 1 would need a slice reduction
+ *                   this kernel does not have, and refusing it here keeps a geometry that would
+ *                   reorder the sum from ever reaching the launcher.
+ *   kNStep    32    N divisible by 32, so the OUTPUT width n = N/2 is a whole number of 16-column
+ *                   windows. A wave owns window t of the gate half and window t of the up half; a
+ *                   ragged n would make the last gate window overrun into the up half's rows and
+ *                   read the wrong weight rows. Every power-of-two n_ff meets this.
+ *   kAlign    16    every fragment load in the kernel is an 8- or 16-byte access, and the skinny
+ *                   bf16 row already requires 16-byte operands (r4d_gemm_args.h:387).
+ *   kOffMax   INT32_MAX  the kernel forms 32-BIT element offsets for both operands (`rowGo(K, ...)`
+ *                   for A and `woff_g + n*K` for W), formed as `unsigned` and added to a base
+ *                   pointer, so the largest legal product of two dimensions is 2^31-1 elements.
+ *                   The test divides instead of multiplying, so it cannot overflow itself. */
+constexpr int64_t kRowMax = 64;
+constexpr int64_t kNMin = 2048;
+constexpr int64_t kNStep = 32;
+constexpr int64_t kAlign = 16;
+/* The largest product of two dimensions this row accepts, in ELEMENTS. It is the kernel's own
+ * 32-bit offset limit; the shape below divides instead of multiplying so the test itself cannot
+ * overflow. */
+constexpr int64_t kOffMax = 2147483647;   /* INT32_MAX: a 32-bit element offset must be positive */
+
+/* `a * b <= kOffMax` WITHOUT EVER FORMING `a * b`. Both arguments are required positive. This is
+ * the only place the bound is decided, and both the call validator and the fuse hook use it, so a
+ * geometry the launcher would refuse is refused here too -- which is what makes a CPU-side
+ * boundary test exercise the real guard rather than a copy of it. */
+bool product_fits(long long a, long long b) {
+    if (a <= 0 || b <= 0) return false;
+    if (a > kOffMax || b > kOffMax) return false;
+    return b <= kOffMax / a;
+}
+
+/* Elements a tensor occupies, from its OWN shape and strides. Saturating: a span that would
+ * overflow returns INT64_MAX rather than a wrapped number, so an overlap test on a nonsense
+ * tensor refuses conservatively instead of reading as "no overlap". */
+int64_t span_elements(const RadTensor& t) {
+    int64_t e = 1;
+    for (uint32_t i = 0; i < t.rank; ++i) {
+        if (t.shape[i] <= 0 || t.stride[i] < 0) return INT64_MAX;
+        if (t.shape[i] == 1) continue;
+        if (t.stride[i] != 0 && (t.shape[i] - 1) > (INT64_MAX - e) / t.stride[i])
+            return INT64_MAX;
+        e += (t.shape[i] - 1) * t.stride[i];
+    }
+    return e;
+}
+
+/* Byte spans overlap? Both operands are bf16, so the multiplier is 2 either side and cancels. An
+ * unknown span (INT64_MAX, saturated above) is treated as overlapping: the caller refuses. */
+bool overlaps(const RadTensor& a, const RadTensor& b) {
+    if (!a.data || !b.data) return false;
+    const int64_t ea = span_elements(a), eb = span_elements(b);
+    if (ea <= 0 || eb <= 0) return true;
+    const uintptr_t x = (uintptr_t)a.data, y = (uintptr_t)b.data;
+    const uint64_t xa = (uint64_t)ea * 2u, xb = (uint64_t)eb * 2u;
+    return x < y + xb && y < x + xa;
+}
+
+static_assert(RAD_DFLASH_GATED_OPERANDS == 3, "the schema below lists three operands");
+
+}  /* namespace */
+
+int rad_dflash_gated_bf16_schema_count(void) { return 1; }
+
+/* ---- schema ---------------------------------------------------------------------------------- */
+#define P_INT(k)  { k, RAD_P_INT, RAD_REQUIRED, 0 }
+#define P_STR(k)  { k, RAD_P_STR, RAD_REQUIRED, 0 }
+#define IN(n)     { n, RAD_OPD_IN,  0 }
+#define WGT(n)    { n, RAD_OPD_WEIGHT, 0 }
+#define OUT(n)    { n, RAD_OPD_OUT, 0 }
+
+static const RadParamSpec kParams[] = {
+    P_INT("M"), P_INT("N"), P_INT("K"), P_STR("dtype"),
+};
+/* THE OPERAND ORDER IS `gemm_nt`'s, with `y` half as wide. `b` is the WEIGHT role, not an input:
+ * issue resolves the handle and waits on the mover for a weight, and reads a plain operand's
+ * buffer. */
+static const RadOperandSpec kOperands[] = { IN("a"), WGT("b"), OUT("y") };
+static const RadOpSchema kSchema = {
+    "dflash_gated_bf16", kParams, (int)(sizeof(kParams) / sizeof(kParams[0])),
+    kOperands, (int)(sizeof(kOperands) / sizeof(kOperands[0])),
+    "y[m,i] = bf16(silu(bf16(c[m,i])) * bf16(c[m,n+i])), c = A @ W^T over the whole [2n, K] "
+    "gate_up weight in one fp32 accumulation, with the gate half first. Both intermediate "
+    "roundings the unfused `gemm_nt` -> `silu_mul` pair performs are kept; nothing is quantised."
+};
+#undef P_INT
+#undef P_STR
+#undef IN
+#undef WGT
+#undef OUT
+
+const RadOpSchema* rad_dflash_gated_bf16_schema_at(int i) { return i == 0 ? &kSchema : nullptr; }
+
+/* ---- operand description --------------------------------------------------------------------- */
+/* `M` is the band ceiling and each operand names the call, exactly as hc_mean's hook does: a tool
+ * sizing from this gets the band, and a launch reads the rows from the tensor. */
+int rad_dflash_gated_bf16_shape(const RadParam* p, int n_p, int operand, RadOpdDesc* out) {
+    if (!out || operand < 0 || operand >= RAD_DFLASH_GATED_OPERANDS) return RAD_E_INVAL;
+    const int64_t M = rad_param_getdim(p, n_p, "M", 0);
+    const int64_t N = rad_param_getdim(p, n_p, "N", 0);
+    const int64_t K = rad_param_getdim(p, n_p, "K", 0);
+    if (M <= 0 || N <= 0 || K <= 0 || (N & 1)) return RAD_E_UNSUPPORTED;
+    /* A derived extent this hook hands out is a product the caller will allocate from, so an
+     * over-large one is refused HERE rather than described and then refused at issue: a tool that
+     * sized a buffer from `N * K` and then got RAD_E_SHAPE would have allocated on a bogus
+     * number. `M * K`, `N * K` and `M * N` are the three products the operands imply. */
+    if (!product_fits(M, K) || !product_fits(N, K) || !product_fits(M, N))
+        return RAD_E_UNSUPPORTED;
+    RadOpdDesc d{};
+    d.dtype = RAD_BF16;
+    d.rank = 2;
+    d.shape[0] = M;
+    d.shape[1] = operand == RAD_DFLASH_GATED_Y ? N / 2 : K;
+    /* The weight's rows are the gate_up plane, not the output width. */
+    if (operand == RAD_DFLASH_GATED_B) d.shape[0] = N;
+    d.fill = (uint32_t)RAD_FILL_NORMAL;
+    d.idx_const = -1;
+    *out = d;
+    return RAD_OK;
+}
+
+/* ---- the call ---------------------------------------------------------------------------------- */
+int rad_dflash_gated_bf16_args(const RadArgs* a, RadDflashGatedCall* call) {
+    if (!a || !call || !a->t || a->n_t != RAD_DFLASH_GATED_OPERANDS) return RAD_E_INVAL;
+    const RadTensor& x = a->t[RAD_DFLASH_GATED_A];
+    const RadTensor& w = a->t[RAD_DFLASH_GATED_B];
+    const RadTensor& y = a->t[RAD_DFLASH_GATED_Y];
+    if (!x.data || !w.data || !y.data) return RAD_E_INVAL;
+
+    const int64_t N = rad_param_getdim(a->p, a->n_p, "N", 0);
+    const int64_t K = rad_param_getdim(a->p, a->n_p, "K", 0);
+    if (N <= 0 || K <= 0 || (N & 1)) return RAD_E_SHAPE;
+    const int64_t n = N / 2;
+
+    /* THE 32-BIT OFFSET BOUND COMES FIRST, before any product is formed or any tensor extent is
+     * read. The kernel addresses both operands with 32-bit element offsets, so `M*K`, `N*K` and
+     * the weight extent are only meaningful -- and only computable without overflow -- under this
+     * bound. Deciding it here, and not in the launcher, is what makes the CPU-side boundary check
+     * exercise the real guard; the launcher carries no second copy of it because one would be
+     * dead code after this. */
+    if (!product_fits(N, K)) return RAD_E_SHAPE;
+
+    /* A STRING SPELLING IS ACCEPTED for the reason hc_mean accepts one: a checker reaching the
+     * launch without a declare in front of it. */
+    const char* dt = rad_param_gets(a->p, a->n_p, "dtype", "bf16");
+    if (!dt || std::strcmp(dt, "bf16") != 0) return RAD_E_DTYPE;
+    if (x.dtype != RAD_BF16 || w.dtype != RAD_BF16 || y.dtype != RAD_BF16) return RAD_E_DTYPE;
+
+    if (x.rank != 2 || y.rank != 2) return RAD_E_UNSUPPORTED;
+    if (N < kNMin || (N % kNStep) != 0 || (K % 16) != 0) return RAD_E_UNSUPPORTED;
+
+    /* Rows are the OPERAND's and `M` is only the ceiling: a decode step presents one sequence's
+     * block out of a max_tok arena, and reading `M` as the count walks rows nobody wrote. `rows`
+     * is bounded by kRowMax below, which is what makes `rows * K` a safe product. */
+    const int64_t rows = x.shape[0];
+    const int64_t band = rad_param_getdim(a->p, a->n_p, "M", 0);
+    if (rows <= 0 || (band > 0 && rows > band) || rows > kRowMax) return RAD_E_SHAPE;
+    /* A's own offsets are `row * K + col`, so its extent is bounded by `rows * K`. */
+    if (!product_fits(rows, K)) return RAD_E_SHAPE;
+    if (x.shape[1] != K || y.shape[0] != rows || y.shape[1] != n) return RAD_E_SHAPE;
+    /* The weight is an opaque plane to libr4d's shims and is checked here only for extent: the
+     * layout hook that would interpret a quantised encoding does not exist on this row, and the
+     * dtype check above already refused anything but a plain bf16 plane. `N * K` is safe to form
+     * under product_fits above, and the span saturates rather than wrapping. */
+    const int64_t w_need = N * K;
+    if (span_elements(w) < w_need) return RAD_E_SHAPE;
+
+    if (!rad_tensor_is_contiguous(&x) || !rad_tensor_is_contiguous(&w) ||
+        !rad_tensor_is_contiguous(&y))
+        return RAD_E_STRIDE;
+
+    /* Every fragment address is `base + 16-byte-aligned offset`; the kernel does not check, so the
+     * shim is where it is checked. */
+    if (((uintptr_t)x.data & (kAlign - 1)) || ((uintptr_t)w.data & (kAlign - 1)) ||
+        ((uintptr_t)y.data & (kAlign - 1)))
+        return RAD_E_ALIGN;
+    /* `__restrict__` is on all three pointers in the kernel, so no two operands may overlap --
+     * not just the output against its inputs. An `a`/`w` overlap would be aliasing UB that no
+     * output comparison could attribute. */
+    if (overlaps(x, y) || overlaps(w, y) || overlaps(x, w)) return RAD_E_INVAL;
+
+    call->a = x.data;
+    call->w = w.data;
+    call->y = y.data;
+    call->M = rows;
+    call->K = K;
+    call->N = N;
+    call->n = n;
+    return RAD_OK;
+}
+
+/* ---- the declared chain ------------------------------------------------------------------------ */
+/* `gemm_nt` into a temporary, then `silu_mul` over it at half the width. The temporary is the
+ * [M, 2n] bf16 plane the unfused pair writes, so the chain describes exactly the two launches this
+ * one replaces -- including the rounding both of them perform on it.
+ *
+ * A STEP'S `M` IS MIRRORED VERBATIM, kind and all, for the reason libr4d's own Step::mirror gives
+ * (r4d_fuse.cpp:172-180): `M` is the RANGED parameter of every op in this vocabulary, and
+ * re-emitting a range as its collapsed high bound would hand the step a different BAND from the
+ * one the fused kernel was selected for -- which for a banded GEMM family is a different kernel
+ * with a different summation order. `N` and `K` are fixed values in both ops and are emitted as
+ * the ints they are; `silu_mul`'s `n` is the fused `N / 2`, which is what makes the second step's
+ * width the output's.
+ *
+ * NOT CHECKABLE BY STOCK rad-kbench: tools/rad_kbench.cpp:2682-2686 resolves every step inside the
+ * FUSED ROW'S OWN PLUGIN, and `mine` publishes neither `gemm_nt` nor `silu_mul`. The declaration is
+ * still the honest description of the arithmetic; parity is the comparator's job. */
+namespace {
+
+RadParam pint(const char* k, long long v) {
+    RadParam p{};
+    p.key = k; p.kind = RAD_P_INT; p.ival = v;
+    return p;
+}
+RadParam pstr(const char* k, const char* v) {
+    RadParam p{};
+    p.key = k; p.kind = RAD_P_STR; p.sval = v;
+    return p;
+}
+
+/* Copy a parameter of the fused op VERBATIM, kind and all, so a range stays a range. Bounded: a
+ * step whose list overflows is a drift error, not something to write past. */
+bool mirror(const RadParam* p, int n_p, const char* key, RadParam* dst) {
+    const RadParam* f = rad_param_find(p, n_p, key);
+    if (!f) return false;
+    *dst = *f;
+    return true;
+}
+
+/* One entry per operand of the STEP op, in its schema's order. */
+bool wire(RadFuseStep* s, const int16_t* from, int n) {
+    if (n > RAD_MAX_FUSE_OPD) return false;
+    for (int i = 0; i < n; ++i) s->from[i] = from[i];
+    s->n_from = n;
+    return true;
+}
+
+}  /* namespace */
+
+int rad_dflash_gated_bf16_fuse(const RadParam* p, int n_p, uint64_t present, int step,
+                               RadFuseStep* out) {
+    (void)present;   /* every operand is required in both ops, so presence cannot change the chain */
+    if (!out) return RAD_E_INVAL;
+    const int64_t M = rad_param_getdim(p, n_p, "M", 0);
+    const int64_t N = rad_param_getdim(p, n_p, "N", 0);
+    const int64_t K = rad_param_getdim(p, n_p, "K", 0);
+    const char* dt = rad_param_gets(p, n_p, "dtype", 0);
+    if (M <= 0 || N <= 0 || K <= 0 || (N & 1)) return RAD_E_UNSUPPORTED;
+    if (!dt || std::strcmp(dt, "bf16") != 0) return RAD_E_UNSUPPORTED;
+    /* A step built at a geometry the step op cannot serve would resolve to nothing and read as
+     * "this fusion has no equivalent", which is a different claim from "not at this shape". The
+     * products are refused WITHOUT being formed, for the same reason the call validator does:
+     * `N * K` on an extreme geometry is an overflow, not a large number. */
+    if (!product_fits(M, K) || !product_fits(N, K) || !product_fits(M, N))
+        return RAD_E_UNSUPPORTED;
+    if (N < kNMin || (N % kNStep) != 0 || (K % 16) != 0 || M > kRowMax) return RAD_E_UNSUPPORTED;
+
+    switch (step) {
+    case 0: {
+        /* The GEMM over the whole [N, K] gate_up plane, into the bf16 that the fold never
+         * materialises. */
+        *out = RadFuseStep{};
+        out->op = "gemm_nt";
+        if (!mirror(p, n_p, "M", &out->p[out->n_p])) return RAD_E_UNSUPPORTED;
+        ++out->n_p;
+        out->p[out->n_p++] = pint("N", (long long)N);
+        out->p[out->n_p++] = pint("K", (long long)K);
+        out->p[out->n_p++] = pstr("dtype", "bf16");
+        const int16_t w[] = { RAD_DFLASH_GATED_A, RAD_DFLASH_GATED_B, RAD_FUSE_TMP(0) };
+        return wire(out, w, 3) ? RAD_OK : RAD_E_INVAL;
+    }
+    case 1: {
+        /* The gate, the multiply and the store over the accumulator plane, at half its width. */
+        *out = RadFuseStep{};
+        out->op = "silu_mul";
+        if (!mirror(p, n_p, "M", &out->p[out->n_p])) return RAD_E_UNSUPPORTED;
+        ++out->n_p;
+        out->p[out->n_p++] = pint("n", (long long)(N / 2));
+        out->p[out->n_p++] = pstr("dtype", "bf16");
+        const int16_t w[] = { RAD_FUSE_TMP(0), RAD_DFLASH_GATED_Y };
+        return wire(out, w, 2) ? RAD_OK : RAD_E_INVAL;
+    }
+    default:
+        return RAD_E_NOTFOUND;
+    }
+}
+
+/* ---- the row ----------------------------------------------------------------------------------- */
+/* THE CONSTRAINTS ARE THE SPECIALISATION, stated so selection never has to find out the hard way.
+ * `N >= 2048` is what makes the split law answer SK == 1, which is the condition under which this
+ * kernel's accumulation is the unfused GEMM's own; a narrower gate_up would need a slice reduction
+ * and is declined rather than served differently. `N % 32 == 0` is what makes the output width a
+ * whole number of 16-column windows, which is how the gate and up halves are paired. `M <= 64` is
+ * the skinny arm: above it the tiled arm would be the right shape and this row has no kernel for
+ * it, so that band resolves to nothing and the graph keeps the pair. */
+static const RadConstraint kConstraints[] = {
+    RAD_CGE("M", 1),
+    RAD_CLE("M", kRowMax),
+    RAD_CDIV("K", 16),
+    RAD_CGE("N", kNMin),
+    RAD_CDIV("N", kNStep),
+    RAD_CIN("dtype", "bf16"),
+};
+
+RadKernelInfo rad_dflash_gated_bf16_row(RadLaunchFn launch) {
+    RadKernelInfo r{};
+    r.name = "mine_dflash_gated_bf16";
+    r.op = kSchema.op;
+    r.family = "gemm";
+    r.computes = kSchema.doc;
+    r.shape = "bf16 A/W, gate_up N = 2*n with the gate half first; M <= 64, N >= 2048 and a "
+              "multiple of 32, K a multiple of 16; SK == 1 by construction, so no cross-slice "
+              "reduction exists";
+    r.dtypes = "bf16 in, bf16 out; fp32 accumulate, two bf16 roundings kept";
+    r.domain = RAD_DOMAIN_DEVICE;
+    r.priority = 100;
+    r.constraints = kConstraints;
+    r.n_constraints = (int)(sizeof(kConstraints) / sizeof(kConstraints[0]));
+    r.launch = launch;
+    r.opd_shape = rad_dflash_gated_bf16_shape;
+    r.replaces = rad_dflash_gated_bf16_fuse;
+    return r;
+}
diff --git a/mine/dflash_gated_bf16.h b/mine/dflash_gated_bf16.h
new file mode 100644
index 0000000000000000000000000000000000000000..437c100dc10a65ed6477ef313aee9215017e877c
--- /dev/null
+++ b/mine/dflash_gated_bf16.h
@@ -0,0 +1,145 @@
+#ifndef RAD_MINE_DFLASH_GATED_BF16_H
+#define RAD_MINE_DFLASH_GATED_BF16_H
+
+#include "rad_plugin.h"
+#include <stdint.h>
+
+/* dflash_gated_bf16 -- DFlash2's BF16 gate/up projection with the SiLU-gated product fused into
+ * the GEMM's epilogue: one launch where the bf16 graph runs `gemm_nt` then `silu_mul`.
+ *
+ * ============================== WHY THIS IS NOT THE FP8 FOLD ==============================
+ *
+ * libr4d already has a gated projection, `gemm_nt_q_gated` (r4d_gemm_fp8a8.hip:1560-1660), and it
+ * is not usable here for the reason rad_block_dflash2.h:831 states: its whole purpose is to write
+ * the QUANTISED product, so its epilogue ends in a quantiser and its operands are the E4M3 pair.
+ * A bf16 down projection reads a bf16 [T, n_ff] plane. The two ops share a shape and nothing else.
+ *
+ * ============================== THE NUMERICS, WHICH ARE THE CONTRACT ==============================
+ *
+ * The unfused pair this stands in for, at the drafter's geometry:
+ *
+ *   gemm_nt   C[M, 2n] = A[M, K] @ W[2n, K]^T, fp32 accumulate, store `(__hip_bfloat16)v`
+ *   silu_mul  y[m, i] = f32_to_bf16((g / (1 + expf(-g))) * u),
+ *             g = bf2f(C[m, i]), u = bf2f(C[m, n + i])
+ *
+ * so the gate and the up arm are EACH ROUNDED TO BF16 before the activation touches them. The
+ * fold keeps both roundings: `narrow_bf16` in the .hip is exactly the GEMM store's own
+ * `(__hip_bfloat16)v` followed by the exact widening back (every bf16 is a float, so that half is
+ * a shift), and only then is the SiLU evaluated -- in f32, with the same
+ * `g / (1.0f + expf(-g))` spelling and the same `f32_to_bf16` store as silu_mul_kernel
+ * (r4d_model_bf16.hip:498-508). Removing either rounding would be a different function, not a
+ * faster one.
+ *
+ * ============================== WHY THE ACCUMULATION ORDER IS UNCHANGED ============================
+ *
+ * The BF16 GEMM dispatch is read off the tree, not assumed, and it is THREE rows for one op:
+ *
+ *   M <= 16        gemm_bf16_nt_m16   (r4d_rows.cpp:4099) -- a forwarding row
+ *   17 <= M <= 64  gemm_bf16_nt_m64   (r4d_rows.cpp:4108)
+ *   M >= 65        gemm_bf16_nt_tiled (r4d_rows.cpp:4117)
+ *
+ * `m16` forwards to `m64` (r4d_gemm_bf16_nt_m16.hip:19-21), and `tiled` is documented and built
+ * to be BYTE-IDENTICAL to `m64` -- same WMMA sequence, same split count, slices summed in the same
+ * order from 0.f (r4d_gemm_bf16_nt_tiled.hip:16-27, r4d_rows.cpp:4120-4122). So ONE accumulation
+ * law covers the whole band IN ITS UNTUNED FORM, and it is: for each output element, K is cut into
+ * SK slices; within a slice the 16-wide k steps run ASCENDING into the WMMA accumulator; the
+ * slices are then summed ASCENDING from 0.f.
+ *
+ * THE FUSION DOES NOT TOUCH THAT LAW. An output element's sum depends only on its own row, column
+ * and the K loop -- never on which wave or block computes it, nor on how N is tiled. What this
+ * kernel changes is WHICH COLUMNS a wave owns: it owns gate column-window t and up column-window t
+ * together (the two are `n_ff/16` tiles apart in the stored [2*n_ff, K] gate_up weight), so the
+ * product closes in registers instead of through a [M, 2*n_ff] global plane. No reduction tree,
+ * no slice partition and no rounding boundary moves.
+ *
+ * ============================== SK == 1, THE SHAPE'S OWN ANSWER ==============================
+ *
+ * The split law is `pick_sk_for(n_tiles, K, unit, wv, bound)` (r4d_gemm_args.h:150-159): the
+ * SMALLEST split whose `n_tiles * sk` reaches kFlatTileTarget = 128. This op's N is the gate_up
+ * width, 2 * n_ff, which for this checkpoint (intermediate_size 7680) is 15360 at TP1, 7680 at TP2
+ * and 3840 at TP4 -- 960, 480 and 240 N tiles, all far past the target -- so the law answers
+ * SK = 1. That is the same answer the unfused `gemm_nt` gets at the same shape, which is what
+ * keeps the two byte-identical.
+ *
+ * At SK = 1 the m64 kernel says it outright: "there is nothing to reduce: lane already holds the
+ * finished value" (r4d_gemm_bf16_nt_m64.hip:136). This kernel serves exactly that. The row's
+ * `N >= 2048` constraint makes SK = 1 unreachable-otherwise inside the declared band (2048/16 =
+ * 128 tiles, which already meets the target at sk = 1 for any K divisible by 16).
+ *
+ * ============================== THE SUPPORTED REFERENCE BASELINE ==============================
+ *
+ * `UNTUNED SK == 1 ONLY`, and this is the one place the fusion is narrower than the op it stands
+ * in for. The baseline reads a tuned `sk` when the tune cache has one for THIS kernel at this
+ * geometry (`r4d_gemm_args.h:272-275`: `c->sk > 0 ? c->sk : ...`), and `r4d_tune_valid_gemm`
+ * admits any legal split (`r4d_rows.cpp:2978-2986`). A tuned `sk >= 2` sums its slices in a
+ * different tree, so a candidate fixed at SK = 1 is not byte-identical to THAT baseline.
+ *
+ * THE REFUSAL IS DEFENSIVE, NOT A FALLBACK. `rad_dflash_gated_bf16_args` and the launcher reject a
+ * pinned `sk > 1` with `RAD_E_UNSUPPORTED`, but a refusal at issue is only a failed step: it does
+ * NOT un-resolve the op and does NOT emit the unfused pair. Fusion here is a DECLARE-time
+ * selection (spec §2.3): the architecture asks for the fused op, and if nothing serves it, it
+ * emits the pair itself. Also, the baseline's `gemm_nt` tune-cache row is keyed on the KERNEL,
+ * the PLUGIN and the geometry, so it is NOT inherited by this op's key and a `sk` from the
+ * baseline row never reaches this launcher automatically.
+ *
+ * SO A FUTURE GRAPH INTEGRATION MUST ESTABLISH, BEFORE ISSUE, ONE OF TWO THINGS:
+ *   (a) the unfused `gemm_nt` at this geometry actually selects `sk == 1` (untuned, or an
+ *       explicit `sk=1` pin in the reference deployment's cache); or
+ *   (b) the original unfused pair is kept for that deployment.
+ * The issue-time refusal is the last guard against a mismatch, not the mechanism that produces
+ * the fallback. `wv`, `mb` and `nt` are fine to pin: they move which block owns an element or the
+ * load hint, never what it adds (`r4d_gemm_args.h:203-205`, and BR_FLAT makes `bound` ignore MB so
+ * the split law answers the same). This row declares no tunable axes of its own.
+ *
+ * CONSEQUENCE FOR THE COMPARATOR: the reference arm must be run UNTUNED, or with `sk=1` pinned
+ * explicitly. A reference run against a cache holding `sk>=2` at this shape is a different
+ * baseline and must be reported as such, not as a candidate failure.
+ *
+ * ============================== WHAT IT DOES NOT DO ==============================
+ *
+ * No quantiser, no scale plane, no int8, no head, no all-reduce, no allocation, no synchronisation
+ * and no persistent state. The output is [M, n] bf16 with n = N/2, written straight from
+ * registers. Nothing is in place: `y` may not alias `a`.
+ *
+ * The declared chain (`gemm_nt` then `silu_mul`) is a DESCRIPTION. It is not executable by stock
+ * rad-kbench, whose chain resolver looks every step up inside the fused row's own plugin
+ * (tools/rad_kbench.cpp:2682-2686) and `mine` publishes neither `gemm_nt` nor `silu_mul`.
+ * Parity has to be established by a comparator that names this row and each unfused libr4d
+ * reference row explicitly. */
+enum {
+    RAD_DFLASH_GATED_A = 0,
+    RAD_DFLASH_GATED_B = 1,
+    RAD_DFLASH_GATED_Y = 2,
+    RAD_DFLASH_GATED_OPERANDS = 3
+};
+
+/* Validated, device-free view of one call. Shape, dtype and alias checks only: nothing here
+ * dereferences a pointer, because at issue every operand is device memory. */
+struct RadDflashGatedCall {
+    const void* a;
+    const void* w;
+    void*       y;
+    int64_t     M;      /* the activation's rows, not the M band ceiling */
+    int64_t     K;      /* n_embd */
+    int64_t     N;      /* the gate_up width, 2 * n_ff */
+    int64_t     n;      /* N / 2, the output width */
+};
+
+int                 rad_dflash_gated_bf16_schema_count(void);
+const RadOpSchema*  rad_dflash_gated_bf16_schema_at(int);
+int                 rad_dflash_gated_bf16_shape(const RadParam*, int, int, RadOpdDesc*);
+/* RAD_OK, or the reason this call is not the op: RAD_E_UNSUPPORTED outside the declared geometry,
+ * RAD_E_SHAPE for extents that disagree with the parameters, RAD_E_DTYPE for anything but bf16,
+ * RAD_E_STRIDE for a non-contiguous operand, RAD_E_ALIGN for a pointer the fragment loads cannot
+ * address, and RAD_E_INVAL for a required operand absent or an output aliasing an input. */
+int                 rad_dflash_gated_bf16_args(const RadArgs*, RadDflashGatedCall*);
+/* The declared chain: `gemm_nt` into a temporary, then `silu_mul` over it at half the width. */
+int                 rad_dflash_gated_bf16_fuse(const RadParam*, int, uint64_t, int, RadFuseStep*);
+RadKernelInfo       rad_dflash_gated_bf16_row(RadLaunchFn);
+int                 rad_mine_dflash_gated_bf16_count(void);
+const RadKernelInfo* rad_mine_dflash_gated_bf16_at(int);
+/* The launch entry point. Declared here so the .hip can define the row from it and so the
+ * registration site has one name to read; it is not part of what `rows.cpp` wire-up needs. */
+int                 rad_mine_dflash_gated_bf16_launch(const RadArgs*, RadStream);
+
+#endif /* RAD_MINE_DFLASH_GATED_BF16_H */
