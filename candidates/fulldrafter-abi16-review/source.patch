+                {"context_features_dim",7680},{"target_width",2560},{"proposal_length",8},
+                {"context_window",0},{"active_vocab",248077},{"vocab_size",248320},
+                {"conv_kernel_size",2},{"conv_group_size",16},{"selector_rank",256},
