+        s.nodes=take(4*cap);s.idx=take(3*cap);s.front=take(2*frontier);
+    }
+    s.total=p;return s;
+}
+int64_t rad_dloop_full_scratch_elements(const RadDLoopFullConfig& c,int op) {
+    if(op<0||op>=RAD_DLOOP_FULL_OPS)return 0;
