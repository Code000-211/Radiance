+            if(threadIdx.x<step&&better(bval[threadIdx.x+step],bidx[threadIdx.x+step],bval[threadIdx.x],bidx[threadIdx.x])) {
+                bval[threadIdx.x]=bval[threadIdx.x+step];bidx[threadIdx.x]=bidx[threadIdx.x+step];
+            }
