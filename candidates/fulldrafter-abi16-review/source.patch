+    for (const StepEntry& e : p.e) {
+        if (e.is_prefill || !e.produces_token || e.n_spec <= 0 || e.n_tokens != e.n_spec + 1)
+            return 0;
+        if (arm == 0) arm = e.n_spec;
+        else if (arm != e.n_spec) return 0;
+    }
+    return arm;
