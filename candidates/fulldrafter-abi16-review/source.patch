+    float val[8]={0,-1000,-0.5f,-INFINITY,-INFINITY,-INFINITY,-INFINITY,-INFINITY};
+    require(rad_mtp_couple_build_q(ids,val,V,&q) && q.count==2 && q.ids[0]==2 && q.ids[1]==4 &&
