+    def predict_next(self, context: list[int]) -> int:
+        h = self.seed
+        for tok in context:
+            h = (h ^ (tok + 0x9E3779B97F4A7C15 + ((h << 6) & 0xFFFFFFFFFFFFFFFF) + (h >> 2))) & 0xFFFFFFFFFFFFFFFF
+        return h % self.vocab_size
+
