+const RadFileEntry* Checkpoint::container_entry(const std::string& n) const {
+    return kind_ == Container ? container_.find(n) : nullptr;
+}
+
+void Checkpoint::write_metadata(RadWriter& w, const RadFile* prior) const {
+    const RadModelMeta& m = meta_.m;
+    /* THE TYPED FIELDS FIRST: these are what the engine sizes a graph from, and they are written
+     * as their own row types. A fresh convert and an extension write them the same way. */
+    w.meta_i("n_layers",        m.n_layers);
+    w.meta_i("n_embd",          m.n_embd);
+    w.meta_i("n_head",          m.n_head);
+    w.meta_i("n_head_kv",       m.n_head_kv);
+    w.meta_i("head_dim",        m.head_dim);
+    w.meta_i("n_ff",            m.n_ff);
+    w.meta_i("n_vocab",         m.n_vocab);
+    w.meta_i("n_ctx_train",     m.n_ctx_train);
+    w.meta_i("n_expert",        m.n_expert);
+    w.meta_i("n_expert_used",   m.n_expert_used);
+    w.meta_i("n_expert_shared", m.n_expert_shared);
+    w.meta_f("rms_eps",         m.rms_eps);
+    w.meta_f("rope_theta",      m.rope_theta);
+    w.meta_f("rope_scale",      m.rope_scale);
+
+    /* THEN THE FREE-FORM ROWS. `MetaOwn` holds every value as text, whatever the source stated,
+     * so the row type is decided here: the one `prior` holds that key as, else string. The VALUE
+     * is the text this checkpoint produced -- `open_container` writes %.17g for an F64, which is
+     * exact for a double, and strtod/strtoll read it back to the same number. */
+    auto prior_row = [prior](const char* k) -> const RadFileKV* {
+        if (!prior) return nullptr;
+        for (int64_t i = 0; i < prior->meta_count(); ++i) {
+            const RadFileKV& kv = prior->meta_at(i);
+            if (std::strcmp(prior->str(kv.key), k) == 0) return &kv;
+        }
+        return nullptr;
+    };
+    for (int i = 0; i < m.n_kv; ++i) {
+        const char* k = m.kv_key[i];
+        const char* v = m.kv_val[i];
+        const RadFileKV* row = prior_row(k);
+        if (row && row->type == RAD_P_INT) {
+            w.meta_i(k, std::strtoll(v, nullptr, 0));
+        } else if (row && row->type == RAD_KV_F64) {
+            w.meta_f(k, std::strtod(v, nullptr));
+        } else {
+            w.meta_s(k, v);
+        }
+    }
+}
+
+int Checkpoint::add_tensors(const std::string& path, const std::string& prefix) {
+    if (kind_ == Gguf || kind_ == None) {
+        RAD_ERR("a tensor file is merged into a safetensors or container namespace; %s is not one",
+                path_.c_str());
+        return RAD_E_UNSUPPORTED;
+    }
+    std::vector<std::string> added;
+    shards_.push_back(std::make_unique<SafeTensorsFile>());
+    RAD_TRY(shards_.back()->open(path));
+    for (const auto& t : shards_.back()->tensors()) {
+        const std::string name = prefix + t.name;
+        /* A CONTAINER ENTRY OWNS ITS NAME even though it is not a SrcTensor: ckpt_resolve answers
+         * a container name from the entry first, so a merged tensor of that name would be
+         * silently unreachable -- the operator believes a file replaced a head and it did not. */
+        if (index_.count(name) || (kind_ == Container && container_.find(name))) {
+            RAD_ERR("%s: '%s' would be merged as '%s', and that name is already taken. Two "
+                    "sources cannot both own one weight.", path.c_str(), t.name.c_str(),
+                    name.c_str());
+            return RAD_E_DUPLICATE;
+        }
+        if (t.dtype == RAD_DT_INVALID) {
+            RAD_ERR("%s: '%s' has dtype %s, which has no RAD equivalent", path.c_str(),
+                    t.name.c_str(), t.dtype_str.c_str());
+            return RAD_E_DTYPE;
+        }
+        SrcTensor s;
+        s.name      = name;
+        s.rad_dtype = t.dtype;
+        s.shape     = t.shape;
+        s.data      = t.data;
+        s.bytes     = (int64_t)t.bytes;
+        index_.emplace(s.name, tensors_.size());
+        tensors_.push_back(std::move(s));
+        added.push_back(name);
+    }
+    if (added.empty()) {
+        RAD_ERR("%s holds no tensors", path.c_str());
+        return RAD_E_FORMAT;
+    }
+    merged_.insert(merged_.end(), added.begin(), added.end());
+    return RAD_OK;
+}
