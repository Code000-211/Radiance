+        const int slot = sched.by_id_.at(7201); auto& s = *sched.reqs_[slot];
+        s.running = true; s.req->state = ReqState::Running; s.entry = 0;
+        s.entry_next = pipeline == 2 ? 0 : -1;
+        sched.next_open_ = pipeline != 0; sched.step_open_ = true;
