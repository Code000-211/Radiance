+TEST(mtp_coupled_rows_emit_their_bound_draft_and_the_bonus_stays_ordinary) {
+    ScopedCoupled on("1");
+    HostChain ch(8, 1, 2);
+    REQUIRE(ch.ok); // A missing coupling kernel is a failure, never a skip.
+    ScopedCoupled off("0");
