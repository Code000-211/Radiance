+                acc[t] += w0 * __builtin_bit_cast(float, a_pk << 16);
+                acc[t] += w1 * __builtin_bit_cast(float, a_pk & 0xFFFF0000u);
+            }
+            if (active_L > 5) {
+                #pragma unroll
+                for (int t = 5; t < 7; ++t) {
