+json salt_messages(const json& messages, const std::string& tag) {
+    json m = messages;
+    if (!m.is_array() || m.empty()) return m;
+    json& c = m[0]["content"];
+    const std::string head = "[" + tag + "]\n";
+    if (c.is_string()) {
+        c = head + c.get<std::string>();
+    } else if (c.is_array()) {
+        c.insert(c.begin(), json{ { "type", "text" }, { "text", head } });
+    } else {
+        c = head;
+    }
+    return m;
+}
