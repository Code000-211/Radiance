+    CHECK_EQ(refused(p), RAD_E_UNSUPPORTED);
+    p = s.params(); set("top_k", RAD_DFLASH_TREE_MAX_K + 1);
+    CHECK_EQ(refused(p), RAD_E_UNSUPPORTED);
+    p = s.params(); set("tree_width", s.K + 1);
+    CHECK_EQ(refused(p), RAD_E_UNSUPPORTED);
+    p = s.params(); set("tree_budget", 0);
+    CHECK_EQ(refused(p), RAD_E_UNSUPPORTED);
