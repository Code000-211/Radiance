+     * a key cannot appear twice in one table, with the second lookup reading the stale one. A
+     * container missing them is one no version of this project wrote; it is still opened, and
+     * declare refuses a zero geometry by name rather than this function guessing. */
+    auto row_i = [&](const char* k, int64_t d) {
+        int64_t v = 0;
+        return f.get_i(k, &v) ? v : d;
+    };
+    auto row_f = [&](const char* k, double d) {
+        double v = 0;
+        return f.get_f(k, &v) ? v : d;
+    };
+    RadModelMeta& m = meta_.m;
+    m.n_layers        = row_i("n_layers", 0);
+    m.n_embd          = row_i("n_embd", 0);
+    m.n_head          = row_i("n_head", 0);
+    m.n_head_kv       = row_i("n_head_kv", 0);
+    m.head_dim        = row_i("head_dim", 0);
+    m.n_ff            = row_i("n_ff", 0);
+    m.n_vocab         = row_i("n_vocab", 0);
+    m.n_ctx_train     = row_i("n_ctx_train", 0);
+    m.n_expert        = row_i("n_expert", 0);
+    m.n_expert_used   = row_i("n_expert_used", 0);
+    m.n_expert_shared = row_i("n_expert_shared", 0);
+    m.rms_eps         = (float)row_f("rms_eps", 1e-6);
+    m.rope_theta      = (float)row_f("rope_theta", 10000.0);
+    m.rope_scale      = (float)row_f("rope_scale", 1.0);
+    meta_.finish();
+    return RAD_OK;
+}
