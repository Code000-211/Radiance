+                        bcol_at(w.qk, tok, nw, koff, c.head_dim, 1), pos,
+                        praw(cu, RAD_I32, 2), kv_cache(c.kv_tail, layer),
+                        praw2(tlb->state_index + s * tw, RAD_I32, 1, tw));
+        }
