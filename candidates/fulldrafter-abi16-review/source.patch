+        if not os.path.exists(cls.PARITY_BIN):
+            raise FileNotFoundError(f"Binary not found: {cls.PARITY_BIN}")
+        res = subprocess.run([cls.PARITY_BIN], capture_output=True, text=True, timeout=180, check=False)
