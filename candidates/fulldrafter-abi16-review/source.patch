+
+    if (!ANC) {
+      const int so = sidx[(size_t)n * sidx_stride + t];
+      // `>= 0`, NOT `> 0`.  A NEGATIVE slot is the pad and ZERO IS A REAL SLOT -- the same rule
+      // the READ above follows, and the same one r4d_gdn_conv_w4_h128_bf16.hip follows.  With `> 0`
+      // a single-sequence decode, whose only slot IS zero, never writes the state back at all:
+      // every step then recurs from the state prefill left behind, the model re-reads its own
+      // prompt and the generation degenerates into repeating it.  A correct read side hides this
+      // one -- the kernel still produces a correct `o` for the first decoded token and a stale one
+      // for every token after it.
+      if (so >= 0) {
+        ST* p = state + (size_t)so * st_slot + (size_t)hv * st_head
+              + (size_t)row * RU_K + k0;
+#pragma unroll
+        for (int j = 0; j < RU_HK; j += 8) ru_store8<NT, SDT>(p + j, &h[j]);
+      }
+    }
+  }
+
+
+}
+template <int ABF16, int NORM, int VS, int NT, int ANC, int STG = 0, int SDT = 0,
+          int CV = 0>
+__global__ __launch_bounds__(RU_V / VS * 2)
+void r4d_gdn_recurrent_update_kernel(const unsigned short* q, const unsigned short* k,
+                                     const unsigned short* v, const void* av, const void* bv,
+                                     long ab_stride, const float* A_log, const float* dt_bias,
+                                     typename ru_state<SDT>::T* state, long st_slot, long st_head,
+                                     unsigned short* o, unsigned char* oq, float* os,
+                                     long oq_pitch, long os_ld, const int* cu, const int* sidx,
+                                     long sidx_stride, const int* naccept, const unsigned short* zg,
+                                     long zg_pitch, const float* nw, float neps, int nact,
+                                     int H, int Hg, float scale, float sp_thr, const RuConv cv) {
+  ru_update_body<ABF16, NORM, VS, NT, ANC, STG, SDT, CV>(
+      q, k, v, av, bv, ab_stride, A_log, dt_bias, state, st_slot, st_head, o, oq, os,
+      oq_pitch, os_ld, cu, sidx, sidx_stride, naccept, zg, zg_pitch, nw, neps, nact,
+      H, Hg, scale, sp_thr, cv);
+}
+
+template <int NORM>
+__global__ __launch_bounds__(RU_V * 2)
+void ru_compact_cv(const void* av, const void* bv, const float* A_log,
+                   const float* dt_bias, float* state, unsigned short* o,
+                   unsigned char* oq, float* os, const int* cu, const int* sidx,
+                   const int* naccept, const unsigned short* zg, const float* nw,
+                   const unsigned short* x, const unsigned short* w,
+                   const unsigned short* b, unsigned short* cs, const int* cidx,
+                   unsigned int* ctr, RuCompact cfg) {
+  RuConv cv{};
+  cv.x = x; cv.xpitch = (long)cfg.xpitch;
+  cv.w = w; cv.b = b; cv.cs = cs;
+  cv.cs_seq = (long)cfg.cs_seq; cv.cs_dim = (long)cfg.cs_dim;
+  cv.cs_tok = (long)cfg.cs_tok; cv.cidx = cidx;
+  cv.ci_stride = (long)cfg.ci_stride; cv.ctr = ctr;
+  ru_update_body<1, NORM, 1, 1, 1, 0, 0, 1>(
+      nullptr, nullptr, nullptr, av, bv, (long)cfg.ab_stride,
+      A_log, dt_bias, state, (long)cfg.st_slot, (long)cfg.st_head, o, oq, os,
+      (long)cfg.oq_pitch, (long)cfg.os_ld, cu, sidx, (long)cfg.sidx_stride,
+      naccept, zg, (long)cfg.zg_pitch, nw, cfg.neps, cfg.nact,
+      cfg.H, cfg.Hg, cfg.scale, cfg.sp_thr, cv);
+}
+
+// THE NON-TEMPORAL HINT on the state load and store (th:TH_STORE_NT / TH_LOAD_NT).
+// It changes no byte of the result -- the line stays coherent, it is only evicted first -- and it
+// is chosen per launch because its cost and its saving land in different kernels and the trade is
+// only visible in a whole step.  ISOLATED the hint is 43.8% SLOWER (20.76 us against 14.44 at
+// 12 MB a call): non-temporal, this kernel is DRAM-write bound, where without the hint the writes
+// stay in the last level and a later kernel pays for the write-back.  In a step there is no later
+// escape -- 48 layers write ~660 MB and a 64 MB last level holds none of it -- so what the hint
+// really moves is WHO pays.  With a matched 12 MB write flood between the decode GEMMs, the same
+// (5120, 3072) GEMM is 14.9 us clean, 20.4 us behind the flood and 18.4 us behind a non-temporal
+// flood, and the whole 64-layer sequence is 110 us faster with the hint.  Under anchor state the
+// balance is about -140 us on the tiled GEMM against +25 us here.
+//
+// ANCHOR STATE: one state per sequence, with the accepted prefix replayed onto it.  It needs the
+// caller's cooperation -- the prefill path must zero state slot sidx[n][1] for every sequence it
+// writes -- so the kernel and radiance_gdn have to agree, and they do so by both being built this
+// way rather than by reading a switch.
+// It is a RUNTIME switch, not a build-time one, because the anchor scheme is NOT PAGED (see the
+// block comment in radiance_gdn.py): vLLM addresses the mamba state by page, and the anchor keeps
+// one state per sequence in the page holding the last token, so a sequence crossing a page reads
+// its anchor out of the previous step's replay factors.  Off, every candidate writes its own slot
+// -- which is exactly the indexing vLLM's own Triton path uses, so it is correct by construction
+// and stays clean across consecutive page crossings.  radiance_gdn.py reads THE SAME variable, so
+// the kernel and its caller cannot disagree about what the state cache means.
+static bool ru_anchor() {
+  const char* e = getenv("RADIANCE_GDN_ANCHOR");
+  return e && e[0] == '1';
+}
+
+// Shared q/k l2 scales across the 128 v-rows of a head: bit-identical to computing them per row.
+// Folding the scales into the reductions instead (STG 2) deletes 128 multiplies a token and is
+// SLOWER for it, so the multiplies are not what the loop waits on -- and it stops being
+// bit-identical, moving about one output in 600 by a single bf16 ULP.
+#ifndef RU_STG_D
+#define RU_STG_D 1
+#endif
+static constexpr int RU_STG = RU_STG_D;
+
+// A non-temporal store on the state write.  THE FLOOD SIZE DECIDES THE SIGN, so the default is
+// off and the decision is made per launch below.
+// Under anchor state a layer floods 12.6 MB of state plus 4.1 MB of replay factors, and at that
+// size the hint is worth about -140 us a step on the tiled W4A8 GEMM against +25 us on this
+// kernel: net about -100 us.
+// UNDER PER-CANDIDATE STATE THE SIGN FLIPS.  With one state per candidate the flood is eight
+// times larger and the non-temporal store is DRAM-write bound for all of it, at which point
+// leaving the hint off wins: without it this kernel runs about 20% faster than FLA's Triton kernel,
+// where with it it is about 20% slower.  It stays switchable because the hint moves cost onto the
+// GEMMs rather than deleting it, and that half of the trade is only visible in a whole step.
+#ifndef RU_NT_D
+#define RU_NT_D 0
+#endif
+// IT IS THE FLOOD SIZE THAT DECIDES, NOT THE SHAPE.  Non-temporal costs this kernel time and saves
+// the GEMMs behind it time, so it wins exactly when the state a layer writes would otherwise have
+// stayed in the 64 MB last level and been handed to the next GEMM as write-back.  At one sequence
+// a layer floods 6.3 MB and the hint is worth about 3% of a whole step; at eight it floods 50 MB,
+// none of it survives, and the hint costs about 2%.
+//
+// The threshold is the last level with room left for the weights streaming through it, not the
+// whole 64 MB.
+#ifndef RU_NT_MB
+#define RU_NT_MB 16
+#endif
+
+// `oq_i8` picks the folded quantiser's codes: E4M3 (0) or int8 (1); see the kernel's epilogue.
+static int ru_update_launch(
+    const void* q, const void* k, const void* v, const void* a, const void* b,
+    long ab_stride, int ab_is_bf16, const void* A_log, const void* dt_bias, void* state,
+    long state_slot_stride, long state_head_stride, void* o, void* oq, void* os,
+    long oq_pitch, long os_ld, const void* cu,
+    const void* ssm_state_indices, long indices_stride, const void* num_accepted,
+    const void* z_gate, long z_pitch, const void* norm_weight, float norm_eps, int norm_act,
+    int N, int H, int Hg, int K, int V, float scale, float softplus_thr, int state_fp16,
+    void* stream, int oq_i8)
+{
+  if (K != RU_K || V != RU_V) return -1;
+  if (H % Hg) return -2;
+  const int nm0 = (z_gate && norm_weight) ? 1 : 0;
+  // Fill the machine: at one sequence the (N, H) grid is 24 workgroups. Split a head's v rows
+  // until there are at least 64 workgroups, but never past four (that is 64 threads, two waves).
+  int vs = 1;
+  if (!nm0) { const int want = (WGTARGET + N * H - 1) / (N * H);
+              vs = want >= 4 ? 4 : (want >= 2 ? 2 : 1);
+              if (vs > VSMAX) vs = VSMAX; }
+  // THE SHIFT MARKER FORBIDS SPLITTING A HEAD.  vs > 1 puts several workgroups on the same
+  // (sequence, head) and therefore on the same marker element: one of them can stamp this step's
+  // marker before another has read the previous step's, and the readers then disagree about how
+  // far the page index moved.  The output degenerates, a greedy generation collapsing mid-word
+  // within a couple of thousand tokens.  One workgroup per (sequence, head) removes the sharing
+  // entirely, and it is not a loss: the wave count is the same either way (vs halves the workgroup
+  // and doubles their number), and vs == 1 is the shape the staged path is instantiated for.
+  if (ru_anchor() && RU_ANC_MARK) vs = 1;
+  dim3 grid(N, H, vs), blk(RU_V / vs * 2);
+  // The state dtype is a template parameter and so is every other switch, so the picks are written
+  // as nested macros rather than #define/#undef pairs: five binary or ternary choices is 72
+  // instantiations, and the preprocessor form makes it easy to leave some of them unreachable.
+#define RU_LAUNCH(AB, NM, VSC, NTC, ANCC, STGC, SDTC)                                         \
+  hipLaunchKernelGGL((r4d_gdn_recurrent_update_kernel<AB, NM, VSC, NTC, ANCC, STGC, SDTC>),   \
+                     grid, blk, 0, (hipStream_t)stream,                                       \
+                     (const unsigned short*)q, (const unsigned short*)k,                      \
+                     (const unsigned short*)v, a, b, ab_stride,                               \
+                     (const float*)A_log, (const float*)dt_bias,                              \
+                     (ru_state<SDTC>::T*)state, state_slot_stride, state_head_stride,         \
+                     (unsigned short*)o, (unsigned char*)oq, (float*)os, oq_pitch, os_ld,    \
+                     (const int*)cu, (const int*)ssm_state_indices,                          \
+                     indices_stride, (const int*)num_accepted,                                \
+                     (const unsigned short*)z_gate, z_pitch, (const float*)norm_weight, norm_eps,      \
+                     norm_act, H, Hg, scale, softplus_thr, RuConv{})
+#define RU_PICKV(AB, NTC, ANCC, SDTC)                                                         \
+  do { if (vs == 4)      RU_LAUNCH(AB, 0, 4, NTC, ANCC, 0, SDTC);                             \
+       else if (vs == 2) RU_LAUNCH(AB, 0, 2, NTC, ANCC, 0, SDTC);                             \
+       else              RU_LAUNCH(AB, 0, 1, NTC, ANCC, 0, SDTC); } while (0)
+#define RU_PICKNM(AB, NTC, ANCC, SDTC)                                                        \
+  do { if (oq_i8) RU_LAUNCH(AB, 2, 1, NTC, ANCC, 0, SDTC);                                    \
+       else       RU_LAUNCH(AB, 1, 1, NTC, ANCC, 0, SDTC); } while (0)
+#define RU_PICKAB(NTC, ANCC, SDTC)                                                            \
+  do { if (ab_is_bf16) { if (nm0) RU_PICKNM(1, NTC, ANCC, SDTC);                              \
+                         else     RU_PICKV(1, NTC, ANCC, SDTC); }                             \
+       else            { if (nm0) RU_PICKNM(0, NTC, ANCC, SDTC);                              \
+                         else     RU_PICKV(0, NTC, ANCC, SDTC); } } while (0)
+#define RU_PICKNT(ANCC, SDTC)                                                                 \
+  do { if (nt) RU_PICKAB(1, ANCC, SDTC); else RU_PICKAB(0, ANCC, SDTC); } while (0)
+#define RU_PICKANC(SDTC)                                                                      \
+  do { if (anc) RU_PICKNT(1, SDTC); else RU_PICKNT(0, SDTC); } while (0)
+
+  // The staged path is instantiated for the shape a decode step runs: bf16 a/b, no fused row
+  // norm, VS 1, anchor on. Everything else keeps the per-row path, which is why STG defaults
+  // to 0 in the template rather than being threaded through every instantiation.
+  const int sdt = state_fp16 ? 1 : 0;
+  const int stg = RU_STG;
+  const bool anc = ru_anchor();
+  // Bytes of state this launch will write. ONE SLOT A SEQUENCE UNDER THE ANCHOR, one a candidate
+  // without it, and the difference is a factor of six: assuming the per-candidate count
+  // unconditionally makes the RU_NT_MB threshold read an eight-request anchored step as a 37.7 MB
+  // flood when it is really 6.3 MB, and puts it on the wrong side of the branch.
+  const long slots_written = anc ? 1 : (long)indices_stride;
+  const long flood = (long)N * slots_written * state_slot_stride * (sdt ? 2 : 4);
+  const bool nt = flood <= (long)RU_NT_MB * 1024 * 1024;
+  // The factor block lives inside one head's slice of a state slot, so it has to fit: one token is
+  // RU_FSTR elements and there are `indices_stride` (= the candidate width) of them.
+  // SIX columns are addressed under the anchor -- three copies of the state and three of the
+  // factor block, so one fixed read column is right whichever way the page index moved -- and a
+  // caller whose candidate width is narrower than that cannot use it.
+  //
+  // THESE RUN BEFORE THE STAGED PATH, NOT AFTER IT. The staged branch below returns, and it is
+  // instantiated with ANCC=1, RU_STG's default of 1 and the vs == 1 the anchor forces -- so the
+  // shipped anchor path is precisely the one that reaches sidx[n*stride + 0..5] and writes the
+  // factor block. Placing these checks after it would leave both bounds untested on exactly that
+  // path.
+  if (anc && indices_stride < 6) return -4;
+  if (anc && (long)indices_stride * RU_FSTR > state_head_stride) return -3;
+  if (stg && ab_is_bf16 && !nm0 && vs == 1 && indices_stride <= RU_TMAX) {
+#define RU_PICKSTG2(ANCC, SDTC)                                                               \
+  do { if (nt) { if (stg == 1) RU_LAUNCH(1, 0, 1, 1, ANCC, 1, SDTC);                          \
+                 else          RU_LAUNCH(1, 0, 1, 1, ANCC, 2, SDTC); }                        \
+       else    { if (stg == 1) RU_LAUNCH(1, 0, 1, 0, ANCC, 1, SDTC);                          \
+                 else          RU_LAUNCH(1, 0, 1, 0, ANCC, 2, SDTC); } } while (0)
+#define RU_PICKSTG(SDTC) do { if (anc) RU_PICKSTG2(1, SDTC); else RU_PICKSTG2(0, SDTC); } while (0)
+    if (sdt) RU_PICKSTG(1); else RU_PICKSTG(0);
+#undef RU_PICKSTG
+#undef RU_PICKSTG2
+    return (int)hipGetLastError();
+  }
+  if (sdt) RU_PICKANC(1); else RU_PICKANC(0);
+#undef RU_PICKANC
+#undef RU_PICKNT
+#undef RU_PICKAB
+#undef RU_PICKNM
+#undef RU_PICKV
+#undef RU_LAUNCH
+  return (int)hipGetLastError();
+}
+
+extern "C" int r4d_gdn_recurrent_update_k128_v128_bf16_fp32state(
+    const void* q, const void* k, const void* v, const void* a, const void* b,
+    long ab_stride, int ab_is_bf16, const void* A_log, const void* dt_bias, void* state,
+    long state_slot_stride, long state_head_stride, void* o, void* oq, void* os,
+    long oq_pitch, long os_ld, const void* cu,
+    const void* ssm_state_indices, long indices_stride, const void* num_accepted,
+    const void* z_gate, long z_pitch, const void* norm_weight, float norm_eps, int norm_act,
+    int N, int H, int Hg, int K, int V, float scale, float softplus_thr, int state_fp16,
+    void* stream)
+{
+  return ru_update_launch(q, k, v, a, b, ab_stride, ab_is_bf16, A_log, dt_bias, state,
+                          state_slot_stride, state_head_stride, o, oq, os, oq_pitch, os_ld, cu,
+                          ssm_state_indices, indices_stride, num_accepted, z_gate, z_pitch,
+                          norm_weight, norm_eps, norm_act, N, H, Hg, K, V, scale, softplus_thr,
+                          state_fp16, stream, 0);
+}
+
+// ============================================================== the folded convolution
+constexpr unsigned kMaxConvCtr = 4096;
+
+
+// The operand enum carries an `OPD_` prefix: RU_K and RU_V are this kernel's head widths.
+// ============================================================== the plugin ABI entry points
+//
+// The shared operand helpers are r4d_gdn_args.h. See libr4d/r4d_args.h for why there is no
+// adapter directory between the core and these launches.
+/* ------------------------------------------------------------------ recurrent update */
+
+enum { OPD_RU_Q = 0, OPD_RU_K, OPD_RU_V, OPD_RU_A, OPD_RU_B, OPD_RU_ALOG, OPD_RU_DTB, OPD_RU_STATE, OPD_RU_SIDX, OPD_RU_NACC, OPD_RU_CU,
+       OPD_RU_Z, OPD_RU_NORMW, OPD_RU_O, OPD_RU_OQ, OPD_RU_OS };
+
+extern "C" int r4d_rad_gdn_recurrent_update(const RadArgs* a, RadStream s) {
+    if (gdn_dims_ok() != RAD_OK) return R4D_NO(RAD_E_SHAPE);
+    const RadTensor* q     = r4d_opt(a, OPD_RU_Q);
+    const RadTensor* k     = r4d_opt(a, OPD_RU_K);
+    const RadTensor* v     = r4d_opt(a, OPD_RU_V);
+    const RadTensor* ta    = r4d_opt(a, OPD_RU_A);
+    const RadTensor* tb    = r4d_opt(a, OPD_RU_B);
+    const RadTensor* alog  = r4d_opt(a, OPD_RU_ALOG);
+    const RadTensor* dtb   = r4d_opt(a, OPD_RU_DTB);
+    const RadTensor* state = r4d_opt(a, OPD_RU_STATE);
+    const RadTensor* sidx  = r4d_opt(a, OPD_RU_SIDX);
+    const RadTensor* nacc  = r4d_opt(a, OPD_RU_NACC);
+    const RadTensor* cu    = r4d_opt(a, OPD_RU_CU);
+    const RadTensor* z     = r4d_opt(a, OPD_RU_Z);
+    const RadTensor* nw    = r4d_opt(a, OPD_RU_NORMW);
+    const RadTensor* o     = r4d_opt(a, OPD_RU_O);
+    const RadTensor* oq    = r4d_opt(a, OPD_RU_OQ);
+    const RadTensor* os    = r4d_opt(a, OPD_RU_OS);
+    if (!q || !k || !v || !ta || !tb || !alog || !dtb || !state || !sidx || !cu || !o)
+        return R4D_NO(RAD_E_INVAL);
+    if (q->rank != 3 || k->rank != 3 || v->rank != 3 || o->rank != 3) return R4D_NO(RAD_E_SHAPE);
+    if (state->rank < 2 || sidx->rank < 1 || ta->rank != 2 || tb->rank != 2) return R4D_NO(RAD_E_SHAPE);
+
+    /* N COMES FROM cu, not from the state-index tensor. The kernel reads cu[n] and cu[n+1] for
+     * every n in the grid, so cu's own length is the only thing that bounds the grid safely --
+     * deriving N from state_idx and trusting cu to be at least as long is the off-by-one that
+     * seqs_of() exists to refuse. state_idx is then checked against it rather than defining it. */
+    int N = 0;
+    int rc = seqs_of(cu, &N);
+    if (rc != RAD_OK) return rc;
+    if (sidx->shape[0] != N) return R4D_NO(RAD_E_SHAPE);
+
+    const long long ab_stride = r4d_row_pitch(ta);
+    if (ab_stride < 0 || r4d_row_pitch(tb) != ab_stride) return R4D_NO(RAD_E_STRIDE);
+    if (!r4d_contig(q) || !r4d_contig(k) || !r4d_contig(v) || !r4d_contig(o))
+        return R4D_NO(RAD_E_STRIDE);
+
+    const long long Hg = q->shape[1];
+    const long long K  = q->shape[2];
+    const long long H  = v->shape[1];
+    const long long V  = v->shape[2];
+    if (H == 0 || Hg == 0 || H % Hg) return R4D_NO(RAD_E_SHAPE);
+
+    /* THE TWO SIDES OF THE STATE CONTRACT HAVE TO AGREE, AND THEY SAY SO. The anchor form is
+     * selected by RADIANCE_GDN_ANCHOR because the kernel serves a second, out-of-tree caller that
+     * has no RadArgs to declare it in -- but a caller that DOES declare `state_form` is naming the
+     * shape its pool was sized for, and running the other form against that pool is silently wrong
+     * rather than slow: per-candidate indexing into a two-slot pool gives three candidate tokens
+     * the same slot, so a partially accepted step resumes from a state two tokens too far along.
+     * Refusing by name turns the one configuration nothing would catch into a selection error,
+     * which the run phase reports with both the kernel and the geometry. */
+    if (const char* sf = r4d_gets(a, "state_form")) {
+        const int want_anc = std::strcmp(sf, "anchor") == 0;
+        if (!want_anc && std::strcmp(sf, "per_candidate") != 0) return R4D_NO(RAD_E_UNSUPPORTED);
+        if (want_anc != (ru_anchor() ? 1 : 0)) return R4D_NO(RAD_E_UNSUPPORTED);
+    }
+
+    const float scale = (float)r4d_getf(a, "scale", 1.0);
+    const float thr   = (float)r4d_getf(a, "softplus_thr", 20.0);
+    /* The vocabulary's names for the folded gated norm, mapped here to libr4d's arguments. */
+    const float neps  = (float)r4d_getf(a, "eps", 0.0);
+    const int   nact  = r4d_act_code(a, "act", "norm_act", 0);
+    if (nact < 0) return R4D_NO(RAD_E_INVAL);
+    /* Same compiled-in 1e-6f as the prefill preamble's l2 norm; see r4d_rad_gdn_conv_prep. */
+    if ((float)r4d_getf(a, "l2_eps", 1e-6) != 1e-6f) return R4D_NO(RAD_E_UNSUPPORTED);
+    /* See the note on the chunk scan: the cache's dtype is what says how wide the state is, not a
+     * declared parameter. Both kernels read it off the same operand so they cannot disagree. */
+    const int   sfp16 = state->dtype == RAD_F16;
+    const int   ab_is_bf16 = (ta->dtype == RAD_BF16) ? 1 : 0;
+    if (tb->dtype != ta->dtype) return R4D_NO(RAD_E_DTYPE);
+    /* `n_head_v` is optional and, where the caller states it, has to agree with the value tensor
+     * -- two sources for one number, and the disagreement would stride through the wrong heads. */
+    const long long nhv = r4d_geti_or(a, "n_head_v", 0);
+    if (nhv > 0 && nhv != H) return R4D_NO(RAD_E_SHAPE);
+
+    /* "bf16 q/k/v and out, fp32 a,b and state cache", plus fp32 A_log / dt_bias / norm weight and
+     * a bf16 z gate -- the casts in r4d_gdn_recurrent_update_k128_v128_bf16_fp32state. */
+    R4D_DT(q, RAD_BF16); R4D_DT(k, RAD_BF16); R4D_DT(v, RAD_BF16); R4D_DT(o, RAD_BF16);
+    R4D_DT(z, RAD_BF16);
+    if (state->dtype != RAD_F32 && state->dtype != RAD_F16) return R4D_NO(RAD_E_DTYPE);
+    R4D_DT(alog, RAD_F32); R4D_DT(dtb, RAD_F32); R4D_DT(nw, RAD_F32);
+
+    /* THE FOLDED QUANTISER IS ALL-OR-NOTHING, and it needs the fused norm: without z and norm_w
+     * the kernel splits a head's rows across workgroups (VS > 1 above), and a block-scaled group
+     * whose amax is spread over several workgroups cannot be reduced in one of them. Refusing is
+     * the only safe answer -- a partial scale plane is wrong numbers, not a slow path. */
+    if ((oq != nullptr) != (os != nullptr)) return R4D_NO(RAD_E_INVAL);
+    if (oq) {
+        if (!z || !nw) return R4D_NO(RAD_E_UNSUPPORTED);
+        if (V != 128) return R4D_NO(RAD_E_SHAPE);
+        if (oq->dtype != RAD_F8E4M3 && oq->dtype != RAD_I8) return R4D_NO(RAD_E_DTYPE);
+        R4D_DT(os, RAD_F32);
+        if (!r4d_contig(oq)) return R4D_NO(RAD_E_STRIDE);
+    }
+
+    /* THE GATE MAY BE A COLUMN VIEW. The delta net's in-projection and its output gate are one
+     * GEMM (rad_block_gdn_fp8.h), so `z` is the right-hand columns of a wider row: its tokens are
+     * `z_row` elements apart, not H*V. Every other layout this op accepts -- a [tokens, H*V]
+     * buffer of its own, a [tokens, H, V] one -- answers the same number. */
+    const long long z_row = z ? gn_row_pitch(z, H * V) : 0;
+    if (z && z_row < 0) return R4D_NO(RAD_E_STRIDE);
+
+    /* THE SLOT AND HEAD STRIDES COME FROM THE TENSOR. The KV manager pads a linear-state page to
+     * the attention page size (spec §7.2), so a slot is wider than H*V*K and deriving the stride
+     * from the shape reads the wrong memory for every slot but the first. */
+    return ru_update_launch(
+        q->data, k->data, v->data, ta->data, tb->data, (long)ab_stride, ab_is_bf16,
+        alog->data, dtb->data, state->data,
+        (long)state->stride[0], (long)state->stride[1],
+        o->data, oq ? oq->data : nullptr, os ? os->data : nullptr,
+        oq ? (long)r4d_row_pitch(oq) : 0, os ? (long)r4d_row_pitch(os) : 0,
+        cu->data, sidx->data, (long)sidx->stride[0],
+        nacc ? nacc->data : nullptr, z ? z->data : nullptr, (long)z_row,
+        nw ? nw->data : nullptr,
+        neps, nact, N, (int)H, (int)Hg, (int)K, (int)V, scale, thr, sfp16, s,
+        oq && oq->dtype == RAD_I8 ? 1 : 0);
+}
+
+
+/* ------------------------------------------------------------------ conv + recurrent update */
+
+/* gdn_conv_update's inputs, then gdn_recurrent_update's minus q, k and v, which are the pair's
+ * intermediate and never reach memory here. Inputs first, outputs last -- docs/OPS.md. */
+enum { OPD_CR_X = 0, OPD_CR_CW, OPD_CR_CB, OPD_CR_CSTATE, OPD_CR_CIDX, OPD_CR_A, OPD_CR_B,
+       OPD_CR_ALOG, OPD_CR_DTB, OPD_CR_STATE, OPD_CR_SIDX, OPD_CR_NACC, OPD_CR_CU, OPD_CR_Z,
+       OPD_CR_NORMW, OPD_CR_O, OPD_CR_OQ, OPD_CR_OS };
+
+static int ru_compact_entry(const RadArgs* a, const R4dSink& sk) {
+    if (gdn_dims_ok() != RAD_OK) return R4D_NO(RAD_E_SHAPE);
+    const RadTensor* x     = r4d_opt(a, OPD_CR_X);
+    const RadTensor* cw    = r4d_opt(a, OPD_CR_CW);
+    const RadTensor* cb    = r4d_opt(a, OPD_CR_CB);
+    const RadTensor* cst   = r4d_opt(a, OPD_CR_CSTATE);
+    const RadTensor* cidx  = r4d_opt(a, OPD_CR_CIDX);
+    const RadTensor* ta    = r4d_opt(a, OPD_CR_A);
+    const RadTensor* tb    = r4d_opt(a, OPD_CR_B);
+    const RadTensor* alog  = r4d_opt(a, OPD_CR_ALOG);
+    const RadTensor* dtb   = r4d_opt(a, OPD_CR_DTB);
+    const RadTensor* state = r4d_opt(a, OPD_CR_STATE);
+    const RadTensor* sidx  = r4d_opt(a, OPD_CR_SIDX);
+    const RadTensor* nacc  = r4d_opt(a, OPD_CR_NACC);
+    const RadTensor* cu    = r4d_opt(a, OPD_CR_CU);
+    const RadTensor* z     = r4d_opt(a, OPD_CR_Z);
+    const RadTensor* nw    = r4d_opt(a, OPD_CR_NORMW);
+    const RadTensor* o     = r4d_opt(a, OPD_CR_O);
+    const RadTensor* oq    = r4d_opt(a, OPD_CR_OQ);
+    const RadTensor* os    = r4d_opt(a, OPD_CR_OS);
+    /* THE ROW NORM IS REQUIRED: the fold is the decode shape, one workgroup per (sequence, value
+     * head), and that is the shape the norm already forces on the unfolded kernel. */
+    if (!x || !cw || !cst || !cidx || !ta || !tb || !alog || !dtb || !state || !sidx ||
+        !nacc || !cu || !z || !nw || !o || !oq || !os)
+        return R4D_NO(RAD_E_INVAL);
+    if (x->rank != 2 || cst->rank != 3 || o->rank != 3 || ta->rank != 2 || tb->rank != 2 ||
+        state->rank < 2 || sidx->rank != 2 || cidx->rank != 1)
+        return R4D_NO(RAD_E_SHAPE);
+
+    int N = 0;
+    int rc = seqs_of(cu, &N);
+    if (rc != RAD_OK) return rc;
+    if (sidx->shape[0] != N) return R4D_NO(RAD_E_SHAPE);
+
+    /* THE HEAD GEOMETRY COMES FROM `o` AND `x`: `o` is [tokens, H, V] and `x` is the projection's
+     * [q | k | v] columns, 2 Hg K + H V wide. There is no q, k or v operand to read it off. */
+    const long long T  = o->shape[0];
+    const long long H  = o->shape[1];
+    const long long V  = o->shape[2];
+    const long long K  = r4d_geti_or(a, "head_k", 0);
+    if (K != RU_K || V != RU_V || r4d_geti_or(a, "head_v", 0) != RU_V) return R4D_NO(RAD_E_SHAPE);
+    if (x->shape[0] != T) return R4D_NO(RAD_E_SHAPE);
+    const long long conv_dim = x->shape[1];
+    if (H <= 0 || H > INT32_MAX || conv_dim <= H * V ||
+        (conv_dim - H * V) % (2 * K)) return R4D_NO(RAD_E_SHAPE);
+    const long long Hg = (conv_dim - H * V) / (2 * K);
+    if (H % Hg) return R4D_NO(RAD_E_SHAPE);
+    const long long nhv = r4d_geti_or(a, "n_head_v", 0);
+    if (nhv > 0 && nhv != H) return R4D_NO(RAD_E_SHAPE);
+    if ((long long)N * Hg > (long long)kMaxConvCtr) return R4D_NO(RAD_E_SHAPE);
+    const long long xpitch = r4d_row_pitch(x);
+    if (xpitch < 0) return R4D_NO(RAD_E_STRIDE);
+    if (!r4d_contig(cw) || !r4d_contig(o)) return R4D_NO(RAD_E_STRIDE);
+    const long long ab_stride = r4d_row_pitch(ta);
+    if (ab_stride < 0 || r4d_row_pitch(tb) != ab_stride) return R4D_NO(RAD_E_STRIDE);
+
+    R4D_DT(x, RAD_BF16); R4D_DT(cw, RAD_BF16); R4D_DT(cb, RAD_BF16); R4D_DT(cst, RAD_BF16);
+    R4D_DT(ta, RAD_BF16); R4D_DT(tb, RAD_BF16); R4D_DT(o, RAD_BF16); R4D_DT(z, RAD_BF16);
+    R4D_DT(alog, RAD_F32); R4D_DT(dtb, RAD_F32); R4D_DT(nw, RAD_F32);
+    if (state->dtype != RAD_F32 || oq->dtype != RAD_I8) return R4D_NO(RAD_E_DTYPE);
+    R4D_DT(os, RAD_F32);
+    if (!r4d_contig(oq)) return R4D_NO(RAD_E_STRIDE);
+
+    /* Convolution cache depth is the deployment window, not this step's token count.
+     * The folded token loop stages at most RU_CVT tokens, while the cache may be deeper.
+     * Check the declared q_len band separately from the cache's history depth. */
+    if (r4d_geti_or(a, "conv_width", 0) != R4D_GDN_CONV_W) return R4D_NO(RAD_E_UNSUPPORTED);
+    const long long q_len = r4d_geti_or(a, "q_len", 0);
+    if (q_len < 1 || q_len > RU_CVT) return R4D_NO(RAD_E_SHAPE);
+    if (cst->shape[2] < R4D_GDN_CONV_W - 1) return R4D_NO(RAD_E_SHAPE);
+
+    /* The recurrent half's contract checks, as r4d_rad_gdn_recurrent_update makes them. */
+    if (const char* sf = r4d_gets(a, "state_form")) {
+        const int want_anc = std::strcmp(sf, "anchor") == 0;
+        if (!want_anc && std::strcmp(sf, "per_candidate") != 0) return R4D_NO(RAD_E_UNSUPPORTED);
+        if (want_anc != (ru_anchor() ? 1 : 0)) return R4D_NO(RAD_E_UNSUPPORTED);
+    }
+    const float scale = (float)r4d_getf(a, "scale", 1.0);
+    const float thr   = (float)r4d_getf(a, "softplus_thr", 20.0);
+    const float neps  = (float)r4d_getf(a, "eps", 0.0);
+    const int   nact  = r4d_act_code(a, "act", "norm_act", 0);
+    if (nact < 0) return R4D_NO(RAD_E_INVAL);
+    if ((float)r4d_getf(a, "l2_eps", 1e-6) != 1e-6f) return R4D_NO(RAD_E_UNSUPPORTED);
+    const long long z_row = gn_row_pitch(z, H * V);
+    if (z_row < 0) return R4D_NO(RAD_E_STRIDE);
+
+    if (!ru_anchor()) return R4D_NO(RAD_E_UNSUPPORTED);
+    auto fits = [](int64_t v) { return v >= 0 && v <= INT32_MAX; };
+    const int64_t oq_row = r4d_row_pitch(oq), os_row = r4d_row_pitch(os);
+    if (!fits(xpitch) || !fits(ab_stride) || !fits(state->stride[0]) ||
+        !fits(state->stride[1]) || !fits(oq_row) || !fits(os_row) ||
+        !fits(sidx->stride[0]) || !fits(z_row) || !fits(cst->stride[0]) ||
+        !fits(cst->stride[1]) || !fits(cst->stride[2]) || !fits(cidx->stride[0]))
+        return R4D_NO(RAD_E_STRIDE);
+    if (sidx->stride[0] < 6 || sidx->stride[0] > INT32_MAX / RU_FSTR ||
+        sidx->stride[0] * RU_FSTR > state->stride[1])
+        return R4D_NO(RAD_E_SHAPE);
+    if ((long long)N * state->stride[0] * 4 > (long long)RU_NT_MB * 1024 * 1024)
+        return R4D_NO(RAD_E_UNSUPPORTED);  // this row is the reached NT=1 instantiation
+    const int64_t counter_bytes = (int64_t)N * Hg * sizeof(unsigned int);
+    if (!a->scratch || a->scratch_bytes < counter_bytes ||
+        (reinterpret_cast<uintptr_t>(a->scratch) & (alignof(unsigned int) - 1)))
+        return R4D_NO(RAD_E_SCRATCH);
+    RuCompact cfg{(int)ab_stride, (int)state->stride[0], (int)state->stride[1],
+                  (int)oq_row, (int)os_row, (int)sidx->stride[0], (int)z_row,
+                  (int)xpitch, (int)cst->stride[0], (int)cst->stride[1],
+                  (int)cst->stride[2], (int)cidx->stride[0],
+                  neps, scale, thr, nact, (int)H, (int)Hg};
+    static_assert(R4dParams<decltype(ru_compact_cv<2>)>::count == 20);
+    static_assert(R4dParams<decltype(ru_compact_cv<2>)>::bytes() == 224);
+    static_assert(R4dParams<decltype(ru_compact_cv<2>)>::count <= RAD_MAX_KPARAMS &&
+                  R4dParams<decltype(ru_compact_cv<2>)>::bytes() <= RAD_KPARAM_BLOB);
+    return R4D_EMIT(sk, ru_compact_cv<2>, dim3(N, (unsigned)H, 1), dim3(RU_V * 2), 0,
+                    ta->data, tb->data, (const float*)alog->data, (const float*)dtb->data,
+                    (float*)state->data, (unsigned short*)o->data,
+                    (unsigned char*)oq->data, (float*)os->data, (const int*)cu->data,
+                    (const int*)sidx->data, (const int*)nacc->data,
+                    (const unsigned short*)z->data, (const float*)nw->data,
+                    (const unsigned short*)x->data, (const unsigned short*)cw->data,
+                    cb ? (const unsigned short*)cb->data : nullptr,
+                    (unsigned short*)cst->data, (const int*)cidx->data,
+                    (unsigned int*)a->scratch, cfg);
+}
diff --git a/reports/betterbench-1200-campaign/gdn-query-reload-probe/gdn_shared_norm_probe.hip b/reports/betterbench-1200-campaign/gdn-query-reload-probe/gdn_shared_norm_probe.hip
new file mode 100644
index 0000000000000000000000000000000000000000..b200edca61228fe8cce8502a75d8daa33ff002d5
--- /dev/null
+++ b/reports/betterbench-1200-campaign/gdn-query-reload-probe/gdn_shared_norm_probe.hip
@@ -0,0 +1,113 @@
+// Isolated CV=1, NORM=2, VS=1, NT=1, ANC=1, STG=0, SDT=0 probe.
+// The fork shares one device arithmetic body between its legacy signature and a compact
+// 19-pointer + 72-byte config signature. Only the latter is exposed by this plugin.
+// Counters live in caller-provided zero-initialized scratch; the last arriving value head
+// resets each counter before the next ordered launch. Neither entry allocates or synchronizes.
+#ifdef __FAST_MATH__
+#error "This experiment must not use fast math: the bit-identity argument needs -ffp-contract=off."
+#endif
+
+#include "rad_abi.h"
+#include "r4d_emit.h"
+#include <climits>
+
+// Hide the included fork's non-CV entry, helpers, and device templates. The only visible
+// symbols are the plugin ABI exports after the visibility boundary below.
+#pragma GCC visibility push(hidden)
+
+// Only the recurrent (non-CV) entry keeps its private name; the folded entry is generated
+// from ru_compact_entry after including the shared arithmetic body.
+#define r4d_rad_gdn_recurrent_update qreload_unused_recurrent_entry
+#include "gdn_shared_norm_fork.hip"
+#undef r4d_rad_gdn_recurrent_update
+R4D_ENTRY(qreload_conv_recurrent_entry, ru_compact_entry)
+
+// The fork calls r4d_gdn_dims to check its compiled-in geometry. libr4d defines it in the chunk
+// scan's translation unit, which this probe does not build. These are the three numbers that
+// kernel bakes in (KD/VD/BT in r4d_gdn_chunk_scan_k128_v128_c64_bf16.hip), restated here so this
+// DSO is self-contained and cannot silently disagree with what it forked. Defined inside the
+// hidden region so it matches the declaration r4d.h made there.
+extern "C" void r4d_gdn_dims(int* head_k, int* head_v, int* chunk) {
+  if (head_k) *head_k = RU_K;
+  if (head_v) *head_v = RU_V;
+  if (chunk)  *chunk  = 64;
+}
+
+namespace qreload {
+static const RadConstraint constraints[] = {
+    RAD_CEQ("head_k", 128), RAD_CEQ("head_v", 128), RAD_CEQ("conv_width", 4),
+    RAD_CGE("q_len", 1), RAD_CLE("q_len", 16),
+};
+
+static int64_t scratch(const RadArgs* a) {
+    // Shape-only declare calls need not have allocated operand addresses yet.
+    if (!a || !a->t || a->n_t <= OPD_CR_O) return -1;
+    const RadTensor* cu = &a->t[OPD_CR_CU];
+    const RadTensor* x = &a->t[OPD_CR_X];
+    const RadTensor* o = &a->t[OPD_CR_O];
+    if (cu->rank != 1 || x->rank != 2 || o->rank != 3 ||
+        cu->shape[0] < 2 || o->shape[1] < 1 || o->shape[1] > INT32_MAX ||
+        x->shape[1] <= o->shape[1] * RU_V)
+        return -1;
+    const int64_t shared = x->shape[1] - o->shape[1] * RU_V;
+    if (shared % (2 * RU_K)) return -1;
+    const int64_t heads = shared / (2 * RU_K);
+    if (heads < 1 || heads > kMaxConvCtr ||
+        cu->shape[0] - 1 > kMaxConvCtr / heads) return -1;
+    return (cu->shape[0] - 1) * heads * sizeof(unsigned int);
+}
+
+}  // namespace qreload
+
+// The plugin ABI exports are the only visible symbols in this DSO.
+#pragma GCC visibility pop
+
+// THE SCHEMA IS LIBR4D'S. Declaring it here would make this DSO the schema owner for an op
+// libr4d already declares, and the first plugin to declare an op fixes its vocabulary -- a
+// re-declaration that drifted by one operand would then be refused against libref for a reason
+// that has nothing to do with this probe. Same reasoning as hc-down-probe: the installed libr4d
+// owns the op, this row implements it.
+extern "C" int rad_kernel_schema_count() { return 0; }
+extern "C" const RadOpSchema* rad_kernel_schema_at(int) { return nullptr; }
+
+// The DSO's only row. `rad_kernel_at` is the ABI's registration; nothing in mine/, the
+// CMakeLists or the frozen tree is touched, and the parent decides whether to register it.
+extern "C" int rad_kernel_count() { return 1; }
+extern "C" const RadKernelInfo* rad_kernel_at(int i) {
+    static const RadKernelInfo row = [] {
+        RadKernelInfo r{};
+        r.name    = "gdn_conv_recurrent_update_k128_v128_bf16_qreload";
+        r.op      = "gdn_conv_recurrent_update";
+        r.family  = "gdn";
+        r.computes = "the folded gdn decode: conv in the recurrent kernel's prologue, then "
+                     "gating, qk l2norm, delta-rule update, gated rms norm and the folded "
+                     "quantiser; under CV the query is re-read from LDS at the output "
+                     "accumulation and the key is re-read from LDS at the delta-rule inner "
+                     "product, the anchor factor store and the h update, instead of being held "
+                     "across the update (bit-identical)";
+        r.shape   = "head_k/head_v 128, conv width 4, 1..16 tokens per sequence, "
+                    "anchor state, one workgroup per (sequence, value head)";
+        r.dtypes  = "bf16 projection/conv/a/b/gate/output, f32 recurrent state, "
+                    "int8 quant output and f32 scale; optional bf16 conv bias";
+        r.domain  = RAD_DOMAIN_DEVICE;
+        // Below libr4d's own gdn row (R4D_PRIO_ONLY == 50) so a hierarchy containing both keeps
+        // the shipped kernel; the comparator addresses this DSO directly instead.
+        r.priority = 40;
+        r.constraints   = qreload::constraints;
+        r.n_constraints = (int)(sizeof(qreload::constraints) / sizeof(qreload::constraints[0]));
+        r.launch   = qreload_conv_recurrent_entry;
+        r.describe = qreload_conv_recurrent_entry_describe;
+        r.scratch  = qreload::scratch;
+        return r;
+    }();
+    return i == 0 ? &row : nullptr;
+}
+
+extern "C" uint32_t rad_plugin_abi_version() { return RAD_ABI_VERSION; }
+extern "C" const RadPluginInfo* rad_plugin_info() {
+    static const RadPluginInfo info = {
+        RAD_PLUGIN_KERNEL, "gdn_query_reload_probe", "0.0.0",
+        "isolated CV query-register-reload probe; not registered in mine", "gfx1201"
+    };
+    return &info;
+}
diff --git a/reports/betterbench-1200-campaign/hc-down-probe/compare.hip b/reports/betterbench-1200-campaign/hc-down-probe/compare.hip
new file mode 100644
index 0000000000000000000000000000000000000000..d8cd68de431aaba78a7a491b3565f5bfdf6a50b9
--- /dev/null
+++ b/reports/betterbench-1200-campaign/hc-down-probe/compare.hip
@@ -0,0 +1,186 @@
+// Reuse the established guarded HC fixture, frozen ABI loader, comparator, event
+// timer and negative comparator controls. No upstream test or source is modified.
+#define main hc_small_probe_original_main
+#include "../hc-small-m-probe/hc_small_m_probe.hip"
+#undef main
+
+namespace {
+using namespace probe;
+constexpr const char* Frozen = "build_hip/radiance_home/kernels/libr4d.so";
+constexpr const char* Candidate = "/tmp/hc-down-wmma.so";
+
+void intermediate(const OracleCall& baseline, const Buffer& candidate_scratch, int rows, int band) {
+    const Bytes ref = baseline.scratch->get(), got = candidate_scratch.get();
+    const size_t dbytes = (size_t)rows * LR * 2, bandbytes = (size_t)band * LR * 2;
+    require(ref.size() >= dbytes + rows * kHcMax * 4 &&
+            got.size() >= bandbytes + band * kHcMax * 4 + 2 * (N / GROUP) * 4,
+            "intermediate scratch too short");
+    double num = 0, den = 0, max_abs = 0;
+    for (size_t i = 0; i < dbytes / 2; ++i) {
+        const float x = host_bf(load<uint16_t>(got, i));
+        const float y = host_bf(load<uint16_t>(ref, i));
+        require(std::isfinite(x) && std::isfinite(y) && load<uint16_t>(got, i) != 0xcdcd,
+                "missing or nonfinite down output");
+        const double delta = (double)x - y;
+        num += delta * delta; den += (double)y * y;
+        max_abs = std::max(max_abs, std::fabs(delta));
+    }
+    const double relative = den > 0 ? std::sqrt(num / den) : (num == 0 ? 0 : 1);
+    std::printf("  d rel_l2=%.9g max_abs=%.9g limit=0.006\n", relative, max_abs);
+    require(relative <= 6e-3, "down output exceeds existing BF16 comparator limit");
+    for (int r = 0; r < rows; ++r) for (int c = 0; c < HC; ++c) {
+        const size_t idx = r * kHcMax + c;
+        const float scale = load<float>(got, bandbytes / 4 + idx);
+        require(std::isfinite(scale) &&
+                load<uint32_t>(got, bandbytes / 4 + idx) == load<uint32_t>(ref, dbytes / 4 + idx),
+                "normalized scale differs bitwise from frozen row");
+    }
+    for (int r = 0; r < rows; ++r)
+        for (int c = HC * 4; c < kHcMax * 4; ++c)
+            require(got[bandbytes + r * kHcMax * 4 + c] == 0xcd,
+                    "normalization scale tail overwritten");
+    if (band > rows)
+        require(std::all_of(got.begin() + dbytes, got.begin() + bandbytes,
+                            [](unsigned char v) { return v == 0xcd; }), "ghost row written");
+    for (int i = 0; i < 2 * (N / GROUP); ++i)
+        require(load<uint32_t>(got, (bandbytes + band * kHcMax * 4) / 4 + i) == 0,
+                "arrival counter not reset after operation");
+}
+
+void refuse(OracleCall& call, const Oracle& plugin, hipStream_t stream, int expected) {
+    require(plugin.row->launch(&call.args, (RadStream)stream) == expected,
+            "candidate accepted invalid geometry, dtype, stride, option, or scratch");
+}
+void boundaries(OracleCall& call, const Oracle& plugin, hipStream_t stream, int rows) {
+    auto p = call.params[0];
+    for (int bad : {1, 2, 5, 8}) {
+        call.params[0] = pi("M", bad);
+        refuse(call, plugin, stream, RAD_E_SHAPE);
+    }
+    call.params[0] = p;
+    if (rows == 4) { call.params[0] = pi("M", 3); refuse(call, plugin, stream, RAD_E_SHAPE); call.params[0] = p; }
+    --call.args.scratch_bytes; refuse(call, plugin, stream, RAD_E_SCRATCH); ++call.args.scratch_bytes;
+    auto up = call.tensors[3], h = call.tensors[0], x = call.tensors[5], down = call.tensors[2];
+    call.tensors[3].dtype = RAD_BF16; refuse(call, plugin, stream, RAD_E_DTYPE); call.tensors[3] = up;
+    call.tensors[2].data = (unsigned char*)down.data + 1;
+    refuse(call, plugin, stream, RAD_E_STRIDE); call.tensors[2] = down;
+    call.tensors[0].shape[0] = 2; refuse(call, plugin, stream, RAD_E_SHAPE); call.tensors[0] = h;
+    call.tensors[0].stride[0] += 8; refuse(call, plugin, stream, RAD_E_STRIDE); call.tensors[0] = h;
+    --call.tensors[5].shape[0]; refuse(call, plugin, stream, RAD_E_STRIDE); call.tensors[5] = x;
+    if (call.tensors[7].data) {
+        auto qs = call.tensors[8], rqs = call.tensors[10];
+        call.tensors[8].data = nullptr; refuse(call, plugin, stream, RAD_E_INVAL); call.tensors[8] = qs;
+        call.tensors[10].data = nullptr; refuse(call, plugin, stream, RAD_E_INVAL); call.tensors[10] = rqs;
+    }
+}
+
+int run_down_probe(int argc, char** argv) {
+    const Options opt = options(argc, argv);
+    require(opt.candidate_plugin.empty() && !opt.rowpair && !opt.fused_norm && !opt.up_wmma,
+            "use --m/--device/--check-only/--warmup/--iters/--repeats; candidate path is fixed");
+    require(!opt.m || opt.m == 3 || opt.m == 4, "only M=3 or M=4");
+    HIP(hipSetDevice(opt.device));
+#ifdef HC_PROBE_AQL
+    require(rad_dev_set(opt.device) == RAD_OK, "native device selection failed");
+#endif
+    hipDeviceProp_t props{};
+    HIP(hipGetDeviceProperties(&props, opt.device));
+    require(std::strncmp(props.gcnArchName, "gfx1201", 7) == 0 && props.warpSize == 32 &&
+            props.sharedMemPerBlock >= 65536, "requires gfx1201 wave32 and 64 KiB LDS");
+    Oracle baseline(Frozen), plugin(Candidate, "hc_down_wmma_m3_m4_probe");
+    Stream stream;
+    Events events;
+    int cases = 0;
+    for (int rows : {3, 4}) {
+        if (opt.m && rows != opt.m) continue;
+        for (uint64_t seed : {uint64_t(1), uint64_t(17), uint64_t(101)}) {
+            Inputs input(rows, seed);
+            std::array<Snapshot, 3> modes;
+            for (int mode = 0; mode < 3; ++mode) {
+                Outputs frozen(rows), candidate(rows);
+                OracleCall before(baseline, input, frozen, rows, mode);
+                OracleCall after(plugin, input, candidate, rows, mode);
+                auto ref = [&] { before.launch(baseline, stream.value); };
+                auto test = [&] { after.launch(plugin, stream.value); };
+                ref(); test(); stream.sync();
+                const auto expected = frozen.get(), got = candidate.get();
+                std::printf("case M=%d seed=%llu mode=%s\n", rows, (unsigned long long)seed,
+                            mode == 0 ? "none" : mode == 1 ? "fp8+rot" : "int8+rot");
+                require(compare(expected, got, mode, false, true), "frozen ABI output comparison failed");
+                require(expected[1] == got[1], "unchanged inject reduction is not byte exact");
+                quant_contract(expected, rows, mode);
+                quant_contract(got, rows, mode);
+                controls(expected, got, rows, mode, false);
+                intermediate(before, *after.scratch, rows, rows);
+                input.check();
+                boundaries(after, plugin, stream.value, rows);
+                ref(); test(); stream.sync();
+                require(frozen.get() == expected && candidate.get() == got,
+                        "repeated operation changed outputs");
+                intermediate(before, *after.scratch, rows, rows);
+                RadLaunchDesc desc[2]{};
+                int ndesc = 0;
+                const auto untouched = after.scratch->get();
+                require(plugin.row->describe &&
+                        plugin.row->describe(&after.args, (RadStream)stream.value, desc, 1, &ndesc) == RAD_E_FULL &&
+                        plugin.row->describe(&after.args, (RadStream)stream.value, desc, 2, &ndesc) == RAD_OK &&
+                        ndesc == 2 && after.scratch->get() == untouched,
+                        "describe capacity/count or side effects differ");
+                for (int i = 0; i < ndesc; ++i)
+                    HIP(hipLaunchKernel(desc[i].func,
+                        dim3(desc[i].grid[0], desc[i].grid[1], desc[i].grid[2]),
+                        dim3(desc[i].block[0], desc[i].block[1], desc[i].block[2]),
+                        desc[i].params, desc[i].shared_bytes, stream.value));
+                stream.sync();
+                require(candidate.get() == got, "described dispatch changed outputs");
+                intermediate(before, *after.scratch, rows, rows);
+                if (rows == 3 && seed == 1 && mode == 0) {
+                    after.params[0] = pi("M", 4);
+                    Buffer wide((size_t)plugin.row->scratch(&after.args));
+                    after.args.scratch = wide.data(); after.args.scratch_bytes = wide.size;
+                    test(); stream.sync();
+                    require(candidate.get() == got, "M3 inside band4 changed outputs");
+                    intermediate(before, wide, rows, 4);
+                    after.params[0] = pi("M", rows);
+                    after.args.scratch = after.scratch->data(); after.args.scratch_bytes = after.scratch->size;
+                }
+                modes[mode] = got;
+                if (mode) {
+                    require(got[0] == modes[0][0] && got[1] == modes[0][1],
+                            "quant mode changed x or inject");
+                    if (mode == 2) require(got[4] == modes[1][4] && got[5] == modes[1][5],
+                                           "INT8 mode changed rotated FP8 output");
+                }
+                if (!opt.check_only) {
+                    for (int i = 0; i < opt.warmup; ++i) { ref(); test(); }
+                    stream.sync();
+                    std::vector<double> a, b;
+                    for (int repeat = 0; repeat < opt.repeats; ++repeat) {
+                        if (repeat & 1) {
+                            b.push_back(measure(test, stream.value, events, opt.iters));
+                            a.push_back(measure(ref, stream.value, events, opt.iters));
+                        } else {
+                            a.push_back(measure(ref, stream.value, events, opt.iters));
+                            b.push_back(measure(test, stream.value, events, opt.iters));
+                        }
+                    }
+                    require(frozen.get() == expected && candidate.get() == got,
+                            "timed operations changed outputs");
+                    intermediate(before, *after.scratch, rows, rows);
+                    spreads("frozen_libr4d", a);
+                    spreads("hc_down_probe", b);
+                }
+                std::printf("  outputs,guards,counters,description,refusals=PASS\n");
+                ++cases;
+            }
+        }
+    }
+    std::printf("PASS cases=%d timing=%s (standalone, NOT sealed BetterBench)\n",
+                cases, opt.check_only ? "disabled" : "event submissions");
+    return 0;
+}
+} // namespace
+int main(int argc, char** argv) {
+    try { return run_down_probe(argc, argv); }
+    catch (const std::exception& e) { std::fprintf(stderr, "FAIL: %s\n", e.what()); return 1; }
+}
diff --git a/reports/betterbench-1200-campaign/hc-down-probe/hc_down_multirow.hip b/reports/betterbench-1200-campaign/hc-down-probe/hc_down_multirow.hip
new file mode 100644
index 0000000000000000000000000000000000000000..a126a1db9e9578340939961527ee4a5af3f8b42b
--- /dev/null
+++ b/reports/betterbench-1200-campaign/hc-down-probe/hc_down_multirow.hip
@@ -0,0 +1,262 @@
+// Standalone multirow HC down experiment; never registered in the serving plugin.
+// numerik: verlustfrei-nicht-bitgenau. Only the FP32 down-dot reduction changes.
+// E4M3 weights are exactly represented in BF16; FP32 group scales follow each dot.
+#ifdef __FAST_MATH__
+#error "HC down probe requires strict floating point compilation"
+#endif
+#include "rad_abi.h"
+#pragma GCC visibility push(hidden)
+#include "../../../mine/hc_up_wmma.hip"
+
+namespace hc_down_multirow {
+constexpr int N = 2560, HC = 4, LR = 320, HN = N * HC, Group = 128;
+constexpr int DownPitch = r4d_hc8::row_bytes(HN, Group);
+constexpr int UpPitch = r4d_hc8::row_bytes(LR, LR / 4);
+constexpr int Slots = 2 * N / Group;
+constexpr int TileK = Group, Pitch = TileK + 8;
+static_assert(DownPitch == 10560 && UpPitch == 336 && HN % TileK == 0);
+
+// 20 CTAs own 16 down columns each. CTA 20 publishes every row's injection,
+// norm scales, and zeroed counters. There is no inter-CTA communication.
+__global__ __launch_bounds__(kThreads)
+void down(const unsigned short* __restrict__ h, const float* __restrict__ w,
+          const unsigned char* __restrict__ dw, const unsigned short* __restrict__ iw,
+          unsigned short* __restrict__ d, unsigned short* __restrict__ inj,
+          float* __restrict__ scale, unsigned int* __restrict__ ctr,
+          int rows, float eps, float wadd) {
+    extern __shared__ __attribute__((aligned(16))) unsigned short sN[];
+    __shared__ float part[kWaves][kHcMax], norms[4][kHcMax];
+    __shared__ unsigned short stage[kWaves][kWave * 8];
+    __shared__ __attribute__((aligned(16))) unsigned short a[16 * Pitch], b[16 * Pitch];
+    const int tid = threadIdx.x, wave = tid / kWave, lane = tid % kWave;
+    const bool publisher = blockIdx.x == LR / 16;
+    if (publisher && tid < Slots) ctr[tid] = 0;
+
+    // Preserve hc_read_a_kernel<true>'s per-row eight-load, eight-add, wave_sum,
+    // eight-wave reduction, and frsqrt order. M=3 with band=4 visits three rows.
+    for (int r = 0; r < rows; ++r) {
+        const unsigned short* hp = h + r * HN;
+        for (int c = 0; c < HC; ++c) {
+            const int cb = c * N;
+            float acc = 0.0f;
+            int i = tid;
+            for (; i + 7 * kThreads < N; i += 8 * kThreads) {
+                unsigned short hv[8];
+#pragma unroll
+                for (int p = 0; p < 8; ++p) hv[p] = hp[cb + i + p * kThreads];
+#pragma unroll
+                for (int p = 0; p < 8; ++p) { const float v = bf2f(hv[p]); acc += v * v; }
+            }
+            for (; i < N; i += kThreads) { const float v = bf2f(hp[cb + i]); acc += v * v; }
+            acc = wave_sum(acc);
+            if (lane == 0) part[wave][c] = acc;
+        }
+        __syncthreads();
+        if (tid < HC) {
+            float ss = 0.0f;
+            for (int k = 0; k < kWaves; ++k) ss += part[k][tid];
+            norms[r][tid] = __frsqrt_rn(ss / (float)N + eps);
+            if (publisher) scale[r * kHcMax + tid] = norms[r][tid];
+        }
+        __syncthreads();
+    }
+
+    if (publisher) {
+        // Only this CTA needs the whole 10240-element normalized row in LDS.
+        // Reuse the same storage for each physical row before the next launch.
+        for (int r = 0; r < rows; ++r) {
+            const unsigned short* hp = h + r * HN;
+            for (int c = 0; c < HC; ++c) {
+                const int cb = c * N;
+                const float sc = norms[r][c];
+                int i = tid;
+                for (; i + 7 * kThreads < N; i += 8 * kThreads) {
+                    float wv[8];
+                    unsigned short hv[8];
+#pragma unroll
+                    for (int p = 0; p < 8; ++p) {
+                        wv[p] = w[cb + i + p * kThreads];
+                        hv[p] = hp[cb + i + p * kThreads];
+                    }
+#pragma unroll
+                    for (int p = 0; p < 8; ++p)
+                        sN[cb + i + p * kThreads] = f2bf(bf2f(hv[p]) * sc * (wv[p] + wadd));
+                }
+                for (; i < N; i += kThreads)
+                    sN[cb + i] = f2bf(bf2f(hp[cb + i]) * sc * (w[cb + i] + wadd));
+            }
+            __syncthreads();
+            for (int c = wave; c < HC; c += kWaves) {
+                const float sum = wave_sum(wave_dot_lds<kDotU>(sN, iw + c * HN, HN, lane, stage[wave]));
+                if (lane == 0) inj[r * HC + c] = f2bf(2.0f * sigmoidf_(sum * (1.0f / HC)));
+            }
+            __syncthreads();
+        }
+        return;
+    }
+
+    // All physical rows occupy A[0..rows); each K=128 group is staged once
+    // per CTA. B is common to every row. Other 12/13 A rows contain zero.
+    v8f total = {};
+    const int col = blockIdx.x * 16 + (lane & 15);
+    const unsigned char* wr = dw + col * DownPitch;
+    for (int k0 = 0; k0 < HN; k0 += TileK) {
+        __syncthreads();
+        for (int t = tid; t < 16 * (TileK / 8); t += kThreads) {
+            const int row = t / (TileK / 8), k8 = (t % (TileK / 8)) * 8;
+            union { uint4 v; unsigned short s[8]; } out;
+            if (row < rows) {
+                const unsigned short* hp = h + row * HN + k0 + k8;
+                const float* wp = w + k0 + k8;
+                const float sc = norms[row][(k0 + k8) / N];
+                unsigned short hv[8];
+                float wv[8];
+#pragma unroll
+                for (int e = 0; e < 8; ++e) {
+                    hv[e] = hp[e];
+                    wv[e] = wp[e];
+                }
+#pragma unroll
+                for (int e = 0; e < 8; ++e)
+                    out.s[e] = f2bf(bf2f(hv[e]) * sc * (wv[e] + wadd));
+            } else {
+                out.v = make_uint4(0, 0, 0, 0);
+            }
+            *(uint4*)(a + row * Pitch + k8) = out.v;
+        }
+        for (int t = tid; t < 16 * (TileK / 8); t += kThreads) {
+            const int j = t / (TileK / 8), k8 = (t % (TileK / 8)) * 8;
+            const int column = blockIdx.x * 16 + j;
+            const uint2 codes = *(const uint2*)(dw + column * DownPitch + k0 + k8);
+            float decoded[8];
+            e4m3x8(codes.x, codes.y, decoded);
+            union { uint4 v; unsigned short s[8]; } out;
+#pragma unroll
+            for (int e = 0; e < 8; ++e) out.s[e] = f2bf(decoded[e]);
+            *(uint4*)(b + j * Pitch + k8) = out.v;
+        }
+        __syncthreads();
+        if (wave == 0) {
+            const v8f raw = gemm<Group / 16>(a, Pitch, 0, b, Pitch, 0, lane, v8f{});
+            const float sc = ((const float*)(wr + HN))[k0 / Group];
+#pragma unroll
+            for (int e = 0; e < 8; ++e) total[e] = fmaf(raw[e], sc, total[e]);
+        }
+    }
+    // gfx1201 gemm: lane & 15 chooses the column; output e selects A row e
+    // for lanes 0..15 (lanes 16..31 hold rows 8..15). Do not store row zero only.
+    if (wave == 0 && lane < 16) {
+        for (int r = 0; r < rows; ++r)
+            d[r * LR + col] = f2bf(siluf_(total[r] * (1.0f / HC)));
+    }
+}
+
+int64_t scratch(const RadArgs* a) {
+    if (!a) return RAD_E_INVAL;
+    const long long m = r4d_geti_or(a, "M", 0);
+    if (m < 3 || m > 4 || r4d_geti_or(a, "n", 0) != N ||
+        r4d_geti_or(a, "hc", 0) != HC || r4d_geti_or(a, "lowrank", 0) != LR ||
+        r4d_geti_or(a, "inject", 0) != 1 || r4d_geti_or(a, "group", 0) != Group ||
+        r4d_geti_or(a, "rotate", 0) < 0 || r4d_geti_or(a, "rotate", 0) > 1 ||
+        !r4d_gets(a, "dtype") || std::strcmp(r4d_gets(a, "dtype"), "bf16") ||
+        !r4d_gets(a, "mix") || std::strcmp(r4d_gets(a, "mix"), "e4m3")) return RAD_E_SHAPE;
+    return m * (LR * 2 + kHcMax * 4) + Slots * 4;
+}
+
+bool dense(const RadTensor* t, uint32_t dt, int width, int rows, unsigned align) {
+    if (!t || !t->data || t->dtype != dt || t->rank != 2 || t->shape[0] != rows ||
+        t->shape[1] != width || ((uintptr_t)t->data & (align - 1))) return false;
+    long long count = 0;
+    return r4d_rows_pitch(t, width, &count) == width && count == rows;
+}
+
+int body(const RadArgs* a, const R4dSink& sk) {
+    const int64_t need = scratch(a);
+    if (need < 0) return (int)need;
+    if (!a->t || a->n_t != 11) return RAD_E_INVAL;
+    const auto* h = r4d_opt(a, HCR_H), *w = r4d_opt(a, HCR_W);
+    const auto* dw = r4d_opt(a, HCR_DOWN), *up = r4d_opt(a, HCR_UP);
+    const auto* iw = r4d_opt(a, HCR_INJW), *x = r4d_opt(a, HCR_X), *inj = r4d_opt(a, HCR_INJ);
+    const auto* q = r4d_opt(a, HCR_Q), *qs = r4d_opt(a, HCR_S);
+    const auto* rq = r4d_opt(a, HCR_RQ), *rqs = r4d_opt(a, HCR_RS);
+    if (!h || !w || !dw || !up || !iw || !x || !inj) return RAD_E_INVAL;
+    if (h->dtype != RAD_BF16 || w->dtype != RAD_F32 || dw->dtype != RAD_F8E4M3 ||
+        up->dtype != RAD_F8E4M3 || iw->dtype != RAD_BF16 || x->dtype != RAD_BF16 ||
+        inj->dtype != RAD_BF16) return RAD_E_DTYPE;
+    const int rows = (int)h->shape[0], band = (int)r4d_geti_or(a, "M", 0);
+    if (h->rank != 2 || rows < 3 || rows > band || rows > 4 ||
+        w->rank != 1 || w->shape[0] != HN || iw->rank != 2 ||
+        iw->shape[0] != HC || iw->shape[1] != HN || dw->rank != 2 ||
+        dw->shape[0] != LR || dw->shape[1] != HN || up->rank != 2 ||
+        up->shape[0] != HN || up->shape[1] != LR) return RAD_E_SHAPE;
+    if (!dense(h, RAD_BF16, HN, rows, 16) || !dense(x, RAD_BF16, N, rows, 2) ||
+        !dense(inj, RAD_BF16, HC, rows, 2) || !r4d_contig(w) || !r4d_contig(iw) ||
+        !r4d_contig(dw) || !r4d_contig(up) ||
+        ((uintptr_t)w->data & 3u) ||
+        (((uintptr_t)iw->data | (uintptr_t)dw->data | (uintptr_t)up->data) & 15u))
+        return RAD_E_STRIDE;
+    if ((q != nullptr) != (qs != nullptr) || (rq != nullptr) != (rqs != nullptr) || (rq && !q) ||
+        (bool)rq != (r4d_geti_or(a, "rotate", 0) == 1)) return RAD_E_INVAL;
+    if (q && q->dtype != RAD_I8 && q->dtype != RAD_F8E4M3) return RAD_E_DTYPE;
+    if (q && qs->dtype != RAD_F32) return RAD_E_DTYPE;
+    if (rq && (rq->dtype != RAD_F8E4M3 || rqs->dtype != RAD_F32)) return RAD_E_DTYPE;
+    if (q && (!dense(q, q->dtype, N, rows, 4) || !dense(qs, RAD_F32, N / Group, rows, 4)))
+        return RAD_E_STRIDE;
+    if (rq && (!dense(rq, RAD_F8E4M3, N, rows, 4) ||
+               !dense(rqs, RAD_F32, N / Group, rows, 4))) return RAD_E_STRIDE;
+    if (!a->scratch || a->scratch_bytes < need || ((uintptr_t)a->scratch & 15u)) return RAD_E_SCRATCH;
+    const float eps = (float)r4d_getf(a, "eps", 1e-6), wadd = (float)r4d_getf(a, "wadd", 0.0);
+    auto* d = (unsigned short*)a->scratch;
+    auto* scales = (float*)(d + band * LR);
+    auto* ctr = (unsigned int*)(scales + band * kHcMax);
+    int rc = R4D_EMIT(sk, down, dim3(LR / 16 + 1), dim3(kThreads),
+                      HN * sizeof(unsigned short), (const unsigned short*)h->data,
+                      (const float*)w->data, (const unsigned char*)dw->data,
+                      (const unsigned short*)iw->data, d, (unsigned short*)inj->data,
+                      scales, ctr, rows, eps, wadd);
+    if (rc != RAD_OK) return rc;
+    return hc_up_mix_launch(up, UpPitch, true, q && q->dtype == RAD_I8, d,
+        (const unsigned short*)h->data, (const float*)w->data, scales,
+        (unsigned short*)x->data, q ? (unsigned char*)q->data : nullptr,
+        q ? (float*)qs->data : nullptr, rq ? (unsigned char*)rq->data : nullptr,
+        rq ? (float*)rqs->data : nullptr, q ? ctr : nullptr, rows, N, HC, LR,
+        HN, N, N, N / Group, N, N / Group, wadd, sk);
+}
+R4D_ENTRY(rad_hc_down_multirow, body)
+
+const RadKernelInfo* row() {
+    static const RadConstraint constraints[] = {
+        RAD_CGE("M", 3), RAD_CLE("M", 4), RAD_CEQ("n", N), RAD_CEQ("hc", HC),
+        RAD_CEQ("lowrank", LR), RAD_CEQ("inject", 1), RAD_CEQ("group", Group),
+        RAD_CIN("dtype", "bf16"), RAD_CIN("mix", "e4m3"),
+    };
+    static const RadKernelInfo value = [] {
+        RadKernelInfo r{};
+        r.name = "hc_down_wmma_m3_m4_probe"; r.op = "hc_read"; r.family = "norm";
+        r.computes = "BF16 normalized N; multirow unscaled BF16 WMMA down; original inject/up/mix/quant";
+        r.shape = "M=3..4 n=2560 hc=4 lowrank=320 inject=1 group=128 tight rows";
+        r.dtypes = "BF16 H/inject/x; E4M3+FP32 per-group down/up; I8/E4M3 optional q";
+        r.domain = RAD_DOMAIN_DEVICE; r.priority = 0;
+        r.constraints = constraints; r.n_constraints = sizeof(constraints) / sizeof(constraints[0]);
+        r.launch = rad_hc_down_multirow; r.describe = rad_hc_down_multirow_describe;
+        r.scratch = scratch; r.layout = r4d_rad_layout_hc_e4m3;
+        r.relayout = r4d_rad_relayout_hc_e4m3;
+        r.unrelayout = r4d_rad_unrelayout_hc_e4m3; r.opd_shape = r4d_shape_hc_read;
+        return r;
+    }();
+    return &value;
+}
+} // namespace hc_down_multirow
+#pragma GCC visibility pop
+
+extern "C" uint32_t rad_plugin_abi_version() { return RAD_ABI_VERSION; }
+extern "C" const RadPluginInfo* rad_plugin_info() {
+    static const RadPluginInfo info = {RAD_PLUGIN_KERNEL, "hc_down_multirow", "0.0.0", "isolated multirow HC down probe", "gfx1201"};
+    return &info;
+}
+extern "C" int rad_kernel_schema_count() { return 0; }
+extern "C" const RadOpSchema* rad_kernel_schema_at(int) { return nullptr; }
+extern "C" int rad_kernel_count() { return 1; }
+extern "C" const RadKernelInfo* rad_kernel_at(int i) {
+    return i == 0 ? hc_down_multirow::row() : nullptr;
+}
diff --git a/reports/betterbench-1200-campaign/hc-down-probe/hc_down_splitk.hip b/reports/betterbench-1200-campaign/hc-down-probe/hc_down_splitk.hip
new file mode 100644
index 0000000000000000000000000000000000000000..ca0af66c144f11188bbe86ca4eb2a22110976531
--- /dev/null
+++ b/reports/betterbench-1200-campaign/hc-down-probe/hc_down_splitk.hip
@@ -0,0 +1,321 @@
+// Standalone split-K HC down prototype; never registered in mine or the serving plugin.
+// Row name is kept as hc_down_wmma_m3_m4_probe only because the frozen comparator selects
+// the row by that name; it is still a private, unregistered experiment.
+//
+// numerik: verlustfrei-nicht-bitgenau. ONLY the FP32 reduction over the 80 independent
+// 128-code down groups changes: wave w folds groups g = w, w+8, ... (its own ten) with the
+// existing `fmaf(raw, scale, total)` in ascending g, and the eight wave partials are then
+// summed in FP32 in ascending wave order. Inside a group nothing moves: the eight staged
+// 16-K chunks each feed the SAME FP32 accumulator (`gemm<1>` with the running raw as its C),
+// which is the instruction sequence gemm<8> issues, so the 128-code raw dot is bit-identical
+// to the unsplit row; the group's existing FP32 scale is still applied to that FP32 raw dot
+// after the group, and every intermediate format stays FP32 or exact E4M3-as-BF16.
+// No scaled weight is narrowed, no accumulator is narrowed, E4M3 codes remain exact in BF16,
+// and the original 256-thread RMS order, __frsqrt_rn, normalized-N f2bf boundary, inject
+// reduction, down f2bf(silu(...)) boundary and the unchanged upstream up/mix/quant kernel
+// are all untouched. This is a source-level declaration, not a parity measurement.
+#ifdef __FAST_MATH__
+#error "HC down probe requires strict floating point compilation"
+#endif
+#include "rad_abi.h"
+#pragma GCC visibility push(hidden)
+#include "../../../mine/hc_up_wmma.hip"
+#pragma GCC visibility pop
+
+// HC_PUBLISH_PARALLEL=0 (default): grid 21, the single publisher CTA 20 loops every row.
+// HC_PUBLISH_PARALLEL=1: grid 20+M, publisher CTA 20+r publishes row r only, and CTR zeroing
+// happens in publisher 0 alone, still ahead of the next kernel in this stream.
+#ifndef HC_PUBLISH_PARALLEL
+#define HC_PUBLISH_PARALLEL 0
+#endif
+static_assert(HC_PUBLISH_PARALLEL == 0 || HC_PUBLISH_PARALLEL == 1,
+              "HC_PUBLISH_PARALLEL is the 0/1 publication-variant switch");
+
+namespace hc_down_splitk {
+constexpr int N = 2560, HC = 4, LR = 320, HN = N * HC, Group = 128;
+constexpr int DownPitch = r4d_hc8::row_bytes(HN, Group);
+constexpr int UpPitch = r4d_hc8::row_bytes(LR, LR / 4);
+constexpr int Slots = 2 * N / Group;              // 40 arrival counters of the next kernel
+constexpr int TileCols = 16;                      // down columns owned by one CTA
+constexpr int kMaxRows = 4;                       // M band this row serves
+constexpr int Chunk = 16;                         // K staged per subchunk: one WMMA step
+constexpr int Pitch = 24;                         // padded row pitch of the 16-K A/B chunks
+constexpr int Groups = HN / Group;                // 80 independent 128-code groups
+constexpr int GroupsPerWave = Groups / kWaves;    // 10 groups per wave, one per iteration
+constexpr bool kPar = HC_PUBLISH_PARALLEL != 0;
+
+static_assert(kWave == 2 * TileCols, "one lane per 8-element item of a 16-row chunk");
+static_assert(DownPitch == 10560 && UpPitch == 336);
+static_assert(Groups % kWaves == 0 && Group % Chunk == 0 && Chunk % 8 == 0);
+static_assert(Pitch >= Chunk + 8 && Pitch % 8 == 0, "fragment reads k and k+8, 8-byte aligned");
+
+// Grid (20 + (kPar ? M : 1)): 20 CTAs own 16 down columns each; CTAs 20..20+M-1 publish.
+// Scratch: [band*LR BF16 d][band*kHcMax FP32 scales][40 u32 arrival counters], unchanged.
+// Across all eight waves, A and B each occupy 6 KiB (16x24 BF16 per wave).
+// The two staging arrays total 12 KiB; only live-row partials occupy another 2 KiB.
+__global__ __launch_bounds__(kThreads)
+void down(const unsigned short* __restrict__ h, const float* __restrict__ w,
+          const unsigned char* __restrict__ dw, const unsigned short* __restrict__ iw,
+          unsigned short* __restrict__ d, unsigned short* __restrict__ inj,
+          float* __restrict__ scale, unsigned int* __restrict__ ctr,
+          int rows, float eps, float wadd) {
+    extern __shared__ __attribute__((aligned(16))) unsigned short sN[];
+    __shared__ float part[kWaves][kHcMax], norms[kMaxRows][kHcMax];
+    __shared__ unsigned short stage[kWaves][kWave * 8];
+    __shared__ float partial[kWaves][kMaxRows][TileCols];
+    __shared__ __attribute__((aligned(16))) unsigned short a[kWaves][TileCols * Pitch];
+    __shared__ __attribute__((aligned(16))) unsigned short b[kWaves][TileCols * Pitch];
+    const int tid = threadIdx.x, wave = tid / kWave, lane = tid % kWave;
+    const int pub = (int)blockIdx.x - LR / TileCols;
+    const bool publisher = pub >= 0;
+    if (pub >= rows) return;                      // M > rows: this publisher owns no row
+    if (pub == 0 && tid < Slots) ctr[tid] = 0;    // publisher 0 alone, before the next kernel
+
+    // A parallel publisher needs only its own row's scale; a serial one needs every row.
+    // Down CTAs always need every row. Both bounds are CTA-uniform.
+    const int r0 = (kPar && publisher) ? pub : 0;
+    const int r1 = (kPar && publisher) ? pub + 1 : rows;
+
+    // Preserve hc_read_a_kernel<true>'s per-row eight-load, eight-add, wave_sum,
+    // eight-wave reduction, and frsqrt order. M=3 with band=4 visits three rows.
+    for (int r = r0; r < r1; ++r) {
+        const unsigned short* hp = h + r * HN;
+        for (int c = 0; c < HC; ++c) {
+            const int cb = c * N;
+            float acc = 0.0f;
+            int i = tid;
+            for (; i + 7 * kThreads < N; i += 8 * kThreads) {
+                unsigned short hv[8];
+#pragma unroll
+                for (int p = 0; p < 8; ++p) hv[p] = hp[cb + i + p * kThreads];
+#pragma unroll
+                for (int p = 0; p < 8; ++p) { const float v = bf2f(hv[p]); acc += v * v; }
+            }
+            for (; i < N; i += kThreads) { const float v = bf2f(hp[cb + i]); acc += v * v; }
+            acc = wave_sum(acc);
+            if (lane == 0) part[wave][c] = acc;
+        }
+        __syncthreads();
+        if (tid < HC) {
+            float ss = 0.0f;
+            for (int k = 0; k < kWaves; ++k) ss += part[k][tid];
+            norms[r][tid] = __frsqrt_rn(ss / (float)N + eps);
+            if (publisher) scale[r * kHcMax + tid] = norms[r][tid];
+        }
+        __syncthreads();
+    }
+
+    if (publisher) {
+        // Only a publisher needs the whole 10240-element normalized row in LDS; it reuses
+        // the same storage per physical row. The inject dot keeps its original order.
+        for (int r = r0; r < r1; ++r) {
+            const unsigned short* hp = h + r * HN;
+            for (int c = 0; c < HC; ++c) {
+                const int cb = c * N;
+                const float sc = norms[r][c];
+                int i = tid;
+                for (; i + 7 * kThreads < N; i += 8 * kThreads) {
+                    float wv[8];
+                    unsigned short hv[8];
+#pragma unroll
+                    for (int p = 0; p < 8; ++p) {
+                        wv[p] = w[cb + i + p * kThreads];
+                        hv[p] = hp[cb + i + p * kThreads];
+                    }
+#pragma unroll
+                    for (int p = 0; p < 8; ++p)
+                        sN[cb + i + p * kThreads] = f2bf(bf2f(hv[p]) * sc * (wv[p] + wadd));
+                }
+                for (; i < N; i += kThreads)
+                    sN[cb + i] = f2bf(bf2f(hp[cb + i]) * sc * (w[cb + i] + wadd));
+            }
+            __syncthreads();
+            for (int c = wave; c < HC; c += kWaves) {
+                const float sum = wave_sum(wave_dot_lds<kDotU>(sN, iw + c * HN, HN, lane, stage[wave]));
+                if (lane == 0) inj[r * HC + c] = f2bf(2.0f * sigmoidf_(sum * (1.0f / HC)));
+            }
+            __syncthreads();
+        }
+        return;
+    }
+
+    // Down dot. Every wave owns ten independent 128-code groups and stages only its own
+    // 16-row A and 16-column B chunk, one 8-element item per lane each. All eight waves run
+    // the same GroupsPerWave*Group/Chunk iterations, so every block barrier is uniform.
+    unsigned short* const aw = a[wave];
+    unsigned short* const bw = b[wave];
+    const int col = blockIdx.x * TileCols + (lane & 15);
+    // One 8-element item per lane: item i covers row/column i>>1 and K half (i&1)*8, so the
+    // 32 lanes fill a 16x16 chunk exactly. frag() then reads k = {0..3, 8..11} for lane>>4 == 0
+    // and {4..7, 12..15} for lane>>4 == 1, which is the "two runs of four" layout.
+    const int ir = lane >> 1, ik = (lane & 1) * 8;
+    const float* const wsc = (const float*)(dw + col * DownPitch + HN);
+    v8f total = {};
+    for (int i = 0; i < GroupsPerWave; ++i) {
+        const int g = wave + i * kWaves;
+        v8f raw = {};
+        for (int s = 0; s < Group / Chunk; ++s) {
+            const int k0 = g * Group + s * Chunk;
+            __syncthreads();
+            union { uint4 v; unsigned short s[8]; } av, bv;
+            if (ir < rows) {
+                const unsigned short* hp = h + ir * HN + k0 + ik;
+                const float* wp = w + k0 + ik;
+                const float sc = norms[ir][(k0 + ik) / N];
+                unsigned short hv[8];
+                float wv[8];
+#pragma unroll
+                for (int e = 0; e < 8; ++e) { hv[e] = hp[e]; wv[e] = wp[e]; }
+#pragma unroll
+                for (int e = 0; e < 8; ++e) av.s[e] = f2bf(bf2f(hv[e]) * sc * (wv[e] + wadd));
+            } else {
+                av.v = make_uint4(0, 0, 0, 0);
+            }
+            *(uint4*)(aw + ir * Pitch + ik) = av.v;
+            const int column = blockIdx.x * TileCols + ir;
+            const uint2 codes = *(const uint2*)(dw + column * DownPitch + k0 + ik);
+            float decoded[8];
+            e4m3x8(codes.x, codes.y, decoded);
+#pragma unroll
+            for (int e = 0; e < 8; ++e) bv.s[e] = f2bf(decoded[e]);
+            *(uint4*)(bw + ir * Pitch + ik) = bv.v;
+            __syncthreads();
+            // Running raw as C: the same mma chain gemm<Group/16> would issue over this group.
+            raw = gemm<1>(aw, Pitch, 0, bw, Pitch, 0, lane, raw);
+        }
+        // The existing FP32 group scale applies to the FP32 128-code raw dot, after the group.
+        const float sc = wsc[g];
+#pragma unroll
+        for (int e = 0; e < 8; ++e) total[e] = fmaf(raw[e], sc, total[e]);
+    }
+    // gfx1201 gemm: lane & 15 selects the column, output e selects A row e for lanes 0..15.
+    // Only the live rows reach LDS; rows 8..15 of lanes 16..31 never store.
+    if (lane < TileCols) {
+#pragma unroll
+        for (int rr = 0; rr < kMaxRows; ++rr)
+            if (rr < rows) partial[wave][rr][lane] = total[rr];
+    }
+    __syncthreads();
+    if (tid < kMaxRows * TileCols) {
+        const int rr = tid / TileCols, lc = tid % TileCols;
+        if (rr < rows) {
+            float acc = 0.0f;
+#pragma unroll
+            for (int k = 0; k < kWaves; ++k) acc += partial[k][rr][lc];
+            d[rr * LR + blockIdx.x * TileCols + lc] = f2bf(siluf_(acc * (1.0f / HC)));
+        }
+    }
+}
+
+int64_t scratch(const RadArgs* a) {
+    if (!a) return RAD_E_INVAL;
+    const long long m = r4d_geti_or(a, "M", 0);
+    if (m < 3 || m > 4 || r4d_geti_or(a, "n", 0) != N ||
+        r4d_geti_or(a, "hc", 0) != HC || r4d_geti_or(a, "lowrank", 0) != LR ||
+        r4d_geti_or(a, "inject", 0) != 1 || r4d_geti_or(a, "group", 0) != Group ||
+        r4d_geti_or(a, "rotate", 0) < 0 || r4d_geti_or(a, "rotate", 0) > 1 ||
+        !r4d_gets(a, "dtype") || std::strcmp(r4d_gets(a, "dtype"), "bf16") ||
+        !r4d_gets(a, "mix") || std::strcmp(r4d_gets(a, "mix"), "e4m3")) return RAD_E_SHAPE;
+    return m * (LR * 2 + kHcMax * 4) + Slots * 4;
+}
+
+bool dense(const RadTensor* t, uint32_t dt, int width, int rows, unsigned align) {
+    if (!t || !t->data || t->dtype != dt || t->rank != 2 || t->shape[0] != rows ||
+        t->shape[1] != width || ((uintptr_t)t->data & (align - 1))) return false;
+    long long count = 0;
+    return r4d_rows_pitch(t, width, &count) == width && count == rows;
+}
+
+int body(const RadArgs* a, const R4dSink& sk) {
+    const int64_t need = scratch(a);
+    if (need < 0) return (int)need;
+    if (!a->t || a->n_t != 11) return RAD_E_INVAL;
+    const auto* h = r4d_opt(a, HCR_H), *w = r4d_opt(a, HCR_W);
+    const auto* dw = r4d_opt(a, HCR_DOWN), *up = r4d_opt(a, HCR_UP);
+    const auto* iw = r4d_opt(a, HCR_INJW), *x = r4d_opt(a, HCR_X), *inj = r4d_opt(a, HCR_INJ);
+    const auto* q = r4d_opt(a, HCR_Q), *qs = r4d_opt(a, HCR_S);
+    const auto* rq = r4d_opt(a, HCR_RQ), *rqs = r4d_opt(a, HCR_RS);
+    if (!h || !w || !dw || !up || !iw || !x || !inj) return RAD_E_INVAL;
+    if (h->dtype != RAD_BF16 || w->dtype != RAD_F32 || dw->dtype != RAD_F8E4M3 ||
+        up->dtype != RAD_F8E4M3 || iw->dtype != RAD_BF16 || x->dtype != RAD_BF16 ||
+        inj->dtype != RAD_BF16) return RAD_E_DTYPE;
+    const int rows = (int)h->shape[0], band = (int)r4d_geti_or(a, "M", 0);
+    if (h->rank != 2 || rows < 3 || rows > band || rows > 4 ||
+        w->rank != 1 || w->shape[0] != HN || iw->rank != 2 ||
+        iw->shape[0] != HC || iw->shape[1] != HN || dw->rank != 2 ||
+        dw->shape[0] != LR || dw->shape[1] != HN || up->rank != 2 ||
+        up->shape[0] != HN || up->shape[1] != LR) return RAD_E_SHAPE;
+    if (!dense(h, RAD_BF16, HN, rows, 16) || !dense(x, RAD_BF16, N, rows, 2) ||
+        !dense(inj, RAD_BF16, HC, rows, 2) || !r4d_contig(w) || !r4d_contig(iw) ||
+        !r4d_contig(dw) || !r4d_contig(up) ||
+        ((uintptr_t)w->data & 3u) ||
+        (((uintptr_t)iw->data | (uintptr_t)dw->data | (uintptr_t)up->data) & 15u))
+        return RAD_E_STRIDE;
+    if ((q != nullptr) != (qs != nullptr) || (rq != nullptr) != (rqs != nullptr) || (rq && !q) ||
+        (bool)rq != (r4d_geti_or(a, "rotate", 0) == 1)) return RAD_E_INVAL;
+    if (q && q->dtype != RAD_I8 && q->dtype != RAD_F8E4M3) return RAD_E_DTYPE;
+    if (q && qs->dtype != RAD_F32) return RAD_E_DTYPE;
+    if (rq && (rq->dtype != RAD_F8E4M3 || rqs->dtype != RAD_F32)) return RAD_E_DTYPE;
+    if (q && (!dense(q, q->dtype, N, rows, 4) || !dense(qs, RAD_F32, N / Group, rows, 4)))
+        return RAD_E_STRIDE;
+    if (rq && (!dense(rq, RAD_F8E4M3, N, rows, 4) ||
+               !dense(rqs, RAD_F32, N / Group, rows, 4))) return RAD_E_STRIDE;
+    if (!a->scratch || a->scratch_bytes < need || ((uintptr_t)a->scratch & 15u)) return RAD_E_SCRATCH;
+    const float eps = (float)r4d_getf(a, "eps", 1e-6), wadd = (float)r4d_getf(a, "wadd", 0.0);
+    auto* d = (unsigned short*)a->scratch;
+    auto* scales = (float*)(d + band * LR);
+    auto* ctr = (unsigned int*)(scales + band * kHcMax);
+    int rc = R4D_EMIT(sk, down, dim3(LR / TileCols + (kPar ? band : 1)), dim3(kThreads),
+                      HN * sizeof(unsigned short), (const unsigned short*)h->data,
+                      (const float*)w->data, (const unsigned char*)dw->data,
+                      (const unsigned short*)iw->data, d, (unsigned short*)inj->data,
+                      scales, ctr, rows, eps, wadd);
+    if (rc != RAD_OK) return rc;
+    // kUpRows/HC=16: four CTAs per 128-channel group, one stream's counter
+    // is initialized by kernel A and self-reset by upstream kernel B.
+    return hc_up_mix_launch(up, UpPitch, true, q && q->dtype == RAD_I8, d,
+        (const unsigned short*)h->data, (const float*)w->data, scales,
+        (unsigned short*)x->data, q ? (unsigned char*)q->data : nullptr,
+        q ? (float*)qs->data : nullptr, rq ? (unsigned char*)rq->data : nullptr,
+        rq ? (float*)rqs->data : nullptr, q ? ctr : nullptr, rows, N, HC, LR,
+        HN, N, N, N / Group, N, N / Group, wadd, sk);
+}
+R4D_ENTRY(rad_hc_down_splitk, body)
+
+const RadKernelInfo* row() {
+    static const RadConstraint constraints[] = {
+        RAD_CGE("M", 3), RAD_CLE("M", 4), RAD_CEQ("n", N), RAD_CEQ("hc", HC),
+        RAD_CEQ("lowrank", LR), RAD_CEQ("inject", 1), RAD_CEQ("group", Group),
+        RAD_CIN("dtype", "bf16"), RAD_CIN("mix", "e4m3"),
+    };
+    static const RadKernelInfo value = [] {
+        RadKernelInfo r{};
+        r.name = "hc_down_wmma_m3_m4_probe"; r.op = "hc_read"; r.family = "norm";
+        r.computes = "BF16 normalized N; eight-wave split-K unscaled BF16 WMMA down; original inject/up/mix/quant";
+        r.shape = "M=3..4 n=2560 hc=4 lowrank=320 inject=1 group=128 tight rows";
+        r.dtypes = "BF16 H/inject/x; E4M3+FP32 per-group down/up; I8/E4M3 optional q";
+        r.domain = RAD_DOMAIN_DEVICE; r.priority = 0;
+        r.constraints = constraints; r.n_constraints = sizeof(constraints) / sizeof(constraints[0]);
+        r.launch = rad_hc_down_splitk; r.describe = rad_hc_down_splitk_describe;
+        r.scratch = scratch; r.layout = r4d_rad_layout_hc_e4m3;
+        r.relayout = r4d_rad_relayout_hc_e4m3;
+        r.unrelayout = r4d_rad_unrelayout_hc_e4m3; r.opd_shape = r4d_shape_hc_read;
+        return r;
+    }();
+    return &value;
+}
+} // namespace hc_down_splitk
+
+// This DSO is an isolated experiment, not the actual serving mine plugin.
+extern "C" uint32_t rad_plugin_abi_version() { return RAD_ABI_VERSION; }
+extern "C" const RadPluginInfo* rad_plugin_info() {
+    static const RadPluginInfo info = {RAD_PLUGIN_KERNEL, "hc_down_splitk", "0.0.0", "isolated split-K HC down probe", "gfx1201"};
+    return &info;
+}
+// This row implements the existing hc_read schema; the installed libr4d owns it.
+extern "C" int rad_kernel_schema_count() { return 0; }
+extern "C" const RadOpSchema* rad_kernel_schema_at(int) { return nullptr; }
+extern "C" int rad_kernel_count() { return 1; }
+extern "C" const RadKernelInfo* rad_kernel_at(int i) {
+    return i == 0 ? hc_down_splitk::row() : nullptr;
+}
