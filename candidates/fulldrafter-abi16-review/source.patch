+
+    using CrossGpuArgmaxFn = int (*)(const uint32_t*, const float*, const uint32_t*, const float*, uint32_t*, int);
+    auto fn = reinterpret_cast<CrossGpuArgmaxFn>(dlsym(handle, "r4d_rad_ar_cross_gpu_argmax_tp2"));
