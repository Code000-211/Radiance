+def f32_to_bf16_rounded(f: float) -> int:
+    """Emulates `round_bf16_val` from r4d_fulldrafter.hip."""
+    u32 = struct.unpack("<I", struct.pack("<f", float(f)))[0]
+    h = (u32 + 0x7FFF + ((u32 >> 16) & 1)) >> 16
+    return h & 0xFFFF
+
