+std::string cell(const json& summary, const char* key) {
+    if (!summary.contains(key) || summary[key].is_null()) return "–";
+    const json& v = summary[key];
+    std::string out = num(v["median"]);
+    if (v["min"] != v["max"]) out += " (" + num(v["min"]) + "–" + num(v["max"]) + ")";
