+        // 5. Write SCR_H2: 7 * H_DIM floats
+        float* h2 = reinterpret_cast<float*>(slice_base + SCR_H2_OFF);
+        for (int i = 0; i < 7 * H_DIM; ++i) h2[i] = static_cast<float>(rng() % 1000) / 10.0f;
