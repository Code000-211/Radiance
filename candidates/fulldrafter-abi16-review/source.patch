+TEST(builtin_corpus_covers_the_categories) {
+    const std::vector<CorpusEntry> c = builtin_corpus();
+    for (const char* cat : { "code", "reasoning", "prose", "json", "file_edit", "summarization" }) {
+        int n = 0;
+        for (const auto& e : c)
+            if (e.category == cat) {
+                ++n;
