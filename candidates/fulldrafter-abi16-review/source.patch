+/* ------------------------------------------------------------------ runs and interference */
+
+TEST(runs_summarise_to_median_and_range) {
+    std::vector<json> runs;
+    for (double v : { 30.0, 10.0, 20.0 }) {
+        json r;
+        r["requests"]["aggregate_tok_s"] = v;
+        r["counters"]["draft_acceptance"] = nullptr;   /* no run measured it */
+        runs.push_back(r);
