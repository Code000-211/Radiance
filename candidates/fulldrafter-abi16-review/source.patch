+        int rc_step = engine.collect_step(&batch, so); if (rc_step != RAD_OK) { std::fprintf(stderr, "collect_step step %d failed with rc=%d: %s\n", step, rc_step, rad_strerror(rc_step)); } EMPIRICAL_ASSERT(rc_step == RAD_OK);
