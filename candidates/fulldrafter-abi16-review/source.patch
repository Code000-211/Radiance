+  span+=extent*stride;
+ }
+ bytes=span*4;
+ if(reinterpret_cast<uintptr_t>(t.data)>UINTPTR_MAX-bytes) return RAD_E_INVAL;
+ return RAD_OK;
+}
+int args(const RadArgs* a,RadMtpPrunedTreeCall* out,int op) {
+ if(!a || !out || !a->t || a->n_t!=(op==2 ? 4 : 8)) return RAD_E_INVAL;
