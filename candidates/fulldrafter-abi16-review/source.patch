+    __shared__ float s_h_lds[FULLDRAFTER_TOTAL_K * 256]; // 12,288 B FP32 LDS (<= 16 KiB -> 16 Waves/SIMD true R9700 occupancy!)
+    __shared__ uint32_t s_unres_mask;
