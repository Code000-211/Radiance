+        if (rad_stream_create(&value, 0) != RAD_OK) throw std::runtime_error("native stream");
+    }
+    void sync() {
+        if (rad_stream_sync(value) != RAD_OK) throw std::runtime_error("native sync");
+    }
+    ~Stream() { if (value) rad_stream_destroy(value); }
+};
