+
+    std::vector<RadTensor> cand_t = cand_side.bind(sc.cand);
+    std::vector<RadTensor> rt = ref_side.bind(sc.ref);
+    std::vector<RadTensor> conv_t(rt.begin(), rt.begin() + 4);
+    std::vector<RadTensor> add_t(rt.begin() + 4, rt.end());
