+        float hazard = 1.0f / (1.0f + expf(-logit));
+        float* surv  = (float*)(s_base + ALODLM_SURV_OFF);
+        surv[j] = round_bf16_val(1.0f - hazard);
+        if (local_j == 0) {
+            *(uint32_t*)(s_base + ALODLM_DEPTHS_OFF) = (uint32_t)depth;
+        }
+    }
