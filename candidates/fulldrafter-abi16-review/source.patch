+    batch.n_spec = 15;
+
+    Engine::StepOut so;
+    so.n_rows = 16;
+    int32_t sample_rows[16];
+    for (int i = 0; i < 15; ++i) sample_rows[i] = 10 + i;
+    sample_rows[15] = 999; // leaf bonus
+    so.rb = sample_rows;
+    so.first_row = { 0 };
+
+    // Before collect_step: record exists
+    RAD_ASSERT(reg.get(seq_id, &trec));
+
