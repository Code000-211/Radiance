+    if (victim >= 0) {
+        if ((size_t)victim >= unit_.size()) return RAD_E_INVAL;
+        UnitState& vs = unit_[(size_t)victim];
+        if (vs.slab_slot < 0 || vs.klass != us.klass) return RAD_E_INVAL;
