+    RadKernelInfo r=rad_mtp_hybrid_lse_row(fn); r.name="mine_mtp_scored_merge_tree_accum"; r.op=schemas[1].op;
+    r.computes=schemas[1].doc; r.shape="TP2, pitch8, capacity2..8, rounds3/5, policy0/1/2";
