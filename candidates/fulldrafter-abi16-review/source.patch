+    CandidateTree tree;
+    tree.build_top2(5u, cands, false, 15);
+    CHECK_OK(sched.set_draft_tree(1, tree, 17));
+
+    REQUIRE(s.req->tree_parent && s.req->tree_depth);
+    CHECK_EQ(s.req->tree_parent[0], -1);
+    CHECK_EQ(s.req->tree_depth[0], 0);
