+    float sq = 0.0f;
+    for (int i = tid; i < H_DIM; i += 256) {
+        float v = s_h[i];
+        s_lat[i] = v;
+        sq += v * v;
+    }
+    float sum_sq = block_reduce_sum(sq);
+    float scale  = rsqrtf(sum_sq / static_cast<float>(H_DIM) + FULLDRAFTER_RMS_NORM_EPS);
