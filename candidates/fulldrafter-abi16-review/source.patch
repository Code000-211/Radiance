+    for (int64_t i = 0; i < nslot; ++i) {
+        const int32_t f = s.sorted[(size_t)i];
+        if (f >= 0 && f < nslot) at[(size_t)f] = (int32_t)i;
+    }
+    out->assign((size_t)(g.M * g.n), 0);
+    for (int64_t m = 0; m < g.M; ++m) {
+        for (int64_t i = 0; i < g.n; ++i) {
+            float acc = 0.0f;
+            for (int64_t j = 0; j < g.top_k; ++j) {
+                const int32_t rr = at[(size_t)(m * g.top_k + j)];
+                if (rr < 0) continue;
+                acc += h_bf16(s.ew[(size_t)(m * g.top_k + j)]) *
+                       h_bf16(s.ye[(size_t)(rr * g.n + i)]);
+            }
+            (*out)[(size_t)(m * g.n + i)] = h_to_bf16(acc);
+        }
+    }
+}
+
+struct HcSweep {
+    const RadKernelInfo* row;
+    int rank, dev;
+    bool gather;
+    int64_t init_M, init_n;      /* the instance's bound: init_M * init_n >= every launch's M*n */
+    void* inst = nullptr;
+    int rc_init = RAD_E_STATE, rc_launch = RAD_OK, rc_sync = -1;
+    std::vector<std::vector<uint16_t>> got_y, got_h;
+};
+
+/* The sweep's two tables, read by both the worker and the verifier. */
+static const HcGeo* hc_geos(bool gather, int* n) {
+    *n = gather ? kHcGatherGeos : kHcWriteGeos;
+    return gather ? kHcGatherGeo : kHcWriteGeo;
+}
+
+static void hc_sweep_worker(HcSweep* t) {
+    if (st_set_device(t->dev) != hipSuccess) { t->rc_init = RAD_E_DEVICE; return; }
+    std::vector<RadParam> ips = {
+        PI("M", t->init_M), PI("n", t->init_n), PS("dtype", "bf16"), PI("world_size", 2),
+    };
+    t->rc_init = t->row->init(ips.data(), (int)ips.size(), t->rank, 2, &t->inst);
+    if (t->rc_init != RAD_OK) return;
+
+    struct Buf {
+        void *y = nullptr, *h = nullptr, *inj = nullptr, *ye = nullptr, *ew = nullptr,
+             *so = nullptr, *sc = nullptr;
+        std::vector<RadTensor> ts;
+        std::vector<RadParam> ps;
+    };
+    int ngeos = 0;
+    const HcGeo* geos = hc_geos(t->gather, &ngeos);
+    std::vector<Buf> b((size_t)ngeos);
+    t->got_y.clear();
+    t->got_y.resize((size_t)ngeos);
+    t->got_h.clear();
+    t->got_h.resize((size_t)ngeos);
+
+    /* PASS ONE: EVERY BUFFER, ALLOCATED AND FILLED. It has to be a pass of its own -- a pageable
+     * host-to-device copy between two launches may drain the stream, and a sweep that drains
+     * between launches never has two handshakes in flight. */
+    for (int k = 0; k < ngeos && t->rc_launch == RAD_OK; ++k) {
+        const HcGeo& g = geos[k];
+        const int64_t irow = hc_irow(g), hrow = hc_hrow(g), nslot = g.M * g.top_k;
+        HcHost hs;
+        hc_host_fill(t->rank, g, k, t->gather, &hs);
+
+        Buf& d = b[(size_t)k];
+        if (hipMalloc(&d.y, (size_t)(g.M * g.n) * 2) != hipSuccess ||
+            hipMalloc(&d.h, (size_t)(g.M * hrow) * 2) != hipSuccess ||
+            hipMalloc(&d.inj, (size_t)(g.M * irow) * 2) != hipSuccess) {
+            t->rc_launch = RAD_E_NOMEM;
+            break;
+        }
+        st_memcpy(d.y, hs.y.data(), hs.y.size() * 2, hipMemcpyHostToDevice);
+        st_memcpy(d.h, hs.h.data(), hs.h.size() * 2, hipMemcpyHostToDevice);
+        st_memcpy(d.inj, hs.inj.data(), hs.inj.size() * 2, hipMemcpyHostToDevice);
+
+        d.ps = {
+            PI("M", g.M), PI("n", g.n), PI("hc", g.hc), PI("world_size", 2),
+            PS("dtype", "bf16"), PI("drain", g.drain),
+        };
+        if (g.nblocks > 0) d.ps.push_back(PI("nblocks", g.nblocks));
+
+        RadTensor ty = T(d.y, RAD_BF16, { g.M, g.n });
+        RadTensor ti = T(d.inj, RAD_BF16, { g.M, g.hc });
+        RadTensor th = T(d.h, RAD_BF16, { g.M, g.hc * g.n });
+        ti.stride[0] = irow;
+        th.stride[0] = hrow;
+
+        if (t->gather) {
+            if (hipMalloc(&d.ye, (size_t)(nslot * g.n) * 2) != hipSuccess ||
+                hipMalloc(&d.ew, (size_t)(g.M * g.top_k) * 2) != hipSuccess ||
+                hipMalloc(&d.so, (size_t)nslot * 4) != hipSuccess) {
+                t->rc_launch = RAD_E_NOMEM;
+                break;
+            }
+            st_memcpy(d.ye, hs.ye.data(), hs.ye.size() * 2, hipMemcpyHostToDevice);
+            st_memcpy(d.ew, hs.ew.data(), hs.ew.size() * 2, hipMemcpyHostToDevice);
+            st_memcpy(d.so, hs.sorted.data(), hs.sorted.size() * 4, hipMemcpyHostToDevice);
+            if (g.inv && hipMalloc(&d.sc, (size_t)nslot * 4) != hipSuccess) {
+                t->rc_launch = RAD_E_NOMEM;
+                break;
+            }
+            d.ps.push_back(PI("top_k", g.top_k));
+            RadTensor tye = T(d.ye, RAD_BF16, { nslot, g.n });
+            RadTensor tew = T(d.ew, RAD_BF16, { g.M, g.top_k });
+            RadTensor tso = T(d.so, RAD_I32, { nslot });
+            RadTensor none;
+            std::memset(&none, 0, sizeof(none));         /* shared / shared_gate absent */
+            d.ts = { tye, tew, tso, none, none, ty, ti, th };
+        } else {
+            d.ts = { ty, ti, th };
+        }
+    }
+
+    /* PASS TWO: THE LAUNCHES, BACK TO BACK. Nothing between them but the next launch. */
+    for (int k = 0; k < ngeos && t->rc_launch == RAD_OK; ++k) {
+        const HcGeo& g = geos[k];
+        Buf& d = b[(size_t)k];
+        RadArgs a;
+        std::memset(&a, 0, sizeof(a));
+        a.t = d.ts.data(); a.n_t = (int)d.ts.size();
+        a.p = d.ps.data(); a.n_p = (int)d.ps.size();
+        a.instance = t->inst;
+        a.rank = t->rank;
+        a.world_size = 2;
+        if (d.sc) { a.scratch = d.sc; a.scratch_bytes = g.M * g.top_k * 4; }
+        t->rc_launch = t->row->launch(&a, nullptr);
+    }
+
+    /* ONE SYNCHRONISATION, AFTER THE LAST LAUNCH. Everything above queued in order on this rank's
+     * stream; the handshakes are what serialise against the peer. */
+    t->rc_sync = st_stream_sync(nullptr);
+
+    for (int k = 0; k < ngeos; ++k) {
+        const HcGeo& g = geos[k];
+        const int64_t hrow = hc_hrow(g);
+        const Buf& d = b[(size_t)k];
+        if (!d.y || !d.h || !d.inj) continue;
+        t->got_y[(size_t)k].resize((size_t)(g.M * g.n));
+        t->got_h[(size_t)k].resize((size_t)(g.M * g.hc * g.n));
+        st_memcpy(t->got_y[(size_t)k].data(), d.y, t->got_y[(size_t)k].size() * 2,
+                  hipMemcpyDeviceToHost);
+        std::vector<uint16_t> all((size_t)(g.M * hrow));
+        st_memcpy(all.data(), d.h, all.size() * 2, hipMemcpyDeviceToHost);
+        for (int64_t m = 0; m < g.M; ++m)
+            for (int64_t c = 0; c < g.hc; ++c)
+                for (int64_t i = 0; i < g.n; ++i)
+                    t->got_h[(size_t)k][(size_t)((m * g.hc + c) * g.n + i)] =
+                        all[(size_t)(m * hrow + c * g.n + i)];
+    }
+
+    for (Buf& d : b) {
+        if (d.y) st_free(d.y);
+        if (d.h) st_free(d.h);
+        if (d.inj) st_free(d.inj);
+        if (d.ye) st_free(d.ye);
+        if (d.ew) st_free(d.ew);
+        if (d.so) st_free(d.so);
+        if (d.sc) st_free(d.sc);
+    }
+}
+
+static void hc_two_rank(const Plugin& pl, const std::vector<int>& devs, bool gather) {
+    const RadKernelInfo* row = find(pl, gather ? "ar_gather_hc_write" : "ar_hc_write");
+    if (!row) {
+        ok(gather ? "ar_gather_hc_write" : "ar_hc_write", false, "row absent");
+        return;
+    }
+    if (devs.size() < 2) {
+        skip(gather ? "ar_gather_hc_write (2 ranks)" : "ar_hc_write (2 ranks)",
+             "fewer than two gfx1201 cards");
+        return;
+    }
+
+    int ngeos = 0;
+    const HcGeo* geos = hc_geos(gather, &ngeos);
+    int64_t bM = 1, bn = 1;
+    for (int k = 0; k < ngeos; ++k) {
+        bM = std::max(bM, geos[k].M);
+        bn = std::max(bn, geos[k].n);
+    }
+
+    HcSweep a{ row, 0, devs[0], gather, bM, bn };
+    HcSweep b{ row, 1, devs[1], gather, bM, bn };
+    std::thread ta(hc_sweep_worker, &a), tb(hc_sweep_worker, &b);
+    ta.join();
+    tb.join();
+
+    ok(gather ? "2-rank ar_gather_hc_write init (peer rendezvous)"
+              : "2-rank ar_hc_write init (peer rendezvous)",
+       a.rc_init == RAD_OK && b.rc_init == RAD_OK,
+       "rc " + std::to_string(a.rc_init) + "/" + std::to_string(b.rc_init));
+    if (a.rc_init != RAD_OK || b.rc_init != RAD_OK) {
+        if (row->fini) { if (a.inst) row->fini(a.inst); if (b.inst) row->fini(b.inst); }
+        return;
+    }
+
+    ok(gather ? "2-rank ar_gather_hc_write, every launch and the one sync reported clean"
+              : "2-rank ar_hc_write, every launch and the one sync reported clean",
+       a.rc_launch == RAD_OK && b.rc_launch == RAD_OK && a.rc_sync == 0 && b.rc_sync == 0,
+       "rc " + std::to_string(a.rc_launch) + "/" + std::to_string(b.rc_launch) + " launch, " +
+           std::to_string(a.rc_sync) + "/" + std::to_string(b.rc_sync) + " sync");
+
+    /* THE UNFUSED CHAIN, REBUILT FOR BOTH RANKS. The message is the only thing the pair shares:
+     * each rank reduces its own with the peer's, so both must land on one bf16 word per element,
+     * and each rank's write then runs over that word with its own gain and its own h.
+     *
+     * THE ELEMENT COUNTS ARE PART OF THE CHECK. A launch that failed leaves its buffers
+     * unreadable, and "0 of 0 wrong" is the shape a passing case would also print. */
+    int64_t bad_y = 0, bad_h = 0, elems_y = 0, elems_h = 0, want_y = 0, want_h = 0;
+    for (int k = 0; k < ngeos; ++k) {
+        const HcGeo& g = geos[k];
+        const int64_t irow = hc_irow(g), hrow = hc_hrow(g);
+        HcHost h0, h1;
+        hc_host_fill(0, g, k, gather, &h0);
+        hc_host_fill(1, g, k, gather, &h1);
+
+        std::vector<uint16_t> red((size_t)(g.M * g.n));
+        if (gather) {
+            std::vector<uint16_t> y0, y1;
+            hc_gather_ref(h0, g, &y0);
+            hc_gather_ref(h1, g, &y1);
+            for (int64_t i = 0; i < g.M * g.n; ++i)
+                red[(size_t)i] = h_to_bf16(h_bf16(y0[(size_t)i]) + h_bf16(y1[(size_t)i]));
+        } else {
+            for (int64_t i = 0; i < g.M * g.n; ++i)
+                red[(size_t)i] = h_to_bf16(h_bf16(h0.y[(size_t)i]) + h_bf16(h1.y[(size_t)i]));
+        }
+        want_y += 2 * g.M * g.n;
+        want_h += 2 * g.M * g.hc * g.n;
+
+        for (int rank = 0; rank < 2; ++rank) {
+            const HcSweep& t = rank ? b : a;
+            const HcHost& hs = rank ? h1 : h0;
+            if (t.got_y[(size_t)k].size() != red.size() ||
+                t.got_h[(size_t)k].size() != (size_t)(g.M * g.hc * g.n)) {
+                ++bad_y;                       /* the launch or the readback never landed */
+                continue;
+            }
+            for (size_t i = 0; i < red.size(); ++i) {
+                ++elems_y;
+                if (t.got_y[(size_t)k][i] != red[i]) ++bad_y;
+            }
+            for (int64_t m = 0; m < g.M; ++m)
+                for (int64_t c = 0; c < g.hc; ++c) {
+                    const float gain = h_bf16(hs.inj[(size_t)(m * irow + c)]);
+                    for (int64_t i = 0; i < g.n; ++i) {
+                        const size_t o = (size_t)((m * g.hc + c) * g.n + i);
+                        const uint16_t want = hc_away(
+                            h_bf16(hs.h[(size_t)(m * hrow + c * g.n + i)]) +
+                            gain * h_bf16(red[(size_t)(m * g.n + i)]));
+                        ++elems_h;
+                        if (t.got_h[(size_t)k][o] != want) ++bad_h;
+                    }
+                }
+        }
+    }
+
+    ok(gather ? "2-rank ar_gather_hc_write: gather, reduce and write byte-exact against the "
+                "unfused chain"
+              : "2-rank ar_hc_write: reduce and write byte-exact against the unfused chain",
+       bad_y == 0 && bad_h == 0 && elems_y == want_y && elems_h == want_h,
+       fmt("%d launches at drain 1 and 3, %lld of %lld message elements and %lld of %lld stream "
+           "elements wrong", ngeos, (long long)bad_y, (long long)elems_y, (long long)bad_h,
+           (long long)elems_h));
+
+    if (row->fini) { row->fini(a.inst); row->fini(b.inst); }
+}
