+    int stage,
+    int slot,
+    const FullDrafterGpuPointers* p,
+    char* scratch,
+    uint32_t* tokens_out,
+    uint32_t M,
+    hipStream_t stream
+);
+
+// Milestone 3: High-Occupancy Fused Transformer Backbone (H=64)
+int r4d_fulldrafter_stage1_backbone(
+    const void* ktap0,
+    const void* ktap1,
+    const void* ktap2,
+    const void* ktap_anc,
+    const int32_t* token_ids,
+    int block_stride,
+    int total_tok,
+    const FullDrafterGpuPointers* p,
+    char* scratch,
+    uint32_t M,
+    hipStream_t stream
+);
+
+int r4d_fulldrafter_stage2_backbone(
+    const FullDrafterGpuPointers* p,
+    char* scratch,
+    const uint32_t* tokens_out,
+    uint32_t M,
+    hipStream_t stream
+);
+
