+            if(p.kind==RAD_P_INT)geometry.set_i(p.key,p.ival);
+            else if(p.kind==RAD_P_F64)geometry.set_f(p.key,p.dval);
+            else if(p.kind==RAD_P_STR)geometry.set_s(p.key,p.sval);
