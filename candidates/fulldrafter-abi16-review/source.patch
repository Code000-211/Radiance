+                for (int k = 0; k < 6; ++k) {
+                    if ((unres_mask >> k) & 1u) s_o1[k * W_DIM + global_row] = round_bf16_val(acc[k]);
+                    if ((unres_mask >> (6 + k)) & 1u) s_o2[k * W_DIM + global_row] = round_bf16_val(acc[6 + k]);
