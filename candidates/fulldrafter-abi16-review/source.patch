+    constexpr int K_STEPS = D / 256;
+    constexpr int NUM_HALVES = (D == 2560) ? ((ACTIVE_VECS == 4) ? 2 : 5) : 3;
+    constexpr int HALF_STEPS = K_STEPS / NUM_HALVES;
+    constexpr int HALF_PAIRS = HALF_STEPS * 128;
