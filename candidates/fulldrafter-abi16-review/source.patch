+        const std::string item = s.substr(pos, comma == std::string::npos ? std::string::npos : comma - pos);
+        int64_t n = 0;
+        if (!parse_int(flag, item.c_str(), lo, hi, &n)) return false;
+        if (std::find(got.begin(), got.end(), (int)n) != got.end()) {
+            RAD_ERR("%s names %lld twice", flag, (long long)n);
