+    /* Demote layer 4 units to HostPinned so they require prefetching into VRAM */
+    for (int e = 0; e < E; ++e) {
+        int32_t u = prefetcher.find_unit_id(4, e);
+        if (u >= 0) heat.set_tier(u, Tier::HostPinned);
+    }
+    CHECK(heat.tier(u_l4_e0) != Tier::VRAM);
+    CHECK(heat.tier(u_l4_e1) != Tier::VRAM);
+
+    /* 2. Dispatch at layer 0 with a dummy hidden state */
+    std::vector<float> h0(64, 0.5f);
+    CHECK_OK(prefetcher.on_layer_dispatch(0, h0.data(), nullptr));
+
+    /* Candidates were evaluated and prefetch was issued for target units */
+    const CedStats& s1 = prefetcher.stats();
+    CHECK(s1.predictions > 0);
+    CHECK(s1.prefetch_issued > 0);
+
+    /* 3. Hold-down lease protection:
+     * Newly prefetched units must be promoted to VRAM and receive a 30-dispatch hold-down lease. */
+    int prefetched_count = 0;
+    for (int e = 0; e < E; ++e) {
+        int32_t u = prefetcher.find_unit_id(4, e);
+        if (u >= 0 && heat.tier(u) == Tier::VRAM) {
+            CHECK(heat.is_leased(u));
+            CHECK_EQ(heat.lease_remaining(u), 30ull);
+            ++prefetched_count;
+        }
+    }
+    CHECK(prefetched_count > 0);
+
+    /* 4. Active leases cannot be evicted:
+     * When all resident units in the slab class are leased, find_eviction_candidate must return -1. */
+    const size_t klass = (size_t)p.units[(size_t)u_l4_e0].slab_class;
+    for (size_t u = 0; u < p.units.size(); ++u) {
+        if ((size_t)p.units[u].slab_class == klass && heat.tier((int32_t)u) == Tier::VRAM) {
+            heat.register_prefetch((int32_t)u);
+            CHECK(heat.is_leased((int32_t)u));
+        }
+    }
+    CHECK_EQ(heat.find_eviction_candidate(klass), -1);
+
+    /* 5. Lease safety under prefetcher:
+     * When all resident units are actively leased, prefetcher skips eviction rather than evicting. */
+    CHECK_OK(prefetcher.on_layer_dispatch(1, h0.data(), nullptr));
+
+    /* 6. Expiration of leases after 30 dispatches:
+     * Advance HeatEngine by 30 dispatches: */
+    heat.advance_dispatch(30);
+    CHECK_EQ(heat.dispatches(), 30ull);
+
+    /* Leases must now be expired */
+    CHECK(!heat.is_leased(u_l4_e0));
+    CHECK_EQ(heat.lease_remaining(u_l4_e0), 0ull);
+    /* Now eviction candidate search succeeds */
+    int32_t evict = heat.find_eviction_candidate(klass);
+    CHECK(evict >= 0);
+
+    /* 7. Probability threshold tau filtering and top-k capping */
+    CedConfig high_tau_cfg = ccfg;
+    high_tau_cfg.threshold = 0.999f;
+    prefetcher.set_config(high_tau_cfg);
+    prefetcher.reset_stats();
+    CHECK_OK(prefetcher.on_layer_dispatch(0, h0.data(), nullptr));
+    CHECK_EQ(prefetcher.stats().prefetch_issued, 0ull);
+
+    /* 8. Bandwidth throttling check:
+     * Set max_prefetch_bytes to 0; any candidate will exceed quota and trigger pcie_throttled */
+    CedConfig throttle_cfg = ccfg;
+    throttle_cfg.threshold = 0.001f;
+    throttle_cfg.max_prefetch_bytes = 0;
+    prefetcher.set_config(throttle_cfg);
+    prefetcher.reset_stats();
+    CHECK_OK(prefetcher.on_layer_dispatch(0, h0.data(), nullptr));
+    CHECK(prefetcher.stats().pcie_throttled > 0);
+
+    /* 9. Layer boundary check: dispatching at layer >= (total_layers - lookahead) */
+    prefetcher.reset_stats();
+    CHECK_OK(prefetcher.on_layer_dispatch(2, h0.data(), nullptr));
+    CHECK_EQ(prefetcher.stats().predictions, 0ull);
+}
+
+TEST(ced_prefetch_with_active_mover_and_clustering) {
+    HeatFixture hf(8, 7);
+    Mover m;
+    MoverConfig mc;
+    CHECK_OK(m.init(hf.f.prog, hf.plan, mc));
+    RadStream compute = nullptr;
+    CHECK_OK(rad_stream_create(&compute, 0));
+    CHECK_OK(m.bind_compute_stream(compute));
+
+    HeatEngine heat;
+    HeatParams hp;
+    hp.min_residency_dispatches = 30;
+    CHECK_OK(heat.init(hf.plan, hp));
+
+    CedConfig ccfg;
+    ccfg.enabled = true;
+    ccfg.lookahead = 0;
+    ccfg.hidden_dim = 64;
+    ccfg.rank = 16;
+    ccfg.n_experts = 8;
+    ccfg.n_clusters = 4;
+    ccfg.cluster_top_k = 2;
+    ccfg.filter_by_cluster = true;
+    ccfg.threshold = 0.05f;
+    ccfg.top_k = 2;
+
+    CedPrefetcher prefetcher;
+    CHECK_OK(prefetcher.init(hf.f.prog, hf.plan, &m, &heat, ccfg));
+    CHECK(prefetcher.enabled());
+
+    /* 1. Locate a host-pinned expert unit to prefetch */
+    int32_t target_unit = -1;
+    for (size_t u = 0; u < hf.plan.units.size(); ++u) {
+        if (!m.is_unit_resident((int32_t)u) && hf.plan.units[u].expert >= 0) {
+            target_unit = (int32_t)u;
+            break;
+        }
+    }
+    CHECK(target_unit >= 0);
+    const int32_t target_cls = hf.plan.units[(size_t)target_unit].slab_class;
+    const int target_layer = hf.plan.units[(size_t)target_unit].layer;
+
+    /* 2. Verify Mover queries with real pools for target slab class */
+    CHECK(m.has_free_slab_slot((size_t)target_cls));
+    CHECK(m.free_slab_slots((size_t)target_cls) > 0);
+
+
+    /* 3. Evaluate CED projection and dispatch prefetch */
+    std::vector<float> h0(64, 0.5f);
+    CHECK_OK(prefetcher.on_layer_dispatch(target_layer, h0.data(), nullptr));
+    const CedStats& s = prefetcher.stats();
+    CHECK(s.predictions > 0);
+
+    /* 4. Issue direct async prefetch of target unit into free slab slot */
+    const int rc = m.prefetch_unit_async(target_unit, -1, &heat);
+    CHECK_OK(rc);
+    CHECK(m.stats().prefetched > 0);
+    CHECK(heat.is_leased(target_unit));
+    CHECK_EQ(heat.lease_remaining(target_unit), 30ull);
+
+    /* 5. Verify lease immunity: cannot be chosen as eviction victim while leased */
+    const int32_t slab_cls = hf.plan.units[(size_t)target_unit].slab_class;
+    for (size_t u = 0; u < hf.plan.units.size(); ++u) {
+        if (hf.plan.units[u].slab_class == slab_cls && heat.tier((int32_t)u) == Tier::VRAM) {
+            heat.register_prefetch((int32_t)u);
+        }
+    }
+    CHECK_EQ(heat.find_eviction_candidate(slab_cls), -1);
+
+    /* 6. Verify expiration and eviction candidate recovery */
+    heat.advance_dispatch(30);
+    CHECK(!heat.is_leased(target_unit));
+    CHECK_EQ(heat.lease_remaining(target_unit), 0ull);
+    const int32_t victim = heat.find_eviction_candidate(slab_cls);
+    CHECK(victim >= 0);
+
+    /* 7. Verify Clustered Expert Distribution (CED) cluster mass computation */
+    std::vector<float> mock_probs = {0.4f, 0.05f, 0.01f, 0.02f, 0.3f, 0.1f, 0.02f, 0.1f};
+    std::vector<float> cluster_mass;
+    prefetcher.projector().compute_cluster_mass(mock_probs, cluster_mass);
+    CHECK_EQ(cluster_mass.size(), 4ull);
+    // Cluster 0 (experts 0,1) mass = 0.45, Cluster 2 (experts 4,5) mass = 0.40
+    CHECK_NEAR(cluster_mass[0], 0.45f, 1e-4);
+    CHECK_NEAR(cluster_mass[2], 0.40f, 1e-4);
+
+    /* 8. Verify report string */
+    std::string rep = prefetcher.report();
+    CHECK(!rep.empty());
+    CHECK(rep.find("CED MoE Prefetcher") != std::string::npos);
+
+    rad_stream_sync(m.transfer_stream());
+    rad_stream_destroy(compute);
+}
+
 RAD_TEST_MAIN()
diff --git a/tests/ple_lookup_gpu_test.cpp b/tests/ple_lookup_gpu_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..975b67cb84df49e84c4c1537d8f620cd65045032
--- /dev/null
+++ b/tests/ple_lookup_gpu_test.cpp
@@ -0,0 +1,407 @@
+/* PLE n-gram lookup regression: the specialised 160-wide walk must return each id's own literal
+ * BF16 row, every launch, with no remembered state between launches.
+ *
+ * Three scenarios over the same row of ops:
+ *   collisions -- 32 pairs of distinct ids a stride apart (the id pattern a set-indexed L1 used to
+ *                 collide on), each launch repeated, so a lookup that remembered anything by id
+ *                 alone would answer the second launch from the first one's payload;
+ *   identity   -- the same LOCAL ids through two immutable tables, two vocab shards and three
+ *                 scales, launched in turn, so a lookup keyed on `tok - vocab_off` alone returns
+ *                 another table's, another shard's or another scale's row;
+ *   boundary   -- padding ids, an id at n_vocab, an id past it and the last in-range id.
+ *
+ * Every expectation is computed here from the literal E4M3 code and the literal scale
+ * (`expected_cell`), never from the kernel, so this is an oracle comparison and not a self-check.
+ *
+ * Usage: ple_lookup_gpu_test [libr4d.so] [rounds], default 1000, requires a free GPU.
+ * Exit 0 = exact outputs; 2 = mismatch; 1 = setup/launch failure. */
+#include "core/device/device.h"
+#include "core/plugin/registry.h"
+#include "abi/rad_plugin.h"
+
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+
+[[noreturn]] void fail(const std::string& what) { throw std::runtime_error(what); }
+
+void check(int status, const char* what) {
+    if (status == RAD_OK) return;
+    const char* detail = rad_dev_last_error();
+    fail(std::string(what) + ": " + rad_strerror(status) +
+         (detail ? std::string("; ") + detail : std::string()));
+}
+
+constexpr int64_t kWidth  = 160;      /* the width the specialised kernel requires */
+constexpr int64_t kM      = 64;       /* its ceiling */
+constexpr int64_t kPairs  = kM / 2;
+constexpr int64_t kVocab  = 100000;
+constexpr int64_t kStride = 65536;    /* the pair distance the removed set index collided on */
+
+/* Exactly representable E4M3 codes and their BF16 images under a scale of 1.0. No NaN or Inf
+ * encoding is present, and every value survives f32 -> BF16 without rounding. */
+constexpr uint8_t kPaletteCode[16] = {
+    0x00, 0x20, 0x22, 0x24, 0x28, 0x2A, 0x2C, 0x30,
+    0x34, 0x38, 0x3A, 0x3C, 0x40, 0x42, 0x44, 0x48,
+};
+constexpr uint16_t kPaletteBf16[16] = {
+    0x0000, 0x3E00, 0x3E20, 0x3E40, 0x3E80, 0x3EA0, 0x3EC0, 0x3F00,
+    0x3F40, 0x3F80, 0x3FA0, 0x3FC0, 0x4000, 0x4020, 0x4040, 0x4080,
+};
+constexpr uint16_t kScaleOne = 0x3F80;
+
+/* Encode both nibbles of id % 251 so distinct ids have distinct rows. */
+int palette_index(int64_t id, int64_t j) {
+    const int64_t residue = id % 251;
+    const int64_t rot = j < 144 ? residue % 16 : residue / 16;
+    return int((j + rot) % 16);
+}
+
+uint16_t row_cell(int64_t id, int64_t j) { return kPaletteBf16[palette_index(id, j)]; }
+
+/* The host's own reading of a literal E4M3 code and a literal scale: the palette entry is the
+ * code's exact value, so the expected image is that value times the scale, narrowed to BF16.
+ * Every palette/scale pair used here is a power of two, so the product must narrow bit-exactly;
+ * a non-exact fixture is a broken test, not a kernel mismatch. */
+uint16_t expected_cell(uint16_t palette_bf16, uint16_t scale_bf16) {
+    float v = 0.0f, s = 0.0f;
+    const uint32_t pb = uint32_t(palette_bf16) << 16, sb = uint32_t(scale_bf16) << 16;
+    std::memcpy(&v, &pb, 4);
+    std::memcpy(&s, &sb, 4);
+    const float p = v * s;
+    uint32_t u = 0;
+    std::memcpy(&u, &p, 4);
+    if ((u & 0xFFFFu) || ((u >> 16) & 0x7F80u) == 0x7F80u)
+        fail("fixture palette * scale is not an exact finite BF16 value");
+    return uint16_t(u >> 16);
+}
+
+struct DeviceBuffer {
+    void* data = nullptr;
+    explicit DeviceBuffer(size_t bytes) {
+        if (bytes) data = rad_dev_alloc(int64_t(bytes), RAD_MEM_DEVICE);
+        if (bytes && !data) fail("device allocation failed");
+    }
+    ~DeviceBuffer() { if (data) rad_dev_free(data, RAD_MEM_DEVICE); }
+    DeviceBuffer(const DeviceBuffer&) = delete;
+    DeviceBuffer& operator=(const DeviceBuffer&) = delete;
+};
+
+const rad::KernelRow* pin_row(rad::Registry& reg) {
+    const auto* rows = reg.rows_for("embed_lookup_q");
+    if (!rows || rows->empty()) fail("no row for op 'embed_lookup_q'");
+    const rad::KernelRow* hit = nullptr;
+    for (const rad::KernelRow* r : *rows) {
+        if (!r->info || !r->info->name || std::strcmp(r->info->name, "embed_lookup_q_bf16") != 0)
+            continue;
+        if (r->plugin != "libr4d")
+            fail(std::string("embed_lookup_q_bf16 is published by '") + r->plugin + "'");
+        if (hit) fail("duplicate embed_lookup_q_bf16 row");
+        hit = r;
+    }
+    if (!hit) fail("missing libr4d/embed_lookup_q_bf16");
+    if (!hit->info->launch || hit->info->domain != RAD_DOMAIN_DEVICE)
+        fail("embed_lookup_q_bf16 is not a device row with a launcher");
+    return hit;
+}
+
+struct Gpu {
+    rad::Registry registry;
+    const rad::KernelRow* row = nullptr;
+    RadStream stream = nullptr;
+    DeviceBuffer d_tok{size_t(kM * 4)};
+    DeviceBuffer d_x{size_t(kM * kWidth * 2)};
+};
+
+/* One launch of the device row: uploads `ids`, runs the kernel and returns the m x kWidth rows.
+ * Every operand is per-call, so no state survives a return and the caller compares against its
+ * own literal oracle. */
+std::vector<uint16_t> launch_rows(Gpu& g, const DeviceBuffer& wte, const DeviceBuffer& scale,
+                                  const int32_t* ids, int64_t m, int64_t n_vocab, int32_t voff) {
+    if (m <= 0 || m > kM) fail("launch row count outside the fixture's buffer");
+    check(rad_memcpy_async(g.d_tok.data, ids, int64_t(m * 4), g.stream), "upload ids");
+    check(rad_stream_sync(g.stream), "finish id upload");
+
+    RadTensor t[5]{};
+    t[0].dtype = RAD_I32;    t[0].rank = 1;
+    t[0].shape[0] = m;       t[0].stride[0] = 1;      t[0].data = g.d_tok.data;
+    t[1].dtype = RAD_F8E4M3; t[1].rank = 2;
+    t[1].shape[0] = n_vocab; t[1].shape[1] = kWidth;
+    t[1].stride[0] = kWidth; t[1].stride[1] = 1;      t[1].data = wte.data;
+    t[2].dtype = RAD_BF16;   t[2].rank = 1;
+    t[2].shape[0] = 1;       t[2].stride[0] = 1;      t[2].data = scale.data;
+    t[3].dtype = RAD_BF16;   t[3].rank = 2;
+    t[3].shape[0] = m;       t[3].shape[1] = kWidth;
+    t[3].stride[0] = kWidth; t[3].stride[1] = 1;      t[3].data = g.d_x.data;
+    /* `ahead` is operand 4 and the device kernel ignores it. */
+    t[4].dtype = RAD_I32;    t[4].rank = 1;
+    t[4].shape[0] = m;       t[4].stride[0] = 1;      t[4].data = nullptr;
+
+    const RadParam params[] = { RAD_INT("M", m), RAD_INT("n_embd", kWidth),
+                                RAD_INT("n_vocab", n_vocab), RAD_INT("vocab_offset", voff),
+                                RAD_STR("dtype", "bf16") };
+    RadArgs args{};
+    args.t = t;  args.n_t = 5;
+    args.p = params; args.n_p = 5;
+    args.rank = 0; args.world_size = 1;
+
+    std::string verr;
+    check(g.registry.validate("embed_lookup_q", args.p, args.n_p, &verr),
+          verr.empty() ? "parameters rejected" : verr.c_str());
+
+    const int rc = g.row->info->launch(&args, g.stream);
+    if (rc != RAD_OK) fail(std::string("launch refused: ") + rad_strerror(rc));
+    check(rad_stream_sync(g.stream), "launch");
+
+    std::vector<uint16_t> got(size_t(m * kWidth));
+    check(rad_memcpy_async(got.data(), g.d_x.data, int64_t(got.size() * 2), g.stream),
+          "download x");
+    check(rad_stream_sync(g.stream), "finish download");
+    return got;
+}
+
+/* Compares one launch against `want(m, j)`; counts, prints the first mismatches, returns the
+ * number of differing cells. */
+template <typename Want>
+size_t compare(const std::vector<uint16_t>& got, int64_t m, const char* stage, int round,
+               const int32_t* ids, Want want, size_t& compared, int& reported,
+               int& first_bad_round) {
+    size_t bad = 0;
+    for (int64_t row = 0; row < m; ++row) {
+        for (int64_t j = 0; j < kWidth; ++j) {
+            const uint16_t w = want(row, j);
+            const uint16_t g = got[size_t(row * kWidth + j)];
+            ++compared;
+            if (g == w) continue;
+            ++bad;
+            if (reported < 16) {
+                ++reported;
+                std::printf("MISMATCH stage=%s round=%d row=%lld tok=%d j=%lld "
+                            "got=0x%04x want=0x%04x\n",
+                            stage, round, (long long)row, ids[row], (long long)j, g, w);
+            }
+        }
+    }
+    if (bad && first_bad_round < 0) first_bad_round = round;
+    return bad;
+}
+
+/* ---- collisions ---------------------------------------------------------------------------
+ * 32 pairs of distinct ids a stride apart, launched twice per round: the second launch is the
+ * probe, and any lookup that answers a repeated id from remembered state must still produce the
+ * byte-identical row, because the expected row is the literal dequant of the table cell. */
+size_t run_collisions(Gpu& g, const DeviceBuffer& d_wte, const DeviceBuffer& d_scale, int rounds,
+                      size_t& compared, int& reported, int& first_bad_round) {
+    std::array<int32_t, size_t(kM)> ids{};
+    size_t bad_total = 0;
+
+    for (int round = 0; round < rounds; ++round) {
+        for (int64_t p = 0; p < kPairs; ++p) {
+            const int32_t base = int32_t(1000 + round * kPairs + p);
+            ids[size_t(2 * p)]     = base;
+            ids[size_t(2 * p + 1)] = base + int32_t(kStride);
+        }
+        for (int pass = 0; pass < 2; ++pass) {
+            const std::vector<uint16_t> got =
+                launch_rows(g, d_wte, d_scale, ids.data(), kM, kVocab, 0);
+            const char* stage = pass ? "repeat" : "fill";
+            bad_total += compare(got, kM, stage, round, ids.data(),
+                                 [&](int64_t row, int64_t j) {
+                                     return row_cell(ids[size_t(row)], j);
+                                 },
+                                 compared, reported, first_bad_round);
+        }
+    }
+    return bad_total;
+}
+
+/* ---- table and scale identity -------------------------------------------------------------
+ * Three cases over the SAME local ids 0..kIdLocal-1, launched in turn:
+ *   A  table A, vocab_off 0,   scale 0.5   -- distinct table, shard and scale
+ *   A2 table A, vocab_off 0,   scale 4.0   -- same token and table, distinct immutable scale
+ *   B  table B, vocab_off 512, scale 2.0   -- same local ids, other table, other shard, other scale
+ */
+constexpr int64_t  kIdLocal   = 8;
+constexpr int32_t  kIdVoffB   = 512;     /* shard B's first GLOBAL id */
+constexpr uint16_t kIdScaleA  = 0x3F00;  /* 0.5 */
+constexpr uint16_t kIdScaleA2 = 0x4080;  /* 4.0 */
+constexpr uint16_t kIdScaleB  = 0x4000;  /* 2.0 */
+
+/* Table B rotates the palette by half, so every cell it stores differs from table A's. */
+int palette_index_for(bool second, int64_t local, int64_t j) {
+    const int64_t idx = (local * 7 + j) % 16;
+    return int(second ? (idx + 8) % 16 : idx);
+}
+uint8_t table_code(bool second, int64_t local, int64_t j) {
+    return kPaletteCode[palette_index_for(second, local, j)];
+}
+uint16_t table_want(bool second, int64_t local, int64_t j, uint16_t scale) {
+    return expected_cell(kPaletteBf16[palette_index_for(second, local, j)], scale);
+}
+
+size_t run_identity(Gpu& g, int rounds, size_t& compared, int& reported, int& first_bad_round) {
+    for (int64_t local = 0; local < kIdLocal; ++local)
+        for (int64_t j = 0; j < kWidth; ++j)
+            if (table_code(false, local, j) == table_code(true, local, j))
+                fail("fixture tables agree at a cell; the identity case would prove nothing");
+
+    std::vector<uint8_t> tA(size_t(kIdLocal * kWidth)), tB(tA.size());
+    for (int64_t local = 0; local < kIdLocal; ++local) {
+        for (int64_t j = 0; j < kWidth; ++j) {
+            tA[size_t(local * kWidth + j)] = table_code(false, local, j);
+            tB[size_t(local * kWidth + j)] = table_code(true, local, j);
+        }
+    }
+    DeviceBuffer d_tA(tA.size()), d_tB(tB.size());
+    DeviceBuffer d_sA(2), d_sA2(2), d_sB(2);
+    check(rad_memcpy_async(d_tA.data, tA.data(), int64_t(tA.size()), g.stream), "upload table A");
+    check(rad_memcpy_async(d_tB.data, tB.data(), int64_t(tB.size()), g.stream), "upload table B");
+    check(rad_memcpy_async(d_sA.data, &kIdScaleA, 2, g.stream), "upload scale A");
+    check(rad_memcpy_async(d_sA2.data, &kIdScaleA2, 2, g.stream), "upload scale A2");
+    check(rad_memcpy_async(d_sB.data, &kIdScaleB, 2, g.stream), "upload scale B");
+    check(rad_stream_sync(g.stream), "finish identity upload");
+
+    struct IdCase {
+        const char* name;
+        bool second;
+        int32_t voff;
+        uint16_t scale;
+        const DeviceBuffer* wte;
+        const DeviceBuffer* scale_dev;
+    };
+    const IdCase cases[3] = {
+        { "A/off0/0.5", false, 0,        kIdScaleA,  &d_tA, &d_sA  },
+        { "A/off0/4",   false, 0,        kIdScaleA2, &d_tA, &d_sA2 },
+        { "B/off512/2", true,  kIdVoffB, kIdScaleB,  &d_tB, &d_sB  },
+    };
+
+    std::array<int32_t, size_t(kIdLocal)> ids{};
+    size_t bad_total = 0;
+
+    for (int round = 0; round < rounds; ++round) {
+        for (const IdCase& c : cases) {
+            for (int64_t m = 0; m < kIdLocal; ++m) ids[size_t(m)] = c.voff + int32_t(m);
+            const std::vector<uint16_t> got =
+                launch_rows(g, *c.wte, *c.scale_dev, ids.data(), kIdLocal, kIdLocal, c.voff);
+            bad_total += compare(got, kIdLocal, c.name, round, ids.data(),
+                                 [&](int64_t row, int64_t j) {
+                                     return table_want(c.second, row, j, c.scale);
+                                 },
+                                 compared, reported, first_bad_round);
+        }
+    }
+    return bad_total;
+}
+
+/* ---- boundary -----------------------------------------------------------------------------
+ * The padding convention (negative id), an id at n_vocab, and an id past it write a zero row;
+ * the first and last in-range ids write their table rows. All in one launch, so the boundary
+ * rows sit next to the valid ones in the same wave-width walk. */
+size_t run_boundary(Gpu& g, const DeviceBuffer& d_wte, const DeviceBuffer& d_scale,
+                    size_t& compared, int& reported, int& first_bad_round) {
+    constexpr int64_t kB = 8;
+    const std::array<int32_t, size_t(kB)> ids = {
+        -1, 0, int32_t(kVocab) - 1, int32_t(kVocab),
+        int32_t(kVocab) + 7, -1000, 17, int32_t(kVocab) * 2
+    };
+
+    const std::vector<uint16_t> got = launch_rows(g, d_wte, d_scale, ids.data(), kB, kVocab, 0);
+    return compare(got, kB, "boundary", 0, ids.data(),
+                   [&](int64_t row, int64_t j) {
+                       const int32_t id = ids[size_t(row)];
+                       return (id < 0 || id >= kVocab) ? uint16_t(0) : row_cell(id, j);
+                   },
+                   compared, reported, first_bad_round);
+}
+
+int run(const char* plugin_path, int rounds) {
+    if (rounds <= 0) fail("zero rounds is a failure, not a pass");
+    if (1000 + kPairs * (rounds - 1) + (kPairs - 1) + kStride >= kVocab)
+        fail("round count needs ids past the table; lower it");
+
+    check(rad_dev_set(0), "select GPU 0");
+    RadDeviceProps props{};
+    check(rad_dev_props(0, &props), "GPU properties");
+    if (props.is_host_backend) fail("a host backend is not the device row under test");
+
+    Gpu g;
+    check(rad_stream_create(&g.stream, 0), "create stream");
+    g.registry.set_code_device(0);
+    const int loaded = g.registry.load_plugin(plugin_path, 0);
+    if (loaded < 0) fail("load libr4d plugin: " + std::string(rad_strerror(loaded)));
+    if (loaded > 0) fail("libr4d declined this machine; nothing to run");
+    if (!g.registry.load_errors().empty())
+        fail("plugin load reported: " + g.registry.load_errors().front());
+    g.row = pin_row(g.registry);
+
+    std::vector<uint8_t> table(size_t(kVocab * kWidth));
+    for (int64_t id = 0; id < kVocab; ++id)
+        for (int64_t j = 0; j < kWidth; ++j)
+            table[size_t(id * kWidth + j)] = kPaletteCode[palette_index(id, j)];
+
+    DeviceBuffer d_wte(table.size());
+    DeviceBuffer d_scale(2);
+    check(rad_memcpy_async(d_wte.data, table.data(), int64_t(table.size()), g.stream),
+          "upload table");
+    check(rad_memcpy_async(d_scale.data, &kScaleOne, 2, g.stream), "upload scale");
+    check(rad_stream_sync(g.stream), "finish upload");
+
+    size_t compared = 0;
+    int reported = 0, first_bad_round = -1;
+
+    const size_t collision_bad =
+        run_collisions(g, d_wte, d_scale, rounds, compared, reported, first_bad_round);
+    std::printf("PLE_LOOKUP_COLLISIONS rounds=%d compared=%zu mismatches=%zu first_bad_round=%d "
+                "verdict=%s\n",
+                rounds, compared, collision_bad, first_bad_round,
+                collision_bad ? "MISMATCH" : "OK");
+
+    compared = 0;
+    const size_t identity_bad = run_identity(g, rounds, compared, reported, first_bad_round);
+    std::printf("PLE_LOOKUP_IDENTITY rounds=%d compared=%zu mismatches=%zu first_bad_round=%d "
+                "verdict=%s\n",
+                rounds, compared, identity_bad, first_bad_round,
+                identity_bad ? "MISMATCH" : "OK");
+    if (compared != size_t(rounds) * size_t(kIdLocal * kWidth) * 3u)
+        fail("identity comparison count does not match the round count");
+
+    compared = 0;
+    const size_t boundary_bad =
+        run_boundary(g, d_wte, d_scale, compared, reported, first_bad_round);
+    std::printf("PLE_LOOKUP_BOUNDARY compared=%zu mismatches=%zu verdict=%s\n",
+                compared, boundary_bad, boundary_bad ? "MISMATCH" : "OK");
+
+    std::printf("PLE_LOOKUP_RESULT rounds=%d mismatches=%zu verdict=%s\n",
+                rounds, collision_bad + identity_bad + boundary_bad,
+                (collision_bad || identity_bad || boundary_bad) ? "MISMATCH" : "OK");
+
+    rad_stream_destroy(g.stream);
+    return (collision_bad || identity_bad || boundary_bad) ? 2 : 0;
+}
+
+}  /* namespace */
+
+int main(int argc, char** argv) {
+    std::string plugin;
+    if (argc > 1) {
+        plugin = argv[1];
+    } else {
+        const char* home = std::getenv("RADIANCE_HOME");
+        plugin = home ? std::string(home) + "/kernels/libr4d.so"
+                      : std::string("radiance_home/kernels/libr4d.so");
+    }
+    const int rounds = argc > 2 ? std::atoi(argv[2]) : 1000;
+    try {
+        return run(plugin.c_str(), rounds);
+    } catch (const std::exception& e) {
+        std::fprintf(stderr, "PLE_LOOKUP_ERROR %s\n", e.what());
+        return 1;
+    }
+}
diff --git a/tests/ple_tree_ops_test.cpp b/tests/ple_tree_ops_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7ecd153819445078b4800f0268a662e1a14bc962
--- /dev/null
+++ b/tests/ple_tree_ops_test.cpp
@@ -0,0 +1,498 @@
+/* Host-only independent oracle: unchanged libref linear PLE operations replay
+ * each root-to-node path. The tree implementation is never its own oracle. */
+#include "rad_test.h"
+#include "../mine/ref_ple_tree.h"
+#include "../libref/ref_ops.h"
+#include <algorithm>
+#include <climits>
+#include <cstring>
+#include <vector>
+
+namespace {
+RadTensor tensor(void* data,uint32_t dtype,std::initializer_list<int64_t> shape) {
+    RadTensor t{};t.data=data;t.dtype=dtype;
+    for (int64_t d:shape) t.shape[t.rank++]=d;
+    int64_t stride=1;
+    for (int i=(int)t.rank-1;i>=0;--i) { t.stride[i]=stride;stride*=t.shape[i]; }
+    return t;
+}
+RadParam pi(const char* key,int64_t value) {
+    RadParam p{};p.key=key;p.kind=RAD_P_INT;p.ival=value;return p;
+}
+RadParam ps(const char* key,const char* value) {
+    RadParam p{};p.key=key;p.kind=RAD_P_STR;p.sval=value;return p;
+}
+int launch(int op,std::vector<RadTensor>& t,std::vector<RadParam>& p) {
+    RadArgs a{};a.t=t.data();a.n_t=(int)t.size();a.p=p.data();a.n_p=(int)p.size();
+    return rad_ref_ple_tree_at(op)->launch(&a,nullptr);
+}
+struct Fixture {
+    static constexpr int N=8,H=4,T=40,Slots=4,XP=N+3,RT=5,RP=RT+2;
+    int ring,capacity,pitch,rows,width=4,dilation=3,rc=13,cp=15;
+    std::vector<int32_t> tokens,tokhist,ids,cu{3,10,15},parent;
+    std::vector<int32_t> ti{2,91,0,92},ci{1,93,3,94},ctx{4,17},path,len{3,2};
+    std::vector<int64_t> mult{INT64_MAX,-9223372036854775783LL,0x123456789abcdefLL};
+    std::vector<int64_t> vocab{97,101,103,107},offset{0,100,210,320};
+    std::vector<uint16_t> x,w,history,residual,y,saved;
+    explicit Fixture(int ring_=0,int capacity_=16,int pitch_=0):
+        ring(ring_),capacity(capacity_),pitch(pitch_ ? pitch_ : capacity_),rows(capacity_>16 ? 144 : T),
+        tokens(rows),tokhist(Slots*RP,-201),ids(rows*H,-901),
+        parent(rows,-77),path(2*pitch,-88),x(rows*XP),w(N*width),history(Slots*N*cp),
+        residual(rows*N),y(rows*N,0x7fc1),saved(rows*N,0x7fa1) {
+        for (int i=0;i<rows;++i) tokens[i]=11+i*3;
+        for (size_t i=0;i<x.size();++i) x[i]=rad_f32_to_bf16((int(i%37)-18)*0.03125f);
+        for (size_t i=0;i<w.size();++i) w[i]=rad_f32_to_bf16((int(i%11)-5)*0.0625f);
+        for (size_t i=0;i<history.size();++i) history[i]=rad_f32_to_bf16((int(i%29)-14)*0.015625f);
+        for (size_t i=0;i<residual.size();++i) residual[i]=rad_f32_to_bf16((int(i%17)-8)*0.125f);
+        for (int slot=0;slot<Slots;++slot) { tokhist[slot*RP]=31+slot;tokhist[slot*RP+1]=41+slot; }
+        const int a[]={-1,0,0,1,2,1,4},b[]={-1,0,1,0,3};
+        std::copy(a,a+7,parent.begin()+3);std::copy(b,b+5,parent.begin()+10);
+        path[0]=0;path[1]=1;path[2]=3;path[pitch]=0;path[pitch+1]=3;
+        tokens[4]=2;tokens[7]=2;tokens[12]=-123;
+    }
+    int hist() const { return (width-1)*dilation; }
+    int ho(int slot,int ch,int pos) const { return (slot*N+ch)*cp+pos; }
+    std::vector<RadParam> params(bool prefill=false,int q=0) const {
+        return {pi("q_len",q ? q : capacity),pi("n",N),pi("heads",H),pi("ngram",3),pi("eos",2),
+            pi("width",width),pi("dilation",dilation),pi("node_capacity",capacity),
+            pi("history_ring",ring),pi("n_seq",2),ps("mode",prefill ? "prefill" : "verify")};
+    }
+    std::vector<RadTensor> operands(int op,int seq=0,int ns=2,bool linear=false) {
+        RadTensor th=tensor(tokhist.data(),RAD_I32,{Slots,1,RT});th.stride[0]=RP;
+        RadTensor ch=tensor(history.data(),RAD_BF16,{Slots,N,rc});ch.stride[1]=cp;ch.stride[0]=N*cp;
+        RadTensor xx=tensor(x.data(),RAD_BF16,{rows,N});xx.stride[0]=XP;
+        RadTensor tt=tensor(tokens.data(),RAD_I32,{rows});
+        RadTensor ix=tensor(ti.data()+seq*2,RAD_I32,{ns,2});
+        RadTensor cx=tensor(ci.data()+seq*2,RAD_I32,{ns,2});
+        RadTensor cc=tensor(cu.data()+seq,RAD_I32,{ns+1});
+        RadTensor pp=linear ? RadTensor{} : tensor(parent.data(),RAD_I32,{rows});
+        RadTensor ctxb=tensor(ctx.data()+seq,RAD_I32,{ns});
+        if (op==RAD_PLE_TREE_IDS) return {tt,th,ix,cc,pp,ctxb,tensor(mult.data(),RAD_I64,{3}),
+            tensor(vocab.data(),RAD_I64,{H}),tensor(offset.data(),RAD_I64,{H}),tensor(ids.data(),RAD_I32,{rows,H})};
+        if (op==RAD_PLE_TREE_CONV) return {xx,tensor(w.data(),RAD_BF16,{N,width}),ch,cx,cc,pp,ctxb,
+            tensor(residual.data(),RAD_BF16,{rows,N}),tensor(y.data(),RAD_BF16,{rows,N}),tensor(saved.data(),RAD_BF16,{rows,N})};
+        return {th,ix,ch,cx,tt,tensor(saved.data(),RAD_BF16,{rows,N}),cc,pp,ctxb,
+            tensor(path.data()+seq*pitch,RAD_I32,{ns,pitch}),tensor(len.data()+seq,RAD_I32,{ns})};
+    }
+    int run(int op,int seq=0,int ns=2,bool linear=false,bool prefill=false,int q=0) {
+        auto t=operands(op,seq,ns,linear);auto p=params(prefill,q);return launch(op,t,p);
+    }
+};
+std::vector<int> ancestry(const Fixture& f,int s,int node) {
+    std::vector<int> path;
+    for (;node>=0;node=f.parent[f.cu[s]+node]) path.push_back(node);
+    std::reverse(path.begin(),path.end());return path;
+}
+struct Linear {
+    std::vector<int32_t> ids,tokhist;
+    std::vector<uint16_t> y,history;
+};
+/* Convert the committed representation to libref's canonical linear state,
+ * gather only this ancestry, and let the old operations compute and commit it. */
+Linear oracle(const Fixture& f,int s,const std::vector<int>& nodes,bool residual=true) {
+    const int length=(int)nodes.size(),bos=f.cu[s],ctx=f.ctx[s],hs=f.ci[2*s],ts=f.ti[2*s];
+    Linear out;out.ids.resize(length*Fixture::H);out.y.resize(length*Fixture::N);
+    out.tokhist.resize(2);out.history.resize(Fixture::N*f.hist());
+    for (int j=0;j<2;++j) out.tokhist[j]=ctx-2+j<0 ? 2 : f.tokhist[ts*Fixture::RP+j];
+    for (int ch=0;ch<Fixture::N;++ch) for (int j=0;j<f.hist();++j) {
+        const int pos=ctx-f.hist()+j;
+        out.history[ch*f.hist()+j]=pos<0 ? 0 : f.history[f.ho(hs,ch,f.ring ? pos%f.rc : j)];
+    }
+    std::vector<int32_t> tok(length),cu{0,length};
+    std::vector<uint16_t> x(length*Fixture::N),r(x.size());
+    for (int j=0;j<length;++j) {
+        tok[j]=f.tokens[bos+nodes[j]];
+        for (int ch=0;ch<Fixture::N;++ch) {
+            x[j*Fixture::N+ch]=f.x[(bos+nodes[j])*Fixture::XP+ch];
+            r[j*Fixture::N+ch]=f.residual[(bos+nodes[j])*Fixture::N+ch];
+        }
+    }
+    std::vector<RadTensor> t={tensor(tok.data(),RAD_I32,{length}),tensor(out.tokhist.data(),RAD_I32,{1,2}),
+        tensor(cu.data(),RAD_I32,{2}),tensor(const_cast<int64_t*>(f.mult.data()),RAD_I64,{3}),
+        tensor(const_cast<int64_t*>(f.vocab.data()),RAD_I64,{Fixture::H}),
+        tensor(const_cast<int64_t*>(f.offset.data()),RAD_I64,{Fixture::H}),{}, {}, {},
+        tensor(out.ids.data(),RAD_I32,{length,Fixture::H})};
+    auto p=f.params();RadArgs a{};a.t=t.data();a.n_t=(int)t.size();a.p=p.data();a.n_p=(int)p.size();
+    CHECK_EQ(ref_ngram_ids(&a,nullptr),RAD_OK);
+    t={tensor(x.data(),RAD_BF16,{length,Fixture::N}),
+        tensor(const_cast<uint16_t*>(f.w.data()),RAD_BF16,{Fixture::N,f.width}),
+        tensor(out.history.data(),RAD_BF16,{1,Fixture::N,f.hist()}),tensor(cu.data(),RAD_I32,{2}),
+        residual ? tensor(r.data(),RAD_BF16,{length,Fixture::N}) : RadTensor{}, {}, {}, {},
+        tensor(out.y.data(),RAD_BF16,{length,Fixture::N})};
+    a.t=t.data();a.n_t=(int)t.size();CHECK_EQ(ref_ple_conv(&a,nullptr),RAD_OK);
+    return out;
+}
+void compare_node(const Fixture& tree,const Fixture& anchor,int seq,int node) {
+    const auto path=ancestry(anchor,seq,node);const auto expected=oracle(anchor,seq,path);
+    const int row=anchor.cu[seq]+node,last=(int)path.size()-1;
+    for (int h=0;h<Fixture::H;++h) CHECK_EQ(tree.ids[row*Fixture::H+h],expected.ids[last*Fixture::H+h]);
+    for (int ch=0;ch<Fixture::N;++ch) {
+        CHECK_EQ(tree.y[row*Fixture::N+ch],expected.y[last*Fixture::N+ch]);
+        CHECK_EQ(tree.saved[row*Fixture::N+ch],anchor.x[row*Fixture::XP+ch]);
+    }
+}
+void expect_commit(Fixture& expected,const Fixture& anchor,int seq,const std::vector<int>& path) {
+    const auto linear=oracle(anchor,seq,path);const int ts=anchor.ti[2*seq],cs=anchor.ci[2*seq];
+    for (int j=0;j<2;++j) expected.tokhist[ts*Fixture::RP+j]=linear.tokhist[j];
+    for (int ch=0;ch<Fixture::N;++ch) {
+        if (anchor.ring) {
+            for (size_t j=0;j<path.size();++j)
+                expected.history[expected.ho(cs,ch,(anchor.ctx[seq]+(int)j)%anchor.rc)]=
+                    anchor.x[(anchor.cu[seq]+path[j])*Fixture::XP+ch];
+        } else for (int j=0;j<anchor.hist();++j)
+            expected.history[expected.ho(cs,ch,j)]=linear.history[ch*anchor.hist()+j];
+    }
+}
+void branching_case(int ring,int context,bool root_only=false) {
+    Fixture anchor(ring);anchor.ctx[0]=context;
+    if (root_only) { anchor.tokens[3]=2;anchor.len[0]=1; }
+    anchor.tokhist[anchor.ti[0]*Fixture::RP+1]=2;
+    Fixture tree=anchor;
+    REQUIRE_EQ(tree.run(RAD_PLE_TREE_IDS),RAD_OK);
+    REQUIRE_EQ(tree.run(RAD_PLE_TREE_CONV),RAD_OK);
+    CHECK(tree.tokhist==anchor.tokhist);CHECK(tree.history==anchor.history);
+    for (int s=0;s<2;++s) for (int node=0;node<anchor.cu[s+1]-anchor.cu[s];++node)
+        compare_node(tree,anchor,s,node);
+    for (int row=0;row<Fixture::T;++row) if (row<anchor.cu[0] || row>=anchor.cu[2]) {
+        for (int h=0;h<Fixture::H;++h) CHECK_EQ(tree.ids[row*Fixture::H+h],-901);
+        for (int ch=0;ch<Fixture::N;++ch) {
+            CHECK_EQ(tree.y[row*Fixture::N+ch],0x7fc1);CHECK_EQ(tree.saved[row*Fixture::N+ch],0x7fa1);
+        }
+    }
+    Fixture expected=anchor;
+    for (int s=0;s<2;++s) {
+        const std::vector<int> path(anchor.path.begin()+16*s,anchor.path.begin()+16*s+anchor.len[s]);
+        CHECK(path.back()!=anchor.cu[s+1]-anchor.cu[s]-1);
+        expect_commit(expected,anchor,s,path);
+    }
+    REQUIRE_EQ(tree.run(RAD_PLE_TREE_COMMIT),RAD_OK);
+    CHECK(tree.tokhist==expected.tokhist);CHECK(tree.history==expected.history);
+    /* Consume the committed representation in a new step, not only inspect it. */
+    tree.ctx[0]+=tree.len[0];tree.ctx[1]+=tree.len[1];tree.cu={30,31,32};
+    tree.parent[30]=-1;tree.parent[31]=-1;
+    Fixture next=tree;
+    REQUIRE_EQ(tree.run(RAD_PLE_TREE_IDS),RAD_OK);REQUIRE_EQ(tree.run(RAD_PLE_TREE_CONV),RAD_OK);
+    compare_node(tree,next,0,0);compare_node(tree,next,1,0);
+}
+} // namespace
+
+TEST(ple_tree_branches_eos_cold_partial_wrap) {
+    for (int ring:{0,1}) for (int ctx:{0,1,2,12,25}) branching_case(ring,ctx);
+}
+
+TEST(ple_tree_cold_eos_root_only_commit) {
+    for (int ring:{0,1}) branching_case(ring,0,true);
+}
+
+TEST(ple_tree_mixed_absolute_subranges) {
+    Fixture anchor(1),all=anchor,split=anchor;
+    for (int op:{RAD_PLE_TREE_IDS,RAD_PLE_TREE_CONV}) {
+        REQUIRE_EQ(all.run(op),RAD_OK);
+        REQUIRE_EQ(split.run(op,1,1),RAD_OK);
+        for (int row=0;row<anchor.cu[1];++row) {
+            if (op==RAD_PLE_TREE_IDS) CHECK_EQ(split.ids[row*Fixture::H],-901);
+            else CHECK_EQ(split.y[row*Fixture::N],0x7fc1);
