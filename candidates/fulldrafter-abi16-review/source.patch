+    t.shape[0] = rows; t.shape[1] = cols; t.stride[0] = ld; t.stride[1] = 1;
+    return t;
+}
+RadTensor vector(void* p, int n, int stride) {
+    RadTensor t{}; t.data = p; t.dtype = RAD_I32; t.rank = 1;
