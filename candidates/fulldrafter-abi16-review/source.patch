diff --git a/mine/ref_mtp_overlay.cpp b/mine/ref_mtp_overlay.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8ccc79cf30bcd12b3d5ef177915912288a0f7ba6
--- /dev/null
+++ b/mine/ref_mtp_overlay.cpp
@@ -0,0 +1,97 @@
+#include "mtp_overlay.h"
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+namespace {
+float load(const void* p,int64_t offset,uint32_t dtype) {
+    return dtype==RAD_BF16 ? rad_bf16_to_f32(static_cast<const uint16_t*>(p)[offset])
+        : rad_fp8e4m3_to_f32(static_cast<const uint8_t*>(p)[offset]);
+}
+/* Separate scalar host implementation: no GPU metadata helper, reduction tree,
+ * online recurrence, or temporary copy of either KV cache. */
+bool metadata(const RadMtpOverlayCall& c,int64_t row,int& prefix) {
+    const int64_t request=row/8;
+    const int id=c.request_ids[request*c.request_stride];
+    bool valid=id>=0 && id<c.N;
+    if(valid) valid=c.meta[int64_t(id)*c.meta_ld]==1;
+    prefix=c.prefix[row*c.prefix_stride];
+    valid=valid && prefix>=1 && prefix<=c.max_ctx && (int64_t(prefix)+3)/4<=c.bt_pitch;
+    if(valid) for(int64_t b=0;b<(int64_t(prefix)+3)/4;++b) {
+        const int page=c.committed_bt[request*c.bt_ld+b];
+        if(page<0 || page>=c.pages) { valid=false; break; }
+    }
+    for(int d=0;d<4;++d) {
+        const int slot=c.ancestors[row*c.ancestor_ld+d];
+        if(d<c.depth) {
+            const int64_t lower=request*32+d*8;
+            if(slot<lower || slot>=lower+8 || int64_t(slot)/4>=c.provisional_pages) valid=false;
+            if(d==c.depth-1 && slot!=lower+row%8) valid=false;
+        } else if(slot!=-1) valid=false;
+    }
+    if(!valid) {
+        if(id>=0 && id<c.N) c.meta[int64_t(id)*c.meta_ld]=0;
+        else for(int64_t i=0;i<c.N;++i) c.meta[i*c.meta_ld]=0;
+    }
+    return valid;
+}
+}
+int rad_ref_mtp_overlay_attn(const RadArgs* a,RadStream) {
+    RadMtpOverlayCall c{}; const int rc=rad_mtp_overlay_attn_args(a,&c); if(rc) return rc;
+    const float scale=1.0f/std::sqrt(float(c.head_dim));
+    for(int64_t row=0;row<c.rows;++row) {
+        int prefix=0;
+        if(!metadata(c,row,prefix)) {
+            std::fill_n(c.out+row*c.out_ld,int64_t(c.n_head)*c.head_dim,uint16_t(0));
+            continue;
+        }
+        for(int head=0;head<c.n_head;++head) {
+            const int kvhead=head/(c.n_head/c.n_head_kv);
+            auto element=[&](int64_t pos,int col) {
+                if(pos<prefix) {
+                    const int page=c.committed_bt[(row/8)*c.bt_ld+pos/4];
+                    const int64_t offset=int64_t(page)*c.committed_stride[0]+int64_t(kvhead)*c.committed_stride[1]+
+                        (pos%4)*c.committed_stride[2]+col;
+                    return load(c.committed_kv,offset,c.kv_dtype);
+                }
+                const int slot=c.ancestors[row*c.ancestor_ld+pos-prefix];
+                const int64_t offset=int64_t(slot/4)*c.provisional_stride[0]+int64_t(kvhead)*c.provisional_stride[1]+
+                    int64_t(slot%4)*c.provisional_stride[2]+col;
+                return load(c.provisional_kv,offset,c.kv_dtype);
+            };
+            auto logit=[&](int64_t pos) {
+                float dot=0;
+                for(int d=0;d<c.head_dim;++d) {
+                    const float q=rad_bf16_to_f32(c.q[row*c.q_ld+int64_t(head)*c.head_dim+d]);
+                    const float product=q*element(pos,d);
+                    dot=dot+product;
+                }
+                return dot*scale;
+            };
+            float maximum=-std::numeric_limits<float>::infinity();
+            for(int64_t pos=0;pos<int64_t(prefix)+c.depth;++pos) maximum=std::max(maximum,logit(pos));
+            float numerator[256]{};
+            float denominator=0;
+            for(int64_t pos=0;pos<int64_t(prefix)+c.depth;++pos) {
+                const float weight=std::exp(logit(pos)-maximum);
+                denominator=denominator+weight;
+                for(int d=0;d<c.head_dim;++d) {
+                    const float product=weight*element(pos,c.head_dim+d);
+                    numerator[d]=numerator[d]+product;
+                }
+            }
+            for(int d=0;d<c.head_dim;++d)
+                c.out[row*c.out_ld+int64_t(head)*c.head_dim+d]=rad_f32_to_bf16(numerator[d]/denominator);
+        }
+    }
+    return RAD_OK;
+}
+int rad_ref_mtp_overlay_count() { return 1; }
+const RadKernelInfo* rad_ref_mtp_overlay_at(int i) {
+    static const RadKernelInfo row=[] {
+        RadKernelInfo r=rad_mtp_overlay_attn_row(rad_ref_mtp_overlay_attn);
+        r.name="ref_mtp_overlay_attn"; r.domain=RAD_DOMAIN_HOST; r.priority=0;
+        return r;
+    }();
+    return i==0 ? &row : nullptr;
+}
diff --git a/mine/ref_mtp_pruned_tree.cpp b/mine/ref_mtp_pruned_tree.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4a1e710495bc5f53a82992fe9c295033123ddb16
--- /dev/null
+++ b/mine/ref_mtp_pruned_tree.cpp
@@ -0,0 +1,144 @@
+#include "mtp_pruned_tree.h"
+#include <algorithm>
+#include <climits>
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+namespace {
+constexpr float neginf=-std::numeric_limits<float>::infinity();
+void reset(int32_t* p) { std::fill(p,p+17,-1); p[0]=0; }
+float decode(uint32_t bits) { float x; std::memcpy(&x,&bits,sizeof x); return x; }
+bool valid_tree(const int32_t* m,const float* scores,int levels,int vocab) {
+ if(m[0]!=1 || m[1]<0 || m[1]>INT_MAX-5 || m[2]!=m[3] || m[3]<0 || (vocab>0 && m[3]>=vocab) || m[44]!=-1) return false;
+ if(scores && scores[0]!=0) return false;
+ for(int depth=1;depth<=levels;++depth) {
+  const int first=1+(depth-1)*8;
+  for(int n=first;n<first+8;++n) {
+   const int parent=m[44+n];
+   if(m[3+n]<0 || (vocab>0 && m[3+n]>=vocab)) return false;
+   if(depth==1 ? parent!=0 : parent<first-8 || parent>=first) return false;
+   if(scores && (std::isnan(scores[n]) || scores[n]>0 || scores[n]>scores[parent])) return false;
+   for(int j=first;j<n;++j) if(m[44+j]==parent && m[3+j]==m[3+n]) return false;
+  }
+ }
+ return true;
+}
+int global_id(const RadMtpPrunedTreeCall& c,int64_t q,bool& repeated) {
+ const int id=c.request_ids[q*c.request_stride]; repeated=false;
+ if(id<0 || id>=c.M) return -1;
+ for(int64_t k=0;k<c.Q;++k) if(k!=q && c.request_ids[k*c.request_stride]==id) {
+  if(k<q) return -1;
+  repeated=true;
+ }
+ return id;
+}
+struct Offer { int token; float value; };
+struct Edge { int token,parent,rank; float score; };
+}
+int rad_ref_mtp_pruned_expand(const RadArgs* a,RadStream) {
+ RadMtpPrunedExpandCall c{}; int rc=rad_mtp_pruned_expand_args(a,&c); if(rc) return rc;
+ for(int64_t q=0;q<c.Q;++q) {
+  bool repeated=false; const int id=c.round==1 ? static_cast<int>(q) : global_id(c,q,repeated); if(id<0) continue;
+  int32_t* m=c.meta+id*c.meta_ld; float* scores=c.score+id*c.score_ld; int32_t* packed=c.packed+id*c.packed_ld;
+  if(c.round==1) {
+   std::fill(m,m+85,-1); std::fill(scores,scores+41,neginf); reset(packed); m[0]=0;
+   const int anchor=c.anchor_rows[q*c.anchor_stride];
+   if(anchor<0 || anchor>=c.token_count) continue;
+   const int token=c.tokens[static_cast<int64_t>(anchor)*c.token_stride],position=c.positions[static_cast<int64_t>(anchor)*c.position_stride];
+   if(token<0 || token>=c.vocab || position<0 || position>INT_MAX-5) continue;
+   m[1]=position; m[2]=token; m[3]=token; m[44]=-1; scores[0]=0; packed[1]=token;
+  } else if(repeated || !valid_tree(m,scores,c.round-1,c.vocab)) { m[0]=0; reset(packed); continue; }
+  std::vector<Edge> frontier;
+  bool valid=true; const int parent_count=c.round==1 ? 1 : 8;
+  for(int j=0;j<parent_count && valid;++j) {
+   std::vector<Offer> offers;
+   const uint32_t* row=c.gathered+(q*parent_count+j)*c.gathered_ld;
+   for(int k=0;k<16;++k) {
+    const int token=static_cast<int32_t>(row[2*k]); const float value=decode(row[2*k+1]);
+    if(token<0 || token>=c.vocab || !std::isfinite(value)) valid=false;
+    if(std::any_of(offers.begin(),offers.end(),[&](const Offer& o){return o.token==token;})) valid=false;
+    offers.push_back({token,value});
+   }
+   if(!valid) break;
+   std::sort(offers.begin(),offers.end(),[](const Offer& x,const Offer& y){return x.value!=y.value ? x.value>y.value : x.token<y.token;});
+   offers.resize(8);
+   const double maximum=offers.front().value; double total=0;
+   for(const Offer& o:offers) total+=std::exp(static_cast<double>(o.value)-maximum);
+   const double log_total=std::log(total); const int parent=c.round==1 ? 0 : 1+(c.round-2)*8+j;
+   for(int rank=0;rank<8;++rank) frontier.push_back({offers[rank].token,parent,rank,static_cast<float>(static_cast<double>(scores[parent])+(static_cast<double>(offers[rank].value)-maximum-log_total))});
+  }
+  if(!valid) { m[0]=0; reset(packed); continue; }
+  std::sort(frontier.begin(),frontier.end(),[](const Edge& x,const Edge& y) {
+   if(x.score!=y.score) return x.score>y.score;
+   return x.parent!=y.parent ? x.parent<y.parent : x.rank<y.rank;
+  });
+  for(int k=0;k<8;++k) {
+   const int n=1+(c.round-1)*8+k;
+   m[3+n]=frontier[k].token; m[44+n]=frontier[k].parent; scores[n]=frontier[k].score;
+  }
+  m[0]=1;
+ }
+ return RAD_OK;
+}
+int rad_ref_mtp_pruned_prepare(const RadArgs* a,RadStream) {
+ RadMtpPrunedPrepareCall c{}; int rc=rad_mtp_pruned_prepare_args(a,&c); if(rc) return rc;
+ for(int64_t q=0;q<c.Q;++q) {
+  bool repeated=false; const int id=global_id(c,q,repeated),depth=c.round-1;
+  const int32_t* m=id<0 ? nullptr : c.meta+id*c.meta_ld;
+  const bool valid=m && !repeated && valid_tree(m,nullptr,depth,c.vocab);
+  for(int j=0;j<8;++j) {
+   const int64_t row=q*8+j;
+   c.token_ids[row*c.token_ids_stride]=0; c.out_positions[row*c.out_positions_stride]=0;
+   c.gather_ids[row*c.gather_ids_stride]=0; c.slots[row*c.slots_stride]=-1; c.prefix[row*c.prefix_stride]=0;
+   int32_t* ancestors=c.ancestors+row*c.ancestors_ld; std::fill(ancestors,ancestors+4,-1);
+   if(!valid) continue;
+   const int node=1+(depth-1)*8+j;
+   std::vector<int> path;
+   for(int n=node;n!=0;n=m[44+n]) path.push_back(n);
+   std::reverse(path.begin(),path.end());
+   for(int k=0;k<depth;++k) ancestors[k]=static_cast<int>(q*32)+path[k]-1;
+   c.token_ids[row*c.token_ids_stride]=m[3+node]; c.out_positions[row*c.out_positions_stride]=m[1]+depth;
+   c.slots[row*c.slots_stride]=static_cast<int>(q*32)+node-1; c.prefix[row*c.prefix_stride]=m[1]+1;
+   c.gather_ids[row*c.gather_ids_stride]=depth==1 ? id : static_cast<int>(q*8)+(m[44+node]-(1+(depth-2)*8));
+  }
+ }
+ return RAD_OK;
+}
+int rad_ref_mtp_pruned_pack(const RadArgs* a,RadStream) {
+ RadMtpPrunedPackCall c{}; int rc=rad_mtp_pruned_pack_args(a,&c); if(rc) return rc;
+ for(int64_t q=0;q<c.Q;++q) {
+  bool repeated=false; const int id=global_id(c,q,repeated); if(id<0) continue;
+  const int32_t* m=c.meta+id*c.meta_ld; const float* scores=c.score+id*c.score_ld; int32_t* out=c.packed+id*c.packed_ld;
+  reset(out); if(repeated || !valid_tree(m,scores,5,0)) continue;
+  std::vector<int> order;
+  for(int n=1;n<=40;++n) order.push_back(n);
+  std::sort(order.begin(),order.end(),[&](int x,int y) {
+   const double sx=static_cast<double>(scores[x])+c.beta*((x-1)/8+1),sy=static_cast<double>(scores[y])+c.beta*((y-1)/8+1);
+   return sx!=sy ? sx>sy : x<y;
+  });
+  order.resize(7); std::sort(order.begin(),order.end());
+  bool closed=true;
+  for(int n:order) if(m[44+n]!=0 && !std::binary_search(order.begin(),order.end(),m[44+n])) closed=false;
+  if(!closed) continue;
+  out[1]=m[3];
+  for(int k=0;k<7;++k) {
+   const int n=order[k],parent=m[44+n]; out[2+k]=m[3+n];
+   out[10+k]=parent==0 ? 0 : static_cast<int>(std::lower_bound(order.begin(),order.end(),parent)-order.begin())+1;
+  }
+  out[0]=8;
+ }
+ return RAD_OK;
+}
+int rad_ref_mtp_pruned_tree_count() { return 3; }
+const RadKernelInfo* rad_ref_mtp_pruned_tree_at(int i) {
+ struct Rows { RadKernelInfo data[3]; };
+ static const Rows rows=[] {
+  Rows r{{rad_mtp_pruned_expand_row(rad_ref_mtp_pruned_expand),rad_mtp_pruned_prepare_row(rad_ref_mtp_pruned_prepare),rad_mtp_pruned_pack_row(rad_ref_mtp_pruned_pack)}};
+  const char* names[]={"ref_mtp_pruned_expand","ref_mtp_pruned_prepare","ref_mtp_pruned_pack"};
+  for(int k=0;k<3;++k) { r.data[k].name=names[k]; r.data[k].domain=RAD_DOMAIN_HOST; r.data[k].priority=0; }
+  return r;
+ }();
+ return i>=0 && i<3 ? rows.data+i : nullptr;
+}
diff --git a/mine/ref_mtp_scored_tree.cpp b/mine/ref_mtp_scored_tree.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a898fae33b72f843015cfa9c8d95452198d98dc2
--- /dev/null
+++ b/mine/ref_mtp_scored_tree.cpp
@@ -0,0 +1,171 @@
+#include "mtp_scored_tree.h"
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <functional>
+#include <limits>
+#include <vector>
+
+namespace {
+constexpr double neginf=-std::numeric_limits<double>::infinity();
+float from_bits(uint32_t bits) { float x; std::memcpy(&x,&bits,sizeof x); return x; }
+struct Node { int token, depth, candidate; double score; };
+}
+int rad_ref_mtp_hybrid_lse(const RadArgs* a,RadStream) {
+    RadMtpHybridLseCall c{}; const int rc=rad_mtp_hybrid_lse_args(a,&c); if(rc) return rc;
+    for(int64_t s=0;s<c.M;++s) {
+        auto value=[&](int64_t j) {
+            double z=from_bits(static_cast<uint32_t>(c.coarse[s*c.coarse_ld+j])<<16);
+            for(int k=0;k<8;++k) if(c.idx[s*c.idx_ld+k]==static_cast<int64_t>(c.vocab_off)+j) { z=c.val[s*c.val_ld+k]; break; }
+            return z;
+        };
+        bool valid=true;
+        double maximum=neginf;
+        const int64_t count=std::max<int64_t>(0,std::min<int64_t>(c.N,static_cast<int64_t>(c.vocab)-c.vocab_off));
+        for(int64_t j=0;j<count;++j) {
+            const double z=value(j);
+            valid=valid && !std::isnan(z) && z!=std::numeric_limits<double>::infinity();
+            maximum=std::max(maximum,z);
+        }
+        double sum=0;
+        if(std::isfinite(maximum)) for(int64_t j=0;j<count;++j) sum+=std::exp(value(j)-maximum);
+        float* out=c.stats+s*c.stats_ld;
+        out[0]=valid ? static_cast<float>(maximum) : std::numeric_limits<float>::quiet_NaN();
+        out[1]=valid ? static_cast<float>(sum) : std::numeric_limits<float>::quiet_NaN(); out[2]=0; out[3]=0;
+    }
+    return RAD_OK;
+}
+int rad_ref_mtp_scored_merge_tree_accum(const RadArgs* a,RadStream) {
+    RadMtpScoredMergeTreeAccumCall c{}; const int rc=rad_mtp_scored_merge_tree_accum_args(a,&c); if(rc) return rc;
+    for(int64_t s=0;s<c.M;++s) {
+        std::vector<uint64_t> keys;
+        for(int j=0;j<16;++j) {
+            const uint32_t* pair=c.gathered+s*c.gathered_ld+j*2;
+            if(static_cast<int32_t>(pair[0])<0 || pair[0]>=static_cast<uint32_t>(c.vocab)) continue;
+            const uint32_t image=pair[1]&0x80000000u ? ~pair[1] : pair[1]|0x80000000u;
+            keys.push_back((static_cast<uint64_t>(image)<<32)|(0xffffffffu-pair[0]));
+        }
+        std::sort(keys.begin(),keys.end(),std::greater<uint64_t>());
+        keys.erase(std::unique(keys.begin(),keys.end()),keys.end());
+        float z[8]; int merged[8];
+        for(int k=0;k<8;++k) {
+            const uint64_t key=static_cast<size_t>(k)<keys.size() ? keys[k] : 0;
+            const uint32_t image=static_cast<uint32_t>(key>>32);
+            const uint32_t bits=key ? (image&0x80000000u ? image&0x7fffffffu : ~image) : 0xff800000u;
+            merged[k]=key ? static_cast<int32_t>(0xffffffffu-static_cast<uint32_t>(key)) : -1;
+            c.idx[s*c.idx_ld+k]=merged[k]; c.val[s*c.val_ld+k]=bits; z[k]=from_bits(bits);
+        }
+        int32_t* out=c.packed+s*c.out_ld;
+        int root=-1;
+        if(c.round==1) { const int ix=c.ids[s*c.id_stride]; if(ix>=0 && ix<c.token_count) root=c.tokens[static_cast<int64_t>(ix)*c.token_stride]; }
+        else if(out[0]>=1 && out[0]<=c.capacity) root=out[1];
+        bool valid=root>=0 && root<c.vocab;
+        if(c.policy==0) {
+            if(c.round==1) for(int r=0;r<c.max_rounds;++r) for(int k=0;k<8;++k)
+                c.history[r*c.hist_round_stride+s*c.hist_row_stride+k]=-1;
+            for(int k=0;k<8;++k)
+                c.history[(c.round-1)*c.hist_round_stride+s*c.hist_row_stride+k]=merged[k];
+        } else {
+            const float* st=c.stats+s*c.stats_ld;
+            const double maximum=std::max(st[0],st[4]); double sum=0;
+            for(int rank=0;rank<2;++rank) {
+                const double m=st[rank*4], q=st[rank*4+1];
+                valid=valid && ((std::isfinite(m) && std::isfinite(q) && q>0) || (m==neginf && q==0));
+                if(q>0) sum+=q*std::exp(m-maximum);
+            }
+            valid=valid && std::isfinite(maximum) && std::isfinite(sum) && sum>0;
+            if(c.round==1) for(int r=0;r<c.max_rounds;++r) for(int k=0;k<8;++k) {
+                c.history[r*c.hist_round_stride+s*c.hist_row_stride+k]=-1;
+                c.log_history[r*c.log_round_stride+s*c.log_row_stride+k]=static_cast<float>(neginf);
+            }
+            double base=0;
+            if(c.round>1) {
+                const int prev=c.history[(c.round-2)*c.hist_round_stride+s*c.hist_row_stride];
+                base=c.log_history[(c.round-2)*c.log_round_stride+s*c.log_row_stride];
+                if(prev<0 || prev>=c.vocab || std::isnan(base) || base>0) valid=false;
+            }
+            for(int k=0;k<8;++k) {
+                double l=neginf;
+                if(merged[k]>=0 && merged[k]<c.vocab) {
+                    if(std::isnan(z[k]) || z[k]==std::numeric_limits<float>::infinity()) valid=false;
+                    else if(valid) { l=(static_cast<double>(z[k])-maximum)-std::log(sum); if(l>1e-5) valid=false; else l=std::min(l,0.0)+base; }
+                }
+                c.history[(c.round-1)*c.hist_round_stride+s*c.hist_row_stride+k]=merged[k];
+                c.log_history[(c.round-1)*c.log_round_stride+s*c.log_row_stride+k]=static_cast<float>(l);
+            }
+        }
+        std::vector<Node> nodes;
+        for(int r=0;r<c.round;++r) for(int k=0;k<8;++k) {
+            const int id=c.history[r*c.hist_round_stride+s*c.hist_row_stride+k];
+            const double l=c.policy==0 ? 0.0 : c.log_history[r*c.log_round_stride+s*c.log_row_stride+k];
+            if(id>=0 && id<c.vocab && (c.policy==0 || (!std::isnan(l) && l<=0))) nodes.push_back({id,r,r*8+k,l});
+        }
+        std::vector<Node> chosen; std::vector<int> parents;
+        if(valid) {
+            auto append=[&](const Node& node,int parent) {
+                for(size_t i=0;i<chosen.size();++i) if(parents[i]==parent && chosen[i].token==node.token) return false;
+                chosen.push_back(node); parents.push_back(parent); return true;
+            };
+            if(c.policy==0) {
+                int spine=0;
+                for(int r=0;r<c.round && chosen.size()<static_cast<size_t>(c.capacity-1);++r) {
+                    auto it=std::find_if(nodes.begin(),nodes.end(),[&](const Node& x){ return x.candidate==r*8; });
+                    if(it==nodes.end()) break;
+                    append(*it,r); ++spine;
+                }
+                for(int r=0;r<spine;++r) for(const auto& node:nodes)
+                    if(node.depth==r && node.candidate%8 && chosen.size()<static_cast<size_t>(c.capacity-1)) append(node,r);
+            } else {
+                std::sort(nodes.begin(),nodes.end(),[](const Node& x,const Node& y) {
+                    if(x.score!=y.score) return x.score>y.score;
+                    if(x.depth!=y.depth) return x.depth<y.depth;
+                    if(x.token!=y.token) return x.token<y.token;
+                    return x.candidate<y.candidate;
+                });
+                std::vector<bool> consumed(nodes.size());
+                while(chosen.size()<static_cast<size_t>(c.capacity-1)) {
+                    bool found=false;
+                    for(size_t j=0;j<nodes.size();++j) {
+                        if(consumed[j]) continue;
+                        const Node node=nodes[j]; int parent=node.depth==0 ? 0 : -1;
+                        if(node.depth>0) {
+                            const int greedy=c.history[(node.depth-1)*c.hist_round_stride+s*c.hist_row_stride];
+                            for(size_t i=0;i<chosen.size();++i) if(chosen[i].depth==node.depth-1 && chosen[i].token==greedy) parent=static_cast<int>(i)+1;
+                        }
+                        if(parent<0) continue;
+                        consumed[j]=true;
+                        if(append(node,parent)) { found=true; break; }
+                    }
+                    if(!found) break;
+                }
+                if(c.policy==2) {
+                    size_t keep=0; double mass=1, best=-std::log(c.costs[0]);
+                    for(size_t i=0;i<chosen.size();++i) {
+                        mass+=std::exp(chosen[i].score);
+                        const double objective=std::log(mass)-std::log(c.costs[i+1]);
+                        if(objective>best) { best=objective; keep=i+1; }
+                    }
+                    chosen.resize(keep); parents.resize(keep);
+                }
+            }
+        }
+        out[0]=valid ? static_cast<int>(chosen.size())+1 : 0;
+        for(int k=0;k<c.capacity;++k) { out[1+k]=-1; out[1+c.capacity+k]=-1; }
+        if(valid) {
+            out[1]=root;
+            for(size_t k=0;k<chosen.size();++k) { out[2+k]=chosen[k].token; out[2+c.capacity+k]=parents[k]; }
+        }
+    }
+    return RAD_OK;
+}
+int rad_ref_mtp_scored_tree_count() { return 2; }
+const RadKernelInfo* rad_ref_mtp_scored_tree_at(int i) {
+    struct Rows { RadKernelInfo data[2]; };
+    static const Rows rows=[] {
+        Rows r{{rad_mtp_hybrid_lse_row(rad_ref_mtp_hybrid_lse),rad_mtp_scored_merge_tree_accum_row(rad_ref_mtp_scored_merge_tree_accum)}};
+        r.data[0].name="ref_mtp_hybrid_lse"; r.data[1].name="ref_mtp_scored_merge_tree_accum";
+        for(auto& row:r.data) { row.domain=RAD_DOMAIN_HOST; row.priority=0; }
+        return r;
+    }();
+    return i>=0 && i<2 ? rows.data+i : nullptr;
+}
diff --git a/mine/ref_mtp_tree_accum.cpp b/mine/ref_mtp_tree_accum.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..57a84b373ea25515fddc938307f0ba524eb3de51
--- /dev/null
+++ b/mine/ref_mtp_tree_accum.cpp
@@ -0,0 +1,104 @@
+#include "mtp_tree_accum.h"
+
+#include <algorithm>
+#include <cstring>
+
+int rad_ref_mtp_tree_accum(const RadArgs* a, RadStream) {
+    RadMtpTreeAccumCall c{};
+    const int rc = rad_mtp_tree_accum_args(a,&c);
+    if (rc != RAD_OK) return rc;
+    for (int64_t s=0;s<c.M;++s) {
+        int32_t* const packed = c.packed+s*c.out_ld;
+        int32_t root = -1;
+        if (c.round == 1) {
+            const int32_t index = c.ids[s*c.id_stride];
+            if (index >= 0 && index < c.token_count) root = c.tokens[index*c.token_stride];
+            for (int r=0;r<c.max_rounds;++r)
+                std::fill_n(c.history+r*c.hist_round_stride+s*c.hist_row_stride,8,-1);
+        } else if (packed[0] > 0 && packed[0] <= c.capacity) root = packed[1];
+        std::fill_n(packed,1+2*c.capacity,-1);
+        packed[0] = 0;
+        std::copy_n(c.cand+s*c.cand_ld,8,
+                    c.history+(c.round-1)*c.hist_round_stride+s*c.hist_row_stride);
+        bool valid = root >= 0 && root < c.vocab;
+        for (int r=0;r<c.round;++r) {
+            const int32_t* cr = c.history+r*c.hist_round_stride+s*c.hist_row_stride;
+            for (int k=0;k<8 && cr[k]>=0;++k) valid = valid && cr[k]<c.vocab;
+        }
+        if (!valid) continue;
+        /* Kept independent from device code: the old engine builder's two passes,
+         * using local token/parent arrays before root-inclusive serialization. */
+        int32_t tokens[65], parents[65];
+        tokens[0] = root; parents[0] = -1;
+        int n = 1, spine = 0;
+        for (int r=0;r<c.round && n<c.capacity;++r) {
+            const int32_t* cr = c.history+r*c.hist_round_stride+s*c.hist_row_stride;
+            if (cr[0] < 0) break;
+            tokens[n] = cr[0]; parents[n] = n-1;
+            ++n; ++spine;
+        }
+        for (int r=0;r<spine && n<c.capacity;++r) {
+            const int32_t* cr = c.history+r*c.hist_round_stride+s*c.hist_row_stride;
+            for (int k=1;k<8 && n<c.capacity;++k) {
+                const int32_t alt = cr[k];
+                if (alt < 0) break;
+                bool dup = alt == cr[0];
+                for (int j=r+1;j<n && !dup;++j)
+                    if (parents[j] == r && tokens[j] == alt) dup = true;
+                if (dup) continue;
+                tokens[n] = alt; parents[n] = r; ++n;
+            }
+        }
+        packed[0] = n;
+        std::copy_n(tokens,n,packed+1);
+        std::copy_n(parents,n,packed+1+c.capacity);
+    }
+    return RAD_OK;
+}
+int rad_ref_mtp_merge_tree_accum(const RadArgs* a, RadStream stream) {
+    RadMtpMergeTreeAccumCall c{};
+    const int rc = rad_mtp_merge_tree_accum_args(a,&c);
+    if (rc != RAD_OK) return rc;
+    for (int64_t s=0;s<c.tree.M;++s) {
+        uint64_t keys[16]{};
+        for (int j=0;j<16;++j) {
+            int32_t id;
+            uint32_t bits;
+            std::memcpy(&id,c.gathered+s*c.gathered_ld+2*j,4);
+            std::memcpy(&bits,c.gathered+s*c.gathered_ld+2*j+1,4);
+            if (id < 0) continue;
+            const uint32_t ordered = bits & 0x80000000u ? ~bits : bits | 0x80000000u;
+            keys[j] = (static_cast<uint64_t>(ordered)<<32) | (0xffffffffu-static_cast<uint32_t>(id));
+        }
+        // Independent host algorithm: sort once, then compact identical keys.
+        std::sort(keys,keys+16,[](uint64_t x, uint64_t y) { return x > y; });
+        const auto end = std::unique(keys,keys+16);
+        for (int k=0;k<8;++k) {
+            const uint64_t key = k < end-keys ? keys[k] : 0;
+            uint32_t bits = static_cast<uint32_t>(key>>32);
+            bits = key ? (bits & 0x80000000u ? bits & 0x7fffffffu : ~bits) : 0xff800000u;
+            c.idx[s*c.tree.cand_ld+k] =
+                key ? static_cast<int32_t>(0xffffffffu-static_cast<uint32_t>(key)) : -1;
+            std::memcpy(c.val+s*c.val_ld+k,&bits,4);
+        }
+    }
+    RadTensor tree_t[] = {a->t[1],a->t[3],a->t[4],a->t[5],a->t[6]};
+    RadArgs tree_a = *a; tree_a.t = tree_t; tree_a.n_t = 5;
+    return rad_ref_mtp_tree_accum(&tree_a,stream);
+}
+
+int rad_ref_mtp_tree_accum_count(void) { return 2; }
+const RadKernelInfo* rad_ref_mtp_tree_accum_at(int i) {
+    static const RadKernelInfo rows[] = {
+        [] {
+            RadKernelInfo r = rad_mtp_tree_accum_row(rad_ref_mtp_tree_accum);
+            r.name = "ref_mtp_tree_accum"; r.domain = RAD_DOMAIN_HOST; r.priority = 0;
+            return r;
+        }(),
+        [] {
+            RadKernelInfo r = rad_mtp_merge_tree_accum_row(rad_ref_mtp_merge_tree_accum);
+            r.name = "ref_mtp_merge_tree_accum"; r.domain = RAD_DOMAIN_HOST; r.priority = 0;
+            return r;
+        }()};
+    return i >= 0 && i < 2 ? &rows[i] : nullptr;
+}
diff --git a/mine/ref_ple_tree.cpp b/mine/ref_ple_tree.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8f1446daf0c3e8e665df87f0354c676f1fd13568
--- /dev/null
+++ b/mine/ref_ple_tree.cpp
@@ -0,0 +1,143 @@
+#include "ref_ple_tree.h"
+#include <cmath>
+#include <cstring>
+
+namespace {
+int checked(const RadArgs* a,int op,RadPleTreeCall& c) {
+    const int rc=rad_ple_tree_args(a,op,&c);
+    if (rc!=RAD_OK) return rc;
+    /* Validate the complete transaction before touching any output or history. */
+    for (int s=0;s<c.nseq;++s) if (!rad_ple_tree_metadata(c,s)) return RAD_E_INVAL;
+    return RAD_OK;
+}
+uint16_t raw(const RadPleTreeTensor& t,int a,int b=0,int d=0) {
+    return static_cast<const uint16_t*>(t.data)[rad_ple_off(t,a,b,d)];
+}
+float bf(const RadPleTreeTensor& t,int a,int b=0,int d=0) {
+    return rad_bf16_to_f32(raw(t,a,b,d));
+}
+int64_t i64(const RadPleTreeTensor& t,int i) {
+    return static_cast<const int64_t*>(t.data)[rad_ple_off(t,i)];
+}
+void store_raw(const RadPleTreeTensor& t,uint16_t v,int a,int b=0,int d=0) {
+    static_cast<uint16_t*>(t.data)[rad_ple_off(t,a,b,d)]=v;
+}
+void store_int(const RadPleTreeTensor& t,int32_t v,int a,int b=0) {
+    static_cast<int32_t*>(t.data)[rad_ple_off(t,a,b)]=v;
+}
+void prefill_history(const RadPleTreeCall& c,int s) {
+    const int bos=rad_ple_int(c.t[4],s),len=rad_ple_int(c.t[4],s+1)-bos;
+    const int slot=rad_ple_int(c.t[3],s),ctx=rad_ple_int(c.t[6],s);
+    for (int ch=0;ch<c.n;++ch) {
+        if (c.ring) {
+            const int first=len>c.conv_len ? len-c.conv_len : 0;
+            for (int j=first;j<len;++j)
+                store_raw(c.t[2],raw(c.t[0],bos+j,ch),slot,ch,(ctx+j)%c.conv_len);
+        } else {
+            uint16_t win[RAD_PLE_TREE_HIST_MAX];
+            for (int i=0;i<c.hist;++i) {
+                const int rel=len-c.hist+i;
+                win[i]=rel>=0 ? raw(c.t[0],bos+rel,ch) :
+                    ctx+rel<0 ? 0 : raw(c.t[2],slot,ch,c.hist+rel);
+            }
+            for (int i=0;i<c.hist;++i) store_raw(c.t[2],win[i],slot,ch,i);
+        }
+    }
+}
+} // namespace
+
+int rad_ref_ngram_ids_tree(const RadArgs* a,RadStream) {
+    RadPleTreeCall c{};const int rc=checked(a,RAD_PLE_TREE_IDS,c);
+    if (rc!=RAD_OK) return rc;
+    for (int h=0;h<c.heads;++h) {
+        const int64_t v=i64(c.t[7],h),off=i64(c.t[8],h);
+        if (v<=0 || off<0 || off>INT32_MAX || v-1>INT32_MAX-off) return RAD_E_SHAPE;
+    }
+    const int per=c.heads/(c.ngram-1);
+    for (int s=0;s<c.nseq;++s) {
+        const int bos=rad_ple_int(c.t[3],s),end=rad_ple_int(c.t[3],s+1);
+        const int slot=rad_ple_int(c.t[2],s),ctx=rad_ple_int(c.t[5],s);
+        for (int node=0;node<end-bos;++node) {
+            int32_t sh[8];sh[0]=rad_ple_int(c.t[0],bos+node);
+            for (int k=1;k<c.ngram;++k) {
+                const int src=rad_ple_tree_source(c,bos,node,k);
+                sh[k]=sh[k-1]==c.eos ? c.eos : src>=0 ? rad_ple_int(c.t[0],bos+src) :
+                    ctx<-src ? c.eos : rad_ple_int(c.t[1],slot,c.ngram-1+src);
+            }
+            uint64_t bits=0;
+            for (int k=0;k<c.ngram;++k) {
+                bits^=(uint64_t)(int64_t)sh[k]*(uint64_t)i64(c.t[6],k);
+                if (!k) continue;
+                int64_t mixed;std::memcpy(&mixed,&bits,sizeof mixed);
+                for (int h=(k-1)*per;h<k*per;++h) {
+                    const int64_t v=i64(c.t[7],h),r=mixed%v;
+                    store_int(c.t[9],(int32_t)((r<0 ? r+v : r)+i64(c.t[8],h)),bos+node,h);
+                }
+            }
+        }
+    }
+    return RAD_OK;
+}
+
+int rad_ref_ple_conv_tree(const RadArgs* a,RadStream) {
+    RadPleTreeCall c{};const int rc=checked(a,RAD_PLE_TREE_CONV,c);
+    if (rc!=RAD_OK) return rc;
+    for (int s=0;s<c.nseq;++s) {
+        const int bos=rad_ple_int(c.t[4],s),end=rad_ple_int(c.t[4],s+1);
+        const int slot=rad_ple_int(c.t[3],s),ctx=rad_ple_int(c.t[6],s);
+        for (int node=0;node<end-bos;++node) for (int ch=0;ch<c.n;++ch) {
+            float acc=0;
+            for (int tap=0;tap<c.width;++tap) {
+                const int src=rad_ple_tree_source(c,bos,node,c.hist-tap*c.dilation);
+                const float x=src>=0 ? bf(c.t[0],bos+src,ch) : ctx<-src ? 0.0f :
+                    bf(c.t[2],slot,ch,c.ring ? (ctx+src)%c.conv_len : c.hist+src);
+                const float product=x*bf(c.t[1],ch,tap);
+                acc=acc+product;
+            }
+            const float residual=c.t[7].data ? bf(c.t[7],bos+node,ch) : 0.0f;
+            store_raw(c.t[8],rad_f32_to_bf16(residual+acc/(1.0f+std::exp(-acc))),bos+node,ch);
+            if (c.t[9].data) store_raw(c.t[9],raw(c.t[0],bos+node,ch),bos+node,ch);
+        }
+    }
+    if (c.prefill) for (int s=0;s<c.nseq;++s) prefill_history(c,s);
+    return RAD_OK;
+}
+
+int rad_ref_ple_tree_commit(const RadArgs* a,RadStream) {
+    RadPleTreeCall c{};const int rc=checked(a,RAD_PLE_TREE_COMMIT,c);
+    if (rc!=RAD_OK) return rc;
+    for (int s=0;s<c.nseq;++s) {
+        const int ts=rad_ple_int(c.t[1],s),cs=rad_ple_int(c.t[3],s);
+        const int bos=rad_ple_int(c.t[6],s),ctx=rad_ple_int(c.t[8],s),len=rad_ple_int(c.t[10],s);
+        int32_t tok[7];
+        for (int i=0;i<c.ngram-1;++i) {
+            const int rel=len-(c.ngram-1)+i;
+            tok[i]=rel>=0 ? rad_ple_int(c.t[4],bos+rad_ple_int(c.t[9],s,rel)) :
+                ctx+rel<0 ? c.eos : rad_ple_int(c.t[0],ts,c.ngram-1+rel);
+        }
+        for (int i=0;i<c.ngram-1;++i) store_int(c.t[0],tok[i],ts,i);
+        for (int ch=0;ch<c.n;++ch) {
+            if (c.ring) {
+                for (int j=0;j<len;++j)
+                    store_raw(c.t[2],raw(c.t[5],bos+rad_ple_int(c.t[9],s,j),ch),cs,ch,(ctx+j)%c.conv_len);
+            } else {
+                uint16_t win[RAD_PLE_TREE_HIST_MAX];
+                for (int i=0;i<c.hist;++i) {
+                    const int rel=len-c.hist+i;
+                    win[i]=rel>=0 ? raw(c.t[5],bos+rad_ple_int(c.t[9],s,rel),ch) :
+                        ctx+rel<0 ? 0 : raw(c.t[2],cs,ch,c.hist+rel);
+                }
+                for (int i=0;i<c.hist;++i) store_raw(c.t[2],win[i],cs,ch,i);
+            }
+        }
+    }
+    return RAD_OK;
+}
+int rad_ref_ple_tree_count(void) { return RAD_PLE_TREE_OPS; }
+const RadKernelInfo* rad_ref_ple_tree_at(int i) {
+    static const RadKernelInfo rows[]={
+        rad_ple_tree_row(RAD_PLE_TREE_IDS,RAD_DOMAIN_HOST,rad_ref_ngram_ids_tree),
+        rad_ple_tree_row(RAD_PLE_TREE_CONV,RAD_DOMAIN_HOST,rad_ref_ple_conv_tree),
+        rad_ple_tree_row(RAD_PLE_TREE_COMMIT,RAD_DOMAIN_HOST,rad_ref_ple_tree_commit)};
+    return i>=0 && i<RAD_PLE_TREE_OPS ? rows+i : nullptr;
+}
