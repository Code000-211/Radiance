+    // Launch 2: Stage 1 Batched 6-Slot Vectorized Multi-GEMV across all M sequences
+    {
+        dim3 gemv_grid((active_v_total + 7) / 8, (uint32_t)M);
+        dim3 gemv_block(256);
+        if (head_dim == 768) {
+            r4d_fulldrafter_lmhead_gemv6_kernel<768><<<gemv_grid, gemv_block, 0, stream>>>(
+                (const float*)(scr_ptr + s1_hidden_off),
+                (const uint16_t*)p_ptr->teacher_lm_head_rank0,
+                (const uint16_t*)active_lm_head1,
+                (float*)(scr_ptr + SCR_BASE_LOGITS_OFF),
+                V_SHARD, active_v_total, scr_ptr, 1
+            );
+        } else {
+            r4d_fulldrafter_lmhead_gemv6_kernel<2560><<<gemv_grid, gemv_block, 0, stream>>>(
+                (const float*)(scr_ptr + s1_hidden_off),
+                (const uint16_t*)p_ptr->teacher_lm_head_rank0,
+                (const uint16_t*)active_lm_head1,
+                (float*)(scr_ptr + SCR_BASE_LOGITS_OFF),
+                V_SHARD, active_v_total, scr_ptr, 1
+            );
+        }
+    }
+
+    if (profile_check) (void)hipEventRecord(e2, stream);
+
+    // Launch 3: Stage 1 Slots 0..5 (Milestone 2 Fused In-LDS Reduction & Markov Select)
+    for (int slot = 0; slot < BLOCK_K; ++slot) {
+        r4d_fulldrafter_slot_markov_select(
+            1, slot, p_ptr, scr_ptr, out_ptr, (uint32_t)M, stream
+        );
+    }
+
+    if (profile_check) (void)hipEventRecord(e3, stream);
+
+    // Launch 4: Stage 2 Backbone (automatically skipped on-GPU per sequence when DLoop verification < theta)
+    r4d_fulldrafter_stage2_backbone(
+        p_ptr, scr_ptr, out_ptr, (uint32_t)M, stream
+    );
+
+    if (!is_fused) {
+        fast_out_proj_kernel<<<dim3(blocks_out_proj, (uint32_t)M), dim3(threads), 0, stream>>>(
+            p_ptr->out_proj, scr_ptr, SCR_H2_OFF, SCR_O2_OFF, p_ptr->selector_hidden_proj,
+            p_ptr, out_ptr, (int)M
+        );
+    }
+
+    if (profile_check) (void)hipEventRecord(e4, stream);
+
+    // Launch 5: Stage 2 Batched 6-Slot Vectorized Multi-GEMV across all M sequences
+    {
+        dim3 gemv_grid((active_v_total + 7) / 8, (uint32_t)M);
+        dim3 gemv_block(256);
+        if (head_dim == 768) {
+            r4d_fulldrafter_lmhead_gemv6_kernel<768><<<gemv_grid, gemv_block, 0, stream>>>(
+                (const float*)(scr_ptr + s2_hidden_off),
+                (const uint16_t*)p_ptr->teacher_lm_head_rank0,
+                (const uint16_t*)active_lm_head1,
+                (float*)(scr_ptr + SCR_BASE_LOGITS_OFF),
+                V_SHARD, active_v_total, scr_ptr, 2
+            );
+        } else {
+            r4d_fulldrafter_lmhead_gemv6_kernel<2560><<<gemv_grid, gemv_block, 0, stream>>>(
+                (const float*)(scr_ptr + s2_hidden_off),
+                (const uint16_t*)p_ptr->teacher_lm_head_rank0,
+                (const uint16_t*)active_lm_head1,
+                (float*)(scr_ptr + SCR_BASE_LOGITS_OFF),
+                V_SHARD, active_v_total, scr_ptr, 2
+            );
+        }
+    }
+
+    if (profile_check) (void)hipEventRecord(e5, stream);
+
+    // Launch 6: Stage 2 Slots 0..5 (Milestone 2 Fused In-LDS Reduction & Markov Select)
+    for (int slot = 0; slot < BLOCK_K; ++slot) {
+        r4d_fulldrafter_slot_markov_select(
+            2, slot, p_ptr, scr_ptr, out_ptr, (uint32_t)M, stream
+        );
+    }
+    } // end else (!is_alodlm_loop)
+
+    if (profile_check) {
+        (void)hipEventRecord(e6, stream);
+        (void)hipStreamSynchronize(stream);
+        if (p_ptr->is_alodlm_loop != 0u) {
+            float t_d0 = 0.0f, t_d1 = 0.0f, t_d2 = 0.0f, t_d3 = 0.0f, t_tot = 0.0f;
+            (void)hipEventElapsedTime(&t_d0, e0, e1);
+            (void)hipEventElapsedTime(&t_d1, e1, e2);
+            (void)hipEventElapsedTime(&t_d2, e2, e3);
+            (void)hipEventElapsedTime(&t_d3, e3, e4);
+            (void)hipEventElapsedTime(&t_tot, e0, e6);
+            std::printf("[PROFILE] ALoDLM-4 (M=%lld): d0: %.3f ms | d1: %.3f ms | d2: %.3f ms | d3: %.3f ms | Total: %.3f ms\n",
+                        M, t_d0, t_d1, t_d2, t_d3, t_tot);
+        } else {
+            float t_bb1 = 0, t_gemv1 = 0, t_slots1 = 0;
+            float t_bb2 = 0, t_gemv2 = 0, t_slots2 = 0;
+            (void)hipEventElapsedTime(&t_bb1, e0, e1);
+            (void)hipEventElapsedTime(&t_gemv1, e1, e2);
+            (void)hipEventElapsedTime(&t_slots1, e2, e3);
+            (void)hipEventElapsedTime(&t_bb2, e3, e4);
+            (void)hipEventElapsedTime(&t_gemv2, e4, e5);
+            (void)hipEventElapsedTime(&t_slots2, e5, e6);
+            std::printf("[PROFILE] S1_BB: %.3f ms | S1_GEMV: %.3f ms | S1_SLOTS: %.3f ms | S2_BB: %.3f ms | S2_GEMV: %.3f ms | S2_SLOTS: %.3f ms | Total: %.3f ms\n",
+                        t_bb1, t_gemv1, t_slots1, t_bb2, t_gemv2, t_slots2,
+                        t_bb1 + t_gemv1 + t_slots1 + t_bb2 + t_gemv2 + t_slots2);
+        }
+        (void)hipEventDestroy(e0); (void)hipEventDestroy(e1); (void)hipEventDestroy(e2);
+        (void)hipEventDestroy(e3); (void)hipEventDestroy(e4); (void)hipEventDestroy(e5);
+        (void)hipEventDestroy(e6);
+    }
+
+    hipError_t err = hipGetLastError();
+    return (err == hipSuccess) ? RAD_OK : RAD_E_DEVICE;
+}
diff --git a/libr4d/r4d_fulldrafter_select.h b/libr4d/r4d_fulldrafter_select.h
new file mode 100644
index 0000000000000000000000000000000000000000..53b587b16f4ee2837049485c27023b78ca51a451
--- /dev/null
+++ b/libr4d/r4d_fulldrafter_select.h
@@ -0,0 +1,144 @@
+#pragma once
+
+#include <cstdint>
+
+#if defined(__HIPCC__)
+#include <hip/hip_runtime.h>
+#define R4D_FDS_HD __host__ __device__
+#define R4D_FDS_INLINE __forceinline__
+#else
+#define R4D_FDS_HD
+#define R4D_FDS_INLINE inline
+#endif
+
+namespace r4d {
+
+static constexpr float FULLDRAFTER_SENTINEL_SCORE = -1e30f;
+static constexpr uint32_t FULLDRAFTER_SENTINEL_ID  = 0xFFFFFFFFu;
+
+// Finite scores sort descending, then by lower token ID. Empty slots must lose
+// even to valid scores below the scratch buffer's -1e30 initialization value.
+R4D_FDS_HD R4D_FDS_INLINE bool fulldrafter_is_better(float va, uint32_t ia, float vb, uint32_t ib) {
+    if (ia == FULLDRAFTER_SENTINEL_ID) return false;
+    if (ib == FULLDRAFTER_SENTINEL_ID) return true;
+    if (va > vb) return true;
+    if (va < vb) return false;
+    return ia < ib;
+}
+
+// Fixed-capacity sorted top-K candidate tracker (K = 16).
+// Maintained in descending order under fulldrafter_is_better.
+struct FullDrafterThreadTop16 {
+    static constexpr int K = 16;
+    float val[K];
+    uint32_t id[K];
+
+    R4D_FDS_HD R4D_FDS_INLINE void init() {
+        #pragma unroll
+        for (int i = 0; i < K; ++i) {
+            val[i] = FULLDRAFTER_SENTINEL_SCORE;
+            id[i]  = FULLDRAFTER_SENTINEL_ID;
+        }
+    }
+
+    R4D_FDS_HD R4D_FDS_INLINE void insert(float v, uint32_t i) {
+        if (!fulldrafter_is_better(v, i, val[K - 1], id[K - 1])) {
+            return;
+        }
+        int pos = K - 1;
+        #pragma unroll
+        for (int p = K - 1; p > 0; --p) {
+            if (fulldrafter_is_better(v, i, val[p - 1], id[p - 1])) {
+                val[p] = val[p - 1];
+                id[p]  = id[p - 1];
+                pos = p - 1;
+            } else {
+                break;
+            }
+        }
+        val[pos] = v;
+        id[pos]  = i;
+    }
+
+    R4D_FDS_HD R4D_FDS_INLINE float current_val(int local_idx) const {
+        return (static_cast<unsigned>(local_idx) < K) ? val[local_idx] : FULLDRAFTER_SENTINEL_SCORE;
+    }
+
+    R4D_FDS_HD R4D_FDS_INLINE uint32_t current_id(int local_idx) const {
+        return (static_cast<unsigned>(local_idx) < K) ? id[local_idx] : FULLDRAFTER_SENTINEL_ID;
+    }
+};
+
+// Host CPU simulation helpers for shared regression verification.
+inline void fulldrafter_block_select_step(
+    const FullDrafterThreadTop16* threads,
+    int* local_idx,
+    int num_threads,
+    float* out_val,
+    uint32_t* out_id,
+    int* winning_tid
+) {
+    float best_v = FULLDRAFTER_SENTINEL_SCORE;
+    uint32_t best_i = FULLDRAFTER_SENTINEL_ID;
+    int best_t = -1;
+    for (int t = 0; t < num_threads; ++t) {
+        float tv = threads[t].current_val(local_idx[t]);
+        uint32_t ti = threads[t].current_id(local_idx[t]);
+        if (fulldrafter_is_better(tv, ti, best_v, best_i)) {
+            best_v = tv;
+            best_i = ti;
+            best_t = t;
+        }
+    }
+    *out_val = best_v;
+    *out_id = best_i;
+    *winning_tid = best_t;
+    if (best_t >= 0 && local_idx[best_t] < FullDrafterThreadTop16::K) {
+        local_idx[best_t]++;
+    }
+}
+
+inline void fulldrafter_block_top16(
+    const FullDrafterThreadTop16* threads,
+    int* local_idx,
+    int num_threads,
+    float* out_vals,
+    uint32_t* out_ids
+) {
+    for (int k = 0; k < FullDrafterThreadTop16::K; ++k) {
+        int winner = -1;
+        fulldrafter_block_select_step(
+            threads, local_idx, num_threads,
+            &out_vals[k], &out_ids[k], &winner
+        );
+    }
+}
+
+inline void fulldrafter_merge_top16(
+    float* cands_val,
+    uint32_t* cands_id,
+    int total_cands,
+    float* out_vals,
+    uint32_t* out_ids
+) {
+    for (int k = 0; k < FullDrafterThreadTop16::K; ++k) {
+        float best_v = FULLDRAFTER_SENTINEL_SCORE;
+        uint32_t best_i = FULLDRAFTER_SENTINEL_ID;
+        int best_idx = -1;
+        for (int i = 0; i < total_cands; ++i) {
+            if (fulldrafter_is_better(cands_val[i], cands_id[i], best_v, best_i)) {
+                best_v = cands_val[i];
+                best_i = cands_id[i];
+                best_idx = i;
+            }
+        }
+        out_vals[k] = best_v;
+        out_ids[k] = best_i;
+        if (best_idx >= 0) {
+            cands_val[best_idx] = FULLDRAFTER_SENTINEL_SCORE;
+            cands_id[best_idx]  = FULLDRAFTER_SENTINEL_ID;
+        }
+    }
+}
+
+} // namespace r4d
