index 0000000000000000000000000000000000000000..db60d57797d0b26f63f2751c8905b587f9dad3aa
--- /dev/null
+++ b/mine/dflash_k_norm_rope_store.h
@@ -0,0 +1,95 @@
+#ifndef RAD_MINE_DFLASH_K_NORM_ROPE_STORE_H
+#define RAD_MINE_DFLASH_K_NORM_ROPE_STORE_H
+
+#include "rad_plugin.h"
+#include <stdint.h>
+
+/* dflash_k_norm_rope_store -- the DFlash2 layer's K chain in one launch:
+ *
+ *     rmsnorm(k)      head_dim-wide RMS norm against the K gain, wadd added to the gain in f32,
+ *                     result ROUNDED TO BF16 (that rounding is rmsnorm's store, not an accident);
+ *     rope(k)         NeoX pairing i <-> i + head_dim/2, `theta`, the position divided by `scale`,
+ *                     accurate sincosf, result rounded to bf16 again;
+ *     kv_store        the rotated bf16 k and the v row scattered into the paged cache at the
+ *                     token's slot: [n_blocks, n_head_kv, block_size, 2*head_dim], k at [.., d]
+ *                     and v at [.., head_dim + d].
+ *
+ * The definition is the UNFUSED DEVICE CHAIN this replaces -- libr4d/r4d_model_bf16.hip's
+ * `rmsnorm_kernel` with block_sum, `rope_kernel` and `kv_store_kernel`. Bit-for-bit equality with
+ * that chain is the INTENDED TARGET, NOT AN ESTABLISHED RESULT: it has been reasoned from the
+ * source (the fold partition, the two bf16 store points, the same transcendental calls) and it has
+ * NOT been measured. No build, compile or device comparison has run against this file. Only the
+ * dedicated mine-vs-libr4d comparator described below can establish it; until then treat every
+ * numerics statement here as an inspection, not a verification.
+ *
+ * The host reference (libref/ref_elementwise.cpp's ref_rmsnorm, ref_attn.cpp's ref_rope /
+ * ref_kv_store) differs from the device chain in two ways that are documented there and are NOT
+ * what this kernel reproduces: ref uses 1.0f/sqrtf where the device uses rsqrtf, and ref
+ * accumulates the sum of squares one element at a time where the device folds it over a wave.
+ * Where they differ the device chain wins, because the device chain is what the engine ran -- and
+ * a comparison against libref is therefore expected to show last-bit differences in the norm, by
+ * design.
+ *
+ * THE ROTATION IS COMPUTED FROM theta. There is no cos/sin plane, no new buffer and no lifetime to
+ * manage; `powf` and `sincosf` are the same two calls rope_kernel makes at the same arguments.
+ *
+ * THE GAIN'S WIDTH IS THE OPERAND'S, f32 in this model (rad_block_dflash2.h declares every norm
+ * gain RAD_F32) and bf16 accepted because vLLM's is -- exactly the pair r4d_rad_rmsnorm accepts.
+ *
+ * THE SUPPORTED GEOMETRY IS NARROW ON PURPOSE: head_dim 128, bf16 k / v / cache, i32 positions and
+ * slots, NeoX with the full head rotated, kv_store's own paged layout and its slot rule (a negative
+ * slot stores nothing, a slot past the last block stores nothing). Everything else is refused at
+ * issue rather than approximated. Partial rotary has no parameter here because this block never
+ * declares one; adding it would need the tail write and a second rounding site.
+ */
+enum {
+    RAD_DKNS_K    = 0,   /* INOUT: normed and rotated in place, exactly as the pair does */
+    RAD_DKNS_V    = 1,
+    RAD_DKNS_W    = 2,   /* WEIGHT: the K-norm gain, head_dim wide */
+    RAD_DKNS_POS  = 3,
+    RAD_DKNS_SLOT = 4,
+    RAD_DKNS_KV   = 5,
+    RAD_DKNS_OPERANDS = 6
+};
+
+/* Validated, device-free view of one call. Nothing here dereferences a pointer: at issue every
+ * operand is device memory. */
+struct RadDflashKStoreCall {
+    void*           k;          /* written in place */
+    const void*     v;
+    const void*     w;
+    const int32_t*  pos;
+    const int32_t*  slot;
+    void*           kv;
+    int64_t         rows, head_dim, n_head_kv, block_size, n_blocks;
+    int64_t         k_pitch, v_pitch;   /* stride[0]: elements between consecutive rows */
+    int             w_f32;
+    float           eps, wadd, theta, rscale;
+};
+
+int rad_dflash_k_store_schema_count(void);
+const RadOpSchema* rad_dflash_k_store_schema_at(int);
+int rad_dflash_k_store_shape(const RadParam*, int, int, RadOpdDesc*);
+/* RAD_OK, or the reason this call is not the op: RAD_E_UNSUPPORTED outside the declared geometry,
+ * RAD_E_SHAPE for an extent that disagrees with the parameters, RAD_E_DTYPE for a width or a
+ * `kv_dtype` that is not the declared one, RAD_E_STRIDE for a column step other than 1 or a cache
+ * that is not packed, RAD_E_INVAL for a required operand absent. */
+int rad_dflash_k_store_args(const RadArgs*, RadDflashKStoreCall*);
+/* THE CHAIN IS A DESCRIPTION, AND STOCK rad-kbench CANNOT EXECUTE IT. It names the conventional
+ * ops `rmsnorm` -> `rope` -> `kv_store` this kernel computes in one launch, each at ITS OWN
+ * geometry (the norm over rows*n_head_kv rows of width head_dim; the rotation and the store over
+ * rows). RAD_E_NOTFOUND past the last step.
+ *
+ * Executability, stated because it is easy to assume: rad-kbench resolves a `replaces` step ONLY
+ * WITHIN THE FUSED ROW'S OWN PLUGIN (tools/rad_kbench.cpp:2682). Plugin `mine` has no
+ * `rmsnorm`/`rope`/`kv_store` rows, so a stock `--fuse` pass reports "no mine kernel for step
+ * 'rmsnorm'" and counts a SKIP. A skip is not a pass and this hook is NOT evidence of parity.
+ * Establishing bit-equality needs the dedicated comparator that launches this row out of `mine`,
+ * launches each step from `libr4d` on an independently initialised buffer set, and compares the
+ * post-launch `k` and the entire `kv_cache` byte for byte, failing closed on any missing row. */
+int rad_dflash_k_store_fuse(const RadParam*, int, uint64_t, int, RadFuseStep*);
+RadKernelInfo rad_dflash_k_store_row(RadLaunchFn);
+int rad_mine_dflash_k_store_count(void);
+const RadKernelInfo* rad_mine_dflash_k_store_at(int);
+
+#endif /* RAD_MINE_DFLASH_K_NORM_ROPE_STORE_H */
diff --git a/mine/dflash_k_norm_rope_store.hip b/mine/dflash_k_norm_rope_store.hip
new file mode 100644
index 0000000000000000000000000000000000000000..7622bb8fb4d83b68aad11a4377ef1fafabd1aece
--- /dev/null
+++ b/mine/dflash_k_norm_rope_store.hip
@@ -0,0 +1,289 @@
+/* dflash_k_norm_rope_store.hip -- the DFlash2 layer's K chain on the device: RMS norm -> NeoX
+ * RoPE -> paged BF16 KV store, in one launch per (token, kv head).
+ *
+ * ============================== THE BASELINE'S OWN PRIMITIVES ARE INCLUDED ==============================
+ *
+ * `libr4d/r4d_common.h` is header-only, self-contained (hip_runtime + cstdint), and gives
+ * `f32_to_bf16`, `bf16_to_f32`, `r4d_wave_sum` and `r4d_act_threads` as `__device__ __forceinline__`
+ * functions, so including it needs no libr4d link. mine/dflash_conv_add.hip already takes a libr4d
+ * header by relative path for the same reason. RE-SPELLING ANY OF THESE WAS THE BUG: a local
+ * conversion that "matched on finite values" is not the baseline's conversion, and a bit-exact
+ * fusion does not get to assume its inputs are finite. The rounding rule is now the chain's own
+ * bytes, not a transcription of them.
+ *
+ * ============================== WHY THE LAYOUT IS ONE ELEMENT A LANE ==============================
+ *
+ * The tempting layout gives a lane several consecutive elements and reduces per wave: no LDS, no
+ * barrier. It is also a DIFFERENT FUNCTION. libr4d's rmsnorm_kernel says it outright -- the width
+ * decides which columns a thread folds into the sum of squares, and two kernels that disagree about
+ * it disagree in the last bits of the norm. A ULP in the mean square is a ULP in the normed value,
+ * and after the rotation's subtraction of two products that ULP can surface as a few percent where
+ * the terms nearly cancel.
+ *
+ * THE REFERENCE'S FOLD IS REPRODUCIBLE AT 128 LANES:
+ *
+ *   * r4d_act_threads(M, 128) is 1024, 512 or 256 (libr4d/r4d_common.h:250-254), never less than
+ *     the head width, so `for (i = threadIdx.x; i < n; i += THR)` gives every thread AT MOST one
+ *     element -- and the threads beyond column 127 contribute exactly 0.0f.
+ *   * block_sum (libr4d/r4d_model_bf16.hip:144-156) folds each wave with r4d_wave_sum and then sums
+ *     the wave partials in ASCENDING wave index. Threads 128..THR-1 are whole waves of zeros, and
+ *     adding +0.0f to a partial is exact, so the reference reduces to four partials in ascending
+ *     order -- exactly what a 128-thread block sums.
+ *   * r4d_wave_sum is a fixed DPP sequence (xor 16, 8, 4, 2, 1) and is CALLED, not copied: the same
+ *     lanes, the same order, therefore the same bits.
+ *
+ * ONE ASSUMPTION IS NAMED RATHER THAN HIDDEN: the four-wave reduction is exact only while every
+ * partial is finite, because `+0.0f` is exact for a finite addend and an INFINITE partial would be
+ * poisoned by a NaN partial from the zero waves. The baseline has the identical exposure with its
+ * own zero threads, so the two still agree bit for bit -- what is not claimed is that either is
+ * numerically meaningful for a row whose sum of squares overflows. The comparator covers Inf/NaN
+ * rows explicitly (see the handoff).
+ *
+ * ============================== THE TWO BF16 ROUNDINGS ==============================
+ *
+ * The unfused path stores the norm as bf16 and rope reads it back, then stores the rotation as bf16
+ * and kv_store copies those bytes. Both roundings are reproduced here: the value handed to
+ * `sincosf`'s products is the ROUNDED norm widened back to f32, and the cache receives the SAME
+ * bf16 the store of `k` receives.
+ *
+ * ============================== RoPE ==============================
+ *
+ * rope_kernel (libr4d/r4d_model_bf16.hip:544-570) is reproduced at the same arguments: NeoX
+ * pairing, `inv = 1.0f / powf(theta, (float)(2*i) / (float)rot)`, the position divided by `scale`
+ * in f32, and `sincosf`. There is NO cos/sin table: computing the angles costs two transcendental
+ * calls a pair and saves a buffer, a lifetime and a second definition of the angles.
+ *
+ * A LANE OWNS A PAIR, not an element. With rot == head_dim, element i and i + head_dim/2 are both
+ * loaded and both produced by lane i < head_dim/2, so there is no shuffle, no LDS exchange and no
+ * read-after-in-place hazard: the partner is in the lane's own registers.
+ *
+ * ============================== THE STORE ==============================
+ *
+ * kv_store_kernel's bf16 branch, element for element: the paged layout is
+ * [n_blocks, n_head_kv, block_size, 2*head_dim] with K at [.., d] and V at [.., head_dim + d], and
+ * a NEGATIVE slot stores nothing. A slot at or past the last block also stores nothing -- that is
+ * the device store's rule (libr4d/r4d_model_bf16.hip:596) and it is what this op reproduces; see the
+ * header note in the .cpp on why libref can refuse it instead.
+ *
+ * V IS COPIED AS BITS. kv_store_bf16 stores the operand's uint16 unchanged (r4d_model_bf16.hip:699),
+ * so the copy is the contract; the dtype is checked in the shim rather than re-narrowed here.
+ */
+#include <hip/hip_runtime.h>
+
+#include "../libr4d/r4d_common.h"
+#include "dflash_k_norm_rope_store.h"
+
+namespace {
+
+constexpr int kThreads = 128;          /* == head_dim: one element a lane, no tail */
+constexpr int kWave    = 32;
+constexpr int kWaves   = kThreads / kWave;
+constexpr int kHeadDim = 128;
+
+/* THE REDUCTION ARGUMENT DEPENDS ON THESE TWO. A block narrower than the head would fold several
+ * columns into one thread's accumulator; a block wider would add extra zero partials, which is
+ * exact but would make the four-wave claim above a five-wave one. Both are stated here so a future
+ * width cannot quietly invalidate the comment. */
+static_assert(kThreads == kHeadDim, "one element a lane: the block IS the head");
+static_assert(kWaves == 4, "block_sum's ascending partials are four here, as at the reference width");
+
+struct Args {
+    uint16_t*       k;
+    const uint16_t* v;
+    const void*     w;
+    const int32_t*  pos;
+    const int32_t*  slot;
+    uint16_t*       kv;
+    int64_t k_pitch, v_pitch;
+    int     n_head_kv, block_size, n_blocks, w_f32;
+    float   eps, wadd, theta, rscale;
+};
+
+/* ============================== ORDERED VALU ==============================
+ *
+ * When BOTH operands are NaN, v_mul/v_add/v_sub return the FIRST source operand's NaN (S0). Which
+ * operand the compiler places in S0 is register allocation, so two kernels built from the same
+ * expression can disagree in a NaN payload -- and here that is a gate failure, not a tolerance.
+ * `kstore/exceptional-gain` failed exactly this way, twice.
+ *
+ * The `_s0` helpers name the operand that must land in S0, so the order is the source text's and
+ * not the allocator's. One instruction each: no predicate, no select, nothing extra on the measured
+ * path.
+ *
+ * THE ORDERS ARE THE REFERENCE'S, taken per instantiation from the shipped
+ * `libr4d/CMakeFiles/libr4d.dir/r4d_model_bf16.hip.o` (fatbin member
+ * `hipv4-amdgcn-amd-amdhsa--gfx1201`), not from one assumed variant:
+ *
+ *   rmsnorm_kernel<WF32,THR>, all SIX instantiations (f32/bf16 gain x 1024/512/256 threads):
+ *     scale in S0 of the first product, `g + wadd` in S0 of the second, `wadd` in S0 of the add.
+ *     e.g. <true,1024> `v_dual_mul_f32 v7, s1, v7` then `v_mul_f32_e32 v7, v8, v7`;
+ *          <false,256> `v_dual_mul_f32 v13, s1, v13` then `v_dual_mul_f32 v12, v12, v13`.
+ *
+ *   rope_kernel, ONE instantiation (kThreads 256): trig in S0 of all four products,
+ *   `c*x0` in S0 of the sub, `c*x1` in S0 of the add:
+ *     v_mul_f32_e32  v8, v0, v1   ; s*x0    v_dual_mul_f32 v0, v0, v6 ; s*x1
+ *     v_dual_mul_f32 v1, v7, v1   ; c*x0    v_mul_f32_e32  v6, v7, v6 ; c*x1
+ *     v_sub_f32_e32  v0, v1, v0   ; c*x0 - s*x1
+ *     v_add_f32_e32  v1, v6, v8   ; c*x1 + s*x0
+ *
+ * Every one of these is exact for finite and infinite inputs -- mul/add are commutative, sub
+ * anti-commutative -- so no already-passing case moves. The orders matter only when both operands
+ * are NaN, which is what a NaN norm scale across a whole head produces.
+ */
+__device__ __forceinline__ float mul_s0(float s0, float s1) {
+    float d;
+    asm("v_mul_f32_e32 %0, %1, %2" : "=v"(d) : "v"(s0), "v"(s1));
+    return d;
+}
+__device__ __forceinline__ float add_s0(float s0, float s1) {
+    float d;
+    asm("v_add_f32_e32 %0, %1, %2" : "=v"(d) : "v"(s0), "v"(s1));
+    return d;
+}
+__device__ __forceinline__ float sub_s0(float s0, float s1) {
+    float d;
+    asm("v_sub_f32_e32 %0, %1, %2" : "=v"(d) : "v"(s0), "v"(s1));
+    return d;
+}
+
+/* `block_sum`'s tail, transcribed from libr4d/r4d_model_bf16.hip:144-156 -- the wave butterfly and
+ * the ascending partial sum. It is the one piece of the reference fold small enough that calling
+ * it is clearer than reaching for a template whose launch width we do not otherwise use, and it
+ * uses r4d_wave_sum, which IS the baseline's own. */
+__device__ __forceinline__ float four_wave_sum(float v, float* lds) {
+    v = r4d_wave_sum(v);
+    if ((threadIdx.x & (kWave - 1)) == 0) lds[threadIdx.x / kWave] = v;
+    __syncthreads();
+    float s = 0.0f;
+#pragma unroll
+    for (int wv = 0; wv < kWaves; ++wv) s += lds[wv];
+    return s;
+}
+
+__global__ __launch_bounds__(kThreads) void kns_kernel(Args a) {
+    __shared__ float lds[kWaves];
+    constexpr int HD   = kHeadDim;
+    constexpr int HALF = HD / 2;
+
+    const int64_t t   = blockIdx.x;          /* token */
+    const int64_t h   = blockIdx.y;          /* kv head */
+    const int64_t l   = threadIdx.x;         /* column == lane; the block IS the head */
+
+    uint16_t* kin = a.k + t * a.k_pitch + h * HD;
+
+    /* ---- rmsnorm's sum of squares, folded exactly as libr4d folds it ---- */
+    const float vv = bf16_to_f32(kin[l]);
+    const float sum = four_wave_sum(vv * vv, lds);
+    const float inv = rsqrtf(sum / (float)HD + a.eps);
+
+    /* The gain, at the operand's own width; `+ wadd` in f32 before the multiply, as
+     * rmsnorm_kernel does (`g + wadd` inside the f32 expression, never in the weight's dtype). */
+    auto gain = [&](int64_t i) -> float {
+        return a.w_f32 ? ((const float*)a.w)[i] : bf16_to_f32(((const uint16_t*)a.w)[i]);
+    };
+    /* THE NORM'S STORE, reproduced as a value with the BASELINE'S conversion: the unfused pair
+     * writes bf16 here and the rotation reads it back, so every use of a normed element below is
+     * this rounded value. */
+    auto normed = [&](int64_t i) -> float {
+        const float x = bf16_to_f32(kin[i]);
+        /* The reference's S0 roles: scale, then `wadd` in the add, then the gain (see above). */
+        const float xs = mul_s0(inv, x);
+        const float gw = add_s0(a.wadd, gain(i));
+        return bf16_to_f32(f32_to_bf16(mul_s0(gw, xs)));
+    };
+
+    /* ---- rope, one lane a pair, exactly rope_kernel's arithmetic ---- */
+    const float div = a.rscale != 0.0f ? a.rscale : 1.0f;
+    const float p   = (float)a.pos[t] / div;
+
+    uint16_t k0 = 0, k1 = 0;
+    if (l < HALF) {
+        const float fr = 1.0f / powf(a.theta, (float)(2 * l) / (float)HD);
+        float sn, cs;
+        sincosf(p * fr, &sn, &cs);
+        const float x0 = normed(l);
+        const float x1 = normed(l + HALF);
+        /* rope_kernel's S0 roles: trig first in every product, `c*x0` first in the sub, `c*x1`
+         * first in the add (see the ORDERED VALU note above). */
+        k0 = f32_to_bf16(sub_s0(mul_s0(cs, x0), mul_s0(sn, x1)));
+        k1 = f32_to_bf16(add_s0(mul_s0(cs, x1), mul_s0(sn, x0)));
+    }
+
+    /* The reduction barrier completed all original K reads. Each active lane now owns
+     * its disjoint pair, so the in-place stores need no second block barrier. */
+    if (l < HALF) {
+        kin[l]        = k0;
+        kin[l + HALF] = k1;
+    }
+
+    /* ---- kv_store's bf16 branch ---- */
+    const int32_t sl = a.slot[t];
+    if (sl < 0 || sl / a.block_size >= a.n_blocks) return;
+    if (l >= HALF) return;
+
+    const int64_t blk = sl / a.block_size;
+    const int64_t off = sl % a.block_size;
+    uint16_t* c = a.kv + (((int64_t)blk * a.n_head_kv + h) * a.block_size + off) * (2 * HD);
+    const uint16_t* vrow = a.v + t * a.v_pitch + h * HD;
+
+    c[l]        = k0;
+    c[HALF + l] = k1;
+    c[HD + l]   = vrow[l];
+    c[HD + HALF + l] = vrow[HALF + l];
+}
+
+}  /* namespace */
+
+/* THE NARROWING BOUNDS ARE CHECKED HERE AS WELL AS AT ISSUE, and this is not belt-and-braces: a
+ * launch may be reached with a band-resolved parameter list whose `M` is the BAND and whose operand
+ * carries the real row count, and a tool may call the entry point directly. Every value the kernel
+ * narrows to uint32 for the grid is bounded here, and the pitches are bounded so the kernel's own
+ * `t * k_pitch` cannot wrap. */
+int rad_mine_dflash_k_store_launch(const RadArgs* a, RadStream stream) {
+    RadDflashKStoreCall call{};
+    const int rc = rad_dflash_k_store_args(a, &call);
+    if (rc != RAD_OK) return rc;
+
+    if (call.rows <= 0 || call.rows > (int64_t)UINT32_MAX) return RAD_E_SHAPE;
+    if (call.n_head_kv <= 0 || call.n_head_kv > (int64_t)UINT32_MAX) return RAD_E_SHAPE;
+    if (call.n_blocks <= 0 || call.n_blocks > INT32_MAX) return RAD_E_SHAPE;
+    if (call.block_size <= 0 || call.block_size > INT32_MAX) return RAD_E_SHAPE;
+    /* The grid is (rows, n_head_kv) and every index is `t*k_pitch + h*head_dim`, so the products
+     * are bounded before they are formed rather than trusted. */
+    if (call.rows > (int64_t)UINT32_MAX / call.n_head_kv) return RAD_E_SHAPE;
+    if (call.k_pitch <= 0 || call.rows > INT64_MAX / call.k_pitch) return RAD_E_SHAPE;
+    if (call.v_pitch <= 0 || call.rows > INT64_MAX / call.v_pitch) return RAD_E_SHAPE;
+
+    Args args{};
+    args.k = static_cast<uint16_t*>(call.k);
+    args.v = static_cast<const uint16_t*>(call.v);
+    args.w = call.w;
+    args.pos = call.pos;
+    args.slot = call.slot;
+    args.kv = static_cast<uint16_t*>(call.kv);
+    args.k_pitch = call.k_pitch;
+    args.v_pitch = call.v_pitch;
+    args.n_head_kv = (int)call.n_head_kv;
+    args.block_size = (int)call.block_size;
+    args.n_blocks = (int)call.n_blocks;
+    args.w_f32 = call.w_f32;
+    args.eps = call.eps;
+    args.wadd = call.wadd;
+    args.theta = call.theta;
+    args.rscale = call.rscale;
+
+    /* ONE BLOCK A (TOKEN, KV HEAD): the head's reduction is a block reduction and its 128 columns
+     * are 128 lanes, so grid.y names the head and nothing in the kernel indexes across heads. */
+    void* kargs[] = { &args };
+    const hipError_t e = hipLaunchKernel((const void*)kns_kernel,
+                                         dim3((unsigned)call.rows, (unsigned)call.n_head_kv),
+                                         dim3(kThreads), kargs, 0, (hipStream_t)stream);
+    return e == hipSuccess ? RAD_OK : RAD_E_DEVICE;
+}
+
+int rad_mine_dflash_k_store_count(void) { return 1; }
+
+const RadKernelInfo* rad_mine_dflash_k_store_at(int i) {
+    static const RadKernelInfo row = rad_dflash_k_store_row(rad_mine_dflash_k_store_launch);
+    return i == 0 ? &row : nullptr;
+}
diff --git a/mine/dflash_tree_select.cpp b/mine/dflash_tree_select.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..be833ffa61a3d0b77cfe28f67c8a8a614b5bfafd
--- /dev/null
+++ b/mine/dflash_tree_select.cpp
@@ -0,0 +1,320 @@
+/* dflash_tree_select.cpp -- schema, operand description and call validation for DFlash2's bounded
+ * DarTree selector. The definition of the op is mine/dflash_tree_select.h; the arithmetic lives in
+ * mine/dflash_tree_select.hip (device) and mine/ref_dflash_tree.cpp (host oracle).
+ *
+ * THE SCHEMA IS `dflash_select`'s, PLUS THE TREE'S OWN BOUNDS. Parameters `M`, `steps`, `top_k`,
+ * `rank`, `n_vocab`, `anchor_stride`, `dtype` are spelled exactly as the linear selector spells
+ * them, because this op is selected where that one is and a caller that has the geometry already
+ * has it in this form. `tree_budget`, `tree_width` and `depth_penalty` are the three the tree adds.
+ *
+ * THE OPERANDS ARE `dflash_select`'s FIRST SIX, IN ITS ORDER, AND THE TREE REPLACES `tokens`:
+ * cand, unary, hp?, anchor, pred, succ -> packed_tree. Keeping the six positions means the caller
+ * does not re-describe the candidate planes, and `hp` stays OPTIONAL AT INDEX 2 because a graph that
+ * does not use the hidden projection still passes an empty operand there (the absent-operand rule
+ * in abi/rad_plugin.h: absent is a null `data`, never a shorter array).
+ *
+ * ONE SCHEMA, TWO DOMAINS. `mine` and `mine_ref` publish the same schema and different rows, which
+ * is the ordinary host-oracle convention in this tree: `mine_ref`'s copy is the reference, and the
+ * comparators select a row by name rather than by plugin priority.
+ *
+ * WHAT THIS FILE DOES NOT VALIDATE. Per-row data -- an anchor outside the vocabulary, a non-finite
+ * unary term, an id that is not a codebook row -- is decided by the kernel and the oracle, because
+ * it is read from device memory at launch time and the contract says such a row produces
+ * `count = 0` rather than a refusal. This file refuses only what a call's METADATA can prove
+ * unserviceable, which is the same split every other row here makes. */
+#include "dflash_tree_select.h"
+
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace {
+
+constexpr int kParams = 10;
+
+/* `dtype` is the operand encoding, not a mode: cand/anchor are I32 by the op's definition, unary
+ * is F32 (the head's widened logits, which is what row_topk emits) and the codebooks are BF16. So
+ * `dtype` names the CODEBOOK and candidate encoding family and "bf16" is the only value that
+ * exists. Anything else is a refusal rather than a conversion. */
+#define P_INT(k) { k, RAD_P_INT, RAD_REQUIRED, 0 }
+#define P_F64(k) { k, RAD_P_F64, RAD_REQUIRED, 0 }
+#define P_STR(k) { k, RAD_P_STR, RAD_REQUIRED, 0 }
+#define IN(n)    { n, RAD_OPD_IN, 0 }
+#define WGT(n)   { n, RAD_OPD_WEIGHT, 0 }
+#define OUT(n)   { n, RAD_OPD_OUT, 0 }
+
+static const RadParamSpec kParamSpecs[] = {
+    P_INT("M"), P_INT("steps"), P_INT("top_k"), P_INT("rank"), P_INT("n_vocab"),
+    P_INT("anchor_stride"), P_INT("tree_budget"), P_INT("tree_width"), P_F64("depth_penalty"),
+    P_STR("dtype"),
+};
+
+static const RadOperandSpec kOperandSpecs[] = {
+    IN("cand"), IN("unary"), { "hp", RAD_OPD_IN, 1 }, IN("anchor"), WGT("pred"), WGT("succ"),
+    OUT("packed_tree"),
+};
+
+static const RadOpSchema kSchema = {
+    "dflash_tree_select", kParamSpecs, kParams, kOperandSpecs, RAD_DFLASH_TREE_OPERANDS,
+    "A bounded DarTree over DFlash2's candidate lattice: every parent at level l scores every "
+    "candidate at level l+1 with the linear selector's own FP32 edge "
+    "unary + sum_r pred[pid][r]*hp[row][r]*succ[cand][r], each parent's set is normalised into a "
+    "log probability, at most tree_width successors a level and tree_budget nodes survive, and "
+    "the survivors are packed root-inclusive into [count, token[16], parent[16]] with the anchor "
+    "as node 0. Pruning keeps every ancestor of every kept node. steps <= 3, budget <= 15."
+};
+#undef P_INT
+#undef P_F64
+#undef P_STR
+#undef IN
+#undef WGT
+#undef OUT
+
+/* The geometry every entry point agrees on. Reading it once keeps the shape hook, the validator
+ * and the row's constraints from drifting apart, which for four independent readers of the same
+ * seven names is the failure this tree has already paid for. */
+struct Geom {
+    int64_t M, steps, K, R, V, astr, budget, width;
+    float beta;
+};
+
+/* Returns RAD_OK or the refusal. `wide` selects rad_param_getdim (a shape hook, which reads a
+ * band's high bound) over rad_param_geti (a launch, where a surviving range is a selection bug).
+ *
+ * `M` IS TREATED DIFFERENTLY IN THE TWO DOMAINS, and deliberately. A shape hook must be told the
+ * band's ceiling -- that is what a tool sizes a buffer from. A LAUNCH reads the sequence count from
+ * the output tensor's rows, exactly as `dflash_select` reads its own `M` from `tokens`, because
+ * RadArgs collapses a range to a value and a call that issued one sequence must not be refused for
+ * not owning `max_seqs * steps` candidate rows. So a missing or non-positive `M` at launch is not
+ * fatal; the band it would have supplied is simply absent. */
+int geometry(const RadParam* p, int n_p, Geom* g, bool wide) {
+    if (!p || !g) return RAD_E_INVAL;
+    auto dim = [&](const char* k, int64_t dflt) {
+        return wide ? rad_param_getdim(p, n_p, k, dflt) : rad_param_geti(p, n_p, k, dflt);
+    };
+    g->M      = dim("M", 0);
+    g->steps  = dim("steps", 0);
+    g->K      = dim("top_k", 0);
+    g->R      = dim("rank", 0);
+    g->V      = dim("n_vocab", 0);
+    g->astr   = dim("anchor_stride", 1);
+    g->budget = dim("tree_budget", 0);
+    g->width  = dim("tree_width", 0);
+    if (g->M <= 0 && wide) return RAD_E_UNSUPPORTED;
+    if (g->M < 0) g->M = 0;
+    if (g->steps <= 0 || g->K <= 0 || g->R <= 0 || g->V <= 0 || g->astr <= 0 ||
+        g->budget <= 0 || g->width <= 0)
+        return RAD_E_UNSUPPORTED;
+    /* THE DECLARED BAND, REFUSED BY NAME. More levels would be out of distribution for a drafter
+     * trained at block 4, more than 15 draft nodes cannot fit the verifier, and a width above the
+     * candidate count is a request for candidates that do not exist. */
+    if (g->steps > RAD_DFLASH_TREE_MAX_STEPS || g->K > RAD_DFLASH_TREE_MAX_K ||
+        g->budget > RAD_DFLASH_TREE_MAX_BUDGET || g->width > g->K ||
+        g->width > RAD_DFLASH_TREE_MAX_WIDTH || g->K > g->V)
+        return RAD_E_UNSUPPORTED;
+    /* `depth_penalty` must be finite and non-positive: the tree's prefix-closure argument is that
+     * a child never outranks its parent, and a positive penalty would invert it. */
+    g->beta = (float)rad_param_getf(p, n_p, "depth_penalty", 0.0);
+    if (!std::isfinite(g->beta) || g->beta > 0.0f) return RAD_E_INVAL;
+    const char* dt = rad_param_gets(p, n_p, "dtype", nullptr);
+    if (!dt || std::strcmp(dt, "bf16") != 0) return RAD_E_DTYPE;
+    /* Every derived extent is a product a caller may allocate from, so the overflow is refused
+     * here rather than described and then refused at issue. */
+    if (g->M > INT64_MAX / g->steps || g->M * g->steps > INT64_MAX / g->K ||
+        g->V > INT64_MAX / g->R || (int64_t)g->M * g->astr > INT64_MAX ||
+        g->M * g->steps > INT64_MAX / g->astr)
+        return RAD_E_UNSUPPORTED;
+    if (g->M * g->steps > INT32_MAX || g->V > INT32_MAX || g->R > INT32_MAX) return RAD_E_SHAPE;
+    return RAD_OK;
+}
+
+/* A dense rank-2 plane whose row pitch is at least the width the op reads. */
+int64_t plane(const RadTensor& t, uint32_t dtype, int64_t rows, int64_t width) {
+    if (!t.data || t.dtype != dtype || t.rank != 2 || t.shape[0] < rows || t.shape[1] < width)
+        return -1;
+    if (t.stride[1] != 1 || t.stride[0] < t.shape[1]) return -1;
+    return t.stride[0];
+}
+
+/* A dense rank-1 plane. */
+bool vector(const RadTensor& t, uint32_t dtype, int64_t n) {
+    return t.data && t.dtype == dtype && t.rank == 1 && t.stride[0] == 1 && t.shape[0] >= n;
+}
+
+bool overlap(const RadTensor& a, const RadTensor& b) {
+    if (!a.data || !b.data) return false;
+    auto bytes = [](const RadTensor& t) {
+        int64_t n = 1;
+        for (uint32_t i = 0; i < t.rank; ++i) n += (t.shape[i] - 1) * t.stride[i];
+        return (uint64_t)n * (t.dtype == RAD_BF16 ? 2u : 4u);
+    };
+    const uintptr_t x = (uintptr_t)a.data, y = (uintptr_t)b.data;
+    const uint64_t xa = bytes(a), xb = bytes(b);
+    return x < y + xb && y < x + xa;
+}
+
+}  /* namespace */
+
+int rad_dflash_tree_select_schema_count(void) { return 1; }
+
+const RadOpSchema* rad_dflash_tree_select_schema_at(int i) { return i == 0 ? &kSchema : nullptr; }
+
+/* ---- operand description --------------------------------------------------------------------- */
+/* `M` is the band's ceiling; the operands name the CALL. That is the same reading `dflash_select`'s
+ * hook takes and the reason the launch reads rows from the tensors instead of from the parameter. */
+int rad_dflash_tree_select_shape(const RadParam* p, int n_p, int operand, RadOpdDesc* out) {
+    if (!out || operand < 0 || operand >= RAD_DFLASH_TREE_OPERANDS) return RAD_E_INVAL;
+    Geom g{};
+    const int rc = geometry(p, n_p, &g, true);
+    if (rc != RAD_OK) return rc;
+    RadOpdDesc d{};
+    d.idx_const = -1;
+    d.fill = (uint32_t)RAD_FILL_NORMAL;
+    const int64_t rows = g.M * g.steps;
+    switch (operand) {
+    case RAD_DFLASH_TREE_CAND:
+        d.dtype = RAD_I32; d.rank = 2; d.shape[0] = rows; d.shape[1] = g.K;
+        d.fill = (uint32_t)RAD_FILL_INDEX; d.idx_max = g.V;
+        break;
+    case RAD_DFLASH_TREE_UNARY:
+        d.dtype = RAD_F32; d.rank = 2; d.shape[0] = rows; d.shape[1] = g.K;
+        break;
+    case RAD_DFLASH_TREE_HP:
+        d.dtype = RAD_BF16; d.rank = 2; d.shape[0] = rows; d.shape[1] = g.R;
+        break;
+    case RAD_DFLASH_TREE_ANCHOR:
+        d.dtype = RAD_I32; d.rank = 1; d.shape[0] = g.M * g.astr;
+        d.fill = (uint32_t)RAD_FILL_INDEX; d.idx_max = g.V;
+        break;
+    case RAD_DFLASH_TREE_PRED:
+    case RAD_DFLASH_TREE_SUCC:
+        d.dtype = RAD_BF16; d.rank = 2; d.shape[0] = g.V; d.shape[1] = g.R;
+        break;
+    default:
+        /* THE PACKED TREE, root-inclusive: count, 16 tokens, 16 parents. Its width is the
+         * verifier's own constant and not `budget`, because a tool sizing from this must get a
+         * buffer the engine's tree declaration accepts whatever the budget of the moment is. */
+        d.dtype = RAD_I32; d.rank = 2; d.shape[0] = g.M; d.shape[1] = RAD_DFLASH_TREE_OUT_COLS;
+        d.fill = (uint32_t)RAD_FILL_INDEX; d.idx_max = g.V;
+        break;
+    }
+    *out = d;
+    return RAD_OK;
+}
+
+/* ---- the call ---------------------------------------------------------------------------------- */
+int rad_dflash_tree_select_args(const RadArgs* a, RadDflashTreeSelectCall* call) {
+    if (!a || !call || !a->t || a->n_t != RAD_DFLASH_TREE_OPERANDS) return RAD_E_INVAL;
+    Geom g{};
+    int rc = geometry(a->p, a->n_p, &g, false);
+    if (rc != RAD_OK) return rc;
+
+    const RadTensor& cand = a->t[RAD_DFLASH_TREE_CAND];
+    const RadTensor& un   = a->t[RAD_DFLASH_TREE_UNARY];
+    const RadTensor& hp   = a->t[RAD_DFLASH_TREE_HP];
+    const RadTensor& anc  = a->t[RAD_DFLASH_TREE_ANCHOR];
+    const RadTensor& pr   = a->t[RAD_DFLASH_TREE_PRED];
+    const RadTensor& sc   = a->t[RAD_DFLASH_TREE_SUCC];
+    const RadTensor& out  = a->t[RAD_DFLASH_TREE_OUT];
+    if (!cand.data || !un.data || !anc.data || !pr.data || !sc.data || !out.data)
+        return RAD_E_INVAL;
+
+    /* THE OUTPUT'S ROWS ARE THE COUNT, exactly as `dflash_select` reads its own `M`: RadArgs carries
+     * the geometry with its ranges collapsed, so `M` here is the band's ceiling (max_seqs) and not
+     * the sequences this pass issued. Reading the parameter would demand max_seqs*steps candidate
+     * rows on a one-sequence step and refuse every launch. */
+    if (out.rank != 2 || out.shape[1] < RAD_DFLASH_TREE_OUT_COLS) return RAD_E_SHAPE;
+    const int64_t M = out.shape[0];
+    /* `M` is required by the schema, so a band is always declared; a call that issues MORE rows
+     * than its band is a disagreement, and one that issues fewer is a normal partial step. */
+    if (M <= 0 || M > g.M) return RAD_E_SHAPE;
+    const int64_t rows = M * g.steps;
+    if (rows > INT32_MAX) return RAD_E_SHAPE;
+
+    RadDflashTreeSelectCall v{};
+    v.M = M;
+    v.rows = rows;
+    v.steps = g.steps;
+    v.K = g.K;
+    v.R = g.R;
+    v.V = g.V;
+    v.anchor_stride = g.astr;
+    v.budget = g.budget;
+    v.width = g.width;
+    v.beta = g.beta;
+
+    v.cand_ld  = plane(cand, RAD_I32, rows, g.K);
+    v.unary_ld = plane(un, RAD_F32, rows, g.K);
+    /* The output is a [M, 33] plane too; its own pitch is what the kernel writes through, so it is
+     * checked the same way rather than assumed contiguous. */
+    if (out.stride[1] != 1 || out.stride[0] < RAD_DFLASH_TREE_OUT_COLS) return RAD_E_STRIDE;
+    v.out_ld   = (int64_t)out.stride[0];
+    v.pred_ld  = plane(pr, RAD_BF16, g.V, g.R);
+    v.succ_ld  = plane(sc, RAD_BF16, g.V, g.R);
+    /* ABSENT IS A NULL `data`, NOT A MISSING OPERAND -- see the header. Both spellings of "no hidden
+     * projection" arrive here and both mean the bigram form. */
+    const bool has_hp = hp.data != nullptr;
+    v.hp_ld = has_hp ? plane(hp, RAD_BF16, rows, g.R) : 0;
+    if (v.cand_ld < 0 || v.unary_ld < 0 || v.hp_ld < 0 || v.pred_ld < 0 || v.succ_ld < 0)
+        return RAD_E_SHAPE;
+    if (!vector(anc, RAD_I32, (M - 1) * g.astr + 1)) return RAD_E_SHAPE;
+    /* One pitch for both candidate planes, because the kernel indexes them with one expression and
+     * a call whose two planes disagree would read a row of the other. */
+    if (v.cand_ld != v.unary_ld) return RAD_E_STRIDE;
+    /* The launch narrows every pitch to `int`; refusing above it here beats a silent truncation. */
+    if (v.cand_ld > INT32_MAX || v.unary_ld > INT32_MAX || v.hp_ld > INT32_MAX ||
+        v.pred_ld > INT32_MAX || v.succ_ld > INT32_MAX || v.out_ld > INT32_MAX ||
+        v.M > INT32_MAX || v.R > INT32_MAX || v.K > INT32_MAX || v.V > INT32_MAX)
+        return RAD_E_SHAPE;
+
+    /* THE PACKED OUTPUT MAY NOT SHARE BYTES WITH ANY INPUT: the kernel reads all three planes of a
+     * level before it writes, but a row's write would land in a plane the NEXT level still reads. */
+    if (overlap(out, cand) || overlap(out, un) || overlap(out, anc) ||
+        (has_hp && overlap(out, hp)) || overlap(out, pr) || overlap(out, sc))
+        return RAD_E_INVAL;
+
+    v.cand = cand.data;
+    v.unary = un.data;
+    v.hp = has_hp ? hp.data : nullptr;
+    v.anchor = anc.data;
+    v.pred = pr.data;
+    v.succ = sc.data;
+    v.out = out.data;
+    *call = v;
+    return RAD_OK;
+}
+
+/* The row's necessary conditions on a GEOMETRY. Strides, dtypes and alignment are properties of a
+ * call and stay in the entry point above, as spec §2.1 requires. */
+static const RadConstraint kConstraints[] = {
+    RAD_CLE("steps", RAD_DFLASH_TREE_MAX_STEPS),
+    RAD_CLE("top_k", RAD_DFLASH_TREE_MAX_K),
+    RAD_CLE("tree_budget", RAD_DFLASH_TREE_MAX_BUDGET),
+    RAD_CLE("tree_width", RAD_DFLASH_TREE_MAX_WIDTH),
+    RAD_CGE("steps", 1),
+    RAD_CGE("tree_budget", 1),
+    RAD_CGE("tree_width", 1),
+    RAD_CIN("dtype", "bf16"),
+};
+
+RadKernelInfo rad_dflash_tree_select_row(RadLaunchFn launch) {
+    RadKernelInfo r{};
+    r.name = "mine_dflash_tree_select";
+    r.op = kSchema.op;
+    r.family = "draft";
+    r.computes = kSchema.doc;
+    r.shape = "steps <= 3, top_k <= 16, tree_budget <= 15, tree_width <= top_k; candidate planes "
+              "are (seq*steps+level) rows; output is the root-inclusive [M, 33] packed tree";
+    r.dtypes = "i32 candidates and anchors, f32 unary, bf16 codebooks and hp, i32 tree out";
+    r.domain = RAD_DOMAIN_DEVICE;
+    r.priority = 100;
+    r.constraints = kConstraints;
+    r.n_constraints = (int)(sizeof(kConstraints) / sizeof(kConstraints[0]));
+    r.launch = launch;
+    r.opd_shape = rad_dflash_tree_select_shape;
+    /* NO `replaces`. This op is not a fusion of conventional ops: it is a DIFFERENT selector with
+     * the same edge arithmetic as `dflash_select`, and a chain claim would say the two agree on
+     * every call, which is false for every budget above one path. */
+    return r;
+}
diff --git a/mine/dflash_tree_select.h b/mine/dflash_tree_select.h
new file mode 100644
index 0000000000000000000000000000000000000000..332d9058af8eacc6e1d89e35ea5bf3da88b23abb
--- /dev/null
+++ b/mine/dflash_tree_select.h
@@ -0,0 +1,138 @@
+#ifndef RAD_MINE_DFLASH_TREE_SELECT_H
+#define RAD_MINE_DFLASH_TREE_SELECT_H
+
+#include "rad_plugin.h"
+#include <stdint.h>
+
+/* dflash_tree_select -- DFlash2's candidate walk, widened into a bounded, pruned tree.
+ *
+ * THE SCORING IS THE SHIPPING SELECTOR'S. For one (parent, candidate) pair the edge is
+ *
+ *     unary[l][c] + sum_r pred[pid][r] * hp[l][r] * succ[cand[l][c]][r],   pid(0) = anchor,
+ *
+ * with `hp` absent meaning a plane of ones. The reduction is reproduced operation for operation
+ * from libr4d/r4d_dflash_select_bf16.hip: a 32-lane accumulation over `r = lane, lane+32, ...`
+ * seeded at zero, the xor-butterfly fold (16,8,4,2,1), and `unary` added last. Same order, same
+ * FP32, `-ffp-contract=off` on both sides, so for the geometry the shipping row accepts
+ * (`rank` a multiple of 32) the linear walk is bit-identical, not merely formula-identical. This
+ * op also accepts `rank` that is not a multiple of 32 -- the fold is the natural extension and
+ * nothing here depends on the multiple -- but parity with libr4d is only claimed where libr4d
+ * runs at all. `top_k` is capped at 16 here rather than libr4d's 32, because a tree's frontier is
+ * sized by the verifier's 16 rows.
+ *
+ * THE TREE HEURISTIC IS ONE SUBTRACTION. A chain compares candidates within one parent; a tree
+ * must also compare ACROSS parents, and raw logits from different parents are not on one scale.
+ * Each parent's candidate scores are therefore shifted by that parent's own maximum, so every
+ * parent's best sits at zero and children carry their parent's accumulated score. The shift is
+ * monotone inside a parent, so it changes no within-parent ordering; across parents it is a
+ * normalisation by local maximum, not a probability. Pruning then keeps the `tree_budget` best
+ * nodes by `score + depth_penalty * depth`, and never keeps a node whose parent it dropped.
+ *
+ * A subtraction rather than a log-softmax on purpose: `logf`/`expf` need not agree bit for bit
+ * between the device and the host oracle, and this op's comparison is a byte comparison. Dropping
+ * the log-sum-exp term removes a per-parent constant from a heuristic that is not a model of
+ * anything, and keeps both sides exactly comparable.
+ *
+ * THREE DELIBERATE DIFFERENCES FROM `dflash_select`, all about ids:
+ *
+ *   * a candidate outside `[0, n_vocab)` is not offered. The chain may pick such a slot on its
+ *     unary term alone because it emits an INDEX; a tree proposes a TOKEN the target must have.
+ *   * an anchor outside `[0, n_vocab)` writes `count = 0`. The chain scores it as a predecessor
+ *     with no codebook contribution; a tree cannot have an unverifiable root.
+ *   * a REPEATED candidate id under one parent is deduplicated to a single node, keeping the
+ *     instance with the highest raw edge score and, on an exact tie, the lower candidate index.
+ *     The scheduler refuses a tree whose siblings propose the same token
+ *     (`core/sched/scheduler.cpp`, `set_draft_tree`), and keeping the best-scoring instance is the
+ *     linear walk's own argmax rule, so a `tree_width = 1` pick is unchanged by the rule.
+ *
+ * ============================== OUTPUT ==============================
+ *
+ * `packed_tree` is dloop_dartree's root-inclusive packing, `[M, 1 + 2*capacity]` I32, which is what
+ * `mine/dloop_tree.hip` writes and `dloop_tree_from_packed` reads. The engine declares the drafter
+ * tree with `capacity = 16` node slots, so a row is 33 columns:
+ *
+ *     col 0                  count = 1 + emitted draft nodes   (0 when the row is invalid)
+ *     col 1 + i              node i's token, i = 0 (THE ANCHOR) .. count-1
+ *     col 1 + capacity + i   node i's root-inclusive parent, the same range: 0 = the anchor
+ *     col 1 + capacity       the anchor's parent: the -1 SENTINEL the validator requires
+ *
+ * At capacity 16 the parent block is columns 17..32, so the sentinel sits at 17 and the first
+ * draft node's parent at 18. Writing the pitch as `1 + capacity` rather than as a literal is what
+ * keeps this correct for a capacity other than 16 -- and `capacity` is the declared tree size, NOT
+ * the selector's `tree_budget`. Unused slots are -1 in both blocks. Nodes are emitted in old-id
+ * order, and an old id is assigned when its level is appended, so `parent(i) < i` holds for every
+ * node after the root. Siblings of one parent appear by descending score, which puts that parent's
+ * greedy child first -- the property `dloop_greedy_chain` reads.
+ *
+ * A row whose per-row data cannot produce a tree (an anchor outside the vocabulary, a non-finite
+ * unary or edge on a live candidate) writes `count = 0`. That is the contract, not a convenience: a
+ * device launch cannot be failed once issued, and the host oracle writes the same zero.
+ *
+ * ============================== BOUNDS ==============================
+ *
+ * `steps` is 1..3, `tree_budget` 1..15, `top_k` 1..16, `tree_width` 1..top_k. A call outside them is
+ * refused rather than clamped: more than 15 draft nodes does not fit the verifier beside the
+ * anchor, and more than 3 levels is past the depth the drafter was trained for. Growth is linear in
+ * the level count (`1 + steps * tree_width <= 49` nodes), never a global beam. */
+enum {
+    RAD_DFLASH_TREE_CAND = 0,
+    RAD_DFLASH_TREE_UNARY = 1,
+    RAD_DFLASH_TREE_HP = 2,
+    RAD_DFLASH_TREE_ANCHOR = 3,
+    RAD_DFLASH_TREE_PRED = 4,
+    RAD_DFLASH_TREE_SUCC = 5,
+    RAD_DFLASH_TREE_OUT = 6,
+    RAD_DFLASH_TREE_OPERANDS = 7
+};
+
+/* The declared limits. They are the verifier's, not a tuning knob: 15 draft nodes is the largest
+ * tree that fits 16 verification rows beside the anchor. */
+enum { RAD_DFLASH_TREE_MAX_STEPS = 3, RAD_DFLASH_TREE_MAX_K = 16,
+       RAD_DFLASH_TREE_MAX_BUDGET = 15, RAD_DFLASH_TREE_MAX_WIDTH = RAD_DFLASH_TREE_MAX_K,
+       RAD_DFLASH_TREE_MAX_NODES = 1 + RAD_DFLASH_TREE_MAX_STEPS * RAD_DFLASH_TREE_MAX_WIDTH,
+       RAD_DFLASH_TREE_OUT_COLS = 33 };
+
+/* Validated, device-free view of one call. Nothing here dereferences a pointer: at issue every
+ * operand is device memory, and the values inside them are checked per row by the kernel and the
+ * oracle, not here. */
+struct RadDflashTreeSelectCall {
+    const void* cand;
+    const void* unary;
+    const void* hp;          /* null when absent: a plane of ones */
+    const void* anchor;
+    const void* pred;
+    const void* succ;
+    void*       out;
+    int64_t     M;           /* the output's rows: the sequences drafting in this pass */
+    int64_t     rows;        /* M * steps: the candidate planes' rows, s*steps + level - 1 */
+    int64_t     steps;
+    int64_t     K;
+    int64_t     R;
+    int64_t     V;
+    int64_t     anchor_stride;
+    int64_t     budget;
+    int64_t     width;
+    float       beta;        /* depth penalty, <= 0 */
+    int64_t     cand_ld;
+    int64_t     unary_ld;
+    int64_t     hp_ld;
+    int64_t     pred_ld;
+    int64_t     succ_ld;
+    int64_t     out_ld;
+};
+
+int                 rad_dflash_tree_select_schema_count(void);
+const RadOpSchema*  rad_dflash_tree_select_schema_at(int);
+int                 rad_dflash_tree_select_shape(const RadParam*, int, int, RadOpdDesc*);
+/* RAD_OK, or the reason this call is not the op: RAD_E_UNSUPPORTED outside the declared level /
+ * top-k / budget band, RAD_E_DTYPE for a non-bf16 dtype, RAD_E_SHAPE for extents or pitches that
+ * disagree with the parameters, RAD_E_STRIDE for a non-dense operand, RAD_E_INVAL for a required
+ * operand absent or an output overlapping an input. */
+int                 rad_dflash_tree_select_args(const RadArgs*, RadDflashTreeSelectCall*);
+RadKernelInfo       rad_dflash_tree_select_row(RadLaunchFn);
+int                 rad_mine_dflash_tree_select_count(void);
+const RadKernelInfo* rad_mine_dflash_tree_select_at(int);
+/* The launch entry point, declared here so the .hip defines its row from it. */
+int                 rad_mine_dflash_tree_select_launch(const RadArgs*, RadStream);
+
+#endif /* RAD_MINE_DFLASH_TREE_SELECT_H */
diff --git a/mine/dflash_tree_select.hip b/mine/dflash_tree_select.hip
new file mode 100644
index 0000000000000000000000000000000000000000..dbf57ebdeae3e639ac5d35ef3f604a899486008c
--- /dev/null
+++ b/mine/dflash_tree_select.hip
@@ -0,0 +1,319 @@
+/* dflash_tree_select.hip -- DFlash2's bounded DarTree selector, one workgroup a sequence.
+ *
+ * The op definition is mine/dflash_tree_select.h. The EDGE ARITHMETIC IS `dflash_select`'s,
+ * reproduced operation for operation: per candidate, a 32-lane accumulation over
+ * `r = lane, lane+32, ...` seeded at zero, the same xor-butterfly fold (`16,8,4,2,1`) the
+ * production kernel gets from `r4d_wave_sum`, and `unary` added LAST. Both are compiled with
+ * `-ffp-contract=off`, so no product is fused into its add on either side. That is what makes the
+ * single-path case reproduce the shipping selector's tokens rather than merely its formula.
+ *
+ * WHAT CHANGES IS WHAT HAPPENS AFTER A LEVEL'S SCORES ARE KNOWN: every parent of the frontier
+ * scores every candidate, each parent's candidates are shifted so its own best sits at zero, and
+ * the level's best `tree_width` pairs become nodes. The shift is monotone within the parent and
+ * has no effect on which pair wins within it, but it makes scores comparable across parents, which
+ * a tree needs and a chain does not.
+ *
+ * INVALID ROWS WRITE `count = 0`. A launch cannot be failed once issued, so a row whose data
+ * cannot produce a tree writes zero and stops. The host oracle produces the same zero.
+ */
+#include <hip/hip_runtime.h>
+
+#include <cstdint>
+
+#include "dflash_tree_select.h"
+#include "../libr4d/r4d_common.h"
+
+namespace {
+
+constexpr int kThreads = 128;
+constexpr int kWave = 32;                              /* production's wave width */
+constexpr int kMaxK = RAD_DFLASH_TREE_MAX_K;
+constexpr int kMaxWidth = RAD_DFLASH_TREE_MAX_WIDTH;
+constexpr int kMaxNodes = RAD_DFLASH_TREE_MAX_NODES;   /* 1 + 3*16 */
+constexpr int kMaxPairs = kMaxK * kMaxWidth;
+constexpr int kCols = RAD_DFLASH_TREE_OUT_COLS;
+/* THE ROW'S NODE CAPACITY, which is what the packing pitch is derived from and NOT the selector's
+ * `tree_budget`. The engine declares the tree with 16 node slots and reads a row of
+ * `1 + 2*capacity` columns, so at capacity 16 that row is 33 columns wide with the anchor's
+ * sentinel parent in between the two blocks. Keeping the pitch written as `1 + capacity + i`
+ * rather than as a literal 18 is what makes this correct for a capacity other than 16. */
+constexpr int kCapacity = (kCols - 1) / 2;              /* 16 */
+static_assert(kCapacity <= RAD_DFLASH_TREE_MAX_WIDTH, "the row must hold every declared width");
+static_assert(1 + 2 * kCapacity == kCols, "the row is exactly two capacity-blocks plus the count");
+
+/* BF16 by shift, exactly as the production kernels widen it. */
+__device__ __forceinline__ float bf16(uint16_t x) { return __uint_as_float((unsigned)x << 16); }
+
+__device__ __forceinline__ bool finite(float x) { return x == x && x != INFINITY && x != -INFINITY; }
+
+/* `dflash_select`'s edge sum for one (parent, candidate), in its order:
+ *
+ *   sa[r]     = pred[pid][r] * hp[row][r]        (or pred[pid][r] when hp is absent)
+ *   acc[l]   += sa[r] * succ[token][r]           for r = l, l+32, ...   (l in [0, 32))
+ *   fold      : stride 16, 8, 4, 2, 1  ->  acc[i] += acc[i ^ stride]
+ *   score     = acc[0] + unary                    (the add comes LAST)
+ *
+ * Every lane participates, including zero lanes past an odd R, just as in the shipping fold. */
+__device__ __forceinline__ float edge_sum(const uint16_t* pred_row, const uint16_t* hp_row,
+                                         const uint16_t* succ_row, int R, int lane) {
+    float acc = 0.0f;
+    for (int64_t r = lane; r < R; r += kWave) {
+        const float p = bf16(pred_row[r]);
+        const float a = hp_row ? __fmul_rn(p, bf16(hp_row[r])) : p;
+        acc = __fadd_rn(acc, __fmul_rn(a, bf16(succ_row[r])));
+    }
+    return r4d_wave_sum(acc);
+}
+
+struct Args {
+    const int32_t* cand;
+    const float*   unary;
+    const uint16_t* hp;          /* nullptr: a plane of ones */
+    const int32_t* anchor;
+    const uint16_t* pred;
+    const uint16_t* succ;
+    int32_t*       out;
+    int M, steps, K, R, V, astr, budget, width;
+    float beta;
+    int cand_ld, unary_ld, hp_ld, pred_ld, succ_ld, out_ld;
+};
+
+__global__ __launch_bounds__(kThreads) void tree_select_kernel(Args a) {
+    const int s = blockIdx.x, tid = threadIdx.x;
+    const int lane = tid & (kWave - 1), wave = tid / kWave;
+    int32_t* out = a.out + (int64_t)s * a.out_ld;
+    if (tid == 0) {
+        for (int i = 0; i < kCols; ++i) out[i] = -1;
+        out[0] = 0;                          /* the invalid-row answer, before any early return */
+    }
+
+    __shared__ int tok[kMaxNodes], par[kMaxNodes], depth[kMaxNodes];
+    __shared__ float score[kMaxNodes];
+    __shared__ int32_t ctok[kMaxK];
+    __shared__ float cun[kMaxK];
+    __shared__ unsigned char live[kMaxK];
+    __shared__ float pairScore[kMaxPairs], pairCorr[kMaxPairs];
+    __shared__ int pairParent[kMaxPairs], pairCand[kMaxPairs], pairLive[kMaxPairs];
+    __shared__ int keep[kMaxNodes + 1], remap[kMaxNodes + 1];
+    __shared__ int invalid, total, first, frontier, chosen;
+
+    if (tid == 0) {
+        const int root = a.anchor[(int64_t)s * a.astr];
+        invalid = root < 0 || root >= a.V;
+        tok[0] = root;
+        par[0] = -1;
+        depth[0] = 0;
+        score[0] = 0.0f;
+        total = 1;
+        first = 0;
+        frontier = 1;
+    }
+    /* Cross-thread communication is LDS-only: inputs are read-only, and only tid 0 writes out.
+     * Keep codebook cache lines across phases rather than globally fencing every barrier. */
+    lds_barrier();
+    if (invalid) return;
+
+    for (int level = 1; level <= a.steps && frontier > 0; ++level) {
+        const int64_t row = (int64_t)s * a.steps + level - 1;
+        if (tid < a.K) {
+            ctok[tid] = a.cand[row * a.cand_ld + tid];
+            cun[tid] = a.unary[row * a.unary_ld + tid];
+            /* An id outside the vocabulary is not a codebook row and cannot be a tree node.
+             * Duplicates ARE live here and are deduplicated later, per parent, by score -- see the
+             * pair loop below for why the choice of instance matters. */
+            live[tid] = (ctok[tid] >= 0 && ctok[tid] < a.V) ? 1 : 0;
+            if (live[tid] && !finite(cun[tid])) atomicExch(&invalid, 1);
+        }
+        lds_barrier();
+        if (invalid) return;
+
+        /* One wave owns a (parent, candidate) pair. Flattening the whole frontier keeps waves
+         * busy even for K < the wave count, without a barrier for each parent. */
+        const int pairs = frontier * a.K;
+        for (int i = wave; i < pairs; i += kThreads / kWave) {
+            const int j = i % a.K, node = first + i / a.K;
+            if (live[j]) {
+                const float corr = __fadd_rn(
+                    edge_sum(a.pred + (int64_t)tok[node] * a.pred_ld,
+                             a.hp ? a.hp + row * a.hp_ld : nullptr,
+                             a.succ + (int64_t)ctok[j] * a.succ_ld, a.R, lane),
+                    cun[j]);
+                if (lane == 0) {
+                    pairCorr[i] = corr;
+                    if (!finite(corr)) atomicExch(&invalid, 1);
+                }
+            }
+        }
+        lds_barrier();
+        if (invalid) return;
+
+        /* Each parent owns a disjoint K-slot slice; dead and duplicate slots stay unoffered.
+         * Keeping the holes preserves the old parent/candidate order without serial compaction. */
+        if (tid < frontier) {
+            const int begin = tid * a.K, node = first + tid;
+            /* Shift by the parent's own maximum, exactly as before. Unary was added LAST above. */
+            float peak = -INFINITY;
+            for (int j = 0; j < a.K; ++j)
+                if (live[j] && pairCorr[begin + j] > peak) peak = pairCorr[begin + j];
+            for (int j = 0; j < a.K; ++j) {
+                const int i = begin + j;
+                pairLive[i] = 0;
+                if (!live[j]) continue;
+                /* Compare EVERY instance: a later, higher-scoring duplicate evicts an earlier
+                 * one. Exact ties retain the lower candidate index, as in the linear walk. */
+                bool beaten = false;
+                for (int q = 0; q < a.K && !beaten; ++q) {
+                    if (q == j || !live[q] || ctok[q] != ctok[j]) continue;
+                    beaten = pairCorr[begin + q] > pairCorr[i] ||
+                             (pairCorr[begin + q] == pairCorr[i] && q < j);
+                }
+                if (beaten) continue;
+                pairScore[i] = __fadd_rn(score[node], pairCorr[i] - peak);
+                pairParent[i] = node;
+                pairCand[i] = j;
+                pairLive[i] = 1;
+            }
+        }
+        /* Snapshot before the fence: thread 0 may publish next level's total while other lanes
+         * are still appending this one, and every writer must retain the same old-id base. */
+        const int append = total;
+        lds_barrier();
+
+        /* The level's best `width` pairs. `pairScore` is the cross-parent order; then the PARENT old
+         * id, which is a deterministic index rather than a comparison of two different parents'
+         * logit scales; then `pairCorr`, so within one parent the winner is the linear walk's argmax
+         * even when the shift rounds two neighbours together; then the candidate index. Total, and
+         * identical on both sides. */
+        /* Count strictly better pairs in parallel. The comparator is total, so rank is a unique
+         * old-id offset: the same append order as width serial argmax rounds, without their
+         * barriers. Stop counting once a pair cannot fit in this level's bounded prefix. */
+        for (int i = tid; i < pairs; i += kThreads) {
+            if (!pairLive[i]) continue;
+            int rank = 0;
+            for (int q = 0; q < pairs && rank < a.width; ++q) {
+                if (!pairLive[q]) continue;
+                const bool better =
+                    pairScore[q] > pairScore[i] ||
+                    (pairScore[q] == pairScore[i] &&
+                     (pairParent[q] < pairParent[i] ||
+                      (pairParent[q] == pairParent[i] &&
+                       (pairCorr[q] > pairCorr[i] ||
+                        (pairCorr[q] == pairCorr[i] && pairCand[q] < pairCand[i])))));
+                if (better) ++rank;
+            }
+            if (rank >= a.width) continue;
+            const int node = append + rank;
+            tok[node] = ctok[pairCand[i]];
+            par[node] = pairParent[i];
+            depth[node] = level;
+            score[node] = pairScore[i];
+        }
+        /* Pair liveness remains immutable throughout ranking; count it alongside the workers. */
+        if (tid == 0) {
+            chosen = 0;
+            for (int i = 0; i < pairs && chosen < a.width; ++i)
+                if (pairLive[i]) ++chosen;
+            first = append;
+            total = append + chosen;
+            frontier = chosen;
+        }
+        lds_barrier();
+    }
+
+    /* ---- prune, then pack in old-id order ----
+     * Peak-normalized deltas <= 0, validated finite beta <= 0 and increasing depth make each
+     * penalized child <= its parent. Depth ties put the parent first even at -inf. The global
+     * top-budget prefix is therefore parent-closed, exactly the eligible-
+     * parent greedy walk. Rank it in parallel, reusing the now-dead pair score plane. */
+    float* const value = pairScore;
+    if (tid < total) value[tid] = score[tid] + a.beta * (float)depth[tid];
+    lds_barrier();
+    if (tid == 0) keep[0] = 1;
+    if (tid > 0 && tid < total) {
+        int rank = 0;
+        for (int i = 1; i < total && rank < a.budget; ++i)
+            if (value[i] > value[tid] ||
+                (value[i] == value[tid] &&
+                 (depth[i] < depth[tid] || (depth[i] == depth[tid] && i < tid))))
+                ++rank;
+        keep[tid] = rank < a.budget;
+    }
+    lds_barrier();
+    if (tid != 0) return;
+
+    for (int i = 0; i <= total; ++i) remap[i] = -1;
+    remap[0] = 0;                       /* the anchor is node 0 */
+    int node = 0;                       /* root-inclusive node id of the last emitted node */
+    for (int i = 1; i < total; ++i) {
+        if (!keep[i]) continue;
+        const int parent = remap[par[i]];
+        /* A level is appended whole, so a parent's old id is smaller and already remapped; the
+         * check stays because a tree the verifier cannot read must not be published. */
+        if (parent < 0 || par[i] >= i) {
+            for (int c = 0; c < kCols; ++c) out[c] = -1;
+            out[0] = 0;
+            return;
+        }
+        remap[i] = ++node;
+        /* THE PACKED ROW, capacity-generic, exactly as `dloop_tree.hip` and `ref_dloop.cpp` write
+         * it and as `dloop_tree_from_packed` reads it:
+         *   row[0]                    count = 1 + draft nodes
+         *   row[1 + i]                node i's token, i = 0 (the anchor) .. count-1
+         *   row[1 + kCols/2 + i]      node i's parent, the same range -- at the declared capacity
+         *                             16 that is row[17 + i], and row[17] is the anchor's -1
+         *                              SENTINEL the validator requires
+         * `node` is the ROOT-INCLUSIVE id, so the token and parent of one node are written at the
+         * same offset and the parent block starts exactly `capacity` columns after the token
+         * block. That is why 16 tokens and 16 parents fit in 33 columns with the sentinel in
+         * between, and why this form stays correct for a capacity other than 16. */
+        out[1 + node] = tok[i];
+        out[1 + kCapacity + node] = parent;
+    }
+    out[0] = node + 1;
+    out[1] = tok[0];
+    out[1 + kCapacity] = -1;           /* the anchor's sentinel parent */
+}
+
+}  /* namespace */
+
+int rad_mine_dflash_tree_select_launch(const RadArgs* a, RadStream stream) {
+    RadDflashTreeSelectCall call{};
+    const int rc = rad_dflash_tree_select_args(a, &call);
+    if (rc != RAD_OK) return rc;
+
+    Args args{};
+    args.cand = static_cast<const int32_t*>(call.cand);
+    args.unary = static_cast<const float*>(call.unary);
+    args.hp = static_cast<const uint16_t*>(call.hp);
+    args.anchor = static_cast<const int32_t*>(call.anchor);
+    args.pred = static_cast<const uint16_t*>(call.pred);
+    args.succ = static_cast<const uint16_t*>(call.succ);
+    args.out = static_cast<int32_t*>(call.out);
+    args.M = (int)call.M;
+    args.steps = (int)call.steps;
+    args.K = (int)call.K;
+    args.R = (int)call.R;
+    args.V = (int)call.V;
+    args.astr = (int)call.anchor_stride;
+    args.budget = (int)call.budget;
+    args.width = (int)call.width;
+    args.beta = call.beta;
+    args.cand_ld = (int)call.cand_ld;
+    args.unary_ld = (int)call.unary_ld;
+    args.hp_ld = (int)call.hp_ld;
+    args.pred_ld = (int)call.pred_ld;
+    args.succ_ld = (int)call.succ_ld;
+    args.out_ld = (int)call.out_ld;
+
+    void* kargs[] = { &args };
+    const hipError_t e = hipLaunchKernel((const void*)tree_select_kernel, dim3((unsigned)call.M),
+                                         dim3(kThreads), kargs, 0, (hipStream_t)stream);
+    return e == hipSuccess ? RAD_OK : RAD_E_DEVICE;
+}
+
+int rad_mine_dflash_tree_select_count(void) { return 1; }
+
+const RadKernelInfo* rad_mine_dflash_tree_select_at(int i) {
+    static const RadKernelInfo row = rad_dflash_tree_select_row(rad_mine_dflash_tree_select_launch);
+    return i == 0 ? &row : nullptr;
+}
