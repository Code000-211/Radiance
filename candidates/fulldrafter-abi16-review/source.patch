+        }
+    }
+    // P == Q bit for bit: build_q and the verifier normalize the same FP32 scores in one order.
+    const int32_t sid[8]={3,1,4,-1,-1,-1,-1,-1};
+    const float sval[8]={0,-0.5f,-1.25f,-INFINITY,-INFINITY,-INFINITY,-INFINITY,-INFINITY};
