+    parse("off","3",nullptr,true);
+    parse("score","5",nullptr,true,1,5);
+    parse("cost","5","1,2,3,4,5,6,7,8",true,2,5);
+    parse(nullptr,"8",nullptr,true,0,8);
+    parse("off","8",nullptr,true,0,8);
