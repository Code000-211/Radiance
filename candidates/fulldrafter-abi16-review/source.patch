+/* hc_mean.cpp -- the schema and the host-side validation for the DFlash2 tap reduction.
+ *
+ * THE SCHEMA IS libref's, SLOT FOR SLOT. The loader refuses a plugin whose schema for an op
+ * disagrees with the one already registered, and arguments are positional, so a capital `N` here
+ * and a lower-case `n` there would make the same call mean two things depending on which kernel
+ * won selection. `hc_mean` is a new op and spells the width `N`, which is what its caller in
+ * arch/qwen4exp_fp8 writes; the gated residual's three ops keep their `n`.
+ *
+ * THE OPERAND ORDER IS `h` THEN `x`. The output is NOT in-place and the tap plane is a different
+ * buffer from the residual stream, so a caller cannot express the call the other way round.
+ *
+ * THIS FILE IS COMPILED INTO THE DEVICE PLUGIN ONLY. The host oracle is libref's ref_hc_mean, and
+ * duplicating it here would be a second reference that rad-kbench could then pick between. What is
+ * shared is the SCHEMA and the validation: a device kernel that accepted a call the oracle refuses
+ * would be a divergence the oracle cannot see, so both are written once and the row below carries
+ * mine's launch entry point in.
+ */
+#include "hc_mean.h"
+
+#include <cstdint>
+#include <cstring>
+
+namespace {
+
+/* The one geometry the device row is compiled for: hc 4, the DFlash2 hyper-connection count, and a
+ * width that is a whole number of 8-wide bf16 groups. `N % 8 == 0` is what lets the kernel read
+ * one `uint4`-sized group of each stream without a tail branch; N = 2560 is the real call and
+ * every multiple of 8 below the alignment bound is the same code. */
+constexpr int64_t kHc = 4;
+constexpr int64_t kAlign = 8;
+
+/* Elements a tensor occupies, from its OWN shape and strides -- a column view is measured over the
+ * columns it names, not over the buffer it is a view of. */
+int64_t span_elements(const RadTensor& t) {
+    int64_t e = 1;
+    for (uint32_t i = 0; i < t.rank; ++i) e += (t.shape[i] - 1) * t.stride[i];
+    return e;
+}
+
+bool overlaps(const RadTensor& a, const RadTensor& b) {
+    if (!a.data || !b.data) return false;
+    const uintptr_t x = (uintptr_t)a.data, y = (uintptr_t)b.data;
+    const int64_t ea = span_elements(a), eb = span_elements(b);
+    const uint64_t xa = (uint64_t)ea * 2u, xb = (uint64_t)eb * 2u;
+    return x < y + xb && y < x + xa;
+}
+
+static_assert(RAD_HC_MEAN_OPERANDS == 2, "the schema below lists two operands");
+
+}  /* namespace */
+
+int rad_hc_mean_schema_count(void) { return 1; }
+
+/* ---- schema ---------------------------------------------------------------------------------- */
+#define P_INT(k)  { k, RAD_P_INT, RAD_REQUIRED, 0 }
+#define P_STR(k)  { k, RAD_P_STR, RAD_REQUIRED, 0 }
+#define IN(n)     { n, RAD_OPD_IN,  0 }
+#define OUT(n)    { n, RAD_OPD_OUT, 0 }
+
+static const RadParamSpec kParams[] = { P_INT("M"), P_INT("N"), P_INT("hc"), P_STR("dtype") };
+static const RadOperandSpec kOperands[] = { IN("h"), OUT("x") };
+static const RadOpSchema kSchema = {
+    "hc_mean", kParams, (int)(sizeof(kParams) / sizeof(kParams[0])),
+    kOperands, (int)(sizeof(kOperands) / sizeof(kOperands[0])),
+    "x[m,i] = mean over the hc streams of h[m, c*N+i] -- the capture's own reduction, summed in "
+    "f32 and stored bf16 once, with no RMS, gate or weight. The output is normally a column view "
+    "of a wider tap plane and is written through its own row stride."
+};
+#undef P_INT
+#undef P_STR
+#undef IN
+#undef OUT
+
+const RadOpSchema* rad_hc_mean_schema_at(int i) { return i == 0 ? &kSchema : nullptr; }
+
+/* ---- operand description --------------------------------------------------------------------- */
+/* `M` is the band ceiling and the operand names the call, exactly as libref's hook says: a tool
+ * that sizes its buffers from this gets the band, which is what a test wants, and a launch reads
+ * the rows from the tensor. The output is described as the packed [M, N] plane a tool allocates
+ * for itself even though a real caller hands a column view of the tap plane -- a description names
+ * extents, and a stride is the caller's (libref/ref_shapes.cpp says the same). */
+int rad_hc_mean_shape(const RadParam* p, int n_p, int operand, RadOpdDesc* out) {
+    if (!out || operand < 0 || operand >= 2) return RAD_E_INVAL;
+    const int64_t M  = rad_param_getdim(p, n_p, "M", 0);
+    const int64_t n  = rad_param_getdim(p, n_p, "N", 0);
+    const int64_t hc = rad_param_getdim(p, n_p, "hc", 0);
+    if (M <= 0 || n <= 0 || hc <= 0) return RAD_E_UNSUPPORTED;
+    RadOpdDesc d{};
+    d.dtype = RAD_BF16;
+    d.rank = 2;
+    d.shape[0] = M;
+    d.shape[1] = operand == RAD_HC_MEAN_IN ? hc * n : n;
+    d.fill = (uint32_t)RAD_FILL_NORMAL;
+    d.idx_const = -1;
+    *out = d;
+    return RAD_OK;
+}
+
+/* ---- the call ---------------------------------------------------------------------------------- */
+int rad_hc_mean_args(const RadArgs* a, RadHcMeanCall* call) {
+    if (!a || !call || !a->t || a->n_t != 2) return RAD_E_INVAL;
+    const RadTensor& h = a->t[RAD_HC_MEAN_IN];
+    const RadTensor& x = a->t[RAD_HC_MEAN_OUT];
+    if (!h.data || !x.data) return RAD_E_INVAL;
+
+    const int64_t n  = rad_param_getdim(a->p, a->n_p, "N", 0);
+    const int64_t hc = rad_param_getdim(a->p, a->n_p, "hc", 0);
+    if (n <= 0 || hc <= 0) return RAD_E_SHAPE;
+    /* Every offset this kernel forms is `row*pitch + (c*n + i)`, so the products are bounded here
+     * once rather than trusted: an overflowing extent is a caller bug that the device would turn
+     * into a wild pointer. */
+    if (n > INT32_MAX || hc > INT32_MAX || hc > INT64_MAX / n) return RAD_E_SHAPE;
+    /* rad_param_getdim rather than rad_args_geti: it reads a RANGE as its high bound, which is
+     * what a tool calling the launch directly still holds, and it is the ABI's own reader for
+     * exactly that case. A STRING spelling is accepted for the same reason the reference accepts
+     * one -- a checker reaching the launch without a declare in front of it. */
+    const char* dt = rad_param_gets(a->p, a->n_p, "dtype", "bf16");
+    if (!dt || std::strcmp(dt, "bf16") != 0) return RAD_E_DTYPE;
+    if (h.dtype != RAD_BF16 || x.dtype != RAD_BF16) return RAD_E_DTYPE;
+    if (h.rank != 2 || x.rank != 2) return RAD_E_UNSUPPORTED;
+    if (hc != kHc || n % kAlign != 0) return RAD_E_UNSUPPORTED;
+    if (h.shape[1] != hc * n || x.shape[1] != n) return RAD_E_SHAPE;
+
+    /* Rows are the operand's, and `M` is only the ceiling -- a decode step presents one row of a
+     * max_tok arena, and reading `M` as the count walks rows nobody wrote (libref/ref_ops.h). */
+    const int64_t rows = h.shape[0];
+    const int64_t band = rad_param_getdim(a->p, a->n_p, "M", 0);
+    if (rows <= 0 || rows > INT32_MAX || (band > 0 && rows > band) || x.shape[0] != rows)
+        return RAD_E_SHAPE;
+
+    /* THE COLUMN STEP HAS TO BE 1, and this is the one place the device row is narrower than the
+     * oracle. The kernel reads a lane's 8 consecutive elements as one group and adds stream c at
+     * +c*N, so a transposed or element-interleaved view would be read wrong -- and the reference,
+     * which walks each element by stride, would be right. Refusing it is what keeps the two from
+     * disagreeing; the ROW pitch is still honoured, which is the view the caller actually uses. */
+    if (h.stride[1] != 1 || x.stride[1] != 1) return RAD_E_UNSUPPORTED;
+    /* Every offset is `row*stride[0] + col`. A negative pitch is never a view. With more than one
+     * row a pitch narrower than the row would make consecutive rows overlap -- a store to row m
+     * landing in row m+1's data -- and a pitch large enough to overflow the product would wrap the
+     * address. Both are refused. With ONE row the pitch is never used, so it may be zero, which is
+     * what several callers hand a single-row slice. */
+    if (h.stride[0] < 0 || x.stride[0] < 0) return RAD_E_SHAPE;
+    if (rows > 1) {
+        if (h.stride[0] < h.shape[1] || x.stride[0] < x.shape[1]) return RAD_E_SHAPE;
+        if (rows > INT64_MAX / h.stride[0] || rows > INT64_MAX / x.stride[0]) return RAD_E_SHAPE;
+    }
+    /* The element offsets have to be expressible; a negative or overflowing one is a caller bug
+     * that the device would turn into a wild pointer. */
+    if (span_elements(h) <= 0 || span_elements(x) <= 0) return RAD_E_SHAPE;
+    if (overlaps(h, x)) return RAD_E_INVAL;
+
+    call->h = h.data;
+    call->x = x.data;
+    call->rows = rows;
+    call->N = n;
+    call->h_pitch = h.stride[0];
+    call->x_pitch = x.stride[0];
+    return RAD_OK;
+}
+
+/* ---- the row ----------------------------------------------------------------------------------- */
+/* THE CONSTRAINTS ARE THE SPECIALISATION, stated so selection never has to find out the hard way.
+ * Without them this row would be chosen for every hc_mean in the graph (device outranks host) and
+ * then refuse hc != 4 at issue, which turns "the host reference serves this" into a failed step.
+ * `N % 8 == 0` is RAD_CDIV's meaning: N is a whole number of 8-wide bf16 groups. */
+static const RadConstraint kConstraints[] = {
+    RAD_CEQ("hc", 4),
+    RAD_CDIV("N", 8),
+    RAD_CIN("dtype", "bf16"),
+};
+
+RadKernelInfo rad_hc_mean_row(RadLaunchFn launch) {
+    RadKernelInfo r{};
+    r.name = "mine_hc_mean_hc4";
+    r.op = kSchema.op;
+    r.family = "norm";
+    r.computes = kSchema.doc;
+    r.shape = "hc==4, N%8==0; the DFlash2 tap (N=2560), any row count up to max_tok";
+    r.dtypes = "bf16 in, bf16 out";
+    r.domain = RAD_DOMAIN_DEVICE;
+    r.priority = 100;
+    r.constraints = kConstraints;
+    r.n_constraints = (int)(sizeof(kConstraints) / sizeof(kConstraints[0]));
+    r.launch = launch;
+    r.opd_shape = rad_hc_mean_shape;
+    return r;
+}
diff --git a/mine/hc_mean.h b/mine/hc_mean.h
new file mode 100644
index 0000000000000000000000000000000000000000..3d74f027fd8ebe308df497720176ac50f06f772c
--- /dev/null
+++ b/mine/hc_mean.h
@@ -0,0 +1,46 @@
+#ifndef RAD_MINE_HC_MEAN_H
+#define RAD_MINE_HC_MEAN_H
+
+#include "rad_plugin.h"
+#include <stdint.h>
+
+/* hc_mean -- the DFlash2 tap: x[m,i] = mean over the hc streams of h[m, c*N+i], summed in f32 and
+ * stored bf16 once. The host reference and the definition of the op are libref's
+ * (libref/ref_hc.cpp); this is mine's device specialisation of the same schema.
+ *
+ * NOT THE GATED RESIDUAL'S READ. No RMS, no gate, no weight, no read of a block input: a caller
+ * that substituted hc_read would normalise and gate the streams and divide by a different number,
+ * and every tap would differ.
+ *
+ * THE OUTPUT IS A COLUMN VIEW. The caller passes `x` as width N at column t*N of a [M, n_taps*N]
+ * tap plane, which reaches the kernel as a rank-2 tensor whose ROW pitch is stride[0] -- the
+ * PLANE's width -- while stride[1] is the column step, 1. The store goes through the row pitch, so
+ * the other taps are never touched.
+ *
+ * The row is specialised at hc 4 and N a multiple of 8 -- the DFlash2 geometry -- and the launch
+ * refuses anything it was not given: bf16 only, rank 2 only, declared widths only, unit column
+ * stride, and a row pitch that cannot make rows overlap. No allocation and no synchronisation on
+ * the launch path. */
+enum { RAD_HC_MEAN_IN = 0, RAD_HC_MEAN_OUT = 1, RAD_HC_MEAN_OPERANDS = 2 };
+
+/* Validated, device-free view of one call. Shape, stride and alias checks only: nothing here
+ * dereferences a pointer, because at issue every operand is device memory. */
+struct RadHcMeanCall {
+    const void* h;
+    void*       x;
+    int64_t     rows, N;
+    int64_t     h_pitch, x_pitch;   /* stride[0]: elements between consecutive rows */
+};
+
+int rad_hc_mean_schema_count(void);
+const RadOpSchema* rad_hc_mean_schema_at(int);
+int rad_hc_mean_shape(const RadParam*, int, int, RadOpdDesc*);
+/* RAD_OK, or the reason this call is not the op: RAD_E_UNSUPPORTED outside the declared geometry,
+ * RAD_E_SHAPE for a width that disagrees with the parameters, RAD_E_DTYPE for anything but bf16,
+ * RAD_E_INVAL for a required operand absent or an output aliasing the input. */
+int rad_hc_mean_args(const RadArgs*, RadHcMeanCall*);
+RadKernelInfo rad_hc_mean_row(RadLaunchFn);
+int rad_mine_hc_mean_count(void);
+const RadKernelInfo* rad_mine_hc_mean_at(int);
+
+#endif /* RAD_MINE_HC_MEAN_H */
diff --git a/mine/hc_mean.hip b/mine/hc_mean.hip
new file mode 100644
index 0000000000000000000000000000000000000000..8910179dce5da438b349f7f0ba555e560ceca98c
--- /dev/null
+++ b/mine/hc_mean.hip
@@ -0,0 +1,117 @@
+/* hc_mean.hip -- the DFlash2 tap reduction on the device: x[m,i] = mean over the hc streams of
+ * h[m, c*N+i], summed in f32 and stored bf16 ONCE. The definition is libref/ref_hc.cpp; mine/hc_mean.h
+ * states the contract and the geometry this row declares.
+ *
+ * ============================== WHAT IT IS NOT ==============================
+ *
+ * NOT `hc_read`. That op normalises each stream (one rsqrt per N), applies a low-rank gate,
+ * multiplies by a per-stream gain and then takes the mean; substituting it here would give a tap
+ * that is a different function of the same bytes, and the DFlash2 capture is
+ * `hidden_states.unflatten(-1, (hc, n)).mean(dim=-2)` with nothing else on it.
+ *
+ * ============================== THE LAYOUT ==============================
+ *
+ * A lane owns eight consecutive output elements and reads the matching element of each stream:
+ * element (m, c, i) is at h + m*h_pitch + c*N + i, so the hc pointers are `N` apart and
+ * consecutive lanes touch consecutive addresses inside each stream.
+ *
+ * THE OUTPUT'S PITCH IS ITS OWN. `x` arrives as a column view of the tap plane: width N, at column
+ * t*N, with the plane's n_taps*N as stride[0]. The store is `x + m*x_pitch + i`, so the columns of
+ * the other taps are untouched and no separate parameter has to say so.
+ *
+ * NO TAIL BRANCH, because the row is declared at N % 8 == 0: a lane's group of 8 sits wholly inside
+ * the row, so the bounds test is the lane's own group index and there is no partial group to hand
+ * to a scalar path. That is what lets the entry point refuse any other width instead of carrying a
+ * second code path the oracle would have to agree with.
+ *
+ * NOTHING IS ALLOCATED AND NOTHING SYNCHRONISES: one launch, one argument struct by value, and the
+ * only host work is the validation below (which dereferences no device memory).
+ */
+#include <hip/hip_runtime.h>
+
+#include "hc_mean.h"
+
+namespace {
+
+constexpr int kThreads = 128;
+
+/* f32 -> bf16, round-to-nearest-even with the tie on the surviving bit's parity, NaN forced quiet.
+ * Spelled out rather than including libr4d/r4d_common.h: this plugin does not link libr4d, and a
+ * device copy of a rounding rule that lives in another plugin's header is exactly how two kernels
+ * come to disagree about the last bit. rad_plugin.h's rad_f32_to_bf16 is the definition; this is
+ * the same arithmetic in device code. */
+__device__ __forceinline__ uint16_t to_bf16(float f) {
+    const uint32_t u = __builtin_bit_cast(uint32_t, f);
+    if ((u & 0x7fffffffu) > 0x7f800000u) return (uint16_t)((u >> 16) | 0x0040u);
+    return (uint16_t)((u + 0x7fffu + ((u >> 16) & 1u)) >> 16);
+}
+
+/* bf16 -> f32 is a shift: every bf16 is exactly a float. */
+__device__ __forceinline__ float to_f32(uint16_t h) {
+    return __builtin_bit_cast(float, (uint32_t)h << 16);
+}
+
+/* The row declares hc 4, so the streams are unrolled rather than looped: `rad_hc_mean_args` has
+ * already refused any other count, and a loop bound the compiler cannot see is a loop it cannot
+ * flatten into four adds. `Args` carries no hc for that reason. */
+struct Args {
+    const uint16_t* __restrict__ h;
+    uint16_t* __restrict__ x;
+    int64_t rows, N, h_pitch, x_pitch;
+};
+
+__global__ __launch_bounds__(kThreads) void mean_kernel(Args a) {
+    /* grid.x indexes rows and grid.y the group of 8 columns within a row: the column dimension is
+     * what keeps a prefill chunk's row count from changing the arithmetic per element. A 2560-wide
+     * tap is 320 groups, so 2.5 blocks of 128 threads per row and the last one is partial. */
+    const int64_t m = blockIdx.x;
+    const int64_t g = blockIdx.y * (int64_t)(kThreads * 8) + threadIdx.x * 8;
+    if (m >= a.rows || g >= a.N) return;
+
+    const uint16_t* hp = a.h + m * a.h_pitch + g;
+    const uint16_t* s0 = hp;
+    const uint16_t* s1 = hp + a.N;
+    const uint16_t* s2 = hp + 2 * a.N;
+    const uint16_t* s3 = hp + 3 * a.N;
+
+    uint16_t* xp = a.x + m * a.x_pitch + g;
+#pragma unroll
+    for (int k = 0; k < 8; ++k) {
+        // Match the reference's +0 accumulator, including four negative-zero inputs.
+        const float acc = 0.0f + to_f32(s0[k]) + to_f32(s1[k]) + to_f32(s2[k]) + to_f32(s3[k]);
+        xp[k] = to_bf16(acc * 0.25f);
+    }
+}
+
+}  /* namespace */
+
+/* The launch. `rad_hc_mean_args` has already refused every geometry this row was not given, so
+ * there is no second validation here and no path that computes something the oracle would not:
+ * either the call is the op or it returned a reason. */
+int rad_mine_hc_mean_launch(const RadArgs* a, RadStream stream) {
+    RadHcMeanCall call{};
+    const int rc = rad_hc_mean_args(a, &call);
+    if (rc != RAD_OK) return rc;
+
+    Args args{};
+    args.h = static_cast<const uint16_t*>(call.h);
+    args.x = static_cast<uint16_t*>(call.x);
+    args.rows = call.rows;
+    args.N = call.N;
+    args.h_pitch = call.h_pitch;
+    args.x_pitch = call.x_pitch;
+
+    const unsigned gx = (unsigned)call.rows;
+    const unsigned gy = (unsigned)((call.N + kThreads * 8 - 1) / (kThreads * 8));
+    void* kargs[] = { &args };
+    const hipError_t e = hipLaunchKernel((const void*)mean_kernel, dim3(gx, gy), dim3(kThreads),
+                                         kargs, 0, (hipStream_t)stream);
+    return e == hipSuccess ? RAD_OK : RAD_E_DEVICE;
+}
+
+int rad_mine_hc_mean_count(void) { return 1; }
+
+const RadKernelInfo* rad_mine_hc_mean_at(int i) {
+    static const RadKernelInfo row = rad_hc_mean_row(rad_mine_hc_mean_launch);
+    return i == 0 ? &row : nullptr;
+}
diff --git a/mine/hc_up_wmma.hip b/mine/hc_up_wmma.hip
new file mode 100644
index 0000000000000000000000000000000000000000..d3093a80d6885d576a31ce282a5c9cb1306033d2
--- /dev/null
+++ b/mine/hc_up_wmma.hip
@@ -0,0 +1,224 @@
+// Qwen Flash-Next's M=3/4 HC read. Only the up-dot reduction is reordered.
+// Reuse the upstream down kernel, weight layout and operand descriptions verbatim.
+// Hide those implementation symbols: loading this plugin must not interpose on libr4d.
+#include <hip/hip_runtime.h>
+#include "rad_abi.h"
+#pragma GCC visibility push(hidden)
+#include "../libr4d/r4d_emit.h"
+#pragma push_macro("R4D_ENTRY")
+#undef R4D_ENTRY
+#define R4D_ENTRY(sym, body)
+#include "../libr4d/r4d_hc_bf16.hip"
+#pragma pop_macro("R4D_ENTRY")
+#include "../libr4d/r4d_fp8_layout.cpp"
+#include "../libr4d/r4d_shapes.cpp"
+#pragma GCC visibility pop
+
+#include <cstdlib>
+#include <cstring>
+
+namespace mine_hc_up {
+constexpr int N = 2560, HC = 4, LR = 320, HN = N * HC, Group = 128;
+constexpr int UpPitch = r4d_hc8::row_bytes(LR, LR / 4);
+constexpr int DownPitch = r4d_hc8::row_bytes(HN, Group);
+
+// E4M3 codes are exact BF16 values. The FP32 scale is applied AFTER each
+// 80-column dot; no scaled weight is narrowed to BF16.
+__global__ __launch_bounds__(128)
+void up_mix(const unsigned char* __restrict__ up, const unsigned short* __restrict__ d,
+            const unsigned short* __restrict__ h, const float* __restrict__ w,
+            const float* __restrict__ scale, unsigned short* __restrict__ x,
+            int rows, float wadd) {
+    constexpr int Channels = 32, Cols = HC * Channels, K = LR / 4, Pitch = K + 8;
+    __shared__ __attribute__((aligned(16))) unsigned short a[16 * Pitch], b[Cols * Pitch];
+    __shared__ unsigned short u[4 * Cols];
+    const int tid = threadIdx.x, lane = tid & 31, wave = tid / 32;
+    const int i0 = blockIdx.x * Channels;
+    v8f total[2] = {}, pair[2] = {};
+    for (int g = 0; g < 4; ++g) {
+        __syncthreads();
+        for (int t = tid; t < 16 * (K / 8); t += 128) {
+            const int r = t / (K / 8), k8 = (t % (K / 8)) * 8;
+            const uint4 v = r < rows ? *(const uint4*)(d + r * LR + g * K + k8)
+                                    : make_uint4(0, 0, 0, 0);
+            *(uint4*)(a + r * Pitch + k8) = v;
+        }
+        for (int t = tid; t < Cols * (K / 8); t += 128) {
+            const int col = t / (K / 8), k8 = (t % (K / 8)) * 8;
+            const int j = (col / Channels) * N + i0 + col % Channels;
+            const uint2 codes = *(const uint2*)(up + j * UpPitch + g * K + k8);
+            float decoded[8];
+            e4m3x8(codes.x, codes.y, decoded);
+            union { uint4 v; unsigned short s[8]; } out;
+#pragma unroll
+            for (int e = 0; e < 8; ++e) out.s[e] = f2bf(decoded[e]);
+            *(uint4*)(b + col * Pitch + k8) = out.v;
+        }
+        __syncthreads();
+#pragma unroll
+        for (int tile = 0; tile < 2; ++tile) {
+            const int btile = wave + tile * 4;
+            const v8f raw = gemm<K / 16>(a, Pitch, 0, b, Pitch, btile, lane, v8f{});
+            const int col = btile * 16 + (lane & 15);
+            const int j = (col / Channels) * N + i0 + col % Channels;
+            const float sc = ((const float*)(up + j * UpPitch + LR))[g];
+#pragma unroll
+            for (int e = 0; e < 8; ++e) {
+                const float v = raw[e] * sc;
+                if ((g & 1) == 0) pair[tile][e] = v;
+                else {
+                    pair[tile][e] += v;
+                    if (g == 1) total[tile][e] = pair[tile][e];
+                    else total[tile][e] += pair[tile][e];
+                }
+            }
+        }
+    }
+#pragma unroll
+    for (int tile = 0; tile < 2; ++tile) {
+        const int col = (wave + tile * 4) * 16 + (lane & 15), r0 = 8 * (lane >> 4);
+#pragma unroll
+        for (int e = 0; e < 8; ++e)
+            if (r0 + e < rows) u[(r0 + e) * Cols + col] = f2bf(sigmoidf_(total[tile][e]));
+    }
+    __syncthreads();
+    for (int idx = tid; idx < rows * Channels; idx += 128) {
+        const int r = idx / Channels, ii = idx % Channels, i = i0 + ii;
+        float acc = 0.0f;
+        for (int c = 0; c < HC; ++c) {
+            const int j = c * N + i;
+            const float nv = nbf(bf2f(h[r * HN + j]) * scale[r * kHcMax + c] * (w[j] + wadd));
+            acc += bf2f(u[r * Cols + c * Channels + ii]) * nv;
+        }
+        x[r * N + i] = f2bf(acc * (1.0f / HC));
+    }
+}
+
+template<bool I8>
+__global__ __launch_bounds__(128)
+void quant(const unsigned short* x, unsigned char* q, float* qs,
+           unsigned char* rq, float* rqs, int rows) {
+    const int r = threadIdx.x / 32, lane = threadIdx.x & 31;
+    if (r >= rows) return;
+    const int group = blockIdx.x, base = group * Group;
+    const unsigned short* xr = x + r * N + base;
+    float m = 0.0f;
+    for (int t = lane; t < Group; t += 32) m = fmaxf(m, fabsf(bf2f(xr[t])));
+    m = r4d_wave_max(m);
+    const float sc = m > 0.0f ? m * (1.0f / q8_top<I8>()) : 1.0f;
+    const float inv = 1.0f / sc;
+    if (lane == 0) qs[r * (N / Group) + group] = sc;
+    const int c4 = lane * 4;
+    *(unsigned*)(q + r * N + base + c4) =
+        q8_pack4<I8>(bf2f(xr[c4]), bf2f(xr[c4 + 1]), bf2f(xr[c4 + 2]), bf2f(xr[c4 + 3]), inv);
+    if (rq) {
+        float v[4];
+#pragma unroll
+        for (int j = 0; j < 4; ++j) v[j] = bf2f(xr[c4 + j]);
+        hc_rot_group(v, lane, rq + r * N + base, rqs + r * (N / Group) + group);
+    }
+}
+
+int64_t scratch(const RadArgs* a) {
+    if (!a) return RAD_E_INVAL;
+    const auto m = r4d_geti_or(a, "M", 0);
+    if (m < 3 || m > 4 || r4d_geti_or(a, "n", 0) != N ||
+        r4d_geti_or(a, "hc", 0) != HC || r4d_geti_or(a, "lowrank", 0) != LR)
+        return RAD_E_SHAPE;
+    return m * (LR * 2 + kHcMax * 4);
+}
+
+bool dense(const RadTensor* t, uint32_t dtype, int width, int rows, unsigned align) {
+    if (!t || t->dtype != dtype || ((uintptr_t)t->data & (align - 1))) return false;
+    long long count = 0;
+    return r4d_rows_pitch(t, width, &count) == width && count >= rows;
+}
+
+int body(const RadArgs* a, const R4dSink& sk) {
+    const int64_t need = scratch(a);
+    if (need < 0) return (int)need;
+    if (!a->t || a->n_t != 11) return RAD_E_INVAL;
+    const RadTensor* h = r4d_opt(a, HCR_H), *w = r4d_opt(a, HCR_W);
+    const RadTensor* down = r4d_opt(a, HCR_DOWN), *up = r4d_opt(a, HCR_UP);
+    const RadTensor* iw = r4d_opt(a, HCR_INJW), *x = r4d_opt(a, HCR_X), *inj = r4d_opt(a, HCR_INJ);
+    const RadTensor* q = r4d_opt(a, HCR_Q), *qs = r4d_opt(a, HCR_S);
+    const RadTensor* rq = r4d_opt(a, HCR_RQ), *rqs = r4d_opt(a, HCR_RS);
+    if (!h || !w || !down || !up || !iw || !x || !inj) return RAD_E_INVAL;
+    long long rows = 0;
+    if (r4d_rows_pitch(h, HN, &rows) != HN || rows < 3 || rows > 4 || rows > r4d_geti_or(a, "M", 0))
+        return RAD_E_SHAPE;
+    if (!dense(h, RAD_BF16, HN, rows, 16) || !dense(x, RAD_BF16, N, rows, 2) ||
+        !dense(inj, RAD_BF16, HC, rows, 2)) return RAD_E_STRIDE;
+    if (w->dtype != RAD_F32 || iw->dtype != RAD_BF16 || down->dtype != RAD_F8E4M3 || up->dtype != RAD_F8E4M3)
+        return RAD_E_DTYPE;
+    if (r4d_numel(w) != HN || r4d_numel(iw) != HC * HN ||
+        down->rank != 2 || down->shape[0] != LR || down->shape[1] != HN ||
+        up->rank != 2 || up->shape[0] != HN || up->shape[1] != LR) return RAD_E_SHAPE;
+    if (!r4d_contig(w) || !r4d_contig(iw) || !r4d_contig(down) || !r4d_contig(up) ||
+        ((uintptr_t)w->data & 3u) || (((uintptr_t)iw->data | (uintptr_t)down->data | (uintptr_t)up->data) & 15u))
+        return RAD_E_STRIDE;
+    if ((q != nullptr) != (qs != nullptr) || (rq != nullptr) != (rqs != nullptr) || (rq && !q))
+        return RAD_E_INVAL;
+    if (q && q->dtype != RAD_I8 && q->dtype != RAD_F8E4M3) return RAD_E_DTYPE;
+    if (q && (r4d_geti_or(a, "group", 0) != Group || !dense(q, q->dtype, N, rows, 4) ||
+              !dense(qs, RAD_F32, N / Group, rows, 4))) return RAD_E_SHAPE;
+    if (rq && (!dense(rq, RAD_F8E4M3, N, rows, 4) || !dense(rqs, RAD_F32, N / Group, rows, 4)))
+        return RAD_E_SHAPE;
+    if (!a->scratch || a->scratch_bytes < need || ((uintptr_t)a->scratch & 15u)) return RAD_E_SCRATCH;
+    auto* d = (unsigned short*)a->scratch;
+    auto* scales = (float*)(d + r4d_geti_or(a, "M", 0) * LR);
+    const float eps = (float)r4d_getf(a, "eps", 1e-6), wadd = (float)r4d_getf(a, "wadd", 0.0);
+    // The upstream ladder for gfx1201's 64 CUs, without a device query on the step path.
+    const long ta = rows == 3 ? 8 : 16;
+    int rc = R4D_EMIT(sk, hc_read_a_kernel<true>, dim3((LR + ta - 1) / ta + 1, rows),
+        dim3(kThreads), HN * sizeof(unsigned short), (const unsigned short*)h->data,
+        (const float*)w->data, (const void*)down->data, (long)DownPitch, (const unsigned short*)iw->data,
+        d, (unsigned short*)inj->data, scales, (long)rows, (long)N, HC, (long)LR, ta,
+        (long)HN, (long)HC, eps, wadd);
+    if (rc != RAD_OK) return rc;
+    rc = R4D_EMIT(sk, up_mix, dim3(N / 32), dim3(128), 0, (const unsigned char*)up->data,
+        d, (const unsigned short*)h->data, (const float*)w->data, scales,
+        (unsigned short*)x->data, (int)rows, wadd);
+    if (rc != RAD_OK || !q) return rc;
+#define MINE_HC_QUANT(I8_) \
+    R4D_EMIT(sk, quant<I8_>, dim3(N / Group), dim3(128), 0, (const unsigned short*)x->data, \
+        (unsigned char*)q->data, (float*)qs->data, rq ? (unsigned char*)rq->data : nullptr, \
+        rq ? (float*)rqs->data : nullptr, (int)rows)
+    rc = q->dtype == RAD_I8 ? MINE_HC_QUANT(true) : MINE_HC_QUANT(false);
+#undef MINE_HC_QUANT
+    return rc;
+}
+
+R4D_ENTRY(rad_mine_hc_up, body)
+
+const RadKernelInfo* row() {
+    static const RadConstraint constraints[] = {
+        RAD_CGE("M", 3), RAD_CLE("M", 4), RAD_CEQ("n", N), RAD_CEQ("hc", HC),
+        RAD_CEQ("lowrank", LR), RAD_CEQ("inject", 1), RAD_CEQ("group", Group),
+        RAD_CIN("dtype", "bf16"), RAD_CIN("mix", "e4m3"),
+    };
+    static const RadKernelInfo value = [] {
+        RadKernelInfo r{};
+        r.name = "mine_hc_read_up_wmma_m3_m4"; r.op = "hc_read"; r.family = "norm";
+        r.computes = "unchanged HC down/inject; unscaled BF16 WMMA up; stateless quantization";
+        r.shape = "M=3..4, n=2560, hc=4, lowrank=320, inject=1, group=128; dense rows";
+        r.dtypes = "bf16 activations; existing E4M3/F32 mixing rows; I8 or E4M3 quantized outputs";
+        r.domain = RAD_DOMAIN_DEVICE; r.priority = 100;
+        r.constraints = constraints; r.n_constraints = sizeof(constraints) / sizeof(constraints[0]);
+        r.launch = rad_mine_hc_up; r.describe = rad_mine_hc_up_describe; r.scratch = scratch;
+        r.layout = r4d_rad_layout_hc_e4m3; r.relayout = r4d_rad_relayout_hc_e4m3;
+        r.unrelayout = r4d_rad_unrelayout_hc_e4m3; r.opd_shape = r4d_shape_hc_read;
+        return r;
+    }();
+    return &value;
+}
+} // namespace mine_hc_up
+
+int rad_mine_hc_up_count() {
+    static const bool enabled = [] { const char* v = std::getenv("RADIANCE_HC_UP_WMMA");
+        return v && std::strcmp(v, "1") == 0; }();
+    return enabled ? 1 : 0;
+}
+const RadKernelInfo* rad_mine_hc_up_at(int i) {
+    return i == 0 && rad_mine_hc_up_count() ? mine_hc_up::row() : nullptr;
+}
