+                ++extra;
+            }
+        }
+        std::printf("  POOL_SET_PASS rows=%zu cutoff_swapped=%zu worst_abs=%g\n",rows,extra,worst);
+    }
+    /* Resolve, upload and launch the device row with NO reference launch, then require the launch to
