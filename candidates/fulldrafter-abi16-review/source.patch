index 0000000000000000000000000000000000000000..5c22cf889556bea14610171a8d0a2fdeb94afb3c
--- /dev/null
+++ b/mine/mtp_scored_tree.hip
@@ -0,0 +1,152 @@
+#include <hip/hip_runtime.h>
+#include "mtp_scored_tree.h"
+#include <cmath>
+
+namespace {
+__device__ float hybrid_value(RadMtpHybridLseCall c,int64_t s,int j) {
+    float z=__uint_as_float(static_cast<uint32_t>(c.coarse[s*c.coarse_ld+j])<<16);
+    const int64_t id=static_cast<int64_t>(c.vocab_off)+j;
+    for(int k=0;k<8;++k) if(c.idx[s*c.idx_ld+k]==id) { z=c.val[s*c.val_ld+k]; break; }
+    return z;
+}
+__global__ void hybrid_lse(RadMtpHybridLseCall c) {
+    const int64_t s=blockIdx.x; const int lane=threadIdx.x;
+    __shared__ float work[256]; __shared__ int bad[256];
+    float mx=-INFINITY; int invalid=0;
+    for(int64_t j=lane;j<c.N && static_cast<int64_t>(c.vocab_off)+j<c.vocab;j+=256) {
+        const float z=hybrid_value(c,s,static_cast<int>(j));
+        if(isnan(z) || z==INFINITY) invalid=1;
+        mx=fmaxf(mx,z);
+    }
+    work[lane]=mx; bad[lane]=invalid; __syncthreads();
+    for(int d=128;d;d/=2) { if(lane<d) { work[lane]=fmaxf(work[lane],work[lane+d]); bad[lane]|=bad[lane+d]; } __syncthreads(); }
+    mx=work[0]; invalid=bad[0]; float sum=0;
+    __syncthreads();
+    if(isfinite(mx) && !invalid) for(int64_t j=lane;j<c.N && static_cast<int64_t>(c.vocab_off)+j<c.vocab;j+=256)
+        sum+=expf(hybrid_value(c,s,static_cast<int>(j))-mx);
+    work[lane]=sum; __syncthreads();
+    for(int d=128;d;d/=2) { if(lane<d) work[lane]+=work[lane+d]; __syncthreads(); }
+    if(lane==0) { float* out=c.stats+s*c.stats_ld; out[0]=invalid ? NAN : mx; out[1]=invalid ? NAN : work[0]; out[2]=0; out[3]=0; }
+}
+__global__ void scored_merge(RadMtpScoredMergeTreeAccumCall c) {
+    const int64_t s=static_cast<int64_t>(blockIdx.x)*blockDim.x+threadIdx.x;
+    if(s>=c.M) return;
+    const uint32_t* input=c.gathered+s*c.gathered_ld;
+    uint64_t keys[16];
+    for(int k=0;k<16;++k) {
+        const int32_t id=static_cast<int32_t>(input[2*k]); uint32_t bits=input[2*k+1];
+        bits=bits&0x80000000u ? ~bits : bits|0x80000000u;
+        keys[k]=id<0 || id>=c.vocab ? 0 : (static_cast<uint64_t>(bits)<<32)|(0xffffffffu-input[2*k]);
+    }
+    int ids[40]; float logs[40]; float values[8];
+    for(int k=0;k<8;++k) {
+        uint64_t winner=0; for(int j=0;j<16;++j) if(keys[j]>winner) winner=keys[j];
+        uint32_t bits=static_cast<uint32_t>(winner>>32);
+        bits=winner ? (bits&0x80000000u ? bits&0x7fffffffu : ~bits) : 0xff800000u;
+        const int id=winner ? static_cast<int32_t>(0xffffffffu-static_cast<uint32_t>(winner)) : -1;
+        c.idx[s*c.idx_ld+k]=id; c.val[s*c.val_ld+k]=bits;
+        if(c.policy!=0) values[k]=__uint_as_float(bits);
+        ids[(c.round-1)*8+k]=id;
+        for(int j=0;j<16;++j) if(keys[j]==winner) keys[j]=0;
+    }
+    int32_t* out=c.packed+s*c.out_ld;
+    int root=-1;
+    if(c.round==1) { const int ix=c.ids[s*c.id_stride]; if(ix>=0 && ix<c.token_count) root=c.tokens[static_cast<int64_t>(ix)*c.token_stride]; }
+    else if(out[0]>=1 && out[0]<=c.capacity) root=out[1];
+    bool valid=root>=0 && root<c.vocab;
+    if(c.policy==0) {
+        for(int r=0;r<c.max_rounds;++r) for(int k=0;k<8;++k) {
+            int32_t* hp=c.history+r*c.hist_round_stride+s*c.hist_row_stride+k;
+            if(c.round==1) *hp=-1;
+            if(r<c.round-1) ids[r*8+k]=*hp;
+        }
+        for(int k=0;k<8;++k)
+            c.history[(c.round-1)*c.hist_round_stride+s*c.hist_row_stride+k]=ids[(c.round-1)*8+k];
+    } else {
+        const float* st=c.stats+s*c.stats_ld;
+        for(int rank=0;rank<2;++rank) {
+            const float m=st[rank*4], q=st[rank*4+1];
+            valid=valid && ((isfinite(m) && isfinite(q) && q>0) || (m==-INFINITY && q==0));
+        }
+        const float mx=fmaxf(st[0],st[4]);
+        const double sum=(st[1]>0 ? static_cast<double>(st[1])*exp(static_cast<double>(st[0])-mx) : 0.0)+
+                         (st[5]>0 ? static_cast<double>(st[5])*exp(static_cast<double>(st[4])-mx) : 0.0);
+        valid=valid && isfinite(mx) && isfinite(sum) && sum>0;
+        for(int r=0;r<c.max_rounds;++r) for(int k=0;k<8;++k) {
+            const int j=r*8+k; int32_t* hp=c.history+r*c.hist_round_stride+s*c.hist_row_stride+k;
+            float* lp=c.log_history+r*c.log_round_stride+s*c.log_row_stride+k;
+            if(c.round==1) { *hp=-1; *lp=-INFINITY; }
+            if(r<c.round-1) { ids[j]=*hp; logs[j]=*lp; }
+        }
+        const double base=c.round==1 ? 0.0 : logs[(c.round-2)*8];
+        if(c.round>1 && (ids[(c.round-2)*8]<0 || ids[(c.round-2)*8]>=c.vocab || isnan(base) || base>0)) valid=false;
+        for(int k=0;k<8;++k) {
+            const int j=(c.round-1)*8+k; const float z=values[k];
+            double l=-INFINITY;
+            if(ids[j]>=0 && ids[j]<c.vocab) {
+                if(isnan(z) || z==INFINITY) valid=false;
+                else if(valid) { l=(static_cast<double>(z)-mx)-log(sum); if(l>1e-5) valid=false; else l=fmin(l,0.0)+base; }
+            }
+            logs[j]=static_cast<float>(l);
+            c.history[(c.round-1)*c.hist_round_stride+s*c.hist_row_stride+k]=ids[j];
+            c.log_history[(c.round-1)*c.log_round_stride+s*c.log_row_stride+k]=logs[j];
+        }
+    }
+    int tok[8], par[8];
+    for(int k=0;k<c.capacity;++k) { tok[k]=-1; par[k]=-1; }
+    int n=0;
+    if(valid) {
+        tok[0]=root; n=1;
+        if(c.policy==0) {
+            int spine=0;
+            for(int r=0;r<c.round && n<c.capacity;++r) {
+                if(ids[r*8]<0 || ids[r*8]>=c.vocab) break;
+                tok[n]=ids[r*8]; par[n]=n-1; ++n; ++spine;
+            }
+            for(int r=0;r<spine && n<c.capacity;++r) for(int k=1;k<8 && n<c.capacity;++k) {
+                const int id=ids[r*8+k]; if(id<0 || id>=c.vocab) continue;
+                bool dup=false; for(int j=1;j<n;++j) if(par[j]==r && tok[j]==id) dup=true;
+                if(!dup) { tok[n]=id; par[n]=r; ++n; }
+            }
+        } else {
+            int source[8];
+            bool used[40]{};
+            while(n<c.capacity) {
+                int best=-1, parent=-1;
+                for(int j=0;j<c.round*8;++j) {
+                    if(used[j] || ids[j]<0 || ids[j]>=c.vocab || isnan(logs[j]) || logs[j]>0) continue;
+                    const int depth=j/8; int p=depth==0 ? 0 : -1;
+                    for(int i=1;i<n && p<0;++i) if(source[i]/8==depth-1 && tok[i]==ids[(depth-1)*8]) p=i;
+                    if(p<0) continue;
+                    bool dup=false; for(int i=1;i<n;++i) if(par[i]==p && tok[i]==ids[j]) dup=true;
+                    if(dup) { used[j]=true; continue; }
+                    if(best<0 || logs[j]>logs[best] || (logs[j]==logs[best] &&
+                       (depth<best/8 || (depth==best/8 && (ids[j]<ids[best] || (ids[j]==ids[best] && j<best)))))) { best=j; parent=p; }
+                }
+                if(best<0) break;
+                used[best]=true; tok[n]=ids[best]; par[n]=parent; source[n]=best; ++n;
+            }
+            if(c.policy==2) {
+                int keep=1; double mass=1.0, best=-log(c.costs[0]);
+                for(int i=1;i<n;++i) { mass+=exp(static_cast<double>(logs[source[i]])); const double objective=log(mass)-log(c.costs[i]); if(objective>best) { best=objective; keep=i+1; } }
+                n=keep;
+            }
+        }
+    }
+    out[0]=n;
+    for(int k=0;k<c.capacity;++k) { out[1+k]=k<n ? tok[k] : -1; out[1+c.capacity+k]=k<n ? par[k] : -1; }
+}
+}
+int rad_mine_mtp_hybrid_lse_launch(const RadArgs* a,RadStream stream) {
+    RadMtpHybridLseCall c{}; const int rc=rad_mtp_hybrid_lse_args(a,&c); if(rc) return rc;
+    void* args[]={&c}; return hipLaunchKernel((const void*)hybrid_lse,dim3(static_cast<unsigned>(c.M)),dim3(256),args,0,reinterpret_cast<hipStream_t>(stream))==hipSuccess ? RAD_OK : RAD_E_DEVICE;
+}
+int rad_mine_mtp_scored_merge_tree_accum_launch(const RadArgs* a,RadStream stream) {
+    RadMtpScoredMergeTreeAccumCall c{}; const int rc=rad_mtp_scored_merge_tree_accum_args(a,&c); if(rc) return rc;
+    void* args[]={&c}; return hipLaunchKernel((const void*)scored_merge,dim3(static_cast<unsigned>((c.M+63)/64)),dim3(64),args,0,reinterpret_cast<hipStream_t>(stream))==hipSuccess ? RAD_OK : RAD_E_DEVICE;
+}
+int rad_mine_mtp_scored_tree_count() { return 2; }
+const RadKernelInfo* rad_mine_mtp_scored_tree_at(int i) {
+    static const RadKernelInfo rows[]={rad_mtp_hybrid_lse_row(rad_mine_mtp_hybrid_lse_launch),rad_mtp_scored_merge_tree_accum_row(rad_mine_mtp_scored_merge_tree_accum_launch)};
+    return i>=0 && i<2 ? rows+i : nullptr;
+}
diff --git a/mine/mtp_tree_accum.cpp b/mine/mtp_tree_accum.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..326f1c1f41519be3eee81e50b40dc7e41d02b2ca
--- /dev/null
+++ b/mine/mtp_tree_accum.cpp
@@ -0,0 +1,213 @@
+#include "mtp_tree_accum.h"
+
+#include <climits>
+#include <cstddef>
+#include <cstdint>
+
+namespace {
+#define PI(k) {k, RAD_P_INT, RAD_REQUIRED, 0}
+const RadParamSpec params[] = {PI("M"), PI("pitch"), PI("capacity"), PI("max_rounds"),
+                               PI("n_vocab"), PI("round")};
+#undef PI
+const RadOperandSpec operands[] = {{"cand", RAD_OPD_IN, 0}, {"token_ids", RAD_OPD_IN, 1},
+    {"draft_out_ids", RAD_OPD_IN, 1}, {"history", RAD_OPD_INOUT, 0}, {"packed", RAD_OPD_INOUT, 0}};
+const RadOpSchema schema = {"mtp_tree_accum", params, 6, operands, 5,
+    "Accumulate up to max_rounds (3 or 8) top-8 MTP rounds on device; root-inclusive bounded tree, "
+    "spine first then sibling-deduplicated alternates. Round one resets live rows."};
+const RadParamSpec merge_params[] = {
+    {"M", RAD_P_INT, RAD_REQUIRED, 0}, {"pitch", RAD_P_INT, RAD_REQUIRED, 0},
+    {"capacity", RAD_P_INT, RAD_REQUIRED, 0}, {"max_rounds", RAD_P_INT, RAD_REQUIRED, 0},
+    {"n_vocab", RAD_P_INT, RAD_REQUIRED, 0}, {"round", RAD_P_INT, RAD_REQUIRED, 0},
+    {"world_size", RAD_P_INT, RAD_REQUIRED, 0}};
+const RadOperandSpec merge_operands[] = {
+    {"gathered", RAD_OPD_IN, 0}, {"idx", RAD_OPD_OUT, 0}, {"val", RAD_OPD_OUT, 0},
+    {"token_ids", RAD_OPD_IN, 1}, {"draft_out_ids", RAD_OPD_IN, 1},
+    {"history", RAD_OPD_INOUT, 0}, {"packed", RAD_OPD_INOUT, 0}};
+const RadOpSchema merge_schema = {"mtp_merge_tree_accum", merge_params, 7, merge_operands, 7,
+    "TP2 top-8 merge with libr4d bit-key ordering, then MTP history and packed-tree accumulation; "
+    "all eight merged ids and value bits remain observable."};
+struct Geometry { int64_t M, cap, vocab, round, rounds; };
+/* max_rounds=3: frozen legacy geometry (capacity<=16). max_rounds=8: fixed MTP8/64
+ * geometry, 8 spine + 56 alternates + root = capacity<=65. */
+int geometry(const RadParam* p, int n, Geometry& g, bool wide) {
+    if (!p) return RAD_E_INVAL;
+    g.M = wide ? rad_param_getdim(p,n,"M",0) : rad_param_geti(p,n,"M",0);
+    g.cap = rad_param_geti(p,n,"capacity",0);
+    g.vocab = rad_param_geti(p,n,"n_vocab",0);
+    g.round = rad_param_geti(p,n,"round",0);
+    g.rounds = rad_param_geti(p,n,"max_rounds",0);
+    if (g.rounds != 3 && g.rounds != 8) return RAD_E_UNSUPPORTED;
+    if (g.M < 1 || g.M > INT32_MAX || g.cap < 2 || g.cap > (g.rounds == 3 ? 16 : 65) ||
+        g.vocab < 1 || g.vocab > INT32_MAX || g.round < 1 || g.round > g.rounds ||
+        rad_param_geti(p,n,"pitch",0) != 8)
+        return RAD_E_UNSUPPORTED;
+    return RAD_OK;
+}
+/* Validate span arithmetic before overlap or kernel pointer arithmetic. Padding is supported,
+ * inner planes remain dense, and no product can overflow the signed byte address domain. */
+int tensor(const RadTensor& t, int rank, const int64_t* minimum, uint64_t& bytes,
+           uint32_t dtype = RAD_I32) {
+    if (!t.data) return RAD_E_INVAL;
+    if (reinterpret_cast<uintptr_t>(t.data) % alignof(int32_t)) return RAD_E_INVAL;
+    if (t.dtype != dtype) return RAD_E_DTYPE;
+    if (t.rank != static_cast<uint32_t>(rank)) return RAD_E_SHAPE;
+    uint64_t span = 1;
+    for (int j = rank - 1; j >= 0; --j) {
+        if (t.shape[j] < minimum[j] || t.shape[j] > INT32_MAX) return RAD_E_SHAPE;
+        if (t.stride[j] < 1 || (j < rank-1 && static_cast<uint64_t>(t.stride[j]) < span))
+            return RAD_E_STRIDE;
+        const uint64_t extent = static_cast<uint64_t>(t.shape[j]-1);
+        if (extent && static_cast<uint64_t>(t.stride[j]) > (INT64_MAX/4-span)/extent)
+            return RAD_E_SHAPE;
+        span += extent * static_cast<uint64_t>(t.stride[j]);
+    }
+    bytes = span * 4;
+    if (reinterpret_cast<uintptr_t>(t.data) > UINTPTR_MAX-bytes) return RAD_E_INVAL;
+    return RAD_OK;
+}
+bool overlap(const RadTensor& a, uint64_t an, const RadTensor& b, uint64_t bn) {
+    const uintptr_t x = reinterpret_cast<uintptr_t>(a.data), y = reinterpret_cast<uintptr_t>(b.data);
+    return an && bn && x < y+bn && y < x+an;
+}
+}
+
+int rad_mtp_tree_accum_schema_count(void) { return 2; }
+const RadOpSchema* rad_mtp_tree_accum_schema_at(int i) {
+    return i == 0 ? &schema : i == 1 ? &merge_schema : nullptr;
+}
+int rad_mtp_tree_accum_shape(const RadParam* p, int n, int operand, RadOpdDesc* out) {
+    if (!out || operand < 0 || operand >= 5) return RAD_E_INVAL;
+    Geometry g{};
+    const int rc = geometry(p,n,g,true);
+    if (rc != RAD_OK) return rc;
+    RadOpdDesc d{};
+    d.dtype = RAD_I32;
+    d.idx_const = -1;
+    d.fill = RAD_FILL_INDEX;
+    d.idx_max = g.vocab;
+    d.rank = 2; d.shape[0] = g.M; d.shape[1] = 8;
+    if (operand == 1 || operand == 2) {
+        d.rank = 1;
+        if (operand == 2) d.idx_max = g.M;
+        if (g.round > 1) d.flags = RAD_OPD_F_ABSENT;
+    } else if (operand == 3) {
+        d.rank = 3; d.shape[0] = g.rounds; d.shape[1] = g.M; d.shape[2] = 8;
+    } else if (operand == 4) {
+        d.shape[1] = 1+2*g.cap;
+    }
+    *out = d;
+    return RAD_OK;
+}
+
+int rad_mtp_tree_accum_args(const RadArgs* a, RadMtpTreeAccumCall* out) {
+    if (!a || !out || !a->t || a->n_t != 5) return RAD_E_INVAL;
+    Geometry g{};
+    int rc = geometry(a->p,a->n_p,g,false);
+    if (rc != RAD_OK) return rc;
+    const auto& cand = a->t[0]; const auto& tok = a->t[1]; const auto& ids = a->t[2];
+    const auto& hist = a->t[3]; const auto& packed = a->t[4];
+    if (packed.rank != 2 || packed.shape[0] < 1 || packed.shape[0] > g.M) return RAD_E_SHAPE;
+    const int64_t M = packed.shape[0];
+    const int64_t cs[] = {M,8}, hs[] = {g.rounds,M,8}, os[] = {M,1+2*g.cap}, ts[] = {1}, is[] = {M};
+    uint64_t bytes[5]{};
+    if ((rc=tensor(cand,2,cs,bytes[0])) != RAD_OK ||
+        (rc=tensor(hist,3,hs,bytes[3])) != RAD_OK ||
+        (rc=tensor(packed,2,os,bytes[4])) != RAD_OK) return rc;
+    if (cand.stride[1] != 1 || hist.stride[2] != 1 || packed.stride[1] != 1)
+        return RAD_E_STRIDE;
+    if (hist.shape[0] != g.rounds || hist.shape[2] != 8) return RAD_E_SHAPE;
+    if (g.round == 1) {
+        if ((rc=tensor(tok,1,ts,bytes[1])) != RAD_OK ||
+            (rc=tensor(ids,1,is,bytes[2])) != RAD_OK) return rc;
+    }
+    for (int i=0;i<5;++i) for (int j=i+1;j<5;++j)
+        if ((i >= 3 || j >= 3) && overlap(a->t[i],bytes[i],a->t[j],bytes[j]))
+            return RAD_E_INVAL;
+    *out = {static_cast<const int32_t*>(cand.data), static_cast<const int32_t*>(tok.data),
+        static_cast<const int32_t*>(ids.data), static_cast<int32_t*>(hist.data),
+        static_cast<int32_t*>(packed.data), M, g.round == 1 ? tok.shape[0] : 0,
+        cand.stride[0], tok.stride[0], ids.stride[0], hist.stride[0], hist.stride[1],
+        packed.stride[0], static_cast<int>(g.cap), static_cast<int>(g.round), static_cast<int>(g.vocab),
+        static_cast<int>(g.rounds)};
+    return RAD_OK;
+}
+
+RadKernelInfo rad_mtp_tree_accum_row(RadLaunchFn launch) {
+    RadKernelInfo r{};
+    r.name = "mine_mtp_tree_accum"; r.op = schema.op; r.family = "draft";
+    r.computes = schema.doc;
+    r.shape = "pitch=8, max_rounds=3 (capacity=2..16) or 8 (capacity=2..65), round=1..max_rounds";
+    r.dtypes = "i32"; r.domain = RAD_DOMAIN_DEVICE; r.priority = 100;
+    r.launch = launch; r.opd_shape = rad_mtp_tree_accum_shape;
+    return r;
+}
+
+int rad_mtp_merge_tree_accum_shape(const RadParam* p, int n, int operand, RadOpdDesc* out) {
+    if (!out || operand < 0 || operand >= 7) return RAD_E_INVAL;
+    Geometry g{};
+    const int rc = geometry(p,n,g,true);
+    if (rc != RAD_OK) return rc;
+    if (rad_param_geti(p,n,"world_size",0) != 2) return RAD_E_UNSUPPORTED;
+    if (operand >= 3)
+        return rad_mtp_tree_accum_shape(p,n,operand-2,out);
+    RadOpdDesc d{};
+    d.dtype = operand == 1 ? RAD_I32 : RAD_F32;
+    d.idx_const = -1;
+    d.rank = 2; d.shape[0] = g.M; d.shape[1] = 8;
+    if (operand == 0) {
+        d.rank = 3; d.shape[1] = 16; d.shape[2] = 2;
+    }
+    *out = d;
+    return RAD_OK;
+}
+
+int rad_mtp_merge_tree_accum_args(const RadArgs* a, RadMtpMergeTreeAccumCall* out) {
+    if (!a || !out || !a->p || !a->t || a->n_t != 7) return RAD_E_INVAL;
+    if (rad_param_geti(a->p,a->n_p,"world_size",0) != 2) return RAD_E_UNSUPPORTED;
+    RadTensor tree_t[] = {a->t[1],a->t[3],a->t[4],a->t[5],a->t[6]};
+    RadArgs tree_a = *a; tree_a.t = tree_t; tree_a.n_t = 5;
+    RadMtpMergeTreeAccumCall c{};
+    int rc = rad_mtp_tree_accum_args(&tree_a,&c.tree);
+    if (rc != RAD_OK) return rc;
+    const int64_t M = c.tree.M;
+    const int64_t gs[] = {M,16,2}, cs[] = {M,8}, ts[] = {1}, is[] = {M};
+    const int64_t hs[] = {c.tree.max_rounds,M,8}, os[] = {M,1+2*c.tree.capacity};
+    const int ranks[] = {3,2,2,1,1,3,2};
+    const int64_t* shapes[] = {gs,cs,cs,ts,is,hs,os};
+    uint64_t bytes[7]{};
+    for (int i=0;i<7;++i) {
+        if (c.tree.round > 1 && (i == 3 || i == 4)) continue;
+        rc = tensor(a->t[i],ranks[i],shapes[i],bytes[i],
+                    i == 0 || i == 2 ? RAD_F32 : RAD_I32);
+        if (rc != RAD_OK) return rc;
+    }
+    const auto& gathered = a->t[0]; const auto& idx = a->t[1]; const auto& val = a->t[2];
+    if (gathered.shape[0] != M || gathered.shape[1] != 16 || gathered.shape[2] != 2 ||
+        idx.shape[0] != M || idx.shape[1] != 8 || val.shape[0] != M || val.shape[1] != 8 ||
+        a->t[6].shape[1] != 1+2*c.tree.capacity) return RAD_E_SHAPE;
+    if (gathered.stride[2] != 1 || gathered.stride[1] != 2 || val.stride[1] != 1)
+        return RAD_E_STRIDE;
+    for (int i=0;i<7;++i) for (int j=i+1;j<7;++j) {
+        const bool writes_i = i == 1 || i == 2 || i >= 5;
+        const bool writes_j = j == 1 || j == 2 || j >= 5;
+        if ((writes_i || writes_j) && overlap(a->t[i],bytes[i],a->t[j],bytes[j]))
+            return RAD_E_INVAL;
+    }
+    c.gathered = static_cast<const uint32_t*>(gathered.data);
+    c.idx = static_cast<int32_t*>(idx.data);
+    c.val = static_cast<uint32_t*>(val.data);
+    c.gathered_ld = gathered.stride[0]; c.val_ld = val.stride[0];
+    *out = c;
+    return RAD_OK;
+}
+
+RadKernelInfo rad_mtp_merge_tree_accum_row(RadLaunchFn launch) {
+    RadKernelInfo r = rad_mtp_tree_accum_row(launch);
+    r.name = "mine_mtp_merge_tree_accum"; r.op = merge_schema.op;
+    r.computes = merge_schema.doc;
+    r.shape = "world_size=2, pitch=8, max_rounds=3 (capacity=2..16) or 8 (capacity=2..65), "
+              "round=1..max_rounds";
+    r.dtypes = "f32 pairs, i32 ids/history/tree, f32 values";
+    r.opd_shape = rad_mtp_merge_tree_accum_shape;
+    return r;
+}
diff --git a/mine/mtp_tree_accum.h b/mine/mtp_tree_accum.h
new file mode 100644
index 0000000000000000000000000000000000000000..5dc911f51046fa3e6f5293f9e6014a8a31e8a786
--- /dev/null
+++ b/mine/mtp_tree_accum.h
@@ -0,0 +1,60 @@
+#ifndef RAD_MINE_MTP_TREE_ACCUM_H
+#define RAD_MINE_MTP_TREE_ACCUM_H
+
+#include "rad_plugin.h"
+#include <stdint.h>
+
+/* candidates, token_ids?, draft_out_ids? -> history, packed.
+ * Scalar round=1..max_rounds selects the issue; no new runtime ABI.
+ * max_rounds=3 is the frozen legacy geometry (capacity<=16); max_rounds=8 is the
+ * fixed MTP8 geometry (8 spine + 56 alternates + root, capacity<=65).
+ * Round 1 resets all max_rounds history planes for each live row and gathers the root.
+ * Later rounds reuse packed's root. Invalid roots/indices/live tokens emit count=0.
+ * Negative candidates terminate a round, as in the old serial builder.
+ * history is persistent [max_rounds,max_seqs,8]; packed is [M,1+2*capacity], root inclusive.
+ * Each issue rebuilds every live packed row, spine first, then deduplicated siblings.
+ * A new step MUST start at round 1; later issues MUST follow in order on one stream.
+ */
+struct RadMtpTreeAccumCall {
+    const int32_t* cand;
+    const int32_t* tokens;
+    const int32_t* ids;
+    int32_t* history;
+    int32_t* packed;
+    int64_t M, token_count;
+    int64_t cand_ld, token_stride, id_stride, hist_round_stride, hist_row_stride, out_ld;
+    int capacity, round, vocab, max_rounds;
+};
+
+/* TP=2 fusion: gathered [M,16,2] f32 (i32 id bits, f32 value) -> all eight
+ * merged ids/values, then the same persistent history and packed tree.
+ * Ordering is libr4d's unsigned 64-bit float-image/~id key, not float comparison.
+ * Equal keys in different input slots disappear together, as in its 16-lane merge.
+ * Negative ids are pads; exhausted outputs are (-1,-infinity).
+ */
+struct RadMtpMergeTreeAccumCall {
+    RadMtpTreeAccumCall tree;
+    const uint32_t* gathered;
+    int32_t* idx;
+    uint32_t* val;
+    int64_t gathered_ld, val_ld;
+};
+
+int rad_mtp_tree_accum_schema_count(void);
+const RadOpSchema* rad_mtp_tree_accum_schema_at(int);
+int rad_mtp_tree_accum_shape(const RadParam*, int, int, RadOpdDesc*);
+int rad_mtp_tree_accum_args(const RadArgs*, RadMtpTreeAccumCall*);
+RadKernelInfo rad_mtp_tree_accum_row(RadLaunchFn);
+int rad_mtp_merge_tree_accum_shape(const RadParam*, int, int, RadOpdDesc*);
+int rad_mtp_merge_tree_accum_args(const RadArgs*, RadMtpMergeTreeAccumCall*);
+RadKernelInfo rad_mtp_merge_tree_accum_row(RadLaunchFn);
+int rad_mine_mtp_merge_tree_accum_launch(const RadArgs*, RadStream);
+int rad_ref_mtp_merge_tree_accum(const RadArgs*, RadStream);
+int rad_mine_mtp_tree_accum_launch(const RadArgs*, RadStream);
+int rad_mine_mtp_tree_accum_count(void);
+const RadKernelInfo* rad_mine_mtp_tree_accum_at(int);
+int rad_ref_mtp_tree_accum(const RadArgs*, RadStream);
+int rad_ref_mtp_tree_accum_count(void);
+const RadKernelInfo* rad_ref_mtp_tree_accum_at(int);
+
+#endif
diff --git a/mine/mtp_tree_accum.hip b/mine/mtp_tree_accum.hip
new file mode 100644
index 0000000000000000000000000000000000000000..d0409044fa26c55e9eff0b44a93223382de4a61a
--- /dev/null
+++ b/mine/mtp_tree_accum.hip
@@ -0,0 +1,140 @@
+#include <hip/hip_runtime.h>
+#include "mtp_tree_accum.h"
+
+namespace {
+/* One lane per sequence. Rounds is the validated max_rounds: 3 keeps the legacy
+ * <=16-node private arrays; 8 is the fixed MTP8 tree with <=65 nodes. No host candidate
+ * read, allocation, synchronization, or auxiliary launch. */
+template <int Rounds>
+__device__ __forceinline__ void accumulate_row(RadMtpTreeAccumCall c, int64_t s,
+                                               const int32_t* merged = nullptr) {
+    constexpr int Cap = Rounds == 3 ? 16 : 65;
+    int32_t* const out = c.packed+s*c.out_ld;
+    int root = -1;
+    if (c.round == 1) {
+        const int idx = c.ids[s*c.id_stride];
+        if (idx >= 0 && idx < c.token_count) root = c.tokens[static_cast<int64_t>(idx)*c.token_stride];
+        // History is reset below while snapshotting this issue's candidate rows.
+    } else if (out[0] >= 1 && out[0] <= c.capacity) {
+        root = out[1];
+    }
+    int32_t candidates[Rounds][8];
+    for (int r=0;r<Rounds;++r) {
+        int32_t* const row = c.history+r*c.hist_round_stride+s*c.hist_row_stride;
+        if (r == c.round-1) {
+            for (int k=0;k<8;++k) {
+                const int32_t tok = merged ? merged[k] : c.cand[s*c.cand_ld+k];
+                candidates[r][k] = tok;
+                row[k] = tok;
+            }
+        } else if (c.round == 1) {
+            for (int k=0;k<8;++k) row[k] = -1;
+        } else if (r < c.round) {
+            for (int k=0;k<8;++k) candidates[r][k] = row[k];
+        }
+    }
+    bool valid = root >= 0 && root < c.vocab;
+    for (int r=0;r<c.round;++r)
+        for (int k=0;k<8 && candidates[r][k]>=0;++k)
+            valid = valid && candidates[r][k] < c.vocab;
+
+    // Construct privately: reading just-written packed entries in each sibling scan
+    // creates a dependent device-memory chain for an otherwise tiny integer walk.
+    int32_t tokens[Cap], parents[Cap];
+    for (int k=0;k<c.capacity;++k) { tokens[k] = -1; parents[k] = -1; }
+    int n = 0;
+    if (valid) {
+        tokens[0] = root;
+        n = 1;
+        int spine = 0;
+        for (int r=0;r<c.round && n<c.capacity;++r) {
+            const int tok = candidates[r][0];
+            if (tok < 0) break;
+            tokens[n] = tok;
+            parents[n] = n-1;
+            ++n; ++spine;
+        }
+        for (int r=0;r<spine && n<c.capacity;++r) {
+            for (int k=1;k<8 && n<c.capacity;++k) {
+                const int tok = candidates[r][k];
+                if (tok < 0) break;
+                bool duplicate = tok == candidates[r][0];
+                for (int j=r+1;j<n && !duplicate;++j)
+                    duplicate = parents[j] == r && tokens[j] == tok;
+                if (duplicate) continue;
+                tokens[n] = tok;
+                parents[n] = r;
+                ++n;
+            }
+        }
+    }
+    out[0] = n;
+    for (int k=0;k<c.capacity;++k) {
+        out[1+k] = tokens[k];
+        out[1+c.capacity+k] = parents[k];
+    }
+}
+
+template <int Rounds>
+__global__ void accumulate(RadMtpTreeAccumCall c) {
+    const int64_t s = static_cast<int64_t>(blockIdx.x)*blockDim.x + threadIdx.x;
+    if (s < c.M) accumulate_row<Rounds>(c,s);
+}
+
+template <int Rounds>
+__global__ void merge_accumulate(RadMtpMergeTreeAccumCall c) {
+    const int64_t s = static_cast<int64_t>(blockIdx.x)*blockDim.x + threadIdx.x;
+    if (s >= c.tree.M) return;
+    const uint32_t* const row = c.gathered+s*c.gathered_ld;
+    uint64_t keys[16];
+    for (int k=0;k<16;++k) {
+        const int32_t id = static_cast<int32_t>(row[2*k]);
+        uint32_t bits = row[2*k+1];
+        bits = bits & 0x80000000u ? ~bits : bits | 0x80000000u;
+        keys[k] = id < 0 ? 0 : (static_cast<uint64_t>(bits)<<32) | (0xffffffffu-row[2*k]);
+    }
+    int32_t merged[8];
+    for (int k=0;k<8;++k) {
+        uint64_t winner = 0;
+        for (int j=0;j<16;++j) if (keys[j] > winner) winner = keys[j];
+        uint32_t bits = static_cast<uint32_t>(winner>>32);
+        bits = winner ? (bits & 0x80000000u ? bits & 0x7fffffffu : ~bits) : 0xff800000u;
+        merged[k] = winner ? static_cast<int32_t>(0xffffffffu-static_cast<uint32_t>(winner)) : -1;
+        c.idx[s*c.tree.cand_ld+k] = merged[k];
+        c.val[s*c.val_ld+k] = bits;
+        // libr4d's wave removes every lane equal to the key, not just one slot.
+        for (int j=0;j<16;++j) if (keys[j] == winner) keys[j] = 0;
+    }
+    accumulate_row<Rounds>(c.tree,s,merged);
+}
+}
+
+int rad_mine_mtp_tree_accum_launch(const RadArgs* a, RadStream stream) {
+    RadMtpTreeAccumCall c{};
+    const int rc = rad_mtp_tree_accum_args(a,&c);
+    if (rc != RAD_OK) return rc;
+    void* args[] = {&c};
+    // max_rounds is validated to 3 or 8 by rad_mtp_tree_accum_args.
+    const void* kernel = c.max_rounds == 8 ? (const void*)accumulate<8> : (const void*)accumulate<3>;
+    return hipLaunchKernel(kernel, dim3(static_cast<unsigned>((c.M+63)/64)),
+                           dim3(64), args, 0, reinterpret_cast<hipStream_t>(stream))
+               == hipSuccess ? RAD_OK : RAD_E_DEVICE;
+}
+int rad_mine_mtp_merge_tree_accum_launch(const RadArgs* a, RadStream stream) {
+    RadMtpMergeTreeAccumCall c{};
+    const int rc = rad_mtp_merge_tree_accum_args(a,&c);
+    if (rc != RAD_OK) return rc;
+    void* args[] = {&c};
+    const void* kernel = c.tree.max_rounds == 8 ? (const void*)merge_accumulate<8>
+                                                : (const void*)merge_accumulate<3>;
+    return hipLaunchKernel(kernel,
+                           dim3(static_cast<unsigned>((c.tree.M+63)/64)), dim3(64), args, 0,
+                           reinterpret_cast<hipStream_t>(stream)) == hipSuccess ? RAD_OK : RAD_E_DEVICE;
+}
+int rad_mine_mtp_tree_accum_count(void) { return 2; }
+const RadKernelInfo* rad_mine_mtp_tree_accum_at(int i) {
+    static const RadKernelInfo rows[] = {
+        rad_mtp_tree_accum_row(rad_mine_mtp_tree_accum_launch),
+        rad_mtp_merge_tree_accum_row(rad_mine_mtp_merge_tree_accum_launch)};
+    return i >= 0 && i < 2 ? &rows[i] : nullptr;
+}
diff --git a/mine/ple_tree.cpp b/mine/ple_tree.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..44fccea92fd7a1b9d14f7cc67ea05ff5ef5f5f40
--- /dev/null
+++ b/mine/ple_tree.cpp
@@ -0,0 +1,235 @@
+#include "ple_tree.h"
+#include <cstring>
+#include <initializer_list>
+
+namespace {
+#define PI(k) {k,RAD_P_INT,RAD_REQUIRED,0}
+#define PO(k) {k,RAD_P_INT,RAD_OPTIONAL,0}
+static const RadParamSpec params[] = {
+    PI("q_len"),PI("n"),PI("heads"),PI("ngram"),PI("eos"),PI("width"),PI("dilation"),
+    PI("node_capacity"),PI("history_ring"),PO("n_seq"),
+    {"mode",RAD_P_STR,RAD_OPTIONAL,0},PO("tok_group"),PO("conv_group"),PO("layer"),PO("raw_buffer")
+};
+#undef PI
+#undef PO
+#define IN(n) {n,RAD_OPD_IN,0}
+#define OPT(n) {n,RAD_OPD_IN,1}
+#define OUT(n) {n,RAD_OPD_OUT,0}
+#define IO(n) {n,RAD_OPD_INOUT,0}
+#define W(n) {n,RAD_OPD_WEIGHT,0}
+static const RadOperandSpec ids[] = {
+    IN("tokens"),IN("tok_history"),IN("tok_idx"),IN("cu"),OPT("parent"),IN("ctx_before"),
+    W("mult"),W("vocab_sizes"),W("offsets"),OUT("ids")
+};
+static const RadOperandSpec conv[] = {
+    IN("x"),W("weights"),IO("conv_history"),IN("conv_idx"),IN("cu"),OPT("parent"),
+    IN("ctx_before"),OPT("residual"),OUT("y"),{"saved_raw",RAD_OPD_OUT,1}
+};
+static const RadOperandSpec commit[] = {
+    IO("tok_history"),IN("tok_idx"),IO("conv_history"),IN("conv_idx"),IN("tokens"),
+    IN("saved_raw"),IN("cu"),OPT("parent"),IN("ctx_before"),IN("path_nodes"),IN("path_len")
+};
+#undef IN
+#undef OPT
+#undef OUT
+#undef IO
+#undef W
+static const RadOpSchema schemas[] = {
+    {"ngram_ids_tree",params,15,ids,10,"Parent-aware EOS-cut ngram hashes over immutable canonical token history."},
+    {"ple_conv_tree",params,15,conv,10,"Dilated BF16 PLE convolution: immutable tree verification or linear committing prefill."},
+    {"ple_tree_commit",params,15,commit,11,"Commit only the accepted root-inclusive token/raw-input ancestry path."}
+};
+static const RadConstraint constraints[] = {
+    RAD_CGE("q_len",1),RAD_CGE("n",1),RAD_CGE("heads",1),RAD_CGE("ngram",2),RAD_CLE("ngram",8),
+    RAD_CGE("eos",0),RAD_CGE("width",2),RAD_CLE("width",8),RAD_CGE("dilation",1),
+    RAD_CGE("node_capacity",16),RAD_CLE("node_capacity",65),RAD_CGE("history_ring",0),RAD_CLE("history_ring",1)
+};
+
+bool geometry(const RadParam* p,int np,int op,RadPleTreeCall& c) {
+    for (int i=0;i<9;++i) {
+        const auto* v=rad_param_find(p,np,params[i].key);
+        if (!v || (v->kind!=RAD_P_INT && !(i==0 && v->kind==RAD_P_RANGE))) return false;
+        if (v->kind==RAD_P_RANGE && (v->ival<1 || v->ival>v->ihi)) return false;
+    }
+    for (int i=9;i<15;++i) {
+        const auto* v=rad_param_find(p,np,params[i].key);
+        if (v && v->kind!=params[i].type && !(i==9 && v->kind==RAD_P_RANGE)) return false;
+        if (v && ((v->kind==RAD_P_STR && !v->sval) ||
+            (v->kind==RAD_P_RANGE && (v->ival<1 || v->ival>v->ihi)))) return false;
+    }
+    auto get=[&](const char* key) { return rad_param_getdim(p,np,key,0); };
+    const int64_t n=get("n"),heads=get("heads"),ng=get("ngram"),eos=get("eos");
+    const int64_t width=get("width"),dil=get("dilation"),q=get("q_len"),ring=get("history_ring");
+    const int64_t capacity=get("node_capacity");
+    const char* mode=rad_param_gets(p,np,"mode","verify");
+    if (std::strcmp(mode,"verify") && std::strcmp(mode,"prefill")) return false;
+    c.prefill=!std::strcmp(mode,"prefill");
+    if ((c.prefill && op!=RAD_PLE_TREE_CONV) || n<1 || n>INT32_MAX || heads<1 || heads>INT32_MAX ||
+        ng<2 || ng>8 || heads%(ng-1) || eos<0 || eos>INT32_MAX || width<2 || width>8 ||
+        dil<1 || dil>RAD_PLE_TREE_HIST_MAX/(width-1) ||
+        (capacity!=RAD_PLE_TREE_CAP && capacity!=RAD_PLE_TREE_WIDE_CAP) ||
+        q<1 || q>INT32_MAX || (!c.prefill && q>capacity) || ring<0 || ring>1) return false;
+    c.op=op;c.n=(int)n;c.heads=(int)heads;c.ngram=(int)ng;c.eos=(int)eos;
+    c.width=(int)width;c.dilation=(int)dil;c.capacity=(int)capacity;c.q_len=(int)q;c.ring=(int)ring;
+    c.hist=(int)((width-1)*dil);
+    return true;
+}
+
+/* Positive non-overlapping strides permit pitched projections and state slots,
+ * while bounding every element and byte offset before either backend launches. */
+bool tensor(const RadTensor& t,uint32_t dt,std::initializer_list<int64_t> shape,
+            RadPleTreeTensor& v) {
+    if (!t.data || t.dtype!=dt || t.rank!=shape.size() || t.rank>3) return false;
+    int i=0;
+    for (int64_t d:shape) if (t.shape[i++]!=d) return false;
+    int64_t span=1;
+    for (int j=(int)t.rank-1;j>=0;--j) {
+        if (t.shape[j]<1 || t.stride[j]<span || t.shape[j]>INT64_MAX/t.stride[j]) return false;
+        span=t.shape[j]*t.stride[j];
+    }
+    const unsigned bytes=dt==RAD_BF16 ? 2u : dt==RAD_I64 ? 8u : 4u;
+    if ((uint64_t)span>SIZE_MAX/bytes || (uintptr_t)t.data>UINTPTR_MAX-(uint64_t)span*bytes) return false;
+    v={};v.data=t.data;
+    for (unsigned j=0;j<t.rank;++j) v.s[j]=t.stride[j];
+    return true;
+}
+bool index(const RadTensor& t,int n,RadPleTreeTensor& v) {
+    return t.rank==1 ? tensor(t,RAD_I32,{n},v) :
+        t.rank==2 && t.shape[1]>0 && tensor(t,RAD_I32,{n,t.shape[1]},v);
+}
+bool token_history(const RadTensor& t,RadPleTreeCall& c,int arg) {
+    if ((t.rank!=2 && t.rank!=3) || t.shape[0]<1 || t.shape[0]>INT32_MAX) return false;
+    const int64_t len=t.shape[t.rank-1];
+    if (len<c.ngram-1 || len>INT32_MAX) return false;
+    c.tok_slots=(int)t.shape[0];c.tok_len=(int)len;
+    if (t.rank==2) return tensor(t,RAD_I32,{c.tok_slots,len},c.t[arg]);
+    if (!tensor(t,RAD_I32,{c.tok_slots,1,len},c.t[arg])) return false;
+    c.t[arg].s[1]=c.t[arg].s[2];c.t[arg].s[2]=0;
+    return true;
+}
+bool conv_history(const RadTensor& t,RadPleTreeCall& c) {
+    if (t.rank!=3 || t.shape[0]<1 || t.shape[0]>INT32_MAX ||
+        t.shape[2]<c.hist || t.shape[2]>INT32_MAX) return false;
+    c.conv_slots=(int)t.shape[0];c.conv_len=(int)t.shape[2];
+    return tensor(t,RAD_BF16,{c.conv_slots,c.n,c.conv_len},c.t[2]);
+}
+uint64_t bytes(const RadTensor& t) {
+    if (!t.data) return 0;
+    uint64_t count=1;
+    for (unsigned j=0;j<t.rank;++j) count+=(uint64_t)(t.shape[j]-1)*t.stride[j];
+    return count*(t.dtype==RAD_BF16 ? 2u : t.dtype==RAD_I64 ? 8u : 4u);
+}
+bool overlaps(const RadTensor& a,const RadTensor& b) {
+    if (!a.data || !b.data) return false;
+    const uintptr_t x=(uintptr_t)a.data,y=(uintptr_t)b.data;
+    return x<y+bytes(b) && y<x+bytes(a);
+}
+
+int shape(int op,const RadParam* p,int np,int operand,RadOpdDesc* out) {
+    if (!out || operand<0 || operand>=schemas[op].n_operands) return RAD_E_INVAL;
+    RadPleTreeCall c{};
+    if (!geometry(p,np,op,c)) return RAD_E_UNSUPPORTED;
+    const int64_t s=rad_param_getdim(p,np,"n_seq",1);
+    if (s<1 || s>INT32_MAX/c.q_len) return RAD_E_SHAPE;
+    const int64_t t=s*c.q_len;
+    RadOpdDesc desc[11]{};int at=0;
+    auto add=[&](uint32_t dt,std::initializer_list<int64_t> dims) -> RadOpdDesc& {
+        auto& v=desc[at++];v.dtype=dt;v.idx_const=-1;
+        for (int64_t d:dims) v.shape[v.rank++]=d;
+        return v;
+    };
+    auto idx=[&](int64_t count,int64_t max,int64_t fixed,uint32_t flags=0) -> RadOpdDesc& {
+        auto& v=add(RAD_I32,{count});v.fill=RAD_FILL_INDEX;v.idx_max=max;v.idx_const=fixed;v.flags=flags;
+        return v;
+    };
+    auto tokhist=[&]() { add(RAD_I32,{s,1,c.ngram-1}); };
+    auto convhist=[&]() { add(RAD_BF16,{s,c.n,c.hist}); };
+    auto slot=[&]() { idx(s,s,-1,RAD_OPD_F_IDX_UNIQUE); };
+    auto cu=[&]() { idx(s+1,t,-1,RAD_OPD_F_IDX_CU); };
+    auto parent=[&]() { add(RAD_I32,{t}).flags=RAD_OPD_F_ABSENT; };
+    auto ctx=[&]() { idx(s,0,c.hist); };
+    if (op==RAD_PLE_TREE_IDS) {
+        idx(t,1024,-1);tokhist();slot();cu();parent();ctx();
+        auto& m=add(RAD_I64,{c.ngram});m.fill=RAD_FILL_INDEX;m.idx_const=17;
+        auto& v=add(RAD_I64,{c.heads});v.fill=RAD_FILL_INDEX;v.idx_const=997;
+        auto& o=add(RAD_I64,{c.heads});o.fill=RAD_FILL_INDEX;o.idx_const=0;
+        add(RAD_I32,{t,c.heads});
+    } else if (op==RAD_PLE_TREE_CONV) {
+        add(RAD_BF16,{t,c.n});add(RAD_BF16,{c.n,c.width});convhist();slot();cu();parent();ctx();
+        add(RAD_BF16,{t,c.n});add(RAD_BF16,{t,c.n});add(RAD_BF16,{t,c.n});
+    } else {
+        tokhist();slot();convhist();slot();idx(t,1024,-1);add(RAD_BF16,{t,c.n});cu();parent();ctx();
+        auto& path=add(RAD_I32,{s,c.capacity});path.fill=RAD_FILL_INDEX;path.idx_const=0;
+        idx(s,0,1);
+    }
+    *out=desc[operand];return RAD_OK;
+}
+} // namespace
+
+int rad_ple_tree_args(const RadArgs* a,int op,RadPleTreeCall* out) {
+    if (!a || !a->t || !out || op<0 || op>=RAD_PLE_TREE_OPS || a->n_t!=schemas[op].n_operands)
+        return RAD_E_INVAL;
+    RadPleTreeCall c{};
+    if (!geometry(a->p,a->n_p,op,c)) return RAD_E_UNSUPPORTED;
+    const int ci=rad_ple_tree_cu(c),pi=rad_ple_tree_parent_index(c),cx=rad_ple_tree_ctx_index(c);
+    const auto& cu=a->t[ci];
+    const auto& x=a->t[op==RAD_PLE_TREE_COMMIT ? 4 : 0];
+    if (cu.rank!=1 || cu.shape[0]<2 || cu.shape[0]>INT32_MAX ||
+        x.rank!=(op==RAD_PLE_TREE_CONV ? 2u : 1u) || x.shape[0]<1 || x.shape[0]>INT32_MAX)
+        return RAD_E_SHAPE;
+    c.nseq=(int)cu.shape[0]-1;c.tokens=(int)x.shape[0];
+    if (!tensor(cu,RAD_I32,{c.nseq+1},c.t[ci]) ||
+        !tensor(a->t[cx],RAD_I32,{c.nseq},c.t[cx]) ||
+        (a->t[pi].data && !tensor(a->t[pi],RAD_I32,{c.tokens},c.t[pi]))) return RAD_E_SHAPE;
+    if (c.prefill && a->t[pi].data) return RAD_E_INVAL;
+    auto row=[&](int i) { return tensor(a->t[i],RAD_BF16,{c.tokens,c.n},c.t[i]); };
+    auto ix=[&](int i) { return index(a->t[i],c.nseq,c.t[i]); };
+    bool ok;
+    if (op==RAD_PLE_TREE_IDS) {
+        ok=tensor(x,RAD_I32,{c.tokens},c.t[0]) && token_history(a->t[1],c,1) && ix(2) &&
+            tensor(a->t[6],RAD_I64,{c.ngram},c.t[6]) && tensor(a->t[7],RAD_I64,{c.heads},c.t[7]) &&
+            tensor(a->t[8],RAD_I64,{c.heads},c.t[8]) && tensor(a->t[9],RAD_I32,{c.tokens,c.heads},c.t[9]);
+    } else if (op==RAD_PLE_TREE_CONV) {
+        ok=row(0) && tensor(a->t[1],RAD_BF16,{c.n,c.width},c.t[1]) && conv_history(a->t[2],c) &&
+            ix(3) && (!a->t[7].data || row(7)) && row(8) &&
+            (a->t[9].data ? row(9) : c.prefill!=0);
+    } else {
+        const int64_t pitch=a->t[9].rank==2 ? a->t[9].shape[1] : 0;
+        ok=token_history(a->t[0],c,0) && ix(1) && conv_history(a->t[2],c) && ix(3) &&
+            tensor(x,RAD_I32,{c.tokens},c.t[4]) && row(5) &&
+            (pitch==RAD_PLE_TREE_CAP || pitch==RAD_PLE_TREE_WIDE_CAP) &&
+            tensor(a->t[9],RAD_I32,{c.nseq,pitch},c.t[9]) && tensor(a->t[10],RAD_I32,{c.nseq},c.t[10]);
+        /* Runtime path storage is independent of the declared verification band. */
+        if (pitch<c.capacity) c.capacity=(int)pitch;
+    }
+    if (!ok) return RAD_E_SHAPE;
+    /* No output may destroy another operand's immutable input or saved bits.
+     * Check intervals, not pointer equality: narrowed/pitched views can overlap. */
+    for (int i=0;i<a->n_t;++i) {
+        const bool write=op==RAD_PLE_TREE_IDS ? i==9 : op==RAD_PLE_TREE_CONV ?
+            (i==8 || i==9 || (i==2 && c.prefill)) : (i==0 || i==2);
+        if (write) for (int j=0;j<a->n_t;++j)
+            if (j!=i && overlaps(a->t[i],a->t[j])) return RAD_E_INVAL;
+    }
+    *out=c;return RAD_OK;
+}
+int rad_ple_tree_schema_count(void) { return RAD_PLE_TREE_OPS; }
+const RadOpSchema* rad_ple_tree_schema_at(int i) {
+    return i>=0 && i<RAD_PLE_TREE_OPS ? schemas+i : nullptr;
+}
+int rad_ple_tree_ids_shape(const RadParam* p,int n,int i,RadOpdDesc* out) { return shape(0,p,n,i,out); }
+int rad_ple_tree_conv_shape(const RadParam* p,int n,int i,RadOpdDesc* out) { return shape(1,p,n,i,out); }
+int rad_ple_tree_commit_shape(const RadParam* p,int n,int i,RadOpdDesc* out) { return shape(2,p,n,i,out); }
+RadKernelInfo rad_ple_tree_row(int op,int domain,RadLaunchFn launch) {
+    static const char* host[]={"ref_ngram_ids_tree","ref_ple_conv_tree","ref_ple_tree_commit"};
+    static const char* device[]={"mine_ngram_ids_tree","mine_ple_conv_tree","mine_ple_tree_commit"};
+    static const RadShapeFn shapes[]={rad_ple_tree_ids_shape,rad_ple_tree_conv_shape,rad_ple_tree_commit_shape};
+    RadKernelInfo r{};
+    if (op<0 || op>=RAD_PLE_TREE_OPS) return r;
+    r.name=domain==RAD_DOMAIN_HOST ? host[op] : device[op];r.op=schemas[op].op;r.family="ple";
+    r.computes=schemas[op].doc;r.shape="ngram=2..8, width=2..8, hist<=64, nodes<=65 (capacity 16 or 65) or linear prefill";
+    r.dtypes="i32 tokens/ids; i64 hash weights; bf16 activations/history; f32 accumulation";
+    r.domain=domain;r.priority=domain==RAD_DOMAIN_DEVICE ? 100 : 0;
+    r.constraints=constraints;r.n_constraints=sizeof(constraints)/sizeof(constraints[0]);
+    r.launch=launch;r.opd_shape=shapes[op];return r;
+}
diff --git a/mine/ple_tree.h b/mine/ple_tree.h
new file mode 100644
index 0000000000000000000000000000000000000000..99141e9893562ba94afa0ec24edd6230c8f4ae9a
--- /dev/null
+++ b/mine/ple_tree.h
@@ -0,0 +1,112 @@
+#ifndef RAD_MINE_PLE_TREE_H
+#define RAD_MINE_PLE_TREE_H
+
+#include "rad_plugin.h"
+#include <stdint.h>
+
+/* Absolute token rows, sequence-local parents, and root-inclusive commit paths.
+ * Token history uses the first ngram-1 cells, oldest to newest. Convolution
+ * history uses the first hist cells in canonical mode, or position % conv_len
+ * in ring mode. Physical history tails/padding are not canonical window cells.
+ * Verification supports 16- or 65-node capacities without per-node scratch.
+ * Commit accepts a physical path pitch of 16 or 65 independently of capacity.
+ * Verification never writes committed history; convolution prefill commits all
+ * its linear inputs after reading the immutable history. No launch allocates. */
+enum { RAD_PLE_TREE_IDS = 0, RAD_PLE_TREE_CONV = 1, RAD_PLE_TREE_COMMIT = 2,
+       RAD_PLE_TREE_OPS = 3, RAD_PLE_TREE_CAP = 16, RAD_PLE_TREE_WIDE_CAP = 65,
+       RAD_PLE_TREE_HIST_MAX = 64 };
+
+struct RadPleTreeTensor {
+    void* data;
+    int64_t s[3];
+};
+struct RadPleTreeCall {
+    RadPleTreeTensor t[11];
+    int op, nseq, tokens, n, heads, ngram, eos, width, dilation, capacity, q_len;
+    int ring, prefill, hist, tok_len, conv_len, tok_slots, conv_slots;
+};
+
+/* Shape/stride/alias checks only: device metadata is never dereferenced here. */
+int rad_ple_tree_args(const RadArgs*, int op, RadPleTreeCall*);
+int rad_ple_tree_schema_count(void);
+const RadOpSchema* rad_ple_tree_schema_at(int);
+int rad_ple_tree_ids_shape(const RadParam*, int, int, RadOpdDesc*);
+int rad_ple_tree_conv_shape(const RadParam*, int, int, RadOpdDesc*);
+int rad_ple_tree_commit_shape(const RadParam*, int, int, RadOpdDesc*);
+RadKernelInfo rad_ple_tree_row(int op, int domain, RadLaunchFn);
+int rad_mine_ple_tree_count(void);
+const RadKernelInfo* rad_mine_ple_tree_at(int);
+
+#if defined(__HIPCC__)
+#define RAD_PLE_HD __host__ __device__
+#else
+#define RAD_PLE_HD
+#endif
+RAD_PLE_HD inline int64_t rad_ple_off(const RadPleTreeTensor& t, int64_t a,
+                                     int64_t b = 0, int64_t c = 0) {
+    return a*t.s[0] + b*t.s[1] + c*t.s[2];
+}
+RAD_PLE_HD inline int rad_ple_int(const RadPleTreeTensor& t, int a, int b = 0) {
+    return static_cast<const int32_t*>(t.data)[rad_ple_off(t,a,b)];
+}
+RAD_PLE_HD inline int rad_ple_parent(const RadPleTreeTensor& t, int bos, int node) {
+    return t.data ? rad_ple_int(t,bos+node) : node-1;
+}
+RAD_PLE_HD inline int rad_ple_tree_cu(const RadPleTreeCall& c) {
+    return c.op == RAD_PLE_TREE_IDS ? 3 : c.op == RAD_PLE_TREE_CONV ? 4 : 6;
+}
+RAD_PLE_HD inline int rad_ple_tree_parent_index(const RadPleTreeCall& c) {
+    return rad_ple_tree_cu(c)+1;
+}
+RAD_PLE_HD inline int rad_ple_tree_ctx_index(const RadPleTreeCall& c) {
+    return rad_ple_tree_cu(c)+2;
+}
+/* A nonnegative result is a local candidate node. -k denotes the k-th
+ * committed predecessor, k>=1. Linear prefill remains constant-time per tap. */
+RAD_PLE_HD inline int rad_ple_tree_source(const RadPleTreeCall& c, int bos,
+                                        int node, int lag) {
+    const auto& p=c.t[rad_ple_tree_parent_index(c)];
+    if (!p.data) return node-lag;
+    while (lag && node>=0) { node=rad_ple_parent(p,bos,node); --lag; }
+    return node>=0 ? node : -lag-1;
+}
+/* Uniform bounded device guards. Runtime producers must validate topology to
+ * report errors; the host reference validates every sequence before any write. */
+RAD_PLE_HD inline bool rad_ple_tree_metadata(const RadPleTreeCall& c, int seq) {
+    const int ci=rad_ple_tree_cu(c), pi=rad_ple_tree_parent_index(c);
+    const int bos=rad_ple_int(c.t[ci],seq), end=rad_ple_int(c.t[ci],seq+1);
+    if (bos<0 || end<=bos || end>c.tokens || end-bos>c.q_len) return false;
+    const int ctx=rad_ple_int(c.t[rad_ple_tree_ctx_index(c)],seq);
+    if (ctx<0 || ctx>INT32_MAX-(end-bos)) return false;
+    if (c.t[pi].data) for (int i=0;i<end-bos;++i) {
+        const int p=rad_ple_parent(c.t[pi],bos,i);
+        if ((i==0 && p!=-1) || (i>0 && (p<0 || p>=i))) return false;
+    }
+    if (c.op!=RAD_PLE_TREE_CONV) {
+        const int slot=rad_ple_int(c.t[c.op==RAD_PLE_TREE_IDS ? 2 : 1],seq);
+        if (slot<0 || slot>=c.tok_slots) return false;
+    }
+    if (c.op!=RAD_PLE_TREE_IDS) {
+        const int slot=rad_ple_int(c.t[3],seq);
+        if (slot<0 || slot>=c.conv_slots) return false;
+    }
+    if (c.op==RAD_PLE_TREE_COMMIT) {
+        const int len=rad_ple_int(c.t[10],seq);
+        if (len<1 || len>end-bos || len>c.capacity) return false;
+        int prev=-1;
+        for (int j=0;j<len;++j) {
+            const int node=rad_ple_int(c.t[9],seq,j);
+            if (node<0 || node>=end-bos || rad_ple_parent(c.t[pi],bos,node)!=prev) return false;
+            prev=node;
+        }
+    }
+    if (c.op==RAD_PLE_TREE_COMMIT || c.prefill) {
+        for (int s=0;s<c.nseq;++s) if (s!=seq &&
+            (rad_ple_int(c.t[3],s)==rad_ple_int(c.t[3],seq) ||
+             (c.op==RAD_PLE_TREE_COMMIT && rad_ple_int(c.t[1],s)==rad_ple_int(c.t[1],seq))))
+            return false;
+    }
+    return true;
+}
+#undef RAD_PLE_HD
+#endif
diff --git a/mine/ple_tree.hip b/mine/ple_tree.hip
new file mode 100644
index 0000000000000000000000000000000000000000..79f409a4f047bdfa495ce4155a9bf55c176782b8
--- /dev/null
+++ b/mine/ple_tree.hip
@@ -0,0 +1,149 @@
+#include <hip/hip_runtime.h>
+#include "ple_tree.h"
+#include "../libr4d/r4d_common.h"
+
+#pragma clang fp contract(off)
+
+namespace {
+constexpr int kThreads=128;
+
+__device__ __forceinline__ uint16_t raw(const RadPleTreeTensor& t,int a,int b=0,int d=0) {
+    return static_cast<const uint16_t*>(t.data)[rad_ple_off(t,a,b,d)];
+}
+__device__ __forceinline__ float bf(const RadPleTreeTensor& t,int a,int b=0,int d=0) {
+    return bf16_to_f32(raw(t,a,b,d));
+}
+__device__ __forceinline__ int64_t weight(const RadPleTreeTensor& t,int i) {
+    return static_cast<const int64_t*>(t.data)[rad_ple_off(t,i)];
+}
+__device__ __forceinline__ void store(const RadPleTreeTensor& t,uint16_t value,int a,int b=0,int d=0) {
+    static_cast<uint16_t*>(t.data)[rad_ple_off(t,a,b,d)]=value;
+}
+
+__global__ __launch_bounds__(kThreads) void ids_kernel(RadPleTreeCall c) {
+    const int seq=blockIdx.x,node=threadIdx.x;
+    if (!rad_ple_tree_metadata(c,seq)) return;
+    const int bos=rad_ple_int(c.t[3],seq),end=rad_ple_int(c.t[3],seq+1);
+    if (node>=end-bos) return;
+    const int slot=rad_ple_int(c.t[2],seq),ctx=rad_ple_int(c.t[5],seq);
+    for (int h=0;h<c.heads;++h) {
+        const int64_t divisor=weight(c.t[7],h),offset=weight(c.t[8],h);
+        if (divisor<=0 || offset<0 || offset>INT32_MAX || divisor-1>INT32_MAX-offset) return;
+    }
+    int64_t shifted[8];
+    shifted[0]=rad_ple_int(c.t[0],bos+node);
+    bool cut=false;
+    for (int k=1;k<c.ngram;++k) {
+        if (cut || shifted[k-1]==c.eos) { cut=true;shifted[k]=c.eos;continue; }
+        const int source=rad_ple_tree_source(c,bos,node,k);
+        shifted[k]=source>=0 ? rad_ple_int(c.t[0],bos+source) :
+            ctx+source>=0 ? rad_ple_int(c.t[1],slot,c.ngram-1+source) : c.eos;
+    }
+    uint64_t mixed=0;
+    const int per=c.heads/(c.ngram-1);
+    for (int k=0;k<c.ngram;++k) {
+        mixed^=static_cast<uint64_t>(shifted[k])*static_cast<uint64_t>(weight(c.t[6],k));
+        if (!k) continue;
+        const int64_t signed_mix=__builtin_bit_cast(int64_t,mixed);
+        for (int j=0;j<per;++j) {
+            const int head=(k-1)*per+j;
+            const int64_t divisor=weight(c.t[7],head),remainder=signed_mix%divisor;
+            const int64_t mod=remainder<0 ? remainder+divisor : remainder;
+            const uint64_t id=static_cast<uint64_t>(mod)+static_cast<uint64_t>(weight(c.t[8],head));
+            static_cast<int32_t*>(c.t[9].data)[rad_ple_off(c.t[9],bos+node,head)]=static_cast<int32_t>(id);
+        }
+    }
+}
+
+/* A lane owns one channel for the entire sequence. All prefill history reads
+ * finish before that lane updates its window, without a second dispatch or a
+ * cross-workgroup barrier, including arbitrary prefill lengths and hist<=64. */
+__global__ __launch_bounds__(kThreads) void conv_kernel(RadPleTreeCall c) {
+    const int seq=blockIdx.x,ch=blockIdx.y*kThreads+threadIdx.x;
+    if (ch>=c.n) return;
+    if (c.prefill) {
+        for (int s=0;s<c.nseq;++s) if (!rad_ple_tree_metadata(c,s)) return;
+    } else if (!rad_ple_tree_metadata(c,seq)) return;
+    const int bos=rad_ple_int(c.t[4],seq),end=rad_ple_int(c.t[4],seq+1),length=end-bos;
+    const int slot=rad_ple_int(c.t[3],seq),ctx=rad_ple_int(c.t[6],seq);
+    float taps[8];
+    for (int j=0;j<c.width;++j) taps[j]=bf(c.t[1],ch,j);
+    for (int node=0;node<length;++node) {
+        float acc=0;
+        for (int j=0;j<c.width;++j) {
+            const int lag=c.hist-j*c.dilation,source=rad_ple_tree_source(c,bos,node,lag);
+            float value=0;
+            if (source>=0) value=bf(c.t[0],bos+source,ch);
+            else if (ctx+source>=0) value=bf(c.t[2],slot,ch,c.ring ? (ctx+source)%c.conv_len : c.hist+source);
+            acc=acc+value*taps[j];
+        }
+        const float residual=c.t[7].data ? bf(c.t[7],bos+node,ch) : 0;
+        store(c.t[8],f32_to_bf16(residual+acc/(1.0f+expf(-acc))),bos+node,ch);
+        if (c.t[9].data) store(c.t[9],raw(c.t[0],bos+node,ch),bos+node,ch);
+    }
+    if (!c.prefill) return;
+    if (c.ring) {
+        const int first=length>c.conv_len ? length-c.conv_len : 0;
+        for (int i=first;i<length;++i) store(c.t[2],raw(c.t[0],bos+i,ch),slot,ch,(ctx+i)%c.conv_len);
+    } else {
+        for (int i=0;i<c.hist;++i) {
+            const int source=length-c.hist+i;
+            const uint16_t value=source>=0 ? raw(c.t[0],bos+source,ch) :
+                ctx+source>=0 ? raw(c.t[2],slot,ch,c.hist+source) : 0;
+            store(c.t[2],value,slot,ch,i);
+        }
+    }
+}
+
+__global__ __launch_bounds__(kThreads) void commit_kernel(RadPleTreeCall c) {
+    const int seq=blockIdx.x,ch=blockIdx.y*kThreads+threadIdx.x;
+    if (ch>=c.n) return;
+    // Reject the whole batch before any store, including another sequence's invalid path or slot.
+    for (int s=0;s<c.nseq;++s) if (!rad_ple_tree_metadata(c,s)) return;
+    const int bos=rad_ple_int(c.t[6],seq),ctx=rad_ple_int(c.t[8],seq),length=rad_ple_int(c.t[10],seq);
+    if (ch==0) {
+        const int slot=rad_ple_int(c.t[1],seq),window=c.ngram-1;
+        for (int i=0;i<window;++i) {
+            const int source=length-window+i;
+            const int32_t value=source>=0 ? rad_ple_int(c.t[4],bos+rad_ple_int(c.t[9],seq,source)) :
+                ctx+source>=0 ? rad_ple_int(c.t[0],slot,window+source) : c.eos;
+            static_cast<int32_t*>(c.t[0].data)[rad_ple_off(c.t[0],slot,i)]=value;
+        }
+    }
+    const int slot=rad_ple_int(c.t[3],seq);
+    if (c.ring) {
+        for (int i=0;i<length;++i) store(c.t[2],raw(c.t[5],bos+rad_ple_int(c.t[9],seq,i),ch),slot,ch,(ctx+i)%c.conv_len);
+    } else {
+        // Sources from old history lie strictly after each destination, so ascending stores are safe.
+        for (int i=0;i<c.hist;++i) {
+            const int source=length-c.hist+i;
+            const uint16_t value=source>=0 ? raw(c.t[5],bos+rad_ple_int(c.t[9],seq,source),ch) :
+                ctx+source>=0 ? raw(c.t[2],slot,ch,c.hist+source) : 0;
+            store(c.t[2],value,slot,ch,i);
+        }
+    }
+}
+
+int ids_launch(const RadArgs* a,RadStream stream) {
+    RadPleTreeCall c{};const int rc=rad_ple_tree_args(a,RAD_PLE_TREE_IDS,&c);if (rc!=RAD_OK) return rc;
+    void* args[]={&c};
+    return hipLaunchKernel((const void*)ids_kernel,dim3(c.nseq),dim3(kThreads),args,0,(hipStream_t)stream)==hipSuccess ? RAD_OK : RAD_E_DEVICE;
+}
+int conv_launch(const RadArgs* a,RadStream stream) {
+    RadPleTreeCall c{};const int rc=rad_ple_tree_args(a,RAD_PLE_TREE_CONV,&c);if (rc!=RAD_OK) return rc;
+    void* args[]={&c};
+    return hipLaunchKernel((const void*)conv_kernel,dim3(c.nseq,(c.n-1)/kThreads+1),dim3(kThreads),args,0,(hipStream_t)stream)==hipSuccess ? RAD_OK : RAD_E_DEVICE;
+}
+int commit_launch(const RadArgs* a,RadStream stream) {
+    RadPleTreeCall c{};const int rc=rad_ple_tree_args(a,RAD_PLE_TREE_COMMIT,&c);if (rc!=RAD_OK) return rc;
+    void* args[]={&c};
+    return hipLaunchKernel((const void*)commit_kernel,dim3(c.nseq,(c.n-1)/kThreads+1),dim3(kThreads),args,0,(hipStream_t)stream)==hipSuccess ? RAD_OK : RAD_E_DEVICE;
+}
+} // namespace
+
+int rad_mine_ple_tree_count(void) { return RAD_PLE_TREE_OPS; }
+const RadKernelInfo* rad_mine_ple_tree_at(int i) {
+    static const RadKernelInfo rows[]={rad_ple_tree_row(RAD_PLE_TREE_IDS,RAD_DOMAIN_DEVICE,ids_launch),
+        rad_ple_tree_row(RAD_PLE_TREE_CONV,RAD_DOMAIN_DEVICE,conv_launch),rad_ple_tree_row(RAD_PLE_TREE_COMMIT,RAD_DOMAIN_DEVICE,commit_launch)};
+    return i>=0 && i<RAD_PLE_TREE_OPS ? rows+i : nullptr;
+}
diff --git a/mine/qsa_tree_commit.cpp b/mine/qsa_tree_commit.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6ec9237c997a6b5123ccceccd3a884362d5d0ee0
--- /dev/null
+++ b/mine/qsa_tree_commit.cpp
@@ -0,0 +1,119 @@
+#include "qsa_tree_commit.h"
+
+#include <climits>
+#include <cmath>
+#include <cstring>
+
+namespace {
+#define PI(k) {k, RAD_P_INT, RAD_REQUIRED, 0}
+#define PF(k) {k, RAD_P_F64, RAD_OPTIONAL, 0}
+const RadParamSpec params[] = {PI("M"), PI("n"), PI("ratio"), PI("ring"), PI("rotary_dim"),
+    PI("block_size"), {"max_tokens", RAD_P_INT, RAD_REQUIRED, RAD_PROLE_CAPACITY},
+    PF("eps"), PF("wadd"), PF("theta"), PF("scale")};
+#undef PI
+#undef PF
+const RadOperandSpec operands[] = {
+    {"k", RAD_OPD_IN, 0}, {"pos", RAD_OPD_IN, 0}, {"paths", RAD_OPD_IN, 0},
+    {"lengths", RAD_OPD_IN, 0}, {"starts", RAD_OPD_IN, 0}, {"tail", RAD_OPD_INOUT, 0},
+    {"sidx", RAD_OPD_IN, 0}, {"bt", RAD_OPD_IN, 0}, {"weight", RAD_OPD_WEIGHT, 0},
+    {"block_keys", RAD_OPD_INOUT, 0}};
+const RadOpSchema schema = {"qsa_tree_commit", params, 11, operands, 10,
+    "Replay each noncontiguous accepted path in order: complete block from old tail and current "
+    "raw key, BF16 pool/RMSNorm/NeoX RoPE, then tail store. One owner per sequence; invalid "
+    "metadata or duplicate live state/page destinations leave the whole batch unchanged."};
+
+int tensor(const RadTensor& t, uint32_t dtype, int rank, uint64_t& bytes) {
+    if (!t.data) return RAD_E_INVAL;
+    if (t.dtype!=dtype) return RAD_E_DTYPE;
+    if (t.rank!=uint32_t(rank)) return RAD_E_SHAPE;
+    const uint64_t element=dtype==RAD_BF16 ? 2 : 4;
+    if (reinterpret_cast<uintptr_t>(t.data)%element) return RAD_E_INVAL;
+    uint64_t span=1;
+    for (int d=rank-1; d>=0; --d) {
+        if (t.shape[d]<1 || t.shape[d]>INT32_MAX) return RAD_E_SHAPE;
+        if (t.stride[d]<1 || (d<rank-1 && uint64_t(t.stride[d])<span)) return RAD_E_STRIDE;
+        const uint64_t extent=uint64_t(t.shape[d]-1);
+        if (extent && uint64_t(t.stride[d])>(INT64_MAX/element-span)/extent) return RAD_E_SHAPE;
+        span+=extent*uint64_t(t.stride[d]);
+    }
+    bytes=span*element;
+    if (reinterpret_cast<uintptr_t>(t.data)>UINTPTR_MAX-bytes) return RAD_E_INVAL;
+    return RAD_OK;
+}
+bool overlap(const RadTensor& a, uint64_t an, const RadTensor& b, uint64_t bn) {
+    const uintptr_t x=reinterpret_cast<uintptr_t>(a.data), y=reinterpret_cast<uintptr_t>(b.data);
+    return x<y+bn && y<x+an;
+}
+}
+
+int rad_qsa_tree_commit_schema_count(void) { return 1; }
+const RadOpSchema* rad_qsa_tree_commit_schema_at(int i) { return i==0 ? &schema : nullptr; }
+
+int rad_qsa_tree_commit_args(const RadArgs* a, RadQsaTreeCommitCall* out) {
+    if (!a || !out || !a->t || a->n_t!=10 || !a->p) return RAD_E_INVAL;
+    const int64_t n=rad_param_geti(a->p,a->n_p,"n",0);
+    const int64_t ratio=rad_param_geti(a->p,a->n_p,"ratio",0);
+    const int64_t ring=rad_param_geti(a->p,a->n_p,"ring",0);
+    const int64_t rot=rad_param_geti(a->p,a->n_p,"rotary_dim",0);
+    const int64_t max_seq=rad_param_geti(a->p,a->n_p,"M",0);
+    const int64_t max_tokens=rad_param_geti(a->p,a->n_p,"max_tokens",0);
+    if (n<1 || n>256 || ratio<1 || ratio>32 || ring<ratio || ring>32 || rot<0 || rot>n ||
+        (rot&1) || max_seq<1 || max_seq>256 || max_tokens<1 || max_tokens>INT32_MAX ||
+        rad_param_geti(a->p,a->n_p,"block_size",0)!=ratio) return RAD_E_UNSUPPORTED;
+    const auto& k=a->t[0]; const auto& pos=a->t[1]; const auto& path=a->t[2];
+    const auto& length=a->t[3]; const auto& start=a->t[4]; const auto& tail=a->t[5];
+    const auto& sidx=a->t[6]; const auto& bt=a->t[7]; const auto& weight=a->t[8];
+    const auto& bk=a->t[9];
+    const int ranks[]={2,1,2,1,1,4,2,2,1,int(bk.rank)};
+    const uint32_t types[]={RAD_BF16,RAD_I32,RAD_I32,RAD_I32,RAD_I32,RAD_BF16,
+                            RAD_I32,RAD_I32,RAD_F32,RAD_BF16};
+    if (bk.rank!=2 && bk.rank!=4) return RAD_E_SHAPE;
+    uint64_t bytes[10]{};
+    for (int i=0; i<10; ++i) {
+        const int rc=tensor(a->t[i],types[i],ranks[i],bytes[i]);
+        if (rc!=RAD_OK) return rc;
+    }
+    const int64_t seqs=path.shape[0], tokens=k.shape[0];
+    if (seqs>max_seq || tokens>max_tokens || k.shape[1]!=n || pos.shape[0]<tokens ||
+        (path.shape[1]!=16 && path.shape[1]!=65) || length.shape[0]!=seqs || start.shape[0]!=seqs ||
+        sidx.shape[0]!=seqs || bt.shape[0]!=seqs || tail.shape[1]!=1 ||
+        tail.shape[2]!=ring || tail.shape[3]!=n || weight.shape[0]!=n) return RAD_E_SHAPE;
+    if (k.stride[1]!=1 || tail.stride[3]!=1 || weight.stride[0]!=1 || bt.stride[1]!=1)
+        return RAD_E_STRIDE;
+    int64_t width=1;
+    for (int d=int(bk.rank)-1; d>0; --d) {
+        if (bk.stride[d]!=width) return RAD_E_STRIDE;
+        if (bk.shape[d]>n/width) return RAD_E_SHAPE;
+        width*=bk.shape[d];
+    }
+    if (width!=n) return RAD_E_SHAPE;
+    for (int i=0; i<10; ++i) for (int j=i+1; j<10; ++j)
+        if ((i==5 || i==9 || j==5 || j==9) && overlap(a->t[i],bytes[i],a->t[j],bytes[j]))
+            return RAD_E_INVAL;
+    const float eps=float(rad_param_getf(a->p,a->n_p,"eps",1e-6));
+    const float wadd=float(rad_param_getf(a->p,a->n_p,"wadd",1.0));
+    const float theta=float(rad_param_getf(a->p,a->n_p,"theta",10000.0));
+    const float scale=float(rad_param_getf(a->p,a->n_p,"scale",1.0));
+    if (!std::isfinite(eps) || eps<0 || !std::isfinite(wadd) || !std::isfinite(theta) ||
+        theta<=0 || !std::isfinite(scale)) return RAD_E_INVAL;
+    *out={static_cast<const uint16_t*>(k.data), static_cast<const int32_t*>(pos.data),
+        static_cast<const int32_t*>(path.data), static_cast<const int32_t*>(length.data),
+        static_cast<const int32_t*>(start.data), static_cast<uint16_t*>(tail.data),
+        static_cast<const int32_t*>(sidx.data), static_cast<const int32_t*>(bt.data),
+        static_cast<const float*>(weight.data), static_cast<uint16_t*>(bk.data),
+        k.stride[0],pos.stride[0],path.stride[0],path.stride[1],length.stride[0],start.stride[0],
+        tail.stride[0],tail.stride[2],sidx.stride[0],bt.stride[0],bk.stride[0],
+        int(tokens),int(seqs),int(n),int(ratio),int(ring),int(rot),int(tail.shape[0]),
+        int(bk.shape[0]),int(bt.shape[1]),int(path.shape[1]),
+        eps,wadd,theta,scale};
+    return RAD_OK;
+}
+
+RadKernelInfo rad_qsa_tree_commit_row(RadLaunchFn launch) {
+    RadKernelInfo row{};
+    row.name="mine_qsa_tree_commit"; row.op=schema.op; row.family="qsa";
+    row.computes=schema.doc;
+    row.shape="n<=256, ratio<=ring<=32, nodes<=65, path width 16 or 65, single-component NeoX";
+    row.dtypes="bf16,f32,i32"; row.domain=RAD_DOMAIN_DEVICE; row.priority=100; row.launch=launch;
+    return row;
+}
diff --git a/mine/qsa_tree_commit.h b/mine/qsa_tree_commit.h
new file mode 100644
index 0000000000000000000000000000000000000000..26f509b9fc47b16f09276eecc51d3f2e2ef96779
--- /dev/null
+++ b/mine/qsa_tree_commit.h
@@ -0,0 +1,104 @@
+#ifndef RAD_MINE_QSA_TREE_COMMIT_H
+#define RAD_MINE_QSA_TREE_COMMIT_H
+
+#include "rad_plugin.h"
+#include <stdint.h>
+
+/* k,pos,paths,lengths,starts,tail(INOUT),sidx,bt,weight,block_keys(INOUT).
+ * paths are sequence-relative nodes, not a contiguous prefix of the projection.
+ * Logical path width (16 or 65) bounds counts and node IDs independently of
+ * the physical row stride; node IDs must also fit their sequence's token span.
+ * Every accepted token completes its block BEFORE replacing its tail row.
+ * Metadata rejection is batch-wide and precedes every state write. Device
+ * metadata refusal leaves all state untouched; it cannot synchronously return
+ * a content error. Independent live sequences must own distinct state/pages.
+ */
+struct RadQsaTreeCommitCall {
+    const uint16_t* k;
+    const int32_t *pos, *paths, *lengths, *starts;
+    uint16_t* tail;
+    const int32_t *sidx, *bt;
+    const float* weight;
+    uint16_t* out;
+    int64_t k_ld, pos_stride, path_ld, path_stride, length_stride, start_stride;
+    int64_t tail_slot, tail_row, sidx_ld, bt_ld, out_ld;
+    int tokens, seqs, n, ratio, ring, rot, slots, pages, blocks, capacity;
+    float eps, wadd, theta, scale;
+};
+
+#if defined(__HIPCC__)
+#define RAD_QSA_HD __host__ __device__
+#else
+#define RAD_QSA_HD
+#endif
+
+RAD_QSA_HD inline int rad_qsa_tree_length(const RadQsaTreeCommitCall& c, int s) {
+    return c.lengths[int64_t(s)*c.length_stride];
+}
+RAD_QSA_HD inline int rad_qsa_tree_token(const RadQsaTreeCommitCall& c, int s, int j) {
+    return c.starts[int64_t(s)*c.start_stride] + c.paths[int64_t(s)*c.path_ld+int64_t(j)*c.path_stride];
+}
+RAD_QSA_HD inline int rad_qsa_tree_position(const RadQsaTreeCommitCall& c, int s, int j) {
+    return c.pos[int64_t(rad_qsa_tree_token(c,s,j))*c.pos_stride];
+}
+RAD_QSA_HD inline int rad_qsa_tree_page(const RadQsaTreeCommitCall& c, int s, int p) {
+    return c.bt[int64_t(s)*c.bt_ld+p/c.ratio];
+}
+RAD_QSA_HD inline bool rad_qsa_tree_metadata(const RadQsaTreeCommitCall& c) {
+    for (int s=0; s<c.seqs; ++s) {
+        const int count=rad_qsa_tree_length(c,s), start=c.starts[int64_t(s)*c.start_stride];
+        const int end=s+1<c.seqs ? c.starts[int64_t(s+1)*c.start_stride] : c.tokens;
+        const int slot=c.sidx[int64_t(s)*c.sidx_ld];
+        if (count<0 || count>c.capacity ||
+            start<0 || start>c.tokens || end<start || end>c.tokens ||
+            slot < -1 || slot>=c.slots) return false;
+        int previous=-1;
+        for (int j=0; j<count; ++j) {
+            const int node=c.paths[int64_t(s)*c.path_ld+int64_t(j)*c.path_stride];
+            if (node<0 || node>=c.capacity || node>=end-start) return false;
+            const int p=rad_qsa_tree_position(c,s,j);
+            if (p<0 || p==INT32_MAX || (j && p!=previous+1) || p/c.ratio>=c.blocks) return false;
+            previous=p;
+            if (slot>=0 && (p+1)%c.ratio==0) {
+                const int page=rad_qsa_tree_page(c,s,p);
+                if (page < -1 || page>=c.pages) return false;
+            }
+        }
+    }
+    /* All node and position reads above are bounded before this alias scan. */
+    for (int s=0; s<c.seqs; ++s) {
+        const int ns=rad_qsa_tree_length(c,s), ss=c.sidx[int64_t(s)*c.sidx_ld];
+        if (!ns || ss<0) continue;
+        for (int t=s+1; t<c.seqs; ++t) {
+            const int nt=rad_qsa_tree_length(c,t), st=c.sidx[int64_t(t)*c.sidx_ld];
+            if (!nt || st<0) continue;
+            if (ss==st) return false;
+            for (int j=0; j<ns; ++j) {
+                const int p=rad_qsa_tree_position(c,s,j);
+                if ((p+1)%c.ratio) continue;
+                const int page=rad_qsa_tree_page(c,s,p);
+                if (page<0) continue;
+                for (int k=0; k<nt; ++k) {
+                    const int q=rad_qsa_tree_position(c,t,k);
+                    if ((q+1)%c.ratio==0 && page==rad_qsa_tree_page(c,t,q)) return false;
+                }
+            }
+        }
+    }
+    return true;
+}
+#undef RAD_QSA_HD
+
+int rad_qsa_tree_commit_schema_count(void);
+const RadOpSchema* rad_qsa_tree_commit_schema_at(int);
+int rad_qsa_tree_commit_args(const RadArgs*, RadQsaTreeCommitCall*);
+RadKernelInfo rad_qsa_tree_commit_row(RadLaunchFn);
+int rad_mine_qsa_tree_commit_launch(const RadArgs*, RadStream);
+int rad_ref_qsa_tree_commit(const RadArgs*, RadStream);
+int64_t rad_ref_qsa_tree_commit_scratch(const RadArgs*);
+int rad_mine_qsa_tree_commit_count(void);
+const RadKernelInfo* rad_mine_qsa_tree_commit_at(int);
+int rad_ref_qsa_tree_commit_count(void);
+const RadKernelInfo* rad_ref_qsa_tree_commit_at(int);
+
+#endif
diff --git a/mine/qsa_tree_commit.hip b/mine/qsa_tree_commit.hip
new file mode 100644
index 0000000000000000000000000000000000000000..21ce75038f7bd097385448a5fd71c19982d51441
--- /dev/null
+++ b/mine/qsa_tree_commit.hip
@@ -0,0 +1,92 @@
+#include "qsa_tree_commit.h"
+#include "../libr4d/r4d_common.h"
+#include <hip/hip_runtime.h>
+#include <hip/hip_bf16.h>
+#include <cmath>
+static_assert(sizeof(RadQsaTreeCommitCall)<=768, "AQL kernarg slot bound");
+
+namespace {
+__global__ __launch_bounds__(256) void qsa_tree_commit_kernel(RadQsaTreeCommitCall c) {
+    const int seq=int(blockIdx.x), t=int(threadIdx.x);
+    __shared__ int valid;
+    __shared__ uint16_t tail[32*256];
+    __shared__ float norm[256], red[8];
+    if (!t) valid=rad_qsa_tree_metadata(c);
+    __syncthreads();
+    if (!valid) return; // A bad LAST sequence must also stop every earlier sequence's writes.
+    const int slot=c.sidx[int64_t(seq)*c.sidx_ld], count=rad_qsa_tree_length(c,seq);
+    if (slot<0 || !count) return;
+    if (t<c.n) for (int r=0; r<c.ring; ++r)
+        tail[r*c.n+t]=c.tail[int64_t(slot)*c.tail_slot+int64_t(r)*c.tail_row+t];
+    __syncthreads();
+    for (int j=0; j<count; ++j) {
+        const int tok=rad_qsa_tree_token(c,seq,j), p=c.pos[int64_t(tok)*c.pos_stride];
+        const uint16_t key=t<c.n ? c.k[int64_t(tok)*c.k_ld+t] : uint16_t(0);
+        const int page=(p+1)%c.ratio==0 ? rad_qsa_tree_page(c,seq,p) : -1;
+        if (page>=0) {
+            // Identical to qsa_work's single-token gather followed by qsa_block_key.
+            float acc=0.0f;
+            if (t<c.n) {
+                const int first=p-c.ratio+1;
+                for (int i=0; i<c.ratio; ++i) {
+                    const int q=first+i;
+                    const uint16_t raw=q==p ? key : tail[(q%c.ring)*c.n+t];
+                    acc+=__bfloat162float(*reinterpret_cast<const __hip_bfloat16*>(&raw));
+                }
+                acc=__bfloat162float(__float2bfloat16(acc/float(c.ratio)));
+            }
+            float ss=t<c.n ? acc*acc : 0.0f;
+            ss=r4d_wave_sum(ss);
+            if (!(t&31)) red[t>>5]=ss;
+            __syncthreads();
+            float sum=0.0f;
+            const int nw=(int(blockDim.x)+31)/32;
+            for (int i=0; i<nw; ++i) sum+=red[i];
+            const float inv=rsqrtf(sum/float(c.n)+c.eps);
+            if (t<c.n) norm[t]=__bfloat162float(__float2bfloat16(acc*inv*(c.wadd+c.weight[t])));
+            __syncthreads();
+            if (t<c.n) {
+                float res=norm[t];
+                if (t<c.rot) {
+                    const int half=c.rot>>1;
+                    const bool first=t<half;
+                    const int pt=first ? t+half : t-half, ci=first ? t : t-half;
+                    const float position=float(p-c.ratio+1)/(c.scale!=0.0f ? c.scale : 1.0f);
+                    const float iv=1.0f/powf(c.theta,float(2*ci)/float(c.rot));
+                    float sine, cosine;
+                    sincosf(position*iv,&sine,&cosine);
+                    const float xp=norm[pt];
+                    res=first ? (res*cosine-xp*sine) : (xp*sine+res*cosine);
+                }
+                reinterpret_cast<__hip_bfloat16*>(c.out)[int64_t(page)*c.out_ld+t]=__float2bfloat16(res);
+            }
+            __syncthreads(); // No wave can replace norm[] before its rotary partner reads it.
+        }
+        // LDS, not a global prefix write: the next token sees exactly this token's old-chain store.
+        if (t<c.n) tail[(p%c.ring)*c.n+t]=key;
+        __syncthreads();
+    }
+    // Only the final owner of each touched ring row publishes it, including paths longer than ring.
+    const int first=count>c.ring ? count-c.ring : 0;
+    if (t<c.n) for (int j=first; j<count; ++j) {
+        const int row=rad_qsa_tree_position(c,seq,j)%c.ring;
+        c.tail[int64_t(slot)*c.tail_slot+int64_t(row)*c.tail_row+t]=tail[row*c.n+t];
+    }
+}
+}
+
+int rad_mine_qsa_tree_commit_launch(const RadArgs* a, RadStream stream) {
+    RadQsaTreeCommitCall c{};
+    const int rc=rad_qsa_tree_commit_args(a,&c);
+    if (rc!=RAD_OK) return rc;
+    void* args[]={&c};
+    const unsigned threads=unsigned((c.n+31)/32*32);
+    return hipLaunchKernel(reinterpret_cast<const void*>(qsa_tree_commit_kernel),dim3(c.seqs),
+        dim3(threads),args,0,reinterpret_cast<hipStream_t>(stream))==hipSuccess ? RAD_OK : RAD_E_DEVICE;
+}
+
+int rad_mine_qsa_tree_commit_count(void) { return 1; }
+const RadKernelInfo* rad_mine_qsa_tree_commit_at(int i) {
+    static const RadKernelInfo row=rad_qsa_tree_commit_row(rad_mine_qsa_tree_commit_launch);
+    return i==0 ? &row : nullptr;
+}
diff --git a/mine/qsa_tree_commit_ref.cpp b/mine/qsa_tree_commit_ref.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8ce3752eab4464f65907009a1f0a64a2cbe8cbf9
--- /dev/null
+++ b/mine/qsa_tree_commit_ref.cpp
@@ -0,0 +1,112 @@
+#include "qsa_tree_commit.h"
+
+#include <cmath>
+#include <cstring>
+
+namespace {
+/* The same three algorithms as the old GPU replay. The stage is caller scratch,
+ * reused for one completed block; no vector or allocation exists on launch. */
+void work(const RadQsaTreeCommitCall& c, int tok, int p, int slot, uint16_t* stage) {
+    for (int i=0; i<c.ratio; ++i) {
+        const int q=p-c.ratio+1+i;
+        const uint16_t* src=q==p ? c.k+int64_t(tok)*c.k_ld :
+            c.tail+int64_t(slot)*c.tail_slot+int64_t(q%c.ring)*c.tail_row;
+        std::memcpy(stage+int64_t(i)*c.n,src,size_t(c.n)*2);
+    }
+}
+void block_key(const RadQsaTreeCommitCall& c, int p, int page,
+               const uint16_t* stage, float* pooled, float* norm) {
+    const int threads=(c.n+31)/32*32;
+    for (int d=0; d<threads; ++d) {
+        float acc=0;
+        if (d<c.n) {
+            for (int i=0; i<c.ratio; ++i) acc+=rad_bf16_to_f32(stage[int64_t(i)*c.n+d]);
+            acc=rad_bf16_to_f32(rad_f32_to_bf16(acc/float(c.ratio)));
+        }
+        pooled[d]=acc; norm[d]=acc*acc;
+    }
+    float sum=0;
+    for (int wave=0; wave<threads; wave+=32) {
+        // The lane-zero result of libr4d's XOR 16,8,4,2,1 butterfly, then wave-order addition.
+        for (int offset=16; offset; offset>>=1)
+            for (int d=0; d<offset; ++d) norm[wave+d]+=norm[wave+d+offset];
+        sum+=norm[wave];
+    }
+    const float inv=1.0f/std::sqrt(sum/float(c.n)+c.eps);
+    for (int d=0; d<c.n; ++d)
+        norm[d]=rad_bf16_to_f32(rad_f32_to_bf16(pooled[d]*inv*(c.wadd+c.weight[d])));
+    for (int d=0; d<c.n; ++d) {
+        float res=norm[d];
+        if (d<c.rot) {
+            const int half=c.rot>>1;
+            const bool first=d<half;
+            const int pt=first ? d+half : d-half, ci=first ? d : d-half;
+            const float position=float(p-c.ratio+1)/(c.scale!=0 ? c.scale : 1.0f);
+            const float iv=1.0f/std::pow(c.theta,float(2*ci)/float(c.rot));
+            const float sine=std::sin(position*iv), cosine=std::cos(position*iv);
+            res=first ? (res*cosine-norm[pt]*sine) : (norm[pt]*sine+res*cosine);
+        }
+        c.out[int64_t(page)*c.out_ld+d]=rad_f32_to_bf16(res);
+    }
+}
+void tail_store(const RadQsaTreeCommitCall& c, int tok, int p, int slot) {
+    std::memcpy(c.tail+int64_t(slot)*c.tail_slot+int64_t(p%c.ring)*c.tail_row,
+                c.k+int64_t(tok)*c.k_ld,size_t(c.n)*2);
+}
+}
+
+int64_t rad_ref_qsa_tree_commit_scratch(const RadArgs* a) {
+    if (!a || !a->p) return RAD_E_INVAL;
+    const int64_t n=rad_param_geti(a->p,a->n_p,"n",0);
+    const int64_t ratio=rad_param_geti(a->p,a->n_p,"ratio",0);
+    const int64_t tokens=rad_param_getdim(a->p,a->n_p,"max_tokens",0);
+    if (n<1 || n>256 || ratio<1 || ratio>32 || tokens<1 || tokens>INT32_MAX) return RAD_E_SHAPE;
+    return ((ratio*n*2+3)&~int64_t(3))+2*((n+31)/32*32)*4;
+}
+
+int rad_ref_qsa_tree_commit(const RadArgs* a, RadStream) {
+    RadQsaTreeCommitCall c{};
+    int rc=rad_qsa_tree_commit_args(a,&c);
+    if (rc!=RAD_OK) return rc;
+    if (!rad_qsa_tree_metadata(c)) return RAD_E_INVAL;
+    const int64_t need=rad_ref_qsa_tree_commit_scratch(a);
+    if (need<0) return int(need);
+    const uintptr_t scratch=reinterpret_cast<uintptr_t>(a->scratch);
+    if (!scratch || (scratch&3) || a->scratch_bytes<need || scratch>UINTPTR_MAX-uint64_t(need))
+        return RAD_E_SCRATCH;
+    for (int i=0; i<10; ++i) {
+        const auto& t=a->t[i];
+        uint64_t span=1;
+        for (unsigned d=0; d<t.rank; ++d) span+=uint64_t(t.shape[d]-1)*uint64_t(t.stride[d]);
+        span*=t.dtype==RAD_BF16 ? 2 : 4;
+        const uintptr_t p=reinterpret_cast<uintptr_t>(t.data);
+        if (scratch<p+span && p<scratch+uint64_t(need)) return RAD_E_SCRATCH;
+    }
+    auto* stage=static_cast<uint16_t*>(a->scratch);
+    auto* pooled=reinterpret_cast<float*>(static_cast<uint8_t*>(a->scratch)+((c.ratio*c.n*2+3)&~3));
+    float* norm=pooled+(c.n+31)/32*32;
+    for (int s=0; s<c.seqs; ++s) {
+        const int slot=c.sidx[int64_t(s)*c.sidx_ld];
+        if (slot<0) continue;
+        for (int j=0; j<rad_qsa_tree_length(c,s); ++j) {
+            const int tok=rad_qsa_tree_token(c,s,j), p=c.pos[int64_t(tok)*c.pos_stride];
+            if ((p+1)%c.ratio==0) {
+                const int page=rad_qsa_tree_page(c,s,p);
+                if (page>=0) { work(c,tok,p,slot,stage); block_key(c,p,page,stage,pooled,norm); }
+            }
+            tail_store(c,tok,p,slot);
+        }
+    }
+    return RAD_OK;
+}
+
+int rad_ref_qsa_tree_commit_count(void) { return 1; }
+const RadKernelInfo* rad_ref_qsa_tree_commit_at(int i) {
+    static const RadKernelInfo row=[] {
+        RadKernelInfo r=rad_qsa_tree_commit_row(rad_ref_qsa_tree_commit);
+        r.name="ref_qsa_tree_commit"; r.domain=RAD_DOMAIN_HOST; r.priority=0;
+        r.scratch=rad_ref_qsa_tree_commit_scratch;
+        return r;
+    }();
+    return i==0 ? &row : nullptr;
+}
diff --git a/mine/ref_attn_paged_tree.cpp b/mine/ref_attn_paged_tree.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1e5ed517f8186ecf50e53f1180e570b5d9943697
--- /dev/null
+++ b/mine/ref_attn_paged_tree.cpp
@@ -0,0 +1,69 @@
+#include "attn_paged_tree.h"
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+int rad_ref_attn_paged_tree_launch(const RadArgs* a,RadStream) {
+    RadAttnPagedTreeCall c{}; const int rc=rad_attn_paged_tree_args(a,&c); if(rc) return rc;
+    std::fill_n(c.out,int64_t(c.rows)*3072,uint16_t(0));
+    // Validate the ragged map before deriving any row address.
+    if(c.cu[0]!=0 || c.cu[c.seqs]!=c.rows) return RAD_OK;
+    for(int s=0;s<c.seqs;++s)
+        if(c.cu[s]<0 || c.cu[s+1]<c.cu[s] || c.cu[s+1]>c.rows) return RAD_OK;
+    for(int seq=0;seq<c.seqs;++seq) {
+        const int begin=c.cu[seq], count=c.cu[seq+1]-begin, ctx=c.seqused[seq];
+        if(count==0) continue;
+        bool valid=count<=c.q_bound && ctx>=count && ctx<=c.max_ctx &&
+            (int64_t(ctx)+3)/4<=c.bt_width && c.parent[begin]==-1;
+        for(int j=1;j<count && valid;++j) valid=c.parent[begin+j]>=0 && c.parent[begin+j]<j;
+        for(int64_t b=0;b<(int64_t(ctx)+3)/4 && valid;++b) {
+            const int page=c.bt[int64_t(seq)*c.bt_pitch+b];
+            valid=page>=0 && page<c.pages;
+        }
+        if(!valid) continue;
+        const int prefix=ctx-count;
+        for(int node=0;node<count;++node) {
+            bool ancestors[65]{};
+            int cur=node;
+            for(int step=0;step<65 && cur>=0;++step) {
+                ancestors[cur]=true; cur=c.parent[begin+cur];
+            }
+            for(int head=0;head<12;++head) {
+                auto element=[&](int pos,int col) {
+                    const int page=c.bt[int64_t(seq)*c.bt_pitch+pos/4];
+                    return rad_fp8e4m3_to_f32(c.kv[int64_t(page)*c.kv_block_pitch+(pos%4)*512+col]);
+                };
+                auto logit=[&](int pos) {
+                    double dot=0;
+                    for(int d=0;d<256;++d)
+                        dot+=double(rad_bf16_to_f32(c.q[(int64_t(begin+node)*12+head)*256+d]))*element(pos,d);
+                    return dot/16.0;
+                };
+                // Independent two-pass FP64 softmax, not the device online/split recurrence.
+                double maximum=-std::numeric_limits<double>::infinity();
+                for(int pos=0;pos<ctx;++pos)
+                    if(pos<prefix || ancestors[pos-prefix]) maximum=std::max(maximum,logit(pos));
+                double numerator[256]{}, denominator=0;
+                for(int pos=0;pos<ctx;++pos) {
+                    if(pos>=prefix && !ancestors[pos-prefix]) continue;
+                    const double weight=std::exp(logit(pos)-maximum);
+                    denominator+=weight;
+                    for(int d=0;d<256;++d) numerator[d]+=weight*element(pos,256+d);
+                }
+                for(int d=0;d<256;++d)
+                    c.out[(int64_t(begin+node)*12+head)*256+d]=rad_f32_to_bf16(float(numerator[d]/denominator));
+            }
+        }
+    }
+    return RAD_OK;
+}
+int rad_ref_attn_paged_tree_count() { return 1; }
+const RadKernelInfo* rad_ref_attn_paged_tree_at(int i) {
+    static const RadKernelInfo row=[] {
+        auto r=rad_attn_paged_tree_row(rad_ref_attn_paged_tree_launch);
+        r.name="ref_attn_paged_tree"; r.domain=RAD_DOMAIN_HOST; r.priority=0; r.scratch=nullptr;
+        r.computes="Independent two-pass FP64 QK/softmax/PV oracle, BF16 output; ordered tree visibility.";
+        return r;
+    }();
+    return i==0 ? &row : nullptr;
+}
diff --git a/mine/ref_dflash_tree.cpp b/mine/ref_dflash_tree.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..cfe923d13f13a9d4d8b253b0c578bfb11563d7fa
--- /dev/null
+++ b/mine/ref_dflash_tree.cpp
@@ -0,0 +1,249 @@
+/* ref_dflash_tree.cpp -- the host oracle for `dflash_tree_select`.
+ *
+ * It shares the schema and the call validation with the device row (mine/dflash_tree_select.cpp)
+ * and nothing else, so a mistake in the kernel's shared-memory bookkeeping cannot be reproduced
+ * here. What the two DO have to agree on is arithmetic and order, because the comparison is a byte
+ * comparison:
+ *
+ *   * the edge sum is `dflash_select`'s, operation for operation -- a 32-lane accumulation over
+ *     `r = lane, lane+32, ...` seeded at zero, the xor-butterfly fold (16,8,4,2,1), then `unary`
+ *     added last, all FP32 with no contraction (`-ffp-contract=off` on this unit, and explicit
+ *     temporaries so the compiler cannot fuse anyway);
+ *   * a level keeps its best `width` pairs by (shifted score desc, raw score desc, parent old id
+ *     asc, candidate index asc) -- the raw score second so a shift that rounds two neighbours
+ *     together cannot change a single-parent pick;
+ *   * a level's scores are shifted by that parent's own maximum; a node's score is its parent's
+ *     score plus that shifted increment;
+ *   * pruning keeps the best `budget` nodes by `score + depth_penalty * depth`, refusing a node
+ *     whose parent is not kept;
+ *   * packing is old-id order with root-inclusive parents; an invalid row writes count = 0.
+ *
+ * The tie cases in the tests use EXACTLY equal inputs, so both sides see the same bits and this
+ * oracle's arithmetic is not being asked to adjudicate a 1-ulp difference. */
+#include "ref_dflash_tree.h"
+
+#include "dflash_tree_select.h"
+
+#include <cmath>
+#include <cstring>
+#include <limits>
+
+namespace {
+
+constexpr int kWave = 32;
+constexpr int kMaxK = RAD_DFLASH_TREE_MAX_K;
+constexpr int kMaxWidth = RAD_DFLASH_TREE_MAX_WIDTH;
+constexpr int kMaxNodes = RAD_DFLASH_TREE_MAX_NODES;
+constexpr int kCols = RAD_DFLASH_TREE_OUT_COLS;
+/* The row's node capacity, which is what the packing pitch is derived from. See
+ * mine/dflash_tree_select.hip: the engine declares 16 node slots, and the row is
+ * 1 + 2*capacity columns with the anchor's sentinel in between. */
+constexpr int kCapacity = (kCols - 1) / 2;
+
+float bf(uint16_t x) {
+    const uint32_t u = (uint32_t)x << 16;
+    float f;
+    std::memcpy(&f, &u, 4);
+    return f;
+}
+
+bool finite_f(float x) {
+    return x == x && x != std::numeric_limits<float>::infinity() &&
+           x != -std::numeric_limits<float>::infinity();
+}
+
+/* The production edge sum: 32 lanes, each accumulating its own stride of `r`, folded by halves,
+ * with `unary` added after the fold. `hp` null is the bigram form (a plane of ones). */
+float edge_sum(const uint16_t* pred_row, const uint16_t* hp_row, const uint16_t* succ_row, int R) {
+    float lane[kWave] = {};
+    for (int r = 0; r < R; ++r) {
+        const float p = bf(pred_row[r]);
+        const float a = hp_row ? p * bf(hp_row[r]) : p;
+        lane[r & (kWave - 1)] = lane[r & (kWave - 1)] + a * bf(succ_row[r]);
+    }
+    for (int stride = kWave / 2; stride > 0; stride >>= 1)
+        for (int i = 0; i < stride; ++i) lane[i] = lane[i] + lane[i + stride];
+    return lane[0];
+}
+
+struct Tree {
+    int32_t tok[kMaxNodes], par[kMaxNodes], depth[kMaxNodes];
+    float score[kMaxNodes];
+    int total, first, frontier;
+};
+
+void run_row(const RadDflashTreeSelectCall& c, int64_t s, int32_t* out) {
+    for (int i = 0; i < kCols; ++i) out[i] = -1;
+    out[0] = 0;
+
+    const auto* cand = static_cast<const int32_t*>(c.cand);
+    const auto* unary = static_cast<const float*>(c.unary);
+    const auto* hp = static_cast<const uint16_t*>(c.hp);
+    const auto* anchor = static_cast<const int32_t*>(c.anchor);
+    const auto* pred = static_cast<const uint16_t*>(c.pred);
+    const auto* succ = static_cast<const uint16_t*>(c.succ);
+
+    const int root = anchor[s * c.anchor_stride];
+    if (root < 0 || root >= c.V) return;
+
+    Tree t{};
+    t.tok[0] = root;
+    t.par[0] = -1;
+    t.depth[0] = 0;
+    t.score[0] = 0.0f;
+    t.total = 1;
+    t.first = 0;
+    t.frontier = 1;
+
+    for (int level = 1; level <= c.steps && t.frontier > 0; ++level) {
+        const int64_t row = s * c.steps + level - 1;
+        int32_t ctok[kMaxK];
+        float cun[kMaxK], corr[kMaxK];
+        bool live[kMaxK];
+        for (int j = 0; j < c.K; ++j) {
+            ctok[j] = cand[row * c.cand_ld + j];
+            cun[j] = unary[row * c.unary_ld + j];
+            live[j] = ctok[j] >= 0 && ctok[j] < c.V;
+            /* A non-finite unary on a live candidate invalidates the row. */
+            if (live[j] && !finite_f(cun[j])) return;
+        }
+
+        float pairScore[kMaxK * kMaxWidth], pairCorr[kMaxK * kMaxWidth];
+        int pairParent[kMaxK * kMaxWidth], pairCand[kMaxK * kMaxWidth];
+        int pairs = 0;
+        for (int p = 0; p < t.frontier; ++p) {
+            const int node = t.first + p;
+            const int pid = t.tok[node];
+            for (int j = 0; j < c.K; ++j) {
+                corr[j] = -std::numeric_limits<float>::infinity();
+                if (!live[j]) continue;
+                corr[j] = edge_sum(pred + (int64_t)pid * c.pred_ld,
+                                   hp ? hp + (int64_t)row * c.hp_ld : nullptr,
+                                   succ + (int64_t)ctok[j] * c.succ_ld, int(c.R)) + cun[j];
+                if (!finite_f(corr[j])) return;
+            }
+            float peak = -std::numeric_limits<float>::infinity();
+            for (int j = 0; j < c.K; ++j)
+                if (live[j] && corr[j] > peak) peak = corr[j];
+            for (int j = 0; j < c.K; ++j) {
+                if (!live[j]) continue;
+                /* One node per token under one parent: the scheduler refuses duplicate siblings.
+                 * EVERY instance is compared, so a later one with a higher score evicts an earlier
+                 * one and exactly one survives per token. Best raw score, ties to the lower index --
+                 * the linear walk's own rule, so a width-1 pick is unchanged. */
+                bool beaten = false;
+                for (int q = 0; q < c.K && !beaten; ++q) {
+                    if (q == j || !live[q] || ctok[q] != ctok[j]) continue;
+                    beaten = corr[q] > corr[j] || (corr[q] == corr[j] && q < j);
+                }
+                if (beaten) continue;
+                pairScore[pairs] = t.score[node] + (corr[j] - peak);
+                pairCorr[pairs] = corr[j];
+                pairParent[pairs] = node;
+                pairCand[pairs] = j;
+                ++pairs;
+            }
+        }
+
+        bool used[kMaxK * kMaxWidth] = {};
+        int chosen = 0;
+        for (int w = 0; w < c.width; ++w) {
+            int best = -1;
+            for (int i = 0; i < pairs; ++i) {
+                if (used[i]) continue;
+                if (best < 0 || pairScore[i] > pairScore[best] ||
+                    (pairScore[i] == pairScore[best] &&
+                     (pairParent[i] < pairParent[best] ||
+                      (pairParent[i] == pairParent[best] &&
+                       (pairCorr[i] > pairCorr[best] ||
+                        (pairCorr[i] == pairCorr[best] && pairCand[i] < pairCand[best]))))))
+                    best = i;
+            }
+            if (best < 0) break;
+            used[best] = true;
+            const int node = t.total++;
+            t.tok[node] = ctok[pairCand[best]];
+            t.par[node] = pairParent[best];
+            t.depth[node] = level;
+            t.score[node] = pairScore[best];
+            chosen = w + 1;
+        }
+        t.first = t.total - chosen;
+        t.frontier = chosen;
+    }
+
+    bool keep[kMaxNodes + 1] = {};
+    keep[0] = true;
+    int accepted = 0;
+    while (accepted < c.budget) {
+        int best = -1;
+        float bestValue = 0.0f;
+        for (int i = 1; i < t.total; ++i) {
+            if (keep[i] || !keep[t.par[i]]) continue;
+            const float value = t.score[i] + c.beta * (float)t.depth[i];
+            if (best < 0 || value > bestValue ||
+                (value == bestValue &&
+                 (t.depth[i] < t.depth[best] || (t.depth[i] == t.depth[best] && i < best)))) {
+                best = i;
+                bestValue = value;
+            }
+        }
+        if (best < 0) break;
+        keep[best] = true;
+        ++accepted;
+    }
+
+    int remap[kMaxNodes + 1];
+    for (int i = 0; i <= kMaxNodes; ++i) remap[i] = -1;
+    remap[0] = 0;                      /* the anchor is node 0 */
+    int node = 0;                      /* root-inclusive id of the last emitted node */
+    for (int i = 1; i < t.total; ++i) {
+        if (!keep[i]) continue;
+        const int parent = remap[t.par[i]];
+        if (parent < 0 || t.par[i] >= i) {
+            for (int k = 0; k < kCols; ++k) out[k] = -1;
+            out[0] = 0;
+            return;
+        }
+        remap[i] = ++node;
+        /* The packed row, capacity-generic, as `dloop_tree.hip`, `ref_dloop.cpp` and
+         * `dloop_tree_from_packed` all agree: node i's token at 1+i, its root-inclusive parent at
+         * 1+capacity+i, the anchor's sentinel at 1+capacity. At capacity 16 the parent columns are
+         * 17..32 and the sentinel is column 17. */
+        out[1 + node] = t.tok[i];
+        out[1 + kCapacity + node] = parent;
+    }
+    out[0] = node + 1;
+    out[1] = t.tok[0];
+    out[1 + kCapacity] = -1;          /* the anchor's sentinel parent */
+}
+
+}  /* namespace */
+
+int rad_ref_dflash_tree_select(const RadArgs* a, RadStream) {
+    RadDflashTreeSelectCall c{};
+    const int rc = rad_dflash_tree_select_args(a, &c);
+    if (rc != RAD_OK) return rc;
+    for (int64_t s = 0; s < c.M; ++s)
+        run_row(c, s, static_cast<int32_t*>(c.out) + s * c.out_ld);
+    return RAD_OK;
+}
+
+namespace {
+
+RadKernelInfo host_row() {
+    RadKernelInfo r = rad_dflash_tree_select_row(rad_ref_dflash_tree_select);
+    r.name = "ref_dflash_tree_select";
+    r.domain = RAD_DOMAIN_HOST;
+    r.priority = 0;
+    return r;
+}
+
+}  /* namespace */
+
+int rad_ref_dflash_tree_select_count(void) { return 1; }
+
+const RadKernelInfo* rad_ref_dflash_tree_select_at(int i) {
+    static const RadKernelInfo row = host_row();
+    return i == 0 ? &row : nullptr;
+}
diff --git a/mine/ref_dflash_tree.h b/mine/ref_dflash_tree.h
new file mode 100644
index 0000000000000000000000000000000000000000..934548fef7fb8bdd401b7e957a17c2f5e8b22d42
--- /dev/null
+++ b/mine/ref_dflash_tree.h
@@ -0,0 +1,11 @@
+#ifndef RAD_REF_DFLASH_TREE_H
+#define RAD_REF_DFLASH_TREE_H
+#include "rad_abi.h"
+
+/* The independent host implementation of `dflash_tree_select`. Same op definition, same validated
+ * call struct, and its own tree construction -- see mine/ref_dflash_tree.cpp for what it shares
+ * with the device row (arithmetic and order) and what it does not (bookkeeping). */
+int rad_ref_dflash_tree_select(const RadArgs*, RadStream);
+int rad_ref_dflash_tree_select_count(void);
+const RadKernelInfo* rad_ref_dflash_tree_select_at(int);
+#endif
diff --git a/mine/ref_dloop.cpp b/mine/ref_dloop.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..02a3008b93316f7169cf64551280a71274841c07
--- /dev/null
+++ b/mine/ref_dloop.cpp
@@ -0,0 +1,211 @@
+#include "ref_dloop.h"
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <limits>
+
+namespace {
+float bf(uint16_t x){return rad_bf16_to_f32(x);}
+const uint16_t* b(const RadArgs* a,int i){return static_cast<const uint16_t*>(a->t[i].data);}
+const float* f(const RadArgs* a,int i){return static_cast<const float*>(a->t[i].data);}
+const int32_t* ix(const RadArgs* a,int i){return static_cast<const int32_t*>(a->t[i].data);}
+float* fo(const RadArgs* a,int i){return static_cast<float*>(a->t[i].data);}
+int32_t* io(const RadArgs* a,int i){return static_cast<int32_t*>(a->t[i].data);}
+float dot(const float* x,const uint16_t* w,int n){float z=0;for(int k=0;k<n;++k)z+=x[k]*bf(w[k]);return z;}
+void linear(const float* x,const uint16_t* w,float* y,int rows,int in,int out){
+    for(int t=0;t<rows;++t)for(int j=0;j<out;++j)y[t*out+j]=dot(x+t*in,w+(int64_t)j*in,in);
+}
+void norm(const float* x,const uint16_t* w,float* y,int rows,int h,float eps){
+    for(int t=0;t<rows;++t){float sum=0;for(int j=0;j<h;++j)sum+=x[t*h+j]*x[t*h+j];
+        const float scale=1.0f/std::sqrt(sum/h+eps);
+        for(int j=0;j<h;++j)y[t*h+j]=x[t*h+j]*scale*bf(w[j]);}
+}
+void conv(const RadDLoopConfig& c,const float* x,const uint16_t* base,const float* dyn,int branch,float* y){
+    const int H=c.hidden_size,G=H/c.conv_group_size,K=c.conv_kernel_size,B=c.proposal_length+1;
+    for(int t=0;t<B;++t)for(int h=0;h<H;++h){float sum=0;
+        for(int o=0;o<K&&o<=t;++o){const float v=x[(t-o)*H+h];
+            sum+=bf(base[(branch*K+o)*H+h])*v;
+            sum+=dyn[((t*2+branch)*K+o)*G+h/c.conv_group_size]*v;}
+        y[t*H+h]=sum;}
+}
+void rope(float* x,int rows,int heads,int dim,int position,float theta){
+    for(int t=0;t<rows;++t)for(int h=0;h<heads;++h)for(int j=0;j<dim/2;++j){
+        float* p=x+(t*heads+h)*dim;const float angle=(position+t)*std::pow(theta,-2.0f*j/dim);
+        const float co=std::cos(angle),si=std::sin(angle),a=p[j],z=p[j+dim/2];
+        p[j]=a*co-z*si;p[j+dim/2]=z*co+a*si;}
+}
+bool better(float score,int id,float old,int oid){return score>old||(score==old&&(oid<0||id<oid));}
+void insert(float score,int id,float* scores,int* ids,int k){
+    for(int j=0;j<k;++j)if(better(score,id,scores[j],ids[j])){
+        for(int z=k-1;z>j;--z){scores[z]=scores[z-1];ids[z]=ids[z-1];}
+        scores[j]=score;ids[j]=id;break;}
+}
+int metadata(const RadArgs* a,const RadDLoopConfig& c,int op){
+    const int si=op==0?2:op==1?3:2,li=op==0?6:op==1?2:1,hi=op==0?5:1;
+    if(op==2)return RAD_OK;
+    for(int s=0;s<c.n_seq;++s){const int slot=ix(a,si)[s];if(slot<0||slot>=c.max_seqs)return RAD_E_INVAL;
+        if(op==0){if(ix(a,3)[s]!=0&&ix(a,3)[s]!=1)return RAD_E_INVAL;
+            for(int q=0;q<s;++q)if(ix(a,si)[q]==slot)return RAD_E_INVAL;
+            bool ended=false;for(int j=0;j<16;++j){int v=ix(a,1)[s*16+j];if(v==-1)ended=true;
+                else if(ended||v<0||v>=c.tap_rows)return RAD_E_INVAL;}}
+        if(op!=0||!ix(a,3)[s]){if(ix(a,li)[slot]<(op==0?0:1)||ix(a,li)[slot]>c.context_window)return RAD_E_INVAL;
+            if(op!=3&&(ix(a,hi)[slot]<0||ix(a,hi)[slot]>=c.context_window))return RAD_E_INVAL;}
+        if(op==3&&a->t[16].data&&(ix(a,16)[s]<0||ix(a,16)[s]>=c.active_vocab))return RAD_E_INVAL;
+    }
+    return RAD_OK;
+}
+}
+
+void rad_ref_dloop_forward(const RadDLoopConfig& c,const uint16_t* weights,const float* ctxh,int length,
+    const uint16_t* anchor,const uint16_t* const* prefix,int plen,float* y,float* scratch){
+    const int H=c.hidden_size,B=c.proposal_length+1,C=c.context_window,D=c.num_kv_heads*c.head_dim;
+    const int I=c.intermediate_size,G=H/c.conv_group_size,N=C+B;
+    float* p=scratch;auto take=[&](int64_t n){float* v=p;p+=n;return v;};
+    float* block=take(B*H);float* z=take(B*H);float* pre=take(B*H);float* q=take(B*H);
+    float* att=take(B*H);float* out=take(B*H);float* k=take(N*D);float* v=take(N*D);
+    float* dyn=take(4*B*G);float* gate=take(B*I);float* up=take(B*I);
+    auto w=[&](int id,int l=0){return weights+rad_dloop_weight_offset(c,id,l);};
+    for(int t=0;t<B;++t)for(int h=0;h<H;++h){
+        if(t==0||t<=plen){const auto* emb=t?prefix[t-1]:anchor;float sum=0;
+            for(int j=0;j<c.target_width;++j)sum+=bf(emb[j])*bf(w(DL_TOKEN_PROJ)[(int64_t)h*c.target_width+j]);
+            block[t*H+h]=sum;
+        }else block[t*H+h]=bf(w(DL_MASK_TOKEN)[h]);}
+    for(int l=0;l<c.num_layers;++l){
+        norm(block,w(DL_INPUT_NORM,l),z,B,H,c.eps);
+        const float* x=z;
+        if(c.conv_kernel_size){linear(z,w(DL_ATTN_KERNEL,l),dyn,B,H,4*G);conv(c,z,w(DL_ATTN_BASE,l),dyn,0,pre);x=pre;}
+        linear(x,w(DL_Q_PROJ,l),q,B,H,H);
+        linear(ctxh,w(DL_K_PROJ,l),k,C,H,D);linear(ctxh,w(DL_V_PROJ,l),v,C,H,D);
+        linear(x,w(DL_K_PROJ,l),k+C*D,B,H,D);linear(x,w(DL_V_PROJ,l),v+C*D,B,H,D);
+        rope(q,B,c.num_q_heads,c.head_dim,C,c.rope_theta);rope(k,N,c.num_kv_heads,c.head_dim,0,c.rope_theta);
+        for(int t=0;t<B;++t)for(int h=0;h<c.num_q_heads;++h){float scores[41];float max=-INFINITY;
+            const int kh=h/(c.num_q_heads/c.num_kv_heads);
+            for(int j=0;j<N;++j){float score=-INFINITY;
+                if(j>=C-length){score=0;for(int d=0;d<c.head_dim;++d)score+=q[t*H+h*c.head_dim+d]*k[j*D+kh*c.head_dim+d];score/=std::sqrt((float)c.head_dim);}
+                scores[j]=score;max=std::max(max,score);}
