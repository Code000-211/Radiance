+ * frontier node, an unpruned one at most the budget. */
+int rad_dloop_full_frontier_max(const RadDLoopFullConfig& c) {
+    return std::max(c.model.budget,c.model.pruned?std::min(c.model.width,c.model.pool_size):0);
