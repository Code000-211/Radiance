+    t[1].data = d_k1; t[1].shape[0] = M;
+    t[2].data = d_k2; t[2].shape[0] = M;
+    t[3].data = d_anc; t[3].shape[0] = M;
+    t[4].data = d_toks; t[4].shape[0] = 7;
+    t[5].data = const_cast<FullDrafterGpuPointers*>(weights.ranks[0].d_gpu_pointers);
+    t[6].data = d_out; t[6].shape[0] = M;
+
+    RadArgs a{};
+    a.n_t = 7;
+    a.t = t;
+    a.scratch = d_scratch;
+    a.scratch_bytes = 8388608LL;
+
+    // Load libr4d.so
+    void* lib = dlopen("/home/orca/RadianceMine/worktrees/tap_record/build_hip/radiance_home/kernels/libr4d.so", RTLD_NOW);
+    if (!lib) {
+        std::fprintf(stderr, "dlopen failed: %s\n", dlerror());
+        return 1;
+    }
+    typedef int (*OpFunc)(const RadArgs*, RadStream);
+    OpFunc op_fn = (OpFunc)dlsym(lib, "r4d_rad_fulldrafter_two_stage");
+    if (!op_fn) {
+        std::fprintf(stderr, "dlsym failed: %s\n", dlerror());
+        return 1;
+    }
+
+    const rad_bf16_t* host_emb_table = weights.ranks[0].host_teacher_embedding_table;
+
+    // 5. Warmup (5 iterations on sequence 0)
+    if (!sequences.empty()) {
+        const auto& seq0 = sequences[0];
+        const rad_bf16_t* row_taps = taps_mmap + (size_t)seq0.row_idx * 7680;
+        hipMemcpyHtoD(d_k0, row_taps + 0, W * sizeof(rad_bf16_t));
+        hipMemcpyHtoD(d_k1, row_taps + 2560, W * sizeof(rad_bf16_t));
+        hipMemcpyHtoD(d_k2, row_taps + 5120, W * sizeof(rad_bf16_t));
+        hipMemcpyHtoD(d_anc, host_emb_table + (size_t)seq0.anchor_token * 2560, W * sizeof(rad_bf16_t));
+        int32_t h_toks0[7] = { seq0.anchor_token, 151643, 151643, 151643, 151643, 151643, 151643 };
+        hipMemcpyHtoD(d_toks, h_toks0, 7 * sizeof(int32_t));
+        for (int w = 0; w < 5; ++w) {
+            op_fn(&a, (RadStream)stream);
+        }
+        hipStreamSynchronize(stream);
+    }
+
+    // 6. Evaluate on all sequences
+    std::vector<std::vector<uint32_t>> all_proposals;
+    all_proposals.reserve(sequences.size());
+    std::vector<int> accepted_lengths_k12;
+    accepted_lengths_k12.reserve(sequences.size());
+    std::vector<int> accepted_lengths_k3;
+    accepted_lengths_k3.reserve(sequences.size());
+
+    int total_evaluated_slots = 0;
+    int total_valid_targets = 0;
+    int total_target_hits = 0;
+    int total_accepted_prefix_k12 = 0;
+    int total_accepted_prefix_k3 = 0;
+    int slot_valid[12] = {0};
+    int slot_hits[12] = {0};
+    float total_gpu_ms = 0.0f;
+
+    hipEvent_t ev_start, ev_stop;
+    hipEventCreate(&ev_start);
+    hipEventCreate(&ev_stop);
+
+    for (size_t i = 0; i < sequences.size(); ++i) {
+        const auto& seq = sequences[i];
+        const rad_bf16_t* row_taps = taps_mmap + (size_t)seq.row_idx * 7680;
+        const rad_bf16_t* p_k0 = row_taps + 0;
+        const rad_bf16_t* p_k1 = row_taps + 2560;
+        const rad_bf16_t* p_k2 = row_taps + 5120;
+        const rad_bf16_t* p_anc = host_emb_table + (size_t)seq.anchor_token * 2560;
+
+        hipMemcpyHtoD(d_k0, p_k0, W * sizeof(rad_bf16_t));
+        hipMemcpyHtoD(d_k1, p_k1, W * sizeof(rad_bf16_t));
+        hipMemcpyHtoD(d_k2, p_k2, W * sizeof(rad_bf16_t));
+        hipMemcpyHtoD(d_anc, p_anc, W * sizeof(rad_bf16_t));
+        int32_t h_toks[7] = { seq.anchor_token, 151643, 151643, 151643, 151643, 151643, 151643 };
+        hipMemcpyHtoD(d_toks, h_toks, 7 * sizeof(int32_t));
+
+        hipEventRecord(ev_start, stream);
+        op_fn(&a, (RadStream)stream);
+        hipEventRecord(ev_stop, stream);
+        hipStreamSynchronize(stream);
+
+        float ms = 0.0f;
+        hipEventElapsedTime(&ms, ev_start, ev_stop);
+        total_gpu_ms += ms;
+
+        std::vector<uint32_t> prop(12, 0);
+        hipMemcpyDtoH(prop.data(), d_out, 12 * sizeof(uint32_t));
+        all_proposals.push_back(prop);
+
+        total_evaluated_slots += 12;
+        int accepted_prefix_k12 = 0;
+        bool chain_intact_k12 = true;
+        for (int k = 0; k < 12; ++k) {
+            if (seq.valid_targets[k]) {
+                total_valid_targets++;
+                slot_valid[k]++;
+                if (prop[k] == static_cast<uint32_t>(seq.targets[k])) {
+                    total_target_hits++;
+                    slot_hits[k]++;
+                    if (chain_intact_k12) accepted_prefix_k12++;
+                } else {
+                    chain_intact_k12 = false;
+                }
+            } else {
+                chain_intact_k12 = false;
+            }
+        }
+        total_accepted_prefix_k12 += accepted_prefix_k12;
+        accepted_lengths_k12.push_back(accepted_prefix_k12);
+
+        int accepted_prefix_k3 = 0;
+        bool chain_intact_k3 = true;
+        for (int k = 0; k < 3; ++k) {
+            if (seq.valid_targets[k]) {
+                if (prop[k] == static_cast<uint32_t>(seq.targets[k])) {
+                    if (chain_intact_k3) accepted_prefix_k3++;
+                } else {
+                    chain_intact_k3 = false;
+                }
+            } else {
+                chain_intact_k3 = false;
+            }
+        }
+        total_accepted_prefix_k3 += accepted_prefix_k3;
+        accepted_lengths_k3.push_back(accepted_prefix_k3);
+    }
+
+    float avg_gpu_ms = total_gpu_ms / sequences.size();
+    float hit_rate = (total_valid_targets > 0) ? (100.0f * total_target_hits / total_valid_targets) : 0.0f;
+    float tau_k12 = 1.0f + (float)total_accepted_prefix_k12 / sequences.size();
+    float tau_k3  = 1.0f + (float)total_accepted_prefix_k3  / sequences.size();
+
+    std::printf("-----------------------------------------------------------------\n");
+    std::printf(" Evaluated Sequences         : %zu\n", sequences.size());
+    std::printf(" Total Evaluated Slots       : %d (N_slots = 50 * 12 = %d)\n", total_evaluated_slots, total_evaluated_slots);
+    std::printf(" Valid Target Positions      : %d (N_valid)\n", total_valid_targets);
+    std::printf(" Ground Truth Hits           : %d / %d (%.4f%%)\n", total_target_hits, total_valid_targets, hit_rate);
+    std::printf(" K=12 Accepted Prefix Tokens : %d (Gross Tau = %.4f)\n", total_accepted_prefix_k12, tau_k12);
+    std::printf(" K=3  Accepted Prefix Tokens : %d (Gross Tau = %.4f)\n", total_accepted_prefix_k3, tau_k3);
+    std::printf(" Avg Drafter Pass Latency    : %.3f ms (Total: %.2f ms)\n", avg_gpu_ms, total_gpu_ms);
+    std::printf(" Per-slot Hits [0..11]       :\n   ");
+    for (int k = 0; k < 12; ++k) {
+        std::printf(" s%d:%d/%d", k, slot_hits[k], slot_valid[k]);
+    }
+    std::printf("\n-----------------------------------------------------------------\n");
+
+    // Output JSON if requested
+    if (!out_json.empty()) {
+        nlohmann::json j;
+        j["sidecar"] = sidecar_path;
+        j["teacher"] = teacher_path;
+        j["is_fused"] = weights.is_fused;
+        j["lm_head_dim"] = weights.lm_head_dim;
+        j["total_evaluated_slots"] = total_evaluated_slots;
+        j["total_valid_targets"] = total_valid_targets;
+        j["total_target_hits"] = total_target_hits;
+        j["hit_rate_pct"] = hit_rate;
+        j["total_accepted_prefix_tokens"] = total_accepted_prefix_k12;
+        j["tau_empirical"] = tau_k12;
+        j["total_accepted_prefix_tokens_k12"] = total_accepted_prefix_k12;
+        j["tau_empirical_k12"] = tau_k12;
+        j["total_accepted_prefix_tokens_k3"] = total_accepted_prefix_k3;
+        j["tau_empirical_k3"] = tau_k3;
+        j["avg_gpu_ms"] = avg_gpu_ms;
+        j["total_gpu_ms"] = total_gpu_ms;
+        j["proposals"] = all_proposals;
+        j["accepted_lengths"] = accepted_lengths_k12;
+        j["accepted_lengths_k12"] = accepted_lengths_k12;
+        j["accepted_lengths_k3"] = accepted_lengths_k3;
+        std::vector<int> sh(slot_hits, slot_hits + 12);
+        std::vector<int> sv(slot_valid, slot_valid + 12);
+        j["slot_hits"] = sh;
+        j["slot_valid"] = sv;
+
+        std::ofstream ofs(out_json);
+        ofs << j.dump(2) << std::endl;
+        std::printf("Saved results to %s\n", out_json.c_str());
+    }
+
+    // Cleanup
+    hipFree(d_k0); hipFree(d_k1); hipFree(d_k2); hipFree(d_anc);
+    hipFree(d_toks); hipFree(d_out); hipFree(d_scratch);
+    hipStreamDestroy(stream);
+    hipEventDestroy(ev_start); hipEventDestroy(ev_stop);
+    dlclose(lib);
+
+    return 0;
+}
diff --git a/tests/drafter_graph_replay_test.cpp b/tests/drafter_graph_replay_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b5b92449aaac1d28125e171187e20518dc3d6fba
--- /dev/null
+++ b/tests/drafter_graph_replay_test.cpp
@@ -0,0 +1,180 @@
+#include <iostream>
+#include <vector>
+#include <string>
+#include <cstring>
+#include <cassert>
+#include <dlfcn.h>
+#include <hip/hip_runtime.h>
+#include "arch/common/rad_block_fulldrafter.h"
+#include "libr4d/r4d_fulldrafter.h"
+#include "abi/rad_abi.h"
+
+using namespace radiance;
+
+#define SCR_PER_SEQ         8388608ULL
+#define SCR_PREV_TOK_OFF    196608
+
+typedef int (*r4d_fulldrafter_two_stage_fn)(const RadArgs* a, RadStream s);
+
+int main(int argc, char** argv) {
+    std::string sidecar_path = "/home/orca/drafter_data/checkpoints/flash_next_k12_exp/drafter_step_92500.safetensors";
+    std::string teacher_path = "/home/orca/drafter_data/teacher/teacher-matrices.safetensors";
+    std::string r4d_path = "/home/orca/RadianceMine/worktrees/tap_record/build_hip/radiance_home/kernels/libr4d.so";
+
+    std::printf("=================================================================\n");
+    std::printf("DRAFTER GRAPH REPLAY REGRESSION TEST: ANCHOR DEVICE-BUFFER UPDATE\n");
+    std::printf("=================================================================\n");
+
+    void* lib = dlopen(r4d_path.c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (!lib) {
+        std::fprintf(stderr, "Failed to load %s: %s\n", r4d_path.c_str(), dlerror());
+        return 1;
+    }
+
+    auto fn = (r4d_fulldrafter_two_stage_fn)dlsym(lib, "r4d_rad_fulldrafter_two_stage");
+    if (!fn) {
+        std::fprintf(stderr, "Failed to find r4d_rad_fulldrafter_two_stage: %s\n", dlerror());
+        return 1;
+    }
+
+    radiance::FullDrafterWeights weights{};
+    std::string err;
+    if (!radiance::FullDrafterLoader::load_weights(sidecar_path, &weights, nullptr, &err, 2)) {
+        std::fprintf(stderr, "Failed to load sidecar: %s\n", err.c_str());
+        return 1;
+    }
+    if (!radiance::FullDrafterLoader::load_teacher_matrices(teacher_path, &weights, &err)) {
+        std::fprintf(stderr, "Failed to load teacher: %s\n", err.c_str());
+        return 1;
+    }
+
+    hipSetDevice(0);
+    hipStream_t stream = nullptr;
+    (void)hipStreamCreate(&stream);
+
+    const int W = 2560;
+    const int M = 1;
+    void *d_k0 = nullptr, *d_k1 = nullptr, *d_k2 = nullptr, *d_anc = nullptr;
+    void *d_toks = nullptr, *d_out = nullptr, *d_scratch = nullptr;
+
+    (void)hipMalloc(&d_k0, M * W * sizeof(radiance::rad_bf16_t));
+    (void)hipMalloc(&d_k1, M * W * sizeof(radiance::rad_bf16_t));
+    (void)hipMalloc(&d_k2, M * W * sizeof(radiance::rad_bf16_t));
+    (void)hipMalloc(&d_anc, M * W * sizeof(radiance::rad_bf16_t));
+    (void)hipMalloc(&d_toks, 7 * sizeof(int32_t));
+    (void)hipMalloc(&d_out, 12 * sizeof(uint32_t));
+    (void)hipMalloc(&d_scratch, SCR_PER_SEQ);
+
+    (void)hipMemset(d_k0, 0, M * W * sizeof(radiance::rad_bf16_t));
+    (void)hipMemset(d_k1, 0, M * W * sizeof(radiance::rad_bf16_t));
+    (void)hipMemset(d_k2, 0, M * W * sizeof(radiance::rad_bf16_t));
+    (void)hipMemset(d_scratch, 0, SCR_PER_SEQ);
+
+    RadTensor t[7]{};
+    t[0].data = d_k0;     t[0].shape[0] = M; t[0].shape[1] = W; t[0].dtype = RAD_BF16;
+    t[1].data = d_k1;     t[1].shape[0] = M; t[1].shape[1] = W; t[1].dtype = RAD_BF16;
+    t[2].data = d_k2;     t[2].shape[0] = M; t[2].shape[1] = W; t[2].dtype = RAD_BF16;
+    t[3].data = d_anc;    t[3].shape[0] = M; t[3].shape[1] = W; t[3].dtype = RAD_BF16;
+    t[4].data = d_toks;   t[4].shape[0] = 7; t[4].shape[1] = 1; t[4].dtype = RAD_I32;
+    t[5].data = const_cast<FullDrafterGpuPointers*>(weights.ranks[0].d_gpu_pointers);
+    t[5].shape[0] = 1;    t[5].shape[1] = 1; t[5].dtype = RAD_BF16;
+    t[6].data = d_out;    t[6].shape[0] = 1;  t[6].shape[1] = 12; t[6].dtype = RAD_I32;
+
+    RadParam params[2];
+    params[0].key = "M";            params[0].kind = RAD_P_INT; params[0].ival = 1;
+    params[1].key = "block_stride"; params[1].kind = RAD_P_INT; params[1].ival = 7;
+
+    RadArgs args{};
+    args.t = t;
+    args.n_t = 7;
+    args.p = params;
+    args.n_p = 2;
+    args.scratch = d_scratch;
+    args.scratch_bytes = SCR_PER_SEQ;
+
+    const auto* host_emb = weights.ranks[0].host_teacher_embedding_table;
+
+    // --- SETUP ANCHOR 1 ---
+    int32_t anchor1 = 151644;
+    int32_t h_toks1[7] = { anchor1, 151643, 151643, 151643, 151643, 151643, 151643 };
+    (void)hipMemcpy(d_toks, h_toks1, sizeof(h_toks1), hipMemcpyHostToDevice);
+    (void)hipMemcpy(d_anc, host_emb + (size_t)anchor1 * W, W * sizeof(radiance::rad_bf16_t), hipMemcpyHostToDevice);
+
+    std::printf("[STEP 1] Capturing Graph with Anchor ID = %d...\n", anchor1);
+    hipGraph_t graph = nullptr;
+    hipGraphExec_t instance = nullptr;
+
+    (void)hipStreamBeginCapture(stream, hipStreamCaptureModeGlobal);
+    int rc = fn(&args, (RadStream)stream);
+    assert(rc == 0);
+    (void)hipStreamEndCapture(stream, &graph);
+    assert(graph != nullptr);
+
+    (void)hipGraphInstantiate(&instance, graph, nullptr, nullptr, 0);
+    assert(instance != nullptr);
+    std::printf("  Graph captured and instantiated successfully.\n");
+
+    // --- REPLAY 1 ---
+    std::printf("[STEP 2] Replay 1 (Expecting Anchor = %d)...\n", anchor1);
+    (void)hipGraphLaunch(instance, stream);
+    (void)hipStreamSynchronize(stream);
+
+    uint32_t prop1[12];
+    (void)hipMemcpy(prop1, d_out, sizeof(prop1), hipMemcpyDeviceToHost);
+
+    uint32_t read_anchor1 = 0;
+    (void)hipMemcpy(&read_anchor1, (char*)d_scratch + SCR_PREV_TOK_OFF, sizeof(uint32_t), hipMemcpyDeviceToHost);
+    std::printf("  Replay 1 proposals: [%u, %u, %u, %u, %u, %u]\n",
+                prop1[0], prop1[1], prop1[2], prop1[3], prop1[4], prop1[5]);
+    std::printf("  Scratch read anchor: %u (expected %d)\n", read_anchor1, anchor1);
+    assert(read_anchor1 == (uint32_t)anchor1);
+
+    // --- UPDATE DEVICE BUFFER FOR REPLAY 2 (DIFFERENT ANCHOR) ---
+    int32_t anchor2 = 9906;
+    std::printf("[STEP 3] Updating Device Buffer on Stream to Anchor ID = %d (NO Graph Recapture)...\n", anchor2);
+    int32_t h_toks2[7] = { anchor2, 151643, 151643, 151643, 151643, 151643, 151643 };
+    (void)hipMemcpyAsync(d_toks, h_toks2, sizeof(h_toks2), hipMemcpyHostToDevice, stream);
+    (void)hipMemcpyAsync(d_anc, host_emb + (size_t)anchor2 * W, W * sizeof(radiance::rad_bf16_t), hipMemcpyHostToDevice, stream);
+
+    // --- REPLAY 2 ---
+    std::printf("[STEP 4] Replay 2 (Expecting Anchor = %d)...\n", anchor2);
+    (void)hipGraphLaunch(instance, stream);
+    (void)hipStreamSynchronize(stream);
+
+    uint32_t prop2[12];
+    (void)hipMemcpy(prop2, d_out, sizeof(prop2), hipMemcpyDeviceToHost);
+
+    uint32_t read_anchor2 = 0;
+    (void)hipMemcpy(&read_anchor2, (char*)d_scratch + SCR_PREV_TOK_OFF, sizeof(uint32_t), hipMemcpyDeviceToHost);
+    std::printf("  Replay 2 proposals: [%u, %u, %u, %u, %u, %u]\n",
+                prop2[0], prop2[1], prop2[2], prop2[3], prop2[4], prop2[5]);
+    std::printf("  Scratch read anchor: %u (expected %d)\n", read_anchor2, anchor2);
+    assert(read_anchor2 == (uint32_t)anchor2);
+    assert(prop1[0] != prop2[0]); // Proposal must differ because conditioning changed!
+
+    // --- STEP 5: VERIFY BITWISE PARITY WITH FRESH UNCAPTURED EXECUTION ---
+    std::printf("[STEP 5] Comparing Replay 2 against fresh uncaptured run with Anchor = %d...\n", anchor2);
+    (void)hipMemset(d_out, 0, 12 * sizeof(uint32_t));
+    rc = fn(&args, (RadStream)stream);
+    assert(rc == 0);
+    (void)hipStreamSynchronize(stream);
+
+    uint32_t prop_fresh[12];
+    (void)hipMemcpy(prop_fresh, d_out, sizeof(prop_fresh), hipMemcpyDeviceToHost);
+
+    bool bitwise_match = (std::memcmp(prop2, prop_fresh, sizeof(prop2)) == 0);
+    std::printf("  Bitwise match Replay 2 vs Fresh Run: %s\n", bitwise_match ? "YES (PASSED)" : "NO (FAILED)");
+    assert(bitwise_match);
+
+    std::printf("\n>>> REGRESSION TEST PASSED: Graph replays correctly propagate device-buffer anchor updates! <<<\n");
+
+    // Cleanup
+    (void)hipGraphExecDestroy(instance);
+    (void)hipGraphDestroy(graph);
+    (void)hipFree(d_k0); (void)hipFree(d_k1); (void)hipFree(d_k2); (void)hipFree(d_anc);
+    (void)hipFree(d_toks); (void)hipFree(d_out); (void)hipFree(d_scratch);
+    (void)hipStreamDestroy(stream);
+    dlclose(lib);
+
+    return 0;
+}
