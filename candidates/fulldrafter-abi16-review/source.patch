+def parse_offsets_from_file(filepath):
+    offsets = {}
+    pattern = re.compile(r"#define\s+(FULLDRAFTER_)?([A-Za-z0-9_]+)\s+([0-9]+L*)")
+    with open(filepath, "r") as f:
+        for line in f:
+            m = pattern.search(line)
+            if m:
+                name = m.group(2)
+                val_str = m.group(3).rstrip("L")
+                offsets[name] = int(val_str)
+    return offsets
+
