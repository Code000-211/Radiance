+        with open(self.h_path) as f:
+            self.h_code = f.read()
+
+        # Parse scratch offsets
+        self.offsets = {}
+        for m in re.finditer(r"#define\s+(SCR_\w+_OFF)\s+([0-9L]+)", self.hip_code):
+            name = m.group(1)
+            val = int(m.group(2).rstrip("L"))
