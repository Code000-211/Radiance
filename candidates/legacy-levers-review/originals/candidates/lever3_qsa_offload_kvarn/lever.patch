diff --git a/arch/common/rad_block_attn_gated_fp8.h b/arch/common/rad_block_attn_gated_fp8.h
index 0fe5282..7bc71b1 100644
--- a/arch/common/rad_block_attn_gated_fp8.h
+++ b/arch/common/rad_block_attn_gated_fp8.h
@@ -143,7 +143,7 @@ struct AttnGatedFP8 {
     rad_op     op_fused_kv = 0;                              /* ...with kv_store folded on, likewise */
     int64_t    fused_rows = 0;                               /* ...and the widest T it is issued at */
     rad_op     op_q_norm = 0, op_k_norm = 0, op_rope_q = 0, op_rope_k = 0;
-    rad_op     op_attn = 0, op_kv_store = 0, op_gq = 0;
+    rad_op     op_attn = 0, op_kv_store = 0, op_query_fwht = 0, op_gq = 0;
     rad_op     op_attn_gq = 0;                               /* attn_paged + gate_quant_fp8 */
     rad_op     op_sig = 0, op_mul = 0;                       /* the bf16 gate, Geom::w_bf16 */
     rad_op     op_ar = 0, op_add = 0;
@@ -337,12 +337,19 @@ inline int AttnGatedFP8::declare(RadBuilder* b, Names& nm, const Geom& geom, int
                          RAD_NOWEIGHTS),
                      {w.k, w.v}, {});
 
+    const bool is_k4v4 = g.kv_dtype && (!std::strcmp(g.kv_dtype, "k4v4") || !std::strcmp(g.kv_dtype, "i4"));
+    if (is_k4v4)
+        op_query_fwht = rw(b, RAD_OP(b, "query_fwht",
+                                      RAD_PARAMS(RAD_RANGE("M", 1, g.max_tok)),
+                                      RAD_NOWEIGHTS),
+                           {w.q}, {w.q});
+
     /* THE PROLOGUE AND THE CACHE STORE AS ONE LAUNCH, wherever the fused prologue is taken: a k
      * head's block already holds its token's rotated k, one element a lane, so it writes that and
      * the head's v into the cache too, byte-for-byte what kv_store would (the fold's row says why).
      * Declared here and not beside op_fused because the cache's block size is read back from the
      * attention op above. It resolves for an E4M3 and a bf16 cache alike. */
-    if (op_fused)
+    if (op_fused && !is_k4v4)
         op_fused_kv = rw(b, RAD_OP(b, "qk_norm_rope_gate_kv_store",
                             RAD_PARAMS(RAD_RANGE("M", 1, fused_rows),
                                        RAD_INT("head_dim", g.head_dim), RAD_INT("n_head", g.n_head),
@@ -395,7 +402,7 @@ inline int AttnGatedFP8::declare(RadBuilder* b, Names& nm, const Geom& geom, int
      * gates, rounds and quantises the row where it is, byte-for-byte the pair (its row says how),
      * and the launch between them is gone. Declared only beside a selection: the dense path's
      * query rows are the band the prefill kernel serves as well, and that kernel has no merge. */
-    if (op_attn && qsa_sel && qsa_sequ && !g.w_bf16) {
+    if (op_attn && qsa_sel && qsa_sequ && !g.w_bf16 && !is_k4v4) {
         op_attn_gq = RAD_OP(b, "attn_paged_gate_quant",
                             RAD_PARAMS(RAD_INT("q_len", 1), RAD_INT("head_dim", g.head_dim),
                                        RAD_INT("gqa", g.gqa()), RAD_INT("causal", 1),
@@ -483,6 +490,9 @@ inline void AttnGatedFP8::step(RadCtx* c, const RadBatch* batch) const {
         RAD_ISSUE(c, op_kv_store,
                   brows(w.k, T), brows(w.v, T), praw(slot, RAD_I32, T), kv_cache(kv, layer));
 
+    if (op_query_fwht)
+        RAD_ISSUE_N(c, op_query_fwht, T, brows(w.q, T));
+
     /* ONE ROW A QUERY IS WHAT MAKES THE SPARSE PATH WORK AT PREFILL, and it needs no new kernel
      * for the same reason the decode path needed none: `attn_paged` indexes its block table and
      * its length by the ROW, and nothing says a row has to be a sequence. A chunk of T queries
diff --git a/arch/common/rad_qsa.h b/arch/common/rad_qsa.h
index 76044b6..9ddd843 100644
--- a/arch/common/rad_qsa.h
+++ b/arch/common/rad_qsa.h
@@ -503,6 +503,27 @@ inline void QsaIndexer::step(RadCtx* c_, const ActFP8& in, const RadBatch* batch
                          hsc[0], hsc[1], hsc[2], hsc[3]);
         }
     }
+
+    if (const char* dump_path = std::getenv("RADIANCE_DUMP_QSA_SEL")) {
+        int sel_count = (int)(T * (c.topk + 1));
+        std::vector<int32_t> hsel(sel_count);
+        rad_stream_sync(rad_stream(c_));
+        rad_memcpy_async(hsel.data(), rad_buf_ptr(c_, w.sel), sel_count * sizeof(int32_t), rad_stream(c_));
+        rad_stream_sync(rad_stream(c_));
+
+        FILE* f = std::fopen(dump_path, "a");
+        if (f) {
+            for (int t = 0; t < T; ++t) {
+                int32_t pos = batch->positions ? ((const int32_t*)batch->positions)[t] : -1;
+                std::fprintf(f, "%d\t%d\t%d", layer, t, pos);
+                for (int k = 0; k < c.topk; ++k) {
+                    std::fprintf(f, "\t%d", hsel[t * (c.topk + 1) + k]);
+                }
+                std::fprintf(f, "\n");
+            }
+            std::fclose(f);
+        }
+    }
 }
 
 }  /* namespace arch */
diff --git a/arch/qwen4exp_fp8/qwen4exp_fp8.cpp b/arch/qwen4exp_fp8/qwen4exp_fp8.cpp
index 147b8ba..4478d7b 100644
--- a/arch/qwen4exp_fp8/qwen4exp_fp8.cpp
+++ b/arch/qwen4exp_fp8/qwen4exp_fp8.cpp
@@ -198,6 +198,23 @@ struct Model {
     VisionTower vit{};
     MediaRows   mrows{};
 
+    bool        qsa_offload = false;
+    bool        kvarn = false;
+
+    void prefetch_layer_blocks(RadCtx* c, int target_layer, RadStream s1, const RadBatch* batch) const {
+        (void)batch;
+        if (!qsa_offload || !kv_full) return;
+        void* dev_ptr = rad_kv_ptr(c, kv_full, target_layer);
+        if (!dev_ptr) return;
+        const int64_t topk = qsacfg.topk > 0 ? qsacfg.topk : 512;
+        const int64_t bytes_per_element = kvarn ? 1 : 2;
+        const int64_t bytes_per_block = g.n_head_kv * g.head_dim * 4 * bytes_per_element;
+        const int64_t prefetch_bytes = topk * bytes_per_block;
+        void* host_ptr = rad_dev_host_ptr(dev_ptr);
+        if (host_ptr && host_ptr != dev_ptr) {
+            rad_memcpy_async(dev_ptr, host_ptr, prefetch_bytes, s1);
+        }
+    }
 };
 
 static Model g_model[MAX_RANKS];
@@ -318,6 +335,11 @@ static int declare(RadBuilder* b, const RadModelMeta* meta, const RadBuildCtx* c
     m.nm = Names(ctx->scope ? ctx->scope : "");
     Names& nm = m.nm;
 
+    const char* env_qsa = std::getenv("RADIANCE_QSA_OFFLOAD");
+    const char* env_kvarn = std::getenv("RADIANCE_KVARN");
+    m.qsa_offload = (ctx->qsa_offload != 0) || (env_qsa && std::atoi(env_qsa) != 0);
+    m.kvarn = (ctx->kvarn != 0) || (env_kvarn && std::atoi(env_kvarn) != 0);
+
     /* arch_splits_ff: the routed experts' width (640 = five fp8 blocks) is split by the plugin
      * below, by whole blocks and parity, at any world up to the block count -- three ranks included,
      * which 640 does not divide. geom_from must not refuse what the plugin then answers. */
@@ -1495,7 +1517,13 @@ static void step(RadCtx* c, const RadBatch* batch) {
         {
             l.hc_mix.read(c, T, 0, T);
             if (l.full) {
+                if (m.qsa_offload && li > 3) rad_lane_join(c, 1, 0);
                 l.qsa.step(c, l.attn.w.h, batch);
+                if (m.qsa_offload && (li + 4 < m.n_run && li + 4 < (int64_t)m.layers.size())) {
+                    rad_lane(c, 1);
+                    m.prefetch_layer_blocks(c, (int)(li + 4), rad_stream(c), batch);
+                    rad_lane(c, 0);
+                }
                 l.attn.step(c, batch);
             }
             else        l.gdn.step(c, batch);
