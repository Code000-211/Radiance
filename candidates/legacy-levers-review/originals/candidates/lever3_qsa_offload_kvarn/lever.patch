         else if (S("--kv-cache-dtype")) {
             if (!(v = need(i))) return RAD_E_INVAL;
-            if (std::strcmp(v, "bf16") && std::strcmp(v, "fp8")) {
-                RAD_ERR("--kv-cache-dtype takes bf16 or fp8, not '%s'", v);
+            if (std::strcmp(v, "bf16") && std::strcmp(v, "fp8") && std::strcmp(v, "k4v4")) {
