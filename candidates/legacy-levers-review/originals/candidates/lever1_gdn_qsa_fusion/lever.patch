+TEST(qwen4exp_gdn_in_proj_concat_and_qsa_qprep_fusion) {
+    RadModelMeta meta = qwen4exp_meta();
+    RadBuildCtx c2 = build_ctx(0, 2);
+    c2.max_tok  = 2048;
+    c2.max_seqs = 8;
+    c2.max_spec = 3;
+    c2.max_ctx  = 200000;
+    RadBuilder b;
+    REQUIRE_EQ(qwen4exp_fp8::declare(&b, &meta, &c2), RAD_OK);
+    const qwen4exp_fp8::Model& m = qwen4exp_fp8::g_model[0];
+
+    /* 1. GDN blk.0.ssm_in weight concatenation at TP2:
+     * Total rows N = 8240 (5120 conv [q|k|v] + 3072 gate z + 48 decay gates a & b) */
+    const RecWeight* w_in = nullptr;
+    const RecWeight* w_ab = nullptr;
+    for (const RecWeight& w : b.weights) {
+        if (w.name == "blk.0.ssm_in.weight") w_in = &w;
+        if (w.name == "blk.0.ssm_ab.weight") w_ab = &w;
+    }
+    REQUIRE(w_in != nullptr);
+    CHECK(w_ab == nullptr);
+    CHECK_EQ(w_in->d.shape[0], 8240);
+    CHECK_EQ(w_in->d.shape[1], 2560);
+    CHECK_EQ(w_in->d.shard, RAD_SHARD_ROW);
+    CHECK_EQ(w_in->d.n_row_parts, 6);
+    CHECK_EQ(w_in->d.row_parts[0], 1024);
+    CHECK_EQ(w_in->d.row_parts[1], 1024);
+    CHECK_EQ(w_in->d.row_parts[2], 3072);
+    CHECK_EQ(w_in->d.row_parts[3], 3072);
+    CHECK_EQ(w_in->d.row_parts[4], 24);
+    CHECK_EQ(w_in->d.row_parts[5], 24);
+
+    /* 2. QSA op_qprep declaration on full-attention layers (layer 3 and 7): */
+    CHECK(m.layers[3].full);
+    CHECK(m.layers[3].qsa.on());
+    CHECK(m.layers[3].qsa.op_qprep != 0);
+
+    /* 3. Issue decode step and verify execution: */
+    RadCtx c; c.b = &b; c.rank = 0; c.world = 2;
+    RadBatch batch = decode_batch();
+    c.batch = &batch;
+    qwen4exp_fp8::step(&c, &batch);
+
+    /* In GDN Layer 0: only 1 in-projection GEMM is issued (m.layers[0].gdn.in.op or op_m1).
+     * In QSA Layer 3: op_qprep (qk_norm_rope_gate) is issued as 1 fused launch instead of 4 rmsnorm + 1 rope. */
+    int layer0_in_gemm_count = 0;
+    int qsa_qprep_count = 0;
+    int qsa_unfused_norm_count = 0;
+    int qsa_unfused_rope_count = 0;
+
+    for (const auto& issue : c.issues) {
+        if (issue.op == m.layers[0].gdn.in.op || issue.op == m.layers[0].gdn.in.op_m1)
+            ++layer0_in_gemm_count;
+        if (issue.op == m.layers[3].qsa.op_qprep)
+            ++qsa_qprep_count;
+        if (issue.op == m.layers[3].qsa.op_norm)
+            ++qsa_unfused_norm_count;
+        if (issue.op == m.layers[3].qsa.op_rope)
+            ++qsa_unfused_rope_count;
+    }
+    CHECK_EQ(layer0_in_gemm_count, 1);
+    CHECK_EQ(qsa_qprep_count, 1);
+    CHECK_EQ(qsa_unfused_norm_count, 0);
+    CHECK_EQ(qsa_unfused_rope_count, 0);
+}
