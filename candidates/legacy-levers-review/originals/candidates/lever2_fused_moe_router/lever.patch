+        std::vector<RadParam> ps = { PI("M", M), PI("K", 2560), PI("n_expert", 512),
+                                     PI("top_k", 10), PI("norm", 1), PS("dtype", "bf16") };
+        run_case(rg, ts, ps, RAD_E_SHAPE);
+    }
+}
