+                                              T(d_w, RAD_BF16, { c.ne, c.K }),
+                                              T(d_wg, RAD_BF16, { 1, c.K }),
+                                              T(d_lg[1], RAD_BF16, { M, c.ne }),
+                                              T(d_id[1], RAD_I32, { M, c.k }),
+                                              T(d_ew[1], RAD_BF16, { M, c.k }),
+                                              T(d_so[1], RAD_I32, { NS }),
+                                              T(d_of[1], RAD_I32, { c.nl + 1 }),
